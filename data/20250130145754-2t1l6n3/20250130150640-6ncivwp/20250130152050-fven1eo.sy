									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "递归"
								},
								{
									"Type": "NodeText",
									"Data": "：将问题分解为子问题 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "f(n)=n+f(n−1) "
