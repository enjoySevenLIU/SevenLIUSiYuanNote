	"Properties": {
		"id": "20250130152050-fven1eo",
		"title": "A2L2——迭代与递归",
		"type": "doc",
		"updated": "20250130155518"
	},
	"Children": [
		{
			"ID": "20250130152050-clyg5n1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152050-clyg5n1",
				"updated": "20250130152126"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "在算法中，重复执行某个任务是很常见的，它与复杂度分析息息相关。\n因此，在介绍时间复杂度和空间复杂度之前，我们先来了解如何在程序中实现重复执行任务，\n即两种基本的程序控制结构：迭代、递归。"
				}
			]
		},
		{
			"ID": "20250130152127-zs1oahg",
			"Type": "NodeHeading",
			"HeadingLevel": 1,
			"Properties": {
				"id": "20250130152127-zs1oahg",
				"updated": "20250130152449"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "迭代"
				}
			]
		},
		{
			"ID": "20250130152131-1wazu3l",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152131-1wazu3l",
				"updated": "20250130152137"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "u",
					"TextMarkTextContent": "迭代（iteration）"
				},
				{
					"Type": "NodeText",
					"Data": "是一种重复执行某个任务的控制结构。\n在迭代中，程序会在满足一定的条件下重复执行某段代码，直到这个条件不再满足。"
				}
			]
		},
		{
			"ID": "20250130152138-3zsymc4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152138-3zsymc4",
				"updated": "20250130152150"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "迭代的形式包括："
				}
			]
		},
		{
			"ID": "20250130152151-88ntum1",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20250130152151-88ntum1",
				"updated": "20250130152449"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "for 循环"
				}
			]
		},
		{
			"ID": "20250130152212-oiecj3t",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152212-oiecj3t",
				"updated": "20250130152218"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "​"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "for"
				},
				{
					"Type": "NodeText",
					"Data": "​ 循环是最常见的迭代形式之一，"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "适合在预先知道迭代次数时使用"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20250130152222-4rt11u8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152222-4rt11u8",
				"updated": "20250130152431"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "以下函数基于 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "for"
				},
				{
					"Type": "NodeText",
					"Data": "​ 循环实现了求和 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "1+2+...+n"
				},
				{
					"Type": "NodeText",
					"Data": " ，求和结果使用变量 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "res"
				},
				{
					"Type": "NodeText",
					"Data": "​ 记录。"
				}
			]
		},
		{
			"ID": "20250130152247-sqm62lv",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20250130152247-sqm62lv",
				"style": "line-height: 22px;",
				"updated": "20250130152449"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "YyM="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "int ForLoop(int n)\n{\n    int result = 0;\n    for (int i = 0; i \u003c n; i++)\n    {\n        result += i;\n    }\n    return result;\n}\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		},
