		{
			"ID": "20250130153804-42ohunh",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130153804-42ohunh",
				"updated": "20250130153808"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "在实际中，编程语言允许的递归深度通常是有限的，过深的递归可能导致栈溢出错误。"
				}
			]
		},
		{
			"ID": "20250130153818-r5uolwq",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20250130153818-r5uolwq",
				"updated": "20250130154209"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "尾递归"
				}
			]
		},
		{
			"ID": "20250130153828-j6fi7u6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130153828-j6fi7u6",
				"updated": "20250130153831"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "有趣的是，"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "如果函数在返回前的最后一步才进行递归调用"
				},
				{
					"Type": "NodeText",
					"Data": "，则该函数可以被编译器或解释器优化，\n使其在空间效率上与迭代相当。这种情况被称为"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "u",
					"TextMarkTextContent": "尾递归（tail recursion）"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20250130154208-on4pkuj",
			"Type": "NodeBlockquote",
			"Properties": {
				"id": "20250130154208-on4pkuj",
				"style": "background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);",
				"updated": "20250130154209"
			},
			"Children": [
				{
					"Type": "NodeBlockquoteMarker",
					"Data": "\u003e"
				},
				{
					"ID": "20250130154209-85g5jhc",
					"Type": "NodeParagraph",
					"Properties": {
						"id": "20250130154209-85g5jhc",
						"updated": "20250130154209"
					},
					"Children": [
						{
							"Type": "NodeText",
							"Data": "请注意，许多编译器或解释器并不支持尾递归优化。例如，Python 默认不支持尾递归优化，因此即使函数是尾递归形式，仍然可能会遇到栈溢出问题。"
						}
					]
				}
			]
		},
		{
			"ID": "20250130153838-xpbecc4",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20250130153838-xpbecc4",
				"updated": "20250130153838"
			},
			"Children": [
				{
					"ID": "20250130153838-brzcgd0",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130153838-brzcgd0",
						"updated": "20250130153838"
					},
					"Children": [
						{
							"ID": "20250130153838-vy9u45f",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130153838-vy9u45f",
								"updated": "20250130153838"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "普通递归"
								},
								{
									"Type": "NodeText",
									"Data": "：当函数返回到上一层级的函数后，需要继续执行代码，因此系统需要保存上一层调用的上下文。"
								}
							]
						}
					]
				},
				{
					"ID": "20250130153838-gt8u8hx",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130153838-gt8u8hx",
						"updated": "20250130153838"
					},
					"Children": [
						{
							"ID": "20250130153838-ibobkfj",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130153838-ibobkfj",
								"updated": "20250130153838"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "尾递归"
								},
								{
									"Type": "NodeText",
									"Data": "：递归调用是函数返回前的最后一个操作，这意味着函数返回到上一层级后，无须继续执行其他操作，因此系统无须保存上一层函数的上下文。"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20250130153840-4q2zncq",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130153840-4q2zncq",
				"updated": "20250130153854"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "以计算 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "1+2+...+n"
				},
				{
					"Type": "NodeText",
					"Data": " 为例，我们可以将结果变量 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "res"
				},
				{
					"Type": "NodeText",
					"Data": "​ 设为函数参数，从而实现尾递归："
				}
			]
		},
		{
			"ID": "20250130153855-r5y2zml",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20250130153855-r5y2zml",
				"style": "line-height: 22px;",
				"updated": "20250130154042"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "YyM="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "int TailRecur(int n, int res)\n{\n    if (n == 0)\n        return res;\n    return TailRecur(n - 1, res + n);\n}\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		},
		{
			"ID": "20250130154107-m5027w0",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130154107-m5027w0",
				"updated": "20250130154116"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "尾递归的执行过程下图，对比普通递归和尾递归，两者的求和操作的执行点是不同的。"
				}
			]
		},
		{
			"ID": "20250130154121-gy4uqzs",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
