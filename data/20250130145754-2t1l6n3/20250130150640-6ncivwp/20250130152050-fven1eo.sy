							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "迭代"
								},
								{
									"Type": "NodeText",
									"Data": "：“自下而上”地解决问题。从最基础的步骤开始，然后不断重复或累加这些步骤，直到任务完成。"
								}
							]
						}
					]
				},
				{
					"ID": "20250130153555-35mumqa",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
