							"Properties": {
								"id": "20250130153646-25pq39k",
								"updated": "20250130153702"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "迭代"
								},
								{
									"Type": "NodeText",
									"Data": "：在循环中模拟求和过程，从 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "1"
								},
								{
									"Type": "NodeText",
									"Data": " 遍历到 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "n"
								},
								{
									"Type": "NodeText",
									"Data": " ，每轮执行求和操作，即可求得 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "f(n)"
								},
								{
									"Type": "NodeText",
									"Data": "。"
								}
							]
						}
					]
				},
				{
					"ID": "20250130153646-4xkkuxa",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
