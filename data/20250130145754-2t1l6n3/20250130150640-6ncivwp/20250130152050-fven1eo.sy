				"updated": "20250130153732"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "递归函数每次调用自身时，系统都会为新开启的函数分配内存，以存储局部变量、调用地址和其他信息等。这将导致两方面的结果。"
				}
			]
		},
		{
			"ID": "20250130153741-qh7tywe",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20250130153741-qh7tywe",
				"updated": "20250130153741"
			},
			"Children": [
				{
					"ID": "20250130153741-3h9kqia",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130153741-3h9kqia",
						"updated": "20250130153741"
					},
					"Children": [
						{
							"ID": "20250130153741-fzjif4v",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130153741-fzjif4v",
								"updated": "20250130153741"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "函数的上下文数据都存储在称为“栈帧空间”的内存区域中，直至函数返回后才会被释放。因此，"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "递归通常比迭代更加耗费内存空间"
								},
								{
									"Type": "NodeText",
									"Data": "。"
								}
							]
						}
					]
				},
				{
					"ID": "20250130153741-n1ir2gl",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130153741-n1ir2gl",
						"updated": "20250130153741"
					},
					"Children": [
						{
							"ID": "20250130153741-oy17zxq",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130153741-oy17zxq",
								"updated": "20250130153741"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "递归调用函数会产生额外的开销。"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "因此递归通常比循环的时间效率更低"
								},
								{
									"Type": "NodeText",
									"Data": "。"
								}
							]
						}
					]
				}
			]
		},
		{
