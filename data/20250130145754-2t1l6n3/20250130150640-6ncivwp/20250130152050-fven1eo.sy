			]
		},
		{
			"ID": "20250130155154-5kfrwvk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130155154-5kfrwvk",
				"updated": "20250130155158"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "那么，迭代和递归具有什么内在联系呢？以上述递归函数为例，求和操作在递归的“归”阶段进行。\n这意味着最初被调用的函数实际上是最后完成其求和操作的，这种工作机制与栈的“先入后出”原则异曲同工。"
				}
			]
		},
		{
			"ID": "20250130155205-dsr040w",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130155205-dsr040w",
				"updated": "20250130155207"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "事实上，“调用栈”和“栈帧空间”这类递归术语已经暗示了递归与栈之间的密切关系："
				}
			]
		},
		{
			"ID": "20250130155205-txah8cq",
			"Type": "NodeList",
			"ListData": {
				"Typ": 1
			},
			"Properties": {
				"id": "20250130155205-txah8cq",
				"updated": "20250130155205"
			},
			"Children": [
				{
					"ID": "20250130155205-818p8lt",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Delimiter": 46,
						"Marker": "MS4=",
						"Num": 1
					},
					"Properties": {
						"id": "20250130155205-818p8lt",
						"updated": "20250130155205"
					},
					"Children": [
						{
							"ID": "20250130155205-bhvji36",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130155205-bhvji36",
								"updated": "20250130155205"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "递"
								},
								{
									"Type": "NodeText",
									"Data": "：当函数被调用时，系统会在“调用栈”上为该函数分配新的栈帧，用于存储函数的局部变量、参数、返回地址等数据。"
								}
							]
						}
					]
				},
				{
					"ID": "20250130155205-cz9yuo9",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Delimiter": 46,
						"Marker": "Mi4=",
						"Num": 2
					},
					"Properties": {
						"id": "20250130155205-cz9yuo9",
						"updated": "20250130155205"
					},
					"Children": [
						{
							"ID": "20250130155205-1ndqfy9",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130155205-1ndqfy9",
								"updated": "20250130155205"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "归"
								},
								{
									"Type": "NodeText",
									"Data": "：当函数完成执行并返回时，对应的栈帧会被从“调用栈”上移除，恢复之前函数的执行环境。"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20250130155221-4obwohf",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130155221-4obwohf",
				"updated": "20250130155221"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "因此，"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "我们可以使用一个显式的栈来模拟调用栈的行为"
				},
				{
					"Type": "NodeText",
					"Data": "，从而将递归转化为迭代形式："
				}
			]
		},
		{
			"ID": "20250130155223-3odm4gr",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20250130155223-3odm4gr",
				"style": "line-height: 22px;",
				"updated": "20250130155445"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "YyM="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "int ForLoopRecur(int n)\n{\n    Stack\u003cint\u003e stack = new();\n    int res = 0;\n    // 递：递归调用\n    for (int i = n; i \u003e 0; i--)\n    {\n        stack.Push(i);\n    }\n    // 归：返回结果\n    while (stack.Count \u003e 0)\n    {\n        res += stack.Pop();\n    }\n    // res = 1 + 2 + 3 + ... + n\n    return res;\n}\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		},
		{
			"ID": "20250130155456-ptzubtf",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130155456-ptzubtf",
				"updated": "20250130155508"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "观察以上代码，当递归转化为迭代后，代码变得更加复杂了。\n尽管迭代和递归在很多情况下可以互相转化，但不一定值得这样做，有以下两点原因："
				}
			]
		},
		{
			"ID": "20250130155513-6hwtfnc",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20250130155513-6hwtfnc",
				"updated": "20250130155513"
			},
			"Children": [
				{
					"ID": "20250130155513-ubxvx2y",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130155513-ubxvx2y",
						"updated": "20250130155513"
					},
					"Children": [
						{
							"ID": "20250130155513-z44ccbh",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130155513-z44ccbh",
								"updated": "20250130155513"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "转化后的代码可能更加难以理解，可读性更差。"
								}
							]
						}
					]
				},
				{
					"ID": "20250130155513-jyoea4p",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130155513-jyoea4p",
						"updated": "20250130155513"
					},
					"Children": [
						{
							"ID": "20250130155513-nsjfdos",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130155513-nsjfdos",
								"updated": "20250130155513"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "对于某些复杂问题，模拟系统调用栈的行为可能非常困难。"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20250130155518-tvzle3g",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130155518-tvzle3g",
				"updated": "20250130155518"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "总之，"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "选择迭代还是递归取决于特定问题的性质"
				},
				{
					"Type": "NodeText",
					"Data": "。在编程实践中，权衡两者的优劣并根据情境选择合适的方法至关重要。"
				}
			]
		}
	]
}