		{
			"ID": "20250130154221-ynzyse2",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20250130154221-ynzyse2",
				"updated": "20250130154955"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "递归树"
				}
			]
		},
		{
			"ID": "20250130154227-ctz4wq4",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130154227-ctz4wq4",
				"updated": "20250130154227"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "当处理与“分治”相关的算法问题时，递归往往比迭代的思路更加直观、代码更加易读。以“斐波那契数列”为例。"
				}
			]
		},
		{
			"ID": "20250130154234-h8m09fl",
			"Type": "NodeBlockquote",
			"Properties": {
				"id": "20250130154234-h8m09fl",
				"updated": "20250130154300"
			},
			"Children": [
				{
					"Type": "NodeBlockquoteMarker",
					"Data": "\u003e"
				},
				{
					"ID": "20250130154234-oxvy30p",
					"Type": "NodeParagraph",
					"Properties": {
						"id": "20250130154234-oxvy30p",
						"updated": "20250130154300"
					},
					"Children": [
						{
							"Type": "NodeText",
							"Data": "问题：给定一个斐波那契数列 "
						},
						{
							"Type": "NodeTextMark",
							"TextMarkType": "inline-math",
							"TextMarkInlineMathContent": "0,1,1,2,3,5,8,13,..."
						},
						{
							"Type": "NodeText",
							"Data": " ，求该数列的第 "
						},
						{
							"Type": "NodeTextMark",
							"TextMarkType": "inline-math",
							"TextMarkInlineMathContent": "n"
						},
						{
							"Type": "NodeText",
							"Data": " 个数字。"
						}
					]
				}
			]
		},
		{
			"ID": "20250130154308-d9sgtyx",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130154308-d9sgtyx",
				"updated": "20250130154316"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "设斐波那契数列的第 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "n"
				},
				{
					"Type": "NodeText",
					"Data": " 个数字为 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "f(n)"
				},
				{
					"Type": "NodeText",
					"Data": "，易得两个结论。"
				}
			]
		},
		{
			"ID": "20250130154308-0cgnaqc",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20250130154308-0cgnaqc",
				"updated": "20250130154333"
			},
			"Children": [
				{
					"ID": "20250130154308-172cjf2",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130154308-172cjf2",
						"updated": "20250130154323"
					},
					"Children": [
						{
							"ID": "20250130154308-xuuokve",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130154308-xuuokve",
								"updated": "20250130154323"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "数列的前两个数字为 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "f(1)=0"
								},
								{
									"Type": "NodeText",
									"Data": " 和 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "f(2)=1"
								},
								{
									"Type": "NodeText",
									"Data": " 。"
								}
							]
						}
					]
				},
				{
					"ID": "20250130154308-pjsmo5b",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130154308-pjsmo5b",
						"updated": "20250130154333"
					},
					"Children": [
						{
							"ID": "20250130154308-miai0up",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130154308-miai0up",
								"updated": "20250130154333"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "数列中的每个数字是前两个数字的和，即 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "f(n)=f(n−1)+f(n−2)"
								},
								{
									"Type": "NodeText",
									"Data": "。"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20250130154338-po332mw",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130154338-po332mw",
				"updated": "20250130154340"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "按照递推关系进行递归调用，将前两个数字作为终止条件，便可写出递归代码。调用 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "fib(n)"
				},
				{
					"Type": "NodeText",
					"Data": "​ 即可得到斐波那契数列的第 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "n"
				},
				{
					"Type": "NodeText",
					"Data": " 个数字："
				}
			]
		},
		{
			"ID": "20250130154342-9pxb446",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20250130154342-9pxb446",
				"style": "line-height: 22px;",
				"updated": "20250130154817"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "YyM="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "int Fib(int n)\n{\n    if (n == 1 || n == 2)\n        return n - 1;\n    return Fib(n - 1) + Fib(n - 2);\n}\n\nConsole.WriteLine($\"{nameof(Fib)}: {Fib(5)}\");\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		},
		{
			"ID": "20250130154817-qag6yl8",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130154817-qag6yl8",
				"updated": "20250130154827"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "输出："
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "Fib: 3"
				},
				{
					"Type": "NodeText",
					"Data": "​"
				}
			]
		},
		{
			"ID": "20250130154829-rhapbda",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130154829-rhapbda",
				"updated": "20250130154918"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "观察以上代码，我们在函数内递归调用了两个函数，"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "这意味着从一个调用产生了两个调用分支"
				},
				{
					"Type": "NodeText",
					"Data": "。\n如下图所示，这样不断递归调用下去，最终将产生一棵层数为 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "n"
				},
				{
					"Type": "NodeText",
					"Data": " 的"
				},
				{
					"Type": "NodeTextMark",
