					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130154121-nkf3s23",
						"updated": "20250130154121"
					},
					"Children": [
						{
							"ID": "20250130154121-c0rrsay",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130154121-c0rrsay",
								"updated": "20250130154121"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "普通递归"
								},
								{
									"Type": "NodeText",
									"Data": "：求和操作是在“归”的过程中执行的，每层返回后都要再执行一次求和操作。"
								}
							]
						}
					]
				},
				{
					"ID": "20250130154121-xq8bnf7",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130154121-xq8bnf7",
						"updated": "20250130154121"
					},
					"Children": [
						{
							"ID": "20250130154121-k95cxwo",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130154121-k95cxwo",
								"updated": "20250130154121"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "尾递归"
								},
								{
									"Type": "NodeText",
									"Data": "：求和操作是在“递”的过程中执行的，“归”的过程只需层层返回。"
								}
							]
						}
					]
				}
			]
		},
