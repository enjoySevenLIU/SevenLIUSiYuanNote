			"Children": [
				{
					"Type": "NodeText",
					"Data": "while 循环"
				}
			]
		},
		{
			"ID": "20250130152415-grtognw",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152415-grtognw",
				"updated": "20250130152420"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "与 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "for"
				},
				{
					"Type": "NodeText",
					"Data": "​ 循环类似，"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "while"
				},
				{
					"Type": "NodeText",
					"Data": "​ 循环也是一种实现迭代的方法。\n在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "while"
				},
				{
					"Type": "NodeText",
					"Data": "​ 循环中，程序每轮都会先检查条件，如果条件为真，则继续执行，否则就结束循环。"
				}
			]
		},
		{
			"ID": "20250130152428-yrk3qe1",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152428-yrk3qe1",
				"updated": "20250130152439"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "下面我们用 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "while"
				},
				{
					"Type": "NodeText",
					"Data": "​ 循环来实现求和 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "1+2+...+n"
				},
				{
					"Type": "NodeText",
					"Data": "："
				}
			]
		},
		{
			"ID": "20250130152437-f8pvky6",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20250130152437-f8pvky6",
				"style": "line-height: 22px;",
				"updated": "20250130152535"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "YyM="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "int WhileLoop(int n)\n{\n    int result = 0;\n    int i = 1;\n    while (i \u003c n)\n    {\n        result += i;\n        i++;\n    }\n    return result;\n}\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		},
		{
			"ID": "20250130152605-bgt5na0",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152605-bgt5na0",
				"updated": "20250130152605"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "​"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong code",
					"TextMarkTextContent": "while"
				},
				{
					"Type": "NodeText",
					"Data": "​ "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "循环比"
				},
				{
					"Type": "NodeText",
					"Data": " "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong code",
					"TextMarkTextContent": "for"
				},
				{
					"Type": "NodeText",
					"Data": "​ "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "循环的自由度更高"
				},
				{
					"Type": "NodeText",
					"Data": "。在 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "while"
				},
				{
					"Type": "NodeText",
					"Data": "​ 循环中，我们可以自由地设计条件变量的初始化和更新步骤。"
				}
			]
		},
		{
			"ID": "20250130152657-spuwezt",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152657-spuwezt",
				"updated": "20250130152707"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "例如在以下代码中，条件变量 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "i"
				},
				{
					"Type": "NodeText",
					"Data": "​ 每轮进行两次更新，这种情况就不太方便用 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "for"
				},
				{
					"Type": "NodeText",
					"Data": "​ 循环实现："
				}
			]
		},
		{
			"ID": "20250130152652-nbd5528",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20250130152652-nbd5528",
				"style": "line-height: 22px;",
				"updated": "20250130152653"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "YyM="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "/* while 循环（两次更新） */\nint WhileLoopII(int n)\n{\n    int res = 0;\n    int i = 1; // 初始化条件变量\n    // 循环求和 1, 4, 10, ...\n    while (i \u003c= n)\n    {\n        res += i;\n        // 更新条件变量\n        i += 1;\n        i *= 2;\n    }\n    return res;\n}\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		},
		{
			"ID": "20250130152717-5buivu9",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20250130152717-5buivu9",
				"updated": "20250130153129"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "嵌套循环"
				}
			]
		},
		{
			"ID": "20250130152726-8i3weuv",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152726-8i3weuv",
				"updated": "20250130152726"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "我们可以在一个循环结构内嵌套另一个循环结构，下面以 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "code",
					"TextMarkTextContent": "for"
				},
				{
					"Type": "NodeText",
					"Data": "​ 循环为例："
				}
			]
		},
		{
			"ID": "20250130152728-wowrbzb",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20250130152728-wowrbzb",
				"style": "line-height: 22px;",
				"updated": "20250130152851"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "YyM="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "/* 双层 for 循环 */\nstring NestedForLoop(int n)\n{\n    StringBuilder res = new();\n    // 循环 i = 1, 2, ..., n-1, n\n    for (int i = 1; i \u003c= n; i++)\n    {\n        // 循环 j = 1, 2, ..., n-1, n\n        for (int j = 1; j \u003c= n; j++)\n        {\n            res.Append($\"({i}, {j}), \");\n        }\n    }\n    return res.ToString();\n}\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		},
		{
			"ID": "20250130153027-ialm88q",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130153027-ialm88q",
				"updated": "20250130153129"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "在这种情况下，函数的操作数量与 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "n^2"
				},
				{
					"Type": "NodeText",
					"Data": " 成正比，或者说算法运行时间和输入数据大小 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "n"
				},
				{
					"Type": "NodeText",
					"Data": " 成“平方关系”。\n我们可以继续添加嵌套循环，每一次嵌套都是一次“升维”，将会使时间复杂度提高至“立方关系”“四次方关系”，以此类推。"
				}
			]
		},
		{
			"ID": "20250130153046-11npkf1",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20250130153046-11npkf1",
				"style": "line-height: 22px;",
				"updated": "20250130153052"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker",
					"CodeBlockInfo": "YyM="
				},
				{
					"Type": "NodeCodeBlockCode",
					"Data": "Console.WriteLine(NestedForLoop(3));\n"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		},
		{
			"ID": "20250130153058-7qlzkkp",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130153058-7qlzkkp",
