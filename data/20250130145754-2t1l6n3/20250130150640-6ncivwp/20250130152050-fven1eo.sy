				"updated": "20250130153642"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "以上述求和函数为例，设问题 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "f(n)=1+2+...+n"
				},
				{
					"Type": "NodeText",
					"Data": "："
				}
			]
		},
		{
			"ID": "20250130153646-r90c5nu",
