	"Type": "NodeDocument",
	"Properties": {
		"id": "20250130152002-euv8nf8",
		"title": "A2L1——算法赋值评估",
		"type": "doc",
		"updated": "20250130152103"
	},
	"Children": [
		{
			"ID": "20250130152024-xuavbd2",
			"Type": "NodeHeading",
			"HeadingLevel": 1,
			"Properties": {
				"id": "20250130152024-xuavbd2",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "算法效率评估"
				}
			]
		},
		{
			"ID": "20250130152024-28f9r78",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152024-28f9r78",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "在算法设计中，我们先后追求以下两个层面的目标："
				}
			]
		},
		{
			"ID": "20250130152024-5a157c5",
			"Type": "NodeList",
			"ListData": {
				"Typ": 1
			},
			"Properties": {
				"id": "20250130152024-5a157c5",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"ID": "20250130152024-m5q3nfc",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Delimiter": 46,
						"Marker": "MS4=",
						"Num": 1
					},
					"Properties": {
						"id": "20250130152024-m5q3nfc",
						"updated": "20250130152024"
					},
					"Children": [
						{
							"ID": "20250130152024-imur1fw",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130152024-imur1fw",
								"updated": "20250130152024"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "找到问题解法"
								},
								{
									"Type": "NodeText",
									"Data": "：算法需要在规定的输入范围内可靠地求得问题的正确解。"
								}
							]
						}
					]
				},
				{
					"ID": "20250130152024-6o90n5a",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Delimiter": 46,
						"Marker": "Mi4=",
						"Num": 2
					},
					"Properties": {
						"id": "20250130152024-6o90n5a",
						"updated": "20250130152024"
					},
					"Children": [
						{
							"ID": "20250130152024-kjw3bfp",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130152024-kjw3bfp",
								"updated": "20250130152024"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "寻求最优解法"
								},
								{
									"Type": "NodeText",
									"Data": "：同一个问题可能存在多种解法，我们希望找到尽可能高效的算法。"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20250130152024-m23dc21",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152024-m23dc21",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "也就是说，在能够解决问题的前提下，算法效率已成为衡量算法优劣的主要评价指标，它包括以下两个维度。"
				}
			]
		},
		{
			"ID": "20250130152024-5brv1un",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20250130152024-5brv1un",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"ID": "20250130152024-1prg991",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130152024-1prg991",
						"updated": "20250130152024"
					},
					"Children": [
						{
							"ID": "20250130152024-x74ruww",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130152024-x74ruww",
								"updated": "20250130152024"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "时间效率"
								},
								{
									"Type": "NodeText",
									"Data": "：算法运行时间的长短。"
								}
							]
						}
					]
				},
				{
					"ID": "20250130152024-42gkenz",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130152024-42gkenz",
						"updated": "20250130152024"
					},
					"Children": [
						{
							"ID": "20250130152024-sm8latc",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130152024-sm8latc",
								"updated": "20250130152024"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "空间效率"
								},
								{
									"Type": "NodeText",
									"Data": "：算法占用内存空间的大小。"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20250130152024-vq84iot",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152024-vq84iot",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "简而言之，"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "我们的目标是设计“既快又省”的数据结构与算法"
				},
				{
					"Type": "NodeText",
					"Data": "。\n而有效地评估算法效率至关重要，因为只有这样，我们才能将各种算法进行对比，进而指导算法设计与优化过程。"
				}
			]
		},
		{
			"ID": "20250130152024-i8ovne6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152024-i8ovne6",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "效率评估方法主要分为两种：实际测试、理论估算。"
				}
			]
		},
		{
			"ID": "20250130152024-8k2t904",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20250130152024-8k2t904",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "实际测试"
				}
			]
		},
		{
			"ID": "20250130152024-7btmgvt",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152024-7btmgvt",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "假设我们现在有算法 A 和算法 B ，它们都能解决同一问题，现在需要对比这两个算法的效率。\n最直接的方法是找一台计算机，运行这两个算法，并监控记录它们的运行时间和内存占用情况。\n这种评估方式能够反映真实情况，但也存在较大的局限性："
				}
			]
		},
		{
			"ID": "20250130152024-4qtxldr",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20250130152024-4qtxldr",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"ID": "20250130152024-8n8yb11",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130152024-8n8yb11",
						"updated": "20250130152024"
					},
					"Children": [
						{
							"ID": "20250130152024-49b50hr",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130152024-49b50hr",
								"updated": "20250130152024"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "难以排除测试环境的干扰因素"
								}
							]
						},
						{
							"ID": "20250130152024-zich1al",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130152024-zich1al",
								"updated": "20250130152024"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "硬件配置会影响算法的性能表现。\n比如一个算法的并行度较高，那么它就更适合在多核 CPU 上运行，一个算法的内存操作密集，那么它在高性能内存上的表现就会更好。\n也就是说，算法在不同的机器上的测试结果可能是不一致的。这意味着我们需要在各种机器上进行测试，统计平均效率，而这是不现实的。"
								}
							]
						}
					]
				},
				{
					"ID": "20250130152024-3ulp386",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130152024-3ulp386",
						"updated": "20250130152024"
					},
					"Children": [
						{
							"ID": "20250130152024-jqal4vd",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130152024-jqal4vd",
								"updated": "20250130152024"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "展开完整测试非常耗费资源"
								}
							]
						},
						{
							"ID": "20250130152024-is3o8a3",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130152024-is3o8a3",
								"updated": "20250130152024"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "随着输入数据量的变化，算法会表现出不同的效率。\n例如，在输入数据量较小时，算法 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "A"
								},
								{
									"Type": "NodeText",
									"Data": "​ 的运行时间比算法 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "B"
								},
								{
									"Type": "NodeText",
									"Data": "​ 短；而在输入数据量较大时，测试结果可能恰恰相反。\n因此，为了得到有说服力的结论，我们需要测试各种规模的输入数据，而这需要耗费大量的计算资源。"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20250130152024-f0c076y",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20250130152024-f0c076y",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "理论估算（复杂度分析）"
				}
			]
		},
		{
			"ID": "20250130152024-ouls0xd",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152024-ouls0xd",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "由于实际测试具有较大的局限性，我们可以考虑仅通过一些计算来评估算法的效率。\n这种估算方法被称为"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "u",
					"TextMarkTextContent": "渐近复杂度分析（asymptotic complexity analysis）"
				},
				{
					"Type": "NodeText",
					"Data": "，简称"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "u",
					"TextMarkTextContent": "复杂度分析"
				},
				{
					"Type": "NodeText",
					"Data": "。"
				}
			]
		},
		{
			"ID": "20250130152024-oc51k8k",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152024-oc51k8k",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "复杂度分析能够体现算法运行所需的时间和空间资源与输入数据大小之间的关系。\n"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "它描述了随着输入数据大小的增加，算法执行所需时间和空间的增长趋势"
				}
			]
		},
		{
			"ID": "20250130152024-rid3aqi",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152024-rid3aqi",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "具体分析这句话，分三个方面："
				}
			]
		},
		{
			"ID": "20250130152024-c86zfxt",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20250130152024-c86zfxt",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"ID": "20250130152024-0xg1heb",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130152024-0xg1heb",
						"updated": "20250130152024"
					},
					"Children": [
						{
							"ID": "20250130152024-wtz6v54",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130152024-wtz6v54",
								"updated": "20250130152024"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "“时间和空间资源”分别对应 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "u",
									"TextMarkTextContent": "时间复杂度（time complexity）"
								},
								{
									"Type": "NodeText",
									"Data": "和 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "u",
									"TextMarkTextContent": "空间复杂度（space complexity）"
								},
								{
									"Type": "NodeText",
									"Data": "。"
								}
							]
						}
					]
				},
				{
					"ID": "20250130152024-hsa0iaj",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130152024-hsa0iaj",
						"updated": "20250130152024"
					},
					"Children": [
						{
							"ID": "20250130152024-8scep3g",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130152024-8scep3g",
								"updated": "20250130152024"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "“随着输入数据大小的增加”意味着复杂度反映了 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "算法运行效率"
								},
								{
									"Type": "NodeText",
									"Data": " 与 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "输入数据体量"
								},
								{
									"Type": "NodeText",
									"Data": " 之间的关系。"
								}
							]
						}
					]
				},
				{
					"ID": "20250130152024-b6pfftt",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250130152024-b6pfftt",
						"updated": "20250130152024"
					},
					"Children": [
						{
							"ID": "20250130152024-ffl6dmj",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250130152024-ffl6dmj",
								"updated": "20250130152024"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "“时间和空间的增长趋势”表示复杂度分析关注的不是运行时间或占用空间的具体值，而是"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "时间或空间增长的“快慢”。"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20250130152024-gufwxoq",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250130152024-gufwxoq",
				"updated": "20250130152024"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "复杂度分析为我们提供了一把评估算法效率的“标尺”，使我们可以衡量执行某个算法所需的时间和空间资源，对比不同算法之间的效率。"
				}
			]
		}
	]
}