TextMarkType":"inline-math","TextMarkInlineMathContent":"O(1)"},{"Type":"NodeText","Data":" ："}]},{"ID":"20250130163342-jh1n8bp","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250130163342-jh1n8bp","style":"line-height: 22px;","updated":"20250130163355"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"/* 常数阶 */\nint Constant(int n)\n{\n    int count = 0;\n    int size = 100000;\n    for (int i = 0; i \u003c size; i++)\n        count++;\n    return count;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250130163229-h12atqb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250130163229-h12atqb","updated":"20250130163651"},"Children":[{"Type":"NodeText","Data":"线性阶 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(n)"},{"Type":"NodeText"}]},{"ID":"20250130163405-vq5qc15","Type":"NodeParagraph","Properties":{"id":"20250130163405-vq5qc15","updated":"20250130163408"},"Children":[{"Type":"NodeText","Data":"线性阶的操作数量相对于输入数据大小 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" 以线性级别增长。线性阶通常出现在单层循环中："}]},{"ID":"20250130163410-8c9qj75","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250130163410-8c9qj75","style":"line-height: 22px;","updated":"20250130163421"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"/* 线性阶 */\nint Linear(int n)\n{\n    int count = 0;\n    for (int i = 0; i \u003c n; i++)\n        count++;\n    return count;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250130163422-tvjc4wz","Type":"NodeParagraph","Properties":{"id":"20250130163422-tvjc4wz","updated":"20250130163434"},"Children":[{"Type":"NodeText","Data":"遍历数组和遍历链表等操作的时间复杂度均为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(n)"},{"Type":"NodeText","Data":" ，其中 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" 为数组或链表的长度："}]},{"ID":"20250130163436-dt81dq6","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250130163436-dt81dq6","style":"line-height: 22px;","updated":"20250130163453"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"/* 线性阶（遍历数组） */\nint ArrayTraversal(int[] nums)\n{\n    int count = 0;\n    // 循环次数与数组长度成正比\n    foreach (int num in nums)\n    {\n        count++;\n    }\n    return count;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250130163455-6ygpujw","Type":"NodeParagraph","Properties":{"id":"20250130163455-6ygpujw","updated":"20250130163521"},"Children":[{"Type":"NodeText","Data":"值得注意的是，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"输入数据大小"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"需根据输入数据的类型来具体确定"},{"Type":"NodeText","Data":"。\n比如在第一个示例中，变量 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" 为输入数据大小；在第二个示例中，数组长度 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" 为数据大小。"}]},{"ID":"20250130163235-faoqek7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250130163235-faoqek7","updated":"20250130163922"},"Children":[{"Type":"NodeText","Data":"平方阶 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(n^2)"},{"Type":"NodeText"}]},{"ID":"20250130163529-596zx7r","Type":"NodeParagraph","Properties":{"id":"20250130163529-596zx7r","updated":"20250130163551"},"Children":[{"Type":"NodeText","Data":"平方阶的操作数量相对于输入数据大小 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" 以平方级别增长。\n平方阶通常出现在嵌套循环中，外层循环和内层循环的时间复杂度都为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(n)"},{"Type":"NodeText","Data":" ，因此总体的时间复杂度为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(n^2)"},{"Type":"NodeText","Data":"："}]},{"ID":"20250130163553-0ar1kpd","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250130163553-0ar1kpd","style":"line-height: 22px;","updated":"20250130163603"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"/* 平方阶 */\nint Quadratic(int n)\n{\n    int count = 0;\n    // 循环次数与数据大小 n 成平方关系\n    for (int i = 0; i \u003c n; i++)\n    {\n        for (int j = 0; j \u003c n; j++)\n        {\n            count++;\n        }\n    }\n    return count;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250130163732-vw08pp8","Type":"NodeParagraph","Properties":{"id":"20250130163732-vw08pp8","updated":"20250130163736"},"Children":[{"Type":"NodeText","Data":"下图对比了常数阶、线性阶和平方阶三种时间复杂度。"}]},{"ID":"20250130163744-o3uq8la","Type":"NodeParagraph","Properties":{"id":"20250130163744-o3uq8la","updated":"20250130163744"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 468px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250130163744-e3kwr17.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 468px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20250130163748-8ienp40","Type":"NodeParagraph","Properties":{"id":"20250130163748-8ienp40","updated":"20250130163906"},"Children":[{"Type":"NodeText","Data":"以冒泡排序为例，外层循环执行 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n−1"},{"Type":"NodeText","Data":" 次，内层循环执行 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n−1"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n−2"},{"Type":"NodeText","Data":"、...、"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"2"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1"},{"Type":"NodeText","Data":" 次，\n平均为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\frac{n}{2}"},{"Type":"NodeText","Data":" 次，因此时间复杂度为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(\\frac{(n−1)n}{2})=O(n^2)"},{"Type":"NodeText","Data":" ："}]},{"ID":"20250130163911-9sczw6s","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250130163911-9sczw6s","style":"line-height: 22px;","updated":"20250130163922"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"/* 平方阶（冒泡排序） */\nint BubbleSort(int[] nums)\n{\n    int count = 0;  // 计数器\n    // 外循环：未排序区间为 [0, i]\n    for (int i = nums.Length - 1; i \u003e 0; i--)\n    {\n        // 内循环：将未排序区间 [0, i] 中的最大元素交换至该区间的最右端\n        for (int j = 0; j \u003c i; j++)\n        {\n            if (nums[j] \u003e nums[j + 1])\n            {\n                // 交换 nums[j] 与 nums[j + 1]\n                (nums[j + 1], nums[j]) = (nums[j], nums[j + 1]);\n                count += 3;  // 元素交换包含 3 个单元操作\n            }\n        }\n    }\n    return count;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250130163246-32mpza8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250130163246-32mpza8","updated":"20250130164146"},"Children":[{"Type":"NodeText","Data":"指数阶 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(2^n)"}]},{"ID":"20250130163944-y8j9f62","Type":"NodeParagraph","Properties":{"id":"20250130163944-y8j9f62","updated":"20250130164011"},"Children":[{"Type":"NodeText","Data":"生物学的“细胞分裂”是指数阶增长的典型例子：初始状态为 1 个细胞，分裂一轮后变为 2 个，分裂两轮后变为 4 个，以此类推，分裂 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" 轮后有 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"2^n"},{"Type":"NodeText","Data":" 个细胞。"}]},{"ID":"20250130164013-qulz481","Type":"NodeParagraph","Properties":{"id":"20250130164013-qulz481","updated":"20250130164028"},"Children":[{"Type":"NodeText","Data":"以下代码模拟了细胞分裂的过程，时间复杂度为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(2^n)"},{"Type":"NodeText","Data":" 。请注意，输入 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" 表示分裂轮数，返回值 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"count"},{"Type":"NodeText","Data":"​ 表示总分裂次数。"}]},{"ID":"20250130164029-0uxsidf","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250130164029-0uxsidf","style":"line-height: 22px;","updated":"20250130164042"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"/* 指数阶（循环实现） */\nint Exponential(int n)\n{\n    int count = 0, bas = 1;\n    // 细胞每轮一分为二，形成数列 1, 2, 4, 8, ..., 2^(n-1)\n    for (int i = 0; i \u003c n; i++)\n    {\n        for (int j = 0; j \u003c bas; j++)\n        {\n            count++;\n        }\n        bas *= 2;\n    }\n    // count = 1 + 2 + 4 + 8 + .. + 2^(n-1) = 2^n - 1\n    return count;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250130164051-4gj1tvb","Type":"NodeParagraph","Properties":{"id":"20250130164051-4gj1tvb","updated":"20250130164051"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 457px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250130164051-xqqww3t.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 457px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20250130164107-m0uq41w","Type":"NodeParagraph","Properties":{"id":"20250130164107-m0uq41w","updated":"20250130164111"},"Children":[{"Type":"NodeText","Data":"在实际算法中，指数阶常出现于递归函数中。例如在以下代码中，其递归地一分为二，经过 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" 次分裂后停止："}]},{"ID":"20250130164114-dqa9r8r","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250130164114-dqa9r8r","style":"line-height: 22px;","updated":"20250130164126"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"/* 指数阶（递归实现） */\nint ExpRecur(int n)\n{\n    if (n == 1) return 1;\n    return ExpRecur(n - 1) + ExpRecur(n - 1) + 1;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250130164141-9s1nt05","Type":"NodeParagraph","Properties":{"id":"20250130164141-9s1nt05","updated":"20250130164146"},"Children":[{"Type":"NodeText","Data":"指数阶增长非常迅速，在穷举法（暴力搜索、回溯等）中比较常见。\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"对于数据规模较大的问题，指数阶是不可接受的，通常需要使用动态规划或贪心算法等来解决。"}]},{"ID":"20250130163251-hkx0t0x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250130163251-hkx0t0x","updated":"20250207121820"},"Children":[{"Type":"NodeText","Data":"对数阶 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(\\log n)"},{"Type":"NodeText"}]},{"ID":"20250130164254-xiegrcr","Type":"NodeParagraph","Properties":{"id":"20250130164254-xiegrcr","updated":"20250130164343"},"Children":[{"Type":"NodeText","Data":"与指数阶相反，对数阶反映了“每轮缩减到一半”的情况。设输入数据大小为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" ，由于每轮缩减到一半，因此循环次数是 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\log_{⁡2}n"},{"Type":"NodeText","Data":" ，即 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"2^n"},{"Type":"NodeText","Data":" 的反函数。"}]},{"ID":"20250130164346-6xop663","Type":"NodeParagraph","Properties":{"id":"20250130164346-6xop663","updated":"20250130164950"},"Children":[{"Type":"NodeText","Data":"以下代码模拟了“每轮缩减到一半”的过程，时间复杂度为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(\\log_2n)"},{"Type":"NodeText","Data":" ，简记为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(\\log⁡ n)"},{"Type":"NodeText","Data":" ："}]},{"ID":"20250130164422-aj950l6","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250130164422-aj950l6","style":"line-height: 22px;","updated":"20250130164433"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"/* 对数阶（循环实现） */\nint Logarithmic(int n)\n{\n    int count = 0;\n    while (n \u003e 1)\n    {\n        n /= 2;\n        count++;\n    }\n    return count;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250130164451-lxcpu8k","Type":"NodeParagraph","Properties":{"id":"20250130164451-lxcpu8k","updated":"20250130164451"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 463px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250130164451-ugx5kwf.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 463px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20250130164508-3e2npbm","Type":"NodeParagraph","Properties":{"id":"20250130164508-3e2npbm","updated":"20250130164527"},"Children":[{"Type":"NodeText","Data":"与指数阶类似，对数阶也常出现于递归函数中。以下代码形成了一棵高度为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\log_2⁡n"},{"Type":"NodeText","Data":" 的递归树："}]},{"ID":"20250130164529-ix6ipdj","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250130164529-ix6ipdj","style":"line-height: 22px;","updated":"20250130164538"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"/* 对数阶（递归实现） */\nint LogRecur(int n)\n{\n    if (n \u003c= 1) return 0;\n    return LogRecur(n / 2) + 1;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250130164705-51kxcv2","Type":"NodeParagraph","Properties":{"id":"20250130164705-51kxcv2","updated":"20250130164706"},"Children":[{"Type":"NodeText","Data":"对数阶常出现于基于分治策略的算法中，体现了“一分为多”和“化繁为简”的算法思想。它增长缓慢，是仅次于常数阶的理想的时间复杂度。"}]},{"ID":"20250130164937-otnk8g4","Type":"NodeBlockquote","Properties":{"id":"20250130164937-otnk8g4","updated":"20250130165130"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250130164941-12ouke1","Type":"NodeParagraph","Properties":{"id":"20250130164941-12ouke1","updated":"20250130164956"},"Children":[{"Type":"NodeTextMark","TextMarkType":"inline-math strong","TextMarkInlineMathContent":"O(\\log⁡ n)"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"的底数是多少？"}]},{"ID":"20250130165002-z3otqk0","Type":"NodeParagraph","Properties":{"id":"20250130165002-z3otqk0","updated":"20250130165017"},"Children":[{"Type":"NodeText","Data":"准确来说，“一分为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"m"},{"Type":"NodeText","Data":"”对应的时间复杂度是 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(\\log_m⁡n)"},{"Type":"NodeText","Data":" 。而通过对数换底公式，我们可以得到具有不同底数、相等的时间复杂度："}]},{"ID":"20250130165002-jtn3eze","Type":"NodeMathBlock","Properties":{"id":"20250130165002-jtn3eze","updated":"20250130165117"},"Children":[{"Type":"NodeMathBlockOpenMarker"},{"Type":"NodeMathBlockContent","Data":"O(\\log_mn)=O(\\log_kn/\\log_km)=O(log_kn)"},{"Type":"NodeMathBlockCloseMarker"}]},{"ID":"20250130165002-9vrsxf4","Type":"NodeParagraph","Properties":{"id":"20250130165002-9vrsxf4","updated":"20250130165130"},"Children":[{"Type":"NodeText","Data":"也就是说，底数 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"m"},{"Type":"NodeText","Data":" 可以在不影响复杂度的前提下转换。因此我们通常会省略底数 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"m"},{"Type":"NodeText","Data":" ，将对数阶直接记为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(\\log⁡ n)"},{"Type":"NodeText","Data":"。"}]}]},{"ID":"20250130163255-6b52hdw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250130163255-6b52hdw","updated":"20250207121836"},"Children":[{"Type":"NodeText","Data":"线性对数阶 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(n \\log n)"},{"Type":"NodeText"}]},{"ID":"20250130165136-1cf6fhi","Type":"NodeParagraph","Properties":{"id":"20250130165136-1cf6fhi","updated":"20250130165149"},"Children":[{"Type":"NodeText","Data":"线性对数阶常出现于嵌套循环中，两层循环的时间复杂度分别为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(\\log⁡n)"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(n)"},{"Type":"NodeText","Data":" 。相关代码如下："}]},{"ID":"20250130165151-fsdv6dc","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250130165151-fsdv6dc","style":"line-height: 22px;","updated":"20250130165254"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"int LinearLogRecur(int n)\n{\n    if (n \u003c= 1) return 1;\n    int count = LinearLogRecur(n / 2) + LinearLogRecur(n / 2);\n    for (int i = 0; i \u003c n; i++)\n    {\n        count++;\n    }\n    return count;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250130165352-51qxcx3","Type":"NodeParagraph","Properties":{"id":"20250130165352-51qxcx3","updated":"20250130165417"},"Children":[{"Type":"NodeText","Data":"下图展示了线性对数阶的生成方式。二叉树的每一层的操作总数都为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" ，树共有 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\log_2⁡n+1"},{"Type":"NodeText","Data":" 层，因此时间复杂度为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(n\\log⁡n)"},{"Type":"NodeText","Data":"。"}]},{"ID":"20250130165423-3vs5gq8","Type":"NodeParagraph","Properties":{"id":"20250130165423-3vs5gq8","updated":"20250130165423"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 704px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250130165423-hs77boq.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 704px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20250130165432-g2x9332","Type":"NodeParagraph","Properties":{"id":"20250130165432-g2x9332","updated":"20250130165444"},"Children":[{"Type":"NodeText","Data":"主流排序算法的时间复杂度通常为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(n\\log⁡n)"},{"Type":"NodeText","Data":" ，例如快速排序、归并排序、堆排序等。"}]},{"ID":"20250130163259-ac2ehis","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250130163259-ac2ehis","updated":"20250207121903"},"Children":[{"Type":"NodeText","Data":"阶乘阶 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(n!)"},{"Type":"NodeText"}]},{"ID":"20250130165613-ke4c5bv","Type":"NodeParagraph","Properties":{"id":"20250130165613-ke4c5bv","updated":"20250130165615"},"Children":[{"Type":"NodeText","Data":"阶乘阶对应数学上的“全排列”问题。给定 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" 个互不重复的元素，求其所有可能的排列方案，方案数量为："}]},{"ID":"20250130165616-08noqmi","Type":"NodeMathBlock","Properties":{"id":"20250130165616-08noqmi","updated":"20250207121903"},"Children":[{"Type":"NodeMathBlockOpenMarker"},{"Type":"NodeMathBlockContent","Data":"n! = n \\times (n-1) \\times (n-2) \\times ... \\times 2 \\times 1"},{"Type":"NodeMathBlockCloseMarker"}]},{"ID":"20250130165715-2817jhf","Type":"NodeParagraph","Properties":{"id":"20250130165715-2817jhf","updated":"20250130165733"},"Children":[{"Type":"NodeText","Data":"阶乘通常使用递归实现。如下图和以下代码所示，第一层分裂出 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" 个，第二层分裂出 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n−1"},{"Type":"NodeText","Data":" 个，以此类推，直至第 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" 层时停止分裂："}]},{"ID":"20250130165736-ex3s5nf","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250130165736-ex3s5nf","style":"line-height: 22px;","updated":"20250130165757"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"/* 阶乘阶（递归实现） */\nint FactorialRecur(int n)\n{\n    if (n == 0) return 1;\n    int count = 0;\n    // 从 1 个分裂出 n 个\n    for (int i = 0; i \u003c n; i++)\n    {\n        count += FactorialRecur(n - 1);\n    }\n    return count;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250130165804-jun1hxx","Type":"NodeParagraph","Properties":{"id":"20250130165804-jun1hxx","updated":"20250130165804"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 570px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250130165804-o7t5hx0.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 570px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20250130165817-gbr4mif","Type":"NodeParagraph","Properties":{"id":"20250130165817-gbr4mif","updated":"20250130165835"},"Children":[{"Type":"NodeText","Data":"请注意，因为当 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n≥4"},{"Type":"NodeText","Data":" 时恒有 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n!\u003e2^n"},{"Type":"NodeText","Data":" ，所以阶乘阶比指数阶增长得更快，在 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" 较大时也是不可接受的。"}]},{"ID":"20250130165838-qvnowbw","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20250130165838-qvnowbw","updated":"20250130170443"},"Children":[{"Type":"NodeText","Data":"最差、最佳、平均时间复杂度"}]},{"ID":"20250130165855-667hy02","Type":"NodeParagraph","Properties":{"id":"20250130165855-667hy02","updated":"20250130165916"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"算法的时间效率往往不是固定的，而是与输入数据的分布有关"},{"Type":"NodeText","Data":"。\n假设输入一个长度为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" 的数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"​ ，其中 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"​ 由从 1 至 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n"},{"Type":"NodeText","Data":" 的数字组成，每个数字只出现一次；\n但元素顺序是随机打乱的，任务目标是返回元素 1 的索引。我们可以得出以下结论。"}]},{"ID":"20250130165937-dxxac09","Type":"NodeList","ListData":{},"Properties":{"id":"20250130165937-dxxac09","updated":"20250130165937"},"Children":[{"ID":"20250130165937-wwosynw","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250130165937-wwosynw","updated":"20250130165937"},"Children":[{"ID":"20250130165937-tsim4kd","Type":"NodeParagraph","Properties":{"id":"20250130165937-tsim4kd","updated":"20250130165943"},"Children":[{"Type":"NodeText","Data":"当 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums = [?, ?, ..., 1]"},{"Type":"NodeText","Data":"​ ，即当末尾元素是 1 时，需要完整遍历数组，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"达到最差时间复杂度"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong inline-math","TextMarkInlineMathContent":"O(n)"},{"Type":"NodeText","Data":" 。"}]}]},{"ID":"20250130165937-svf8g24","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250130165937-svf8g24","updated":"20250130165937"},"Children":[{"ID":"20250130165937-v8ua6po","Type":"NodeParagraph","Properties":{"id":"20250130165937-v8ua6po","updated":"20250130170101"},"Children":[{"Type":"NodeText","Data":"当 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums = [1, ?, ?, ...]"},{"Type":"NodeText","Data":"​ ，即当首个元素为 1 时，无论数组多长都不需要继续遍历，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"达到最佳时间复杂度"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong inline-math","TextMarkInlineMathContent":"\\Omega(1)"},{"Type":"NodeText","Data":" 。"}]}]}]},{"ID":"20250130170105-z2nepkz","Type":"NodeParagraph","Properties":{"id":"20250130170105-z2nepkz","updated":"20250130170117"},"Children":[{"Type":"NodeText","Data":"“最差时间复杂度”对应函数渐近上界，使用大 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O"},{"Type":"NodeText","Data":" 记号表示。相应地，“最佳时间复杂度”对应函数渐近下界，用 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\Omega"},{"Type":"NodeText","Data":" 记号表示："}]},{"ID":"20250130165929-o66q75z","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250130165929-o66q75z","style":"line-height: 22px;","updated":"20250130170141"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"/* 生成一个数组，元素为 { 1, 2, ..., n }，顺序被打乱 */\nint[] RandomNumbers(int n)\n{\n    int[] nums = new int[n];\n    // 生成数组 nums = { 1, 2, 3, ..., n }\n    for (int i = 0; i \u003c n; i++)\n    {\n        nums[i] = i + 1;\n    }\n\n    // 随机打乱数组元素\n    for (int i = 0; i \u003c nums.Length; i++)\n    {\n        int index = new Random().Next(i, nums.Length);\n        (nums[i], nums[index]) = (nums[index], nums[i]);\n    }\n    return nums;\n}\n\n/* 查找数组 nums 中数字 1 所在索引 */\nint FindOne(int[] nums)\n{\n    for (int i = 0; i \u003c nums.Length; i++)\n    {\n        // 当元素 1 在数组头部时，达到最佳时间复杂度 O(1)\n        // 当元素 1 在数组尾部时，达到最差时间复杂度 O(n)\n        if (nums[i] == 1)\n            return i;\n    }\n    return -1;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250130170222-qmx7p1x","Type":"NodeParagraph","Properties":{"id":"20250130170222-qmx7p1x","updated":"20250130170231"},"Children":[{"Type":"NodeText","Data":"值得说明的是，我们在实际中很少使用最佳时间复杂度，因为通常只有在很小概率下才能达到，可能会带来一定的误导性。\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"而最差时间复杂度更为实用，因为它给出了一个效率安全值"},{"Type":"NodeText","Data":"，让我们可以放心地使用算法。"}]},{"ID":"20250130170237-wr7ax60","Type":"NodeParagraph","Properties":{"id":"20250130170237-wr7ax60","updated":"20250130170255"},"Children":[{"Type":"NodeText","Data":"从上述示例可以看出，最差时间复杂度和最佳时间复杂度只出现于“特殊的数据分布”，\n这些情况的出现概率可能很小，并不能真实地反映算法运行效率。\n相比之下，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"平均时间复杂度可以体现算法在随机输入数据下的运行效率"},{"Type":"NodeText","Data":"，用 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\Theta"},{"Type":"NodeText","Data":" 记号来表示。"}]},{"ID":"20250130170402-qcidlvu","Type":"NodeBlockquote","Properties":{"id":"20250130170402-qcidlvu","updated":"20250130170443"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250130170410-lal2m94","Type":"NodeParagraph","Properties":{"id":"20250130170410-lal2m94","updated":"20250130170443"},"Children":[{"Type":"NodeText","Data":"可能由于 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O"},{"Type":"NodeText","Data":" 符号过于朗朗上口，因此我们常常使用它来表示平均时间复杂度。\n但从严格意义上讲，这种做法并不规范。在本书和其他资料中，若遇到类似“平均时间复杂度 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"O(n)"},{"Type":"NodeText","Data":"”的表述，请将其直接理解为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\Theta(n)"},{"Type":"NodeText","Data":" 。"}]}]},{"ID":"20250130170300-idj7vt5","Type":"NodeParagraph","Properties":{"id":"20250130170300-idj7vt5","updated":"20250130170328"},"Children":[{"Type":"NodeText","Data":"对于部分算法，我们可以简单地推算出随机数据分布下的平均情况。\n比如上述示例，由于输入数组是被打乱的，因此元素 1 出现在任意索引的概率都是相等的，\n那么算法的平均循环次数就是数组长度的一半 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"n/2"},{"Type":"NodeText","Data":" ，平均时间复杂度为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\Theta (n/2) = \\Theta (n)"},{"Type":"NodeText","Data":" 。"}]},{"ID":"20250130170337-4gekiyi","Type":"NodeParagraph","Properties":{"id":"20250130170337-4gekiyi","updated":"20250130170344"},"Children":[{"Type":"NodeText","Data":"但对于较为复杂的算法，计算平均时间复杂度往往比较困难，因为很难分析出在数据分布下的整体数学期望。\n在这种情况下，我们通常使用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最差时间复杂度作为算法效率的评判标准。"}]},{"ID":"20250130170345-d6855o6","Type":"NodeParagraph","Properties":{"id":"20250130170345-d6855o6","updated":"20250130170359"}}]}