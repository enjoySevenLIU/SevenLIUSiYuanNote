224-t2aoqxz","Type":"NodeParagraph","Properties":{"id":"20250915195224-t2aoqxz","updated":"20250915195224"},"Children":[{"Type":"NodeText","Data":"开发调试时：通常关闭垂直同步观察真实的 GPU 性能瓶颈"}]}]},{"ID":"20250915195225-h40zskw","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250915195225-h40zskw","updated":"20250915195225"},"Children":[{"ID":"20250915195225-z3g083h","Type":"NodeParagraph","Properties":{"id":"20250915195225-z3g083h","updated":"20250915195225"},"Children":[{"Type":"NodeText","Data":"低端机运行卡顿时：关闭垂直同步可减少帧率锁死卡顿"}]}]},{"ID":"20250915195228-epki5tv","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250915195228-epki5tv","updated":"20250915202509"},"Children":[{"ID":"20250915195228-dfd9kdu","Type":"NodeParagraph","Properties":{"id":"20250915195228-dfd9kdu","updated":"20250915195228"},"Children":[{"Type":"NodeText","Data":"正式发包时："}]},{"ID":"20250915195230-6tt7j22","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250915195230-6tt7j22","updated":"20250915202509"},"Children":[{"ID":"20250915195233-w9qkiad","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250915195233-w9qkiad","updated":"20250915202509"},"Children":[{"ID":"20250915195233-fivdboc","Type":"NodeParagraph","Properties":{"id":"20250915195233-fivdboc","updated":"20250915202509"},"Children":[{"Type":"NodeText","Data":"帧率较高的项目可以开启垂直同步防止画面撕裂（比如主机、VR 的高帧率项目）"}]}]},{"ID":"20250915195233-y4c651o","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250915195233-y4c651o","updated":"20250915195233"},"Children":[{"ID":"20250915195233-xzp3q5z","Type":"NodeParagraph","Properties":{"id":"20250915195233-xzp3q5z","updated":"20250915195233"},"Children":[{"Type":"NodeText","Data":"帧率较低的项目可以关闭垂直同步避免帧率降档"}]}]},{"ID":"20250915195233-bnqi8yf","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250915195233-bnqi8yf","updated":"20250915195233"},"Children":[{"ID":"20250915195233-evurnvo","Type":"NodeParagraph","Properties":{"id":"20250915195233-evurnvo","updated":"20250915195233"},"Children":[{"Type":"NodeText","Data":"或者直接交给玩家在设置中进行设置"}]}]}]}]}]},{"ID":"20250915195216-trmz74j","Type":"NodeParagraph","Properties":{"id":"20250915195216-trmz74j","updated":"20250915195216"},"Children":[{"Type":"NodeText","Data":"在使用垂直同步时应注意："}]},{"ID":"20250915195241-e6hgkic","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250915195241-e6hgkic","updated":"20250915202626"},"Children":[{"ID":"20250915195247-s3ss76m","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250915195247-s3ss76m","updated":"20250915202626"},"Children":[{"ID":"20250915195247-2blmagc","Type":"NodeParagraph","Properties":{"id":"20250915195247-2blmagc","updated":"20250915195247"},"Children":[{"Type":"NodeText","Data":"确保帧率 \u003e= 显示器刷新率"}]},{"ID":"20250915195248-0txpn8t","Type":"NodeParagraph","Properties":{"id":"20250915195248-0txpn8t","updated":"20250915202626"},"Children":[{"Type":"NodeText","Data":"如果帧率低于刷新率，系统会“降档”（如从 60FPS 降为 30FPS），导致明显卡顿\n建议确保游戏至少稳定在刷新率（如 60 Hz）之上"}]}]},{"ID":"20250915195247-kj8r4cq","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250915195247-kj8r4cq","updated":"20250915195247"},"Children":[{"ID":"20250915195247-ns4owef","Type":"NodeParagraph","Properties":{"id":"20250915195247-ns4owef","updated":"20250915195247"},"Children":[{"Type":"NodeText","Data":"避免频繁掉帧或波动"}]},{"ID":"20250915195251-aoz90kz","Type":"NodeParagraph","Properties":{"id":"20250915195251-aoz90kz","updated":"20250915195300"},"Children":[{"Type":"NodeText","Data":"帧率波动容易触发降档，产生体验断崖式下降\n使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Application.targetFrameRate"},{"Type":"NodeText","Data":"​ 或其他方式稳定帧率"}]},{"ID":"20250915195301-se0xdko","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250915195301-se0xdko","updated":"20250915195305"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"Application.targetFrameRate = 60;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]},{"ID":"20250915195247-1fmoklq","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250915195247-1fmoklq","updated":"20250915195247"},"Children":[{"ID":"20250915195247-vtd3pm7","Type":"NodeParagraph","Properties":{"id":"20250915195247-vtd3pm7","updated":"20250915195247"},"Children":[{"Type":"NodeText","Data":"测试不同设备刷新率"}]},{"ID":"20250915195310-rh0am4v","Type":"NodeParagraph","Properties":{"id":"20250915195310-rh0am4v","updated":"20250915195320"},"Children":[{"Type":"NodeText","Data":"玩家显示器可能是 60Hz、75Hz、120Hz、144Hz、165Hz\n如果你写死了某些逻辑基于固定帧率（比如 60 FPS），在高刷新率设备上可能出错\n应尽量 基于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Time.deltaTime"},{"Type":"NodeText","Data":"​ 实现帧无关逻辑"}]}]},{"ID":"20250915195247-jre1tl1","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250915195247-jre1tl1","updated":"20250915195247"},"Children":[{"ID":"20250915195247-h3yjhwx","Type":"NodeParagraph","Properties":{"id":"20250915195247-h3yjhwx","updated":"20250915195247"},"Children":[{"Type":"NodeText","Data":"注意输入延迟"}]},{"ID":"20250915195329-kk2zepq","Type":"NodeParagraph","Properties":{"id":"20250915195329-kk2zepq","updated":"20250915195331"},"Children":[{"Type":"NodeText","Data":"VSync 会导致 GPU 等待显示器信号再提交帧，会增加输入延迟（尤其是在低帧率时）\n射击、格斗等对响应要求高的游戏需谨慎使用"}]}]},{"ID":"20250915195247-ukcqwnu","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20250915195247-ukcqwnu","updated":"20250915195341"},"Children":[{"ID":"20250915195247-phqywpw","Type":"NodeParagraph","Properties":{"id":"20250915195247-phqywpw","updated":"20250915195247"},"Children":[{"Type":"NodeText","Data":"与平台特性/设置协调"}]},{"ID":"20250915195335-ukhv63s","Type":"NodeParagraph","Properties":{"id":"20250915195335-ukhv63s","updated":"20250915195341"},"Children":[{"Type":"NodeText","Data":"有些平台默认强制开启 VSync（如某些安卓设备)\n有些平台（如 PC）允许玩家手动控制显卡驱动中的 VSync 设置\n开发时应 暴露 VSync 控制项（设置菜单），让玩家按需开启 / 关闭"}]}]}]},{"ID":"20250915195238-vcwaha3","Type":"NodeParagraph","Properties":{"id":"20250915195238-vcwaha3","updated":"20250915195238"},"Children":[{"Type":"NodeText","Data":"等等"}]}]}