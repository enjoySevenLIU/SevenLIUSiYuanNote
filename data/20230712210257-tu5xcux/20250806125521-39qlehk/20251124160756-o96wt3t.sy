stItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251126103141-etuyb88","updated":"20251126103155"},"Children":[{"ID":"20251126103141-aiw7d3m","Type":"NodeParagraph","Properties":{"id":"20251126103141-aiw7d3m","updated":"20251126103155"},"Children":[{"Type":"NodeText","Data":"少量参数的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Format"},{"Type":"NodeText","Data":"​ 拼接"}]}]}]},{"ID":"20251124161318-7hcar7g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251124161318-7hcar7g","updated":"20251126103712"},"Children":[{"Type":"NodeText","Data":"避免装箱拆箱"}]},{"ID":"20251124161326-buzlcba","Type":"NodeParagraph","Properties":{"id":"20251124161326-buzlcba","updated":"20251124161342"},"Children":[{"Type":"NodeText","Data":"C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 中一切皆对象，万物之父都是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"System.Object"},{"Type":"NodeText","Data":"​"}]},{"ID":"20251124161343-athalyx","Type":"NodeParagraph","Properties":{"id":"20251124161343-athalyx","updated":"20251124161343"},"Children":[{"Type":"NodeText","Data":"装箱："}]},{"ID":"20251124161344-7jenaj3","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251124161344-7jenaj3","updated":"20251124161351"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"int x = 10;\nobject obj = x;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251124161355-07c3vyp","Type":"NodeParagraph","Properties":{"id":"20251124161355-07c3vyp","updated":"20251124161444"},"Children":[{"Type":"NodeText","Data":"把一个值类型（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"int"},{"Type":"NodeText","Data":"​、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"float"},{"Type":"NodeText","Data":"​、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"struct"},{"Type":"NodeText","Data":"​）放进一个 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"object"},{"Type":"NodeText","Data":"​ 变量\n值类型在栈上，引用类型（包括 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"object"},{"Type":"NodeText","Data":"​）在堆上\n所以当值类型要被当成 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"object"},{"Type":"NodeText","Data":"​ 使用时，就需要创建一个新的堆对象，把值类型的值拷贝进去\n就好像，做一个盒子，把值类型放进去的感觉，所以称为装箱"}]},{"ID":"20251124161438-zp2w3if","Type":"NodeParagraph","Properties":{"id":"20251124161438-zp2w3if","updated":"20251124161438"},"Children":[{"Type":"NodeText","Data":"主要成本：\n此时 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"obj"},{"Type":"NodeText","Data":"​ 指向堆，10 被赋值到堆中，原本的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"x"},{"Type":"NodeText","Data":"​ 仍在栈中\n整个过程创建了一个新的堆对象（需要 GC 管理），成本很高，会给 GC 带来压力"}]},{"ID":"20251124161447-pfgpds7","Type":"NodeParagraph","Properties":{"id":"20251124161447-pfgpds7","updated":"20251124161450"},"Children":[{"Type":"NodeText","Data":"拆箱："}]},{"ID":"20251124161451-zouznt2","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251124161451-zouznt2","updated":"20251124161519"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"int x = 10;\nobject obj = x;\nint y = (int)obj;\t// 拆箱\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251124161502-qk653ew","Type":"NodeParagraph","Properties":{"id":"20251124161502-qk653ew","updated":"20251124161541"},"Children":[{"Type":"NodeText","Data":"从 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"object"},{"Type":"NodeText","Data":"​ 再提取出值类型，拆箱不是取值，而是先检查类型，再从堆对象里拷贝出内部值"}]},{"ID":"20251124161543-cggpq2b","Type":"NodeParagraph","Properties":{"id":"20251124161543-cggpq2b","updated":"20251124161543"},"Children":[{"Type":"NodeText","Data":"主要成本：类型检查和值拷贝回栈，成本消耗中等"}]},{"ID":"20251124161544-vtgud1n","Type":"NodeParagraph","Properties":{"id":"20251124161544-vtgud1n","updated":"20251124161549"},"Children":[{"Type":"NodeText","Data":"如何避免装箱拆箱："}]},{"ID":"20251124161553-wun8nsw","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251124161553-wun8nsw","updated":"20251126103712"},"Children":[{"ID":"20251124161557-5cv3fve","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251124161557-5cv3fve","updated":"20251126103623"},"Children":[{"ID":"20251124161557-i06sbi3","Type":"NodeParagraph","Properties":{"id":"20251124161557-i06sbi3","updated":"20251126103623"},"Children":[{"Type":"NodeText","Data":"使用泛型"}]}]},{"ID":"20251124161557-aa7mlis","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251124161557-aa7mlis","updated":"20251126103712"},"Children":[{"ID":"20251124161557-ptykdtd","Type":"NodeParagraph","Properties":{"id":"20251124161557-ptykdtd","updated":"20251124161648"},"Children":[{"Type":"NodeText","Data":"正确使用内置 API"}]},{"ID":"20251124161558-b1836b2","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251124161558-b1836b2","updated":"20251126103712"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"Debug.Log(\"Frame \" + Time.frameCount); \t\t\t// 无装箱\nDebug.LogFormat(\"Frame {0}\", Time.frameCount); \t// 装箱，因为 LogFormat 的变长参数类型为 object[]\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]}]},{"ID":"20251124161617-u77mo8x","Type":"NodeParagraph","Properties":{"id":"20251124161617-u77mo8x","updated":"20251124161621"},"Children":[{"Type":"NodeText","Data":"等等"}]},{"ID":"20251124161614-5j6wr5p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251124161614-5j6wr5