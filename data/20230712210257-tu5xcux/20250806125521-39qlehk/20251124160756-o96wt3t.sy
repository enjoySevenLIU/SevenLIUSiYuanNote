8d2c8","updated":"20251124164844"},"Children":[{"Type":"NodeText","Data":"只在玩家不在意卡顿的时候调用（切场景/读条/暂停）\n在启用增量 GC 时，手动 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Collect"},{"Type":"NodeText","Data":"​ 也会按照增量模式慢慢做完，仍要注意时机"}]}]},{"ID":"20251124164716-6hg9oxg","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251124164716-6hg9oxg","updated":"20251124164900"},"Children":[{"ID":"20251124164716-o4ztm8q","Type":"NodeParagraph","Properties":{"id":"20251124164716-o4ztm8q","updated":"20251124164716"},"Children":[{"Type":"NodeText","Data":"避免与内存优化互相打架"}]},{"ID":"20251124164847-y8edid3","Type":"NodeParagraph","Properties":{"id":"20251124164847-y8edid3","updated":"20251124164900"},"Children":[{"Type":"NodeText","Data":"比如在频繁加载、卸载资源时，不要频繁手动 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"GC.Collect"},{"Type":"NodeText","Data":"​，否则 CPU 会被榨干。\n正确做法是：一段集中释放资源后，在安全节点触发一次 GC，而不是每次小释放都 GC"}]}]}]},{"ID":"20251124164931-az02ooj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251124164931-az02ooj","updated":"20251126111916"},"Children":[{"Type":"NodeText","Data":"诊断与工具"}]},{"ID":"20251124164937-lqumskt","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251124164937-lqumskt","updated":"20251126111916"},"Children":[{"ID":"20251124164943-y6zfqk9","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251124164943-y6zfqk9","updated":"20251124164943"},"Children":[{"ID":"20251124164943-1f9ckzl","Type":"NodeParagraph","Properties":{"id":"20251124164943-1f9ckzl","updated":"20251124164943"},"Children":[{"Type":"NodeText","Data":"所有理论上的内存优化最后都应该回到数据上验证："}]},{"ID":"20251124164944-1gbqeml","Type":"NodeList","ListData":{},"Properties":{"id":"20251124164944-1gbqeml","updated":"20251124164946"},"Children":[{"ID":"20251124164946-b6esndj","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"202511241