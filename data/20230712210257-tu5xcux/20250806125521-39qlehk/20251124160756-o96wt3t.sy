24162918"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"foreach (var x in 某个Unity自己暴露的集合)"},{"Type":"NodeText","Data":"​"}]}]}]},{"ID":"20251124162902-x9opesu","Type":"NodeParagraph","Properties":{"id":"20251124162902-x9opesu","updated":"20251124162902"},"Children":[{"Type":"NodeText","Data":"这些最好在 Profiler 里看一眼 GC Alloc，如果有，就换成 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"for"},{"Type":"NodeText","Data":"​ 或改迭代器实现"}]}]}]},{"ID":"20251124162746-7va915u","Type":"NodeParagraph","Properties":{"id":"20251124162746-7va915u","updated":"20251124162936"},"Children":[{"Type":"NodeText","Data":"总之：别再用一律不用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"foreach"},{"Type":"NodeText","Data":"​ 这种老规矩，现在版本的 C#、Unity 都已经优化了很多，用 Profiler 判断哪里有 GC，再精确优化哪里"}]},{"ID":"20251124162934-sy1n9jd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251124162934-sy1n9jd","updated":"20251124163125"},"Children":[{"Type":"NodeText","Data":"协程的合理使用"}]},{"ID":"20251124162958-zi09dob","Type":"NodeParagraph","Properties":{"id":"20251124162958-zi09dob","updated":"20251124163007"},"Children":[{"Type":"NodeText","Data":"启动一个协程会消耗少量内存，如果内存消耗和 GC 是严重问题\n可以尝试避免产生太多短时间的协程，避免在运行时大量调用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"StartCoroutine"},{"Type":"NodeText","Data":"​\n因为一个协同程序，在底层本质上是一个状态机对象"}]},{"ID":"20251124163008-pp6j5m0","Type":"NodeParagraph","Properties":{"id":"20251124163008-pp6j5m0","updated":"20251124163011"},"Children":[{"Type":"NodeText","Data":"举例："}]},{"ID":"20251124163012-fexo4nu","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251124163012-fexo4nu","updated":"20251124163018"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"IEnumerator MyCoroutine()\n{\n    yield return new WaitForSeconds(1f);\n    Debug.Log(\"Done\");\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251124163019-k06ojrq","Type":"NodeParagraph","Properties":{"id":"20251124163019-k06ojrq","updated":"20251124163027"},"Children":[{"Type":"NodeText","Data":"编译器实际上会把它翻译成一个隐藏的类，类似："}]},{"ID":"20251124163028-ocrugdx","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251124163028-ocrugdx","updated":"20251124163036"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"class MyCoroutine_d__0 : IEnumerator\n{\n  int _state;\n  object _current;\n  MonoBehaviour _this; // 捕获外部 this\n\n  public bool MoveNext()\n  {\n      switch (_state)\n      {\n          case 0:\n              _state = 1;\n              _current = new WaitForSeconds(1f);\n              return true;\n          case 1:\n              _state = -1;\n              Debug.Log(\"Done\");\n              return false;\n      }\n      return false;\n  }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251124163044-jphd2mx","Type":"NodeParagraph","Properties":{"id":"20251124163044-jphd2mx","updated":"20251124163120"},"Children":[{"Type":"NodeText","Data":"当我们调用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"StartCoroutine"},{"Type":"NodeText","Data":"​ 时，实际上是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"new"},{"Type":"NodeText","Data":"​ 了一个堆对象，然后交给 Unity 的协程调度器去管理\n而且当我们在协程中使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"yield"},{"Type":"NodeText","Data":"​ 时，经常也会使用一些 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"new"},{"Type":"NodeText","Data":"​ 对象的操作，比如："}]},{"ID":"20251124163116-24fea0b","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251124163116-24fea0b","updated":"20251124163117"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type"