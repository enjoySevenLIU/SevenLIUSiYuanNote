:"20251124165041-fnxgrvr","updated":"20251124165041"},"Children":[{"Type":"NodeText","Data":"自定义物理、布料实现、软体、绳子物理表现等"}]}]},{"ID":"20251124165038-f53wbcl","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251124165038-f53wbcl","updated":"20251124165047"},"Children":[{"ID":"20251124165038-mtlqw1s","Type":"NodeParagraph","Properties":{"id":"20251124165038-mtlqw1s","updated":"20251124165043"},"Children":[{"Type":"NodeText","Data":"CPU 是性能瓶颈时"}]},{"ID":"20251124165042-e2vv71a","Type":"NodeParagraph","Properties":{"id":"20251124165042-e2vv71a","updated":"20251124165047"},"Children":[{"Type":"NodeText","Data":"比如主线程压力非常大、GC 非常频繁，但是 GPU 还非常轻松的情况下"}]}]}]}]}