"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250918203837-5hofe2a","updated":"20250918204019"},"Children":[{"ID":"20250918203837-cxpvze4","Type":"NodeParagraph","Properties":{"id":"20250918203837-cxpvze4","updated":"20250918204019"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250918203952-qf8vrst","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"DrawCall"}]}]},{"ID":"20250918203857-b6v7w0k","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250918203857-b6v7w0k","updated":"20250918204641"},"Children":[{"ID":"20250918203857-dzqke9y","Type":"NodeParagraph","Properties":{"id":"20250918203857-dzqke9y","updated":"20250922163000"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250918204641-kw8mbv0","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"动态批处理"},{"Type":"NodeText","Data":"（在运行时每帧将多个相同材质的动态小对象进行合批，减少 DrawCall，局限性较大）"}]}]},{"ID":"20250918203900-h2ivo79","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250918203900-h2ivo79","updated":"20250919105439"},"Children":[{"ID":"20250918203900-2zemr9h","Type":"NodeParagraph","Properties":{"id":"20250918203900-2zemr9h","updated":"20250922162945"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250919105439-w4iknm1","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"静态批处理"},{"Type":"NodeText","Data":"（在构建时将多个相同材质的静态对象网格合并为大网格，再一次性提交 GPU，用内存换性能，减少 DrawCall）"}]}]},{"ID":"20250918203904-mgkeh01","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250918203904-mgkeh01","updated":"20250919145831"},"Children":[{"ID":"20250918203904-f5lxnoa","Type":"NodeParagraph","Properties":{"id":"20250918203904-f5lxnoa","updated":"20250922162416"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250919145831-3ema0jv","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"GPU Instancing"},{"Type":"NodeText","Data":"（让 CPU 通过一次 DrawCall 传递所有相同网格和材质对象的实例数据，让 GPU 根据实例数据绘制，在绘制大量重复对象时显著降低 DrawCall）"}]}]},{"ID":"20250918203910-ocrlbqz","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250918203910-ocrlbqz","updated":"20250919154953"},"Children":[{"ID":"20250918203910-ng9u67v","Type":"NodeParagraph","Properties":{"id":"20250918203910-ng9u67v","updated":"20250922162908"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250919154952-4bba43p","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"SRP Batcher"},{"Type":"NodeText","Data":"（将相同 Shader 的物体和材质数据缓存到 GPU，只在内容变化时更新数据，减少相同 Shader 但材质不同的 SetPass 的性能消耗，不减少 DrawCall）"}]}]},{"ID":"20250918203917-mzqbfgt","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250918203917-mzqbfgt","updated":"20250922114643"},"Children":[{"ID":"20250918203917-97re1sv","Type":"NodeParagraph","Properties":{"id":"20250918203917-97re1sv","updated":"20250922114643"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250922114643-xtg60c9","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"DrawCall 优化方案对比"}]}]},{"ID":"20250918203930-ie444ck","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250918203930-ie444ck","updated":"20250926120058"},"Children":[{"ID":"20250918203930-91wrsy1","Type":"NodeParagraph","Properties":{"id":"20250918203930-91wrsy1","updated":"20250926120058"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250922163105-fuf75zb","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"手动合并网格"},{"Type":"NodeText","Data":"（通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Mesh"},{"Type":"NodeText","Data":"​ API 手动合并网格，通过减少网格数量减少 DrawCall，可控性和灵活性更高）"}]}]}]},{"ID":"20250922161438-glspvln","Type":"NodeParagraph","Properties":{"id":"20250922161438-glspvln","updated":"20250922161438"}}]}