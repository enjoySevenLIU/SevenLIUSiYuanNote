deListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250828203209-luhuuhn","updated":"20250828203209"},"Children":[{"ID":"20250828203209-o62kgpy","Type":"NodeParagraph","Properties":{"id":"20250828203209-o62kgpy","updated":"20250828203209"},"Children":[{"Type":"NodeText","Data":"All Of Memory： 所有内存页签"}]},{"ID":"20250828203249-pv53925","Type":"NodeParagraph","Properties":{"id":"20250828203249-pv53925","updated":"20250828203259"},"Children":[{"Type":"NodeText","Data":"它是这个工具中最强大、最底层、最全面的页签，显示包括托管堆（Managed Heap）在内的所有内存块\n用于追查复杂内存泄漏、查找引用链闭环、深入调试"}]}]}]}]}]},{"ID":"20250828203324-6h7um91","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250828203324-6h7um91","updated":"20250829104632"},"Children":[{"Type":"NodeText","Data":"Summary（总结概要页签）"}]},{"ID":"20250828203347-n113ya2","Type":"NodeParagraph","Properties":{"id":"20250828203347-n113ya2","updated":"20250828204122"},"Children":[{"Type":"NodeText","Data":"该页签主要显示快照中的内存总体信息，该页签主要由以下四部分组成："}]},{"ID":"20250828204122-4264p7s","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250828204122-4264p7s","updated":"20250829104313"},"Children":[{"ID":"20250828204122-0g0iag1","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250828204122-0g0iag1","updated":"20250828204122"},"Children":[{"ID":"20250828204122-trbu2y6","Type":"NodeParagraph","Properties":{"id":"20250828204122-trbu2y6","updated":"20250828204122"},"Children":[{"Type":"NodeText","Data":"Memory Usage On Device（设备上的内存使用情况）"}]},{"ID":"20250829104251-0ep8c2a","Type":"NodeParagraph","Properties":{"id":"20250829104251-0ep8c2a","updated":"20250829104252"},"Children":[{"Type":"NodeText","Data":"判断应用是否接近或超出设备内存上限"}]}]},{"ID":"20250828204122-9v8ctgt","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250828204122-9v8ctgt","updated":"20250828204122"},"Children":[{"ID":"20250828204122-lmk4pow","Type":"NodeParagraph","Properties":{"id":"20250828204122-lmk4pow","updated":"20250829103836"},"Children":[{"Type":"NodeText","Data":"Allocated Memory Distribution（已分配内存分布）"}]},{"ID":"20250829104254-j9u5v4o","Type":"NodeParagraph","Properties":{"id":"20250829104254-j9u5v4o","updated":"20250829104258"},"Children":[{"Type":"NodeText","Data":"快速识别主要内存消耗源头"}]}]},{"ID":"20250828204122-lvqv5g3","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250828204122-lvqv5g3","updated":"20250828204122"},"Children":[{"ID":"20250828204122-86ni9jk","Type":"NodeParagraph","Properties":{"id":"20250828204122-86ni9jk","updated":"20250828204122"},"Children":[{"Type":"NodeText","Data":"Managed Heap Utilization（托管堆使用率）"}]},{"ID":"20250829104300-q8619gn","Type":"NodeParagraph","Properties":{"id":"20250829104300-q8619gn","updated":"20250829104306"},"Children":[{"Type":"NodeText","Data":"用于分析 C# 脚本对象的内存使用效率"}]}]},{"ID":"20250828204122-oi3ne15","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250828204122-oi3ne15","updated":"20250829104313"},"Children":[{"ID":"20250828204122-k4uje9q","Type":"NodeParagraph","Properties":{"id":"20250828204122-k4uje9q","updated":"20250828204122"},"Children":[{"Type":"NodeText","Data":"Top Unity Objects Categories（Unity对象内存占用最多的类型分类）"}]},{"ID":"20250829104309-sg91q56","Type":"NodeParagraph","Properties":{"id":"20250829104309-sg91q56","updated":"20250829104313"},"Children":[{"Type":"NodeText","Data":"针对某类型内容优化的数据依据之一"}]}]}]},{"ID":"20250828204130-63fml52","Type":"NodeParagraph","Properties":{"id":"20250828204130-63fml52","updated":"20250828204201"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250828204152-tob37e8.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250829103826-gfti4t0","Type":"NodeParagraph","Properties":{"id":"20250829103826-gfti4t0","updated":"20250829104132"},"Children":[{"Type":"NodeText","Data":"其中，Allocated Memory Distribution，Managed Heap Utilization，和 Top Unity Objects Categories 部分右上角都有 Inspect 按钮，\nInspect 按钮可以跳转到更详细的分类页面，并自动筛选出该类内存的相关对象或资源，方便你进一步深入分析\n它是定位问题的快速入口，适合先看 Summary 总览，再 drill-down（向下钻取） 到具体对象。\n它不会改变快照本身，只是切换到对应视图并加好过滤\n如果你正在查某个大类的内存异常问题（比如贴图暴涨、Mesh 堆积），使用 Inspect 可以极大提高定位效率"}]},{"ID":"20250829104316-jzl0n9a","Type":"NodeParagraph","Properties":{"id":"20250829104316-jzl0n9a","updated":"20250829104326"},"Children":[{"Type":"NodeText","Data":"着重关注以下内容："}]},{"ID":"20250829104326-v7fcefo","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250829104326-v7fcefo","updated":"20250829104336"},"Children":[{"ID":"20250829104326-wedp6fv","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250829104326-wedp6fv","updated":"20250829104329"},"Children":[{"ID":"20250829104326-qrupgbp","Type":"NodeParagraph","Properties":{"id":"20250829104326-qrupgbp","updated":"20250829104329"},"Children":[{"Type":"NodeText","Data":"托管堆内存：是否有 GC 压力，是否有内存碎片化问题"}]}]},{"ID":"20250829104326-hl25xh2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250829104326-hl25xh2","updated":"20250829104336"},"Children":[{"ID":"20250829104326-mgdpygn","Type":"NodeParagraph","Properties":{"id":"20250829104326-mgdpygn","updated":"20250829104336"},"Children":[{"Type":"NodeText","Data":"原生内存：是否存在 Unity 原生对象内存泄漏，比如 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"GameObject"},{"Type":"NodeText","Data":"​，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Component"},{"Type":"NodeText","Data":"​、资源等"}]}]},{"ID":"20250829104326-namnxrd","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250829104326-namnxrd","updated":"2025