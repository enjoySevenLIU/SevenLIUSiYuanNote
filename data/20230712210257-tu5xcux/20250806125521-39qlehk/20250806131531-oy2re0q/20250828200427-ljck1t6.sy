2bdla","Type":"NodeParagraph","Properties":{"id":"20250828204248-6m2bdla","updated":"20250828204248"},"Children":[{"Type":"NodeText","Data":"主要作用：\n展示当前快照中，Unity 在设备上实际占用了多少内存\n可以用于判断当前是否接近设备内存限制，特别是移动设备上是否存在内存溢出的风险"}]},{"ID":"20250828204334-pg2abqz","Type":"NodeParagraph","Properties":{"id":"20250828204334-pg2abqz","updated":"20250828204359"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250828204359-gguqu0q.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250828204248-zc5xizg","Type":"NodeBlockquote","Properties":{"id":"20250828204248-zc5xizg","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20250828204326"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250828204316-xhpl90o","Type":"NodeParagraph","Properties":{"id":"20250828204316-xhpl90o","updated":"20250828204326"},"Children":[{"Type":"NodeText","Data":"补充 —— 内存溢出：\n在 iOS / Android 上，系统会给每个 App 分配一段最大内存上限（比如 512MB、1GB 等，依设备不同而异）\n如果你的游戏在运行过程中内存分配超出了这个上限，那么系统会判断该 App 占用内存超标，会强行杀死进程，不给任何提示！"}]}]},{"ID":"20250828204248-f52h7sn","Type":"NodeParagraph","Properties":{"id":"20250828204248-f52h7sn","updated":"20250828204248"},"Children":[{"Type":"NodeText","Data":"一些统计数据（不准确，以真机为主）"}]},{"ID":"20250828204425-q6p66ou","Type":"NodeTable","TableAligns":[0,0],"Properties":{"colgroup":"min-width: 60px;|min-width: 60px;","id":"20250828204425-q6p66ou","updated":"20250828204637"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"设备"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"分配最大内存上限"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Android 低端机"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"~350 – 450MB"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Android 中端机"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"~500 – 600MB"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Android 高端机"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"~700MB – 1.2GB"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"iPhone 6s"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"~350MB"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"iPhone 12+"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"~1GB+"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"iPad Pro"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"~1.5GB+"}]}]}]},{"ID":"20250828204248-njqe4i8","Type":"NodeBlockquote","Properties":{"id":"20250828204248-njqe4i8","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20250828204412"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250828204412-3ahlf6s","Type":"NodeParagraph","Properties":{"id":"20250828204412-3ahlf6s","updated":"20250828204412"},"Children":[{"Type":"NodeText","Data":"注意：建议在真机上进行调试排查"}]}]},{"ID":"20250828204727-yadyb28","Type":"NodeParagraph","Properties":{"id":"20250828204727-yadyb28","updated":"20250829101544"},"Children":[{"Type":"NodeText","Data":"点击内存占用比例条，在右侧的信息面板可以看到如下内容："}]},{"ID":"20250828204907-9ydts4w","Type":"NodeSuperBlock","Properties":{"id":"20250828204907-9ydts4w","updated":"20250828205216"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20250828204759-y1vys8z","Type":"NodeParagraph","Properties":{"id":"20250828204759-y1vys8z","updated":"20250828204907"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250828204823-12g3mfm.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250828204901-hgyck2v","Type":"NodeBlockquote","Properties":{"id":"20250828204901-hgyck2v","updated":"20250828205216"},"Children":[{"ID":"20250828204916-hhw9kcg","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20250828204916-hhw9kcg","updated":"20250828204944"},"Children":[{"Type":"NodeText","Data":"设备上的内存使用情况"}]},{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250828204904-9sm3elu","Type":"NodeParagraph","Properties":{"id":"20250828204904-9sm3elu","updated":"20250828204905"},"Children":[{"Type":"NodeText","Data":"显示您已分配给系统的内存量，以及设备上当前驻留的内存量。分配的内存可以高于设备上可用的最大内存，而不会造成问题。"}]},{"ID":"20250828204942-txhz8bb","Type":"NodeHeading","HeadingLevel":6,"Properties":{"id":"20250828204942-txhz8bb","updated":"20250828204944"},"Children":[{"Type":"NodeText","Data":"已分配内存"}]},{"ID":"20250828204944-xo0b0qx","Type":"NodeParagraph","Properties":{"id":"20250828204944-xo0b0qx","updated":"20250828204944"},"Children":[{"Type":"NodeText","Data":"分配内存是指由进程分配的所有内存，该进程有操作系统提交的资源。资源可能位于物理内存中（在这种情况下，它被称为驻留）或交换到辅助存储，例如磁盘上的页面文件。如果分配的内存区域在一段时间内未被使用或未被访问，操作系统可能会决定压缩或将其移动到磁盘。这允许您的应用程序在物理内存中只保留它立即需要的东西。不利的一面是，对辅助存储的访问速度要慢得多，可能会影响您的应用程序性能。"}]},{"ID":"20250828205015-34yht59","Type":"NodeParagraph","Properties":{"id":"20250828205015-34yht59","updated":"20250828205015"},"Children":[{"Type":"NodeText","Data":"检查分配的内存使用情况，以改善应用程序的总体健康状况。"}]},{"ID":"20250828205023-7i604n7","Type":"NodeHeading","HeadingLevel":6,"Properties":{"id":"20250828205023-7i604n7","updated":"20250828205048"},"Children":[{"Type":"NodeText","Data":"设备上驻留内存总量"}]},{"ID":"20250828205025-7w0xe5o","Type":"NodeParagraph","Properties":{"id":"20250828205025-7w0xe5o","updated":"20250828205047"},"Children":[{"Type":"NodeText","Data":"当前位于设备物理内存（RAM）中的已分配内存部分。它是应用程序对目标设备要求有多高的指标。如果常驻内存使用量增加，您可能会面临页面错误、性能下降或从系统中驱逐的风险。"}]},{"ID":"20250828205047-rqzen78","Type":"NodeParagraph","Properties":{"id":"20250828205047-rqzen78","updated":"20250828205048"},"Children":[{"Type":"NodeText","Data":"检查应用程序的驻留内存使用情况，以降低内存不足的最直接风险。"}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20250828205222-0i0eayt","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20250828205222-0i0eayt","updated":"20250829113038"},"Children":[{"Type":"NodeText","Data":"Allocated Memory Distribution（已分配内存分布）"}]},{"ID":"20250828205259-pj4ljzb","Type":"NodeParagraph","Properties":{"id":"20250828205259-pj4ljzb","updated":"20250828205259"},"Children":[{"Type":"NodeText","Data":"主要作用：\n显示分配的内存如何在内存区域中分布\n将光标悬停在类别上，查看分配的内存中有多少当前驻留在设备上。\n可用于分析各个系统的内存占用比例，判断到底是谁“吃”内存"}]},{"ID":"20250828205534-nuofq1g","Type":"NodeParagraph","Properties":{"id":"20250828205534-nuofq1g","updated":"20250828205535"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250828205535-ts2w1h5.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250828205259-ym7t1gi","Type":"NodeParagraph","Properties":{"id":"20250828205259-ym7t1gi","updated":"20250828205310"},"Children":[{"Type":"NodeText","Data":"它由以下几个部分组成"}]},{"ID":"20250828205310-tqe9551","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250828205310-tqe9551","updated":"20250828205507"},"Children":[{"ID":"20250828205310-tg0cwtv","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250828205310-tg0cwtv","updated":"20250828205358"},"Children":[{"ID":"20250828205310-fs3kd78","Type":"NodeParagraph","Properties":{"id":"20250828205310-fs3kd78","updated":"20250828205358"},"Children":[{"Type":"NodeText","Data":"Native（原生内存）：C++ 层对象，如 GameObject、资源加载、系统插件等；如果这里过高，排查是否未及时释放对象"}]}]},{"ID":"20250828205310-7db1z6m","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250828205310-7db1z6m","updated":"20250828205408"},"Children":[{"ID":"20250828205310-sn80765","Type":"NodeParagraph","Properties":{"id":"20250828205310-sn80765","updated":"20250828205408"},"Children":[{"Type":"NodeText","Data":"Managed（托管内存）：C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 代码里的类、数组、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"List"},{"Type":"NodeText","Data":"​ 等托管对象，如果过高；排查是否存在内存泄漏、GC压力大等问题"}]}]},{"ID":"20250828205310-4pl07ff","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250828205310-4pl07ff","updated":"20250828205421"},"Children":[{"ID":"20250828205310-jz9ixqn","Type":"NodeParagraph","Properties":{"id":"20250828205310-jz9ixqn","updated":"20250828205421"},"Children":[{"Type":"NodeText","Data":"Executables \u0026 Mapped（可执行文件和映射内存）：可执行代码和库；如果过高，说明项目模块太多，建议开启代码裁剪（Stripping Level）"}]}]},{"ID":"20250828205310-lpf3sz1","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250828205310-lpf3sz1","updated":"20250828205439"},"Children":[{"ID":"20250828205310-ntc1pu4","Type":"NodeParagraph","Properties":{"id":"20250828205310-ntc1pu4","updated":"20250828205439"},"Children":[{"Type":"NodeText","Data":"Graphics (Estimated)（图形相关内存（估算）)：GPU 纹理、Mesh、Animation 等资源；如果过高，检查贴图大小/格式/是否读写等问题"}]}]},{"ID":"20250828205310-ehssfrc","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20250828205310-ehssfrc","updated":"20250828205507"},"Children":[{"ID":"20250828205310-svnpwvz","Type":"NodeParagraph","Properties":{"id":"20250828205310-svnpwvz","updated":"20250828205507"},"Children":[{"Type":"NodeText","Data":"Untracked*（未追踪的内存）：Unity 无法识别的内存，若很大；可能是图形驱动、插件、平台相关等，需用平台专用工具查看（如 Android Profiler、Xcode Instruments）"}]}]}]},{"ID":"20250828205609-bswwn84","Type":"NodeParagraph","Properties":{"id":"20250828205609-bswwn84","updated":"20250829101533"},"Children":[{"Type":"NodeText","Data":"点击内存占用比例条的不同部分，在右侧的信息面板可以看到如下内容："}]},{"ID":"20250828205615-2hagq9h","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20250828205615-2hagq9h","updated":"20250829113038"},"Children":[{"Type":"NodeText","Data":"Native（原生内存）"}]},{"ID":"20250828205924-vw30eap","Type":"NodeSuperBlock","Properties":{"id":"20250828205924-vw30eap","updated":"20250829113038"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20250828205653-0m0f0k6","Type":"NodeParagraph","Properties":{"id":"20250828205653-0m0f0k6","updated":"20250829113038"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250828205654-yxcw50d.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250828205655-b88xag9","Type":"NodeBlockquote","Properties":{"id":"20250828205655-b88xag9","updated":"20250828210123"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250828205656-no3ap4r","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20250828205656-no3ap4r","updated":"20250828210123"},"Children":[{"Type":"NodeText","Data":"原生内存"}]},{"ID":"20250828205730-plxugaa","Type":"NodeParagraph","Properties":{"id":"20250828205730-plxugaa","updated":"20250828205730"},"Children":[{"Type":"NodeText","Data":"原生内存（Native memory），被以下对象使用："}]},{"ID":"20250828205737-ndz0rir","Type":"NodeList","ListData":{},"Properties":{"id":"20250828205737-ndz0rir","updated":"20250828210123"},"Children":[{"ID":"20250828205738-qp1umjc","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250828205738-qp1umjc","updated":"20250828210123"},"Children":[{"ID":"20250828205738-k6atnv5","Type":"NodeParagraph","Properties":{"id":"20250828205738-k6atnv5","updated":"20250828210123"},"Children":[{"Type":"NodeText","Data":"场景对象（如 GameObject 和它们的组件）"}]}]},{"ID":"20250828205741-gc64tdi","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250828205741-gc64tdi","updated":"20250828205741"},"Children":[{"ID":"20250828205741-oou5lav","Type":"NodeParagraph","Properties":{"id":"20250828205741-oou5lav","updated":"20250828205741"},"Children":[{"Type":"NodeText","Data":"资源（Assets）和管理器（Managers）"}]}]},{"ID":"20250828205747-fyhbq9o","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250828205747-fyhbq9o","updated":"20250828205747"},"Children":[{"ID":"20250828205747-ikoyp84","Type":"NodeParagraph","Properties":{"id":"20250828205747-ikoyp84","updated":"20250828205747"},"Children":[{"Type":"NodeText","Data":"原生分配（Native Allocations），包括 NativeArray 和其他原生容器（Native Containers）"}]}]},{"ID":"20250828205755-hdfdtxw","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250828205755-hdfdtxw","updated":"20250828205755"},"Children":[{"ID":"20250828205755-hf1d49f","Type":"NodeParagraph","Properties":{"id":"20250828205755-hf1d49f","updated":"20250828205800"},"Children":[{"Type":"NodeText","Data":"图形资源在 CPU 端的内存占用"}]}]},{"ID":"20250828205800-1r010sc","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250828205800-1r010sc","updated":"20250828205800"},"Children":[{"ID":"20250828205800-ub1nxwo","Type":"NodeParagraph","Properties":{"id":"20250828205800-ub1nxwo","updated":"20250828205806"},"Children":[{"Type":"NodeText","Data":"以及其他类型的原生对象"}]}]}]},{"ID":"20250828205809-jya8z56","Type":"NodeParagraph","Properties":{"id":"20250828205809-jya8z56","updated":"20250828205855"},"Children":[{"Type":"NodeText","Data":"这个分类不包括 GPU 图形内存，图形内存会在单独的 \"Graphics\" 类别中显示。"}]},{"ID":"20250828205826-lssjtgk","Type":"NodeParagraph","Properties":{"id":"20250828205826-lssjtgk","updated":"20250828205826"},"Children":[{"Type":"NodeText","Data":"你可以在 All Of Memory Breakdown（全部内存明细） 中进一步查看这些分类的详细信息。"}]},{"ID":"20250828205833-hw60qfr","Type":"NodeParagraph","Properties":{"id":"20250828205833-hw60qfr","updated":"20250828205913"},"Children":[{"Type":"NodeText","Data":"注意：Summary（概览）视图和 All Of Memory（全部内存）视图中的数值可能不同，因为它们在归类方式上是不同的。不同的方式将项目分组在一起。"}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20250828205916-0c0cmyl","Type":"NodeParagraph","Properties":{"id":"20250828205916-0c0cmyl","updated":"20250828205918"},"Children":[{"Type":"NodeText","Data":"建议：如果你正在分析某个 Native 内存异常增长的情况，建议重点查看 \"All Of Memory\" 中的 “Objects and Allocations” 和 \"Memory Map\""}]},{"ID":"20250828205955-eted8x9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20250828205955-eted8x9","updated":"20250828210215"},"Children":[{"Type":"NodeText","Data":"Managed（托管内存）"}]},{"ID":"20250828210205-eyy27js","Type":"NodeSuperBlock","Properties":{"id":"20250828210205-eyy27js","updated":"20250828210206"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20250828205959-dknj95i","Type":"NodeParagraph","Properties":{"id":"20250828205959-dknj95i","updated":"20250828210206"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250828210000-i1gvkr2.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250828210014-nalqlb2","Type":"NodeBlockquote","Properties":{"id":"20250828210014-nalqlb2","updated":"20250828210205"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250828210016-ohhufv9","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20250828210016-ohhufv9","updated":"20250828210114"},"Children":[{"Type":"NodeText","Data":"托管内存"}]},{"ID":"20250828210039-rld6h0g","Type":"NodeParagraph","Properties":{"id":"20250828210039-rld6h0g","updated":"20250828210043"},"Children":[{"Type":"NodeText","Data":"包含所有虚拟机和托管堆（Managed Heap）的内存"}]},{"ID":"20250828210043-6m0uxqo","Type":"NodeParagraph","Properties":{"id":"20250828210043-6m0uxqo","updated":"20250828210043"},"Children":[{"Type":"NodeText","Data":"托管堆（Managed Heap）包含了与托管对象（Managed Objects）相关的数据，以及为这些对象预留的空间。它由脚本的垃圾回收器（Scripting Garbage Collector）进行管理，因此任何不再与根对象存在引用链的托管对象都会被回收。"}]},{"ID":"20250828210052-effmv7x","Type":"NodeParagraph","Properties":{"id":"20250828210052-effmv7x","updated":"20250828210052"},"Children":[{"Type":"NodeText","Data":"托管内存中的“已使用”部分包括了用于托管对象的内存，以及一些无法归还（释放）但当前未被使用的空闲空间。"}]},{"ID":"20250828210057-dq9z0bf","Type":"NodeParagraph","Properties":{"id":"20250828210057-dq9z0bf","updated":"20250828210057"},"Children":[{"Type":"NodeText","Data":"这个分类中的“已预留（reserved）”内存可以在需要时快速重复利用，或者会在每进行 6 次 GC.Collect 垃圾回收清扫时被归还给系统。"}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20250828210151-xgsjlrn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20250828210151-xgsjlrn","updated":"20250828210411"},"Children":[{"Type":"NodeText","Data":"Executables \u0026 Mapped（可执行文件和映射内存）"}]},{"ID":"20250828210334-ianpo5c","Type":"NodeSuperBlock","Properties":{"id":"20250828210334-ianpo5c","updated":"20250828210334"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20250828210213-mmv8nnn","Type":"NodeParagraph","Properties":{"id":"20250828210213-mmv8nnn","updated":"20250828210334"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250828210151-39f3huf.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250828210247-h85ch7o","Type":"NodeBlockquote","Properties":{"id":"20250828210247-h85ch7o","updated":"20250828210334"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250828210248-tbhf436","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20250828210248-tbhf436","updated":"20250828210328"},"Children":[{"Type":"NodeText","Data":"可执行文件和映射内存"}]},{"ID":"20250828210300-k2ubsa5","Type":"NodeParagraph","Properties":{"id":"20250828210300-k2ubsa5","updated":"20250828210316"},"Children":[{"Type":"NodeText","Data":"由应用程序构建代码占用的内存，包括所有共享库（shared libraries）和程序集（assemblies），无论是托管（Managed）还是原生（Native）的。目前，这个数值在所有平台上的报告还不完全一致。"}]},{"ID":"20250828210321-wl5glpi","Type":"NodeParagraph","Properties":{"id":"20250828210321-wl5glpi","updated":"20250828210328"},"Children":[{"Type":"NodeText","Data":"你可以通过以下方式减少这部分内存使用：使用更高级别的代码剥离（Code Stripping Level，如 IL2CPP 下的 Stripping Level 设置） 减少对不同模块和库的依赖"}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20250828210317-izf1ioq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20250828210317-izf1ioq","updated":"20250829094255"},"Children":[{"Type":"NodeText","Data":"Graphics (Estimated)（图形相关内存（估算））"}]},{"ID":"20250828210636-y641afc","Type":"NodeSuperBlock","Properties":{"id":"20250828210636-y641afc","updated":"20250829094255"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20250828210409-2rrfg29","Type":"NodeParagraph","Properties":{"id":"20250828210409-2rrfg29","updated":"20250828210636"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250828210407-5nca66v.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250828210440-4gaek77","Type":"NodeBlockquote","Properties":{"id":"20250828210440-4gaek77","updated":"20250829094255"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250828210442-knnsidp","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20250828210442-knnsidp","updated":"20250829094255"},"Children":[{"Type":"NodeText","Data":"图形相关（估算）"}]},{"ID":"20250828210458-yo90i3s","Type":"NodeParagraph","Properties":{"id":"20250828210458-yo90i3s","updated":"20250828210508"},"Children":[{"Type":"NodeText","Data":"指的是图形驱动和 GPU 为渲染你的应用程序而使用的估算内存。"}]},{"ID":"20250828210522-18e0xle","Type":"NodeParagraph","Properties":{"id":"20250828210522-18e0xle","updated":"20250828210543"},"Children":[{"Type":"NodeText","Data":"这些信息是基于 Unity 内部对图形资源分配情况的追踪得出的，包括：RenderTexture、Texture、Mesh、Animation 以及其他通过 Unity 或脚本 API 分配的图形缓冲区（Graphics Buffers）你可以在 All Of Memory 标签页中进一步查看这些图形资源。"}]},{"ID":"20250828210552-m60vfhq","Type":"NodeParagraph","Properties":{"id":"20250828210552-m60vfhq","updated":"20250829094255"},"Children":[{"Type":"NodeText","Data":"注意事项： 并不是所有图形对象的内存都会体现在这个分类中。例如：启用了 Read/Write 的图形资源，在 CPU 内存中需要保留一份副本，这会使它们的总内存使用量翻倍。（之后会教大家如何排查 Read/Write 造成的问题（"},{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"TODO"},{"Type":"NodeText","Data":"​）） 可以通过 Unity Objects 标签页来查看 Unity 对象的总内存使用情况。 此外，并非所有此类资源的内存都实际存在于 GPU 中。 Memory Profiler 无法准确获取图形资源是否驻留在 GPU 内存中的信息，因此这里只能提供估算值。"}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20250828210632-cnrw1st","Type":"NodeParagraph","Properties":{"id":"20250828210632-cnrw1st","updated":"20250828210648"},"Children":[{"Type":"NodeText","Data":"建议： 如果你在分析图形内存暴涨（如纹理、RT 多开-创建过多的RenderTexture）的问题，这段内容非常关键。\n一般屏幕后处理、相机截图、多视角渲染、水面反射、投影、UI特效都会生成 RenderTexture 渲染纹理"}]},{"ID":"20250828210729-lns8hm9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20250828210729-lns8hm9","updated":"20250829100502"},"Children":[{"Type":"NodeText","Data":"Untracked* （未标记（追踪）的内存）"}]},{"ID":"20250828210939-ggd7ap5","Type":"NodeSuperBlock","Properties":{"id":"20250828210939-ggd7ap5","updated":"20250829094636"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20250828210702-r9pcbpc","Type":"NodeParagraph","Properties":{"id":"20250828210702-r9pcbpc","updated":"20250828210940"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250828210727-4ug4lfi.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250828210759-g5ca30s","Type":"NodeBlockquote","Properties":{"id":"20250828210759-g5ca30s","updated":"20250829094636"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250828210801-hidwc5z","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20250828210801-hidwc5z","updated":"20250829094636"},"Children":[{"Type":"NodeText","Data":"未标记（追踪）的内存"}]},{"ID":"20250828210814-2lzzq0b","Type":"NodeParagraph","Properties":{"id":"20250828210814-2lzzq0b","updated":"20250829094636"},"Children":[{"Type":"NodeText","Data":"Untracked Memory（未追踪内存） 这部分内存是 Memory Profiler 尚无法追踪或归类的内存，原因可能包括："}]},{"ID":"20250828211021-o1s8z2q","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250828211021-o1s8z2q","updated":"20250828211022"},"Children":[{"ID":"20250828211022-v8ryi5e","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250828211022-v8ryi5e","updated":"20250828211022"},"Children":[{"ID":"20250828211022-q17amug","Type":"NodeParagraph","Properties":{"id":"20250828211022-q17amug","updated":"20250828211022"},"Children":[{"Type":"NodeText","Data":"平台特有的内存使用机制"}]}]},{"ID":"20250828211024-z0kb6p1","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250828211024-z0kb6p1","updated":"20250828211024"},"Children":[{"ID":"20250828211024-e4nv6am","Type":"NodeParagraph","Properties":{"id":"20250828211024-e4nv6am","updated":"20250828211024"},"Children":[{"Type":"NodeText","Data":"Memory Profiler 的追踪能力尚未覆盖"}]}]},{"ID":"20250828211028-yjnvqhf","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250828211028-yjnvqhf","updated":"20250828211028"},"Children":[{"ID":"20250828211028-3u0a6nj","Type":"NodeParagraph","Properties":{"id":"20250828211028-3u0a6nj","updated":"20250828211044"},"Children":[{"Type":"NodeText","Data":"某些潜在的 bug 或内存记录漏洞"}]}]}]},{"ID":"20250828211044-m5trgwz","Type":"NodeParagraph","Properties":{"id":"20250828211044-m5trgwz","updated":"20250828211106"},"Children":[{"Type":"NodeText","Data":"这部分 Untracked 内存的计算方式如下：\nMemory Profiler 会分析整个 Unity 进程中已分配和常驻（resident）的内存区域，然后从中减去 Unity 已知的托管内存和原生内存分配器所使用的区域，剩下的部分就是无法归类的“未追踪”内存。要进一步分析这些未追踪内存，你需要使用平台专用的底层 Profiler（例如 Xcode Instruments、Android Studio Profiler 等）。"}]},{"ID":"20250828210906-nan4u33","Type":"NodeParagraph","Properties":{"id":"20250828210906-nan4u33","updated":"20250829094229"},"Children":[{"Type":"NodeText","Data":"补充说明： 在计算 Untracked 内存的 “Allocated Size（已分配大小）” 时， 我们还会从中减去 Graphics（Estimated）图形内存的大小，因为：我们知道图形设备会申请某些类型的内存区域，但无法精确追踪每个图形资源具体映射到哪个内存块，所以我们直接从图形设备相关区域中减去 Graphics（Estimated）的总值，若找不到图形区域，则从最大的几个内存区域中扣减这部分图形估算值"}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20250828210911-emcbqrf","Type":"NodeParagraph","Properties":{"id":"20250828210911-emcbqrf","updated":"20250828210915"},"Children":[{"Type":"NodeText","Data":"建议："}]},{"ID":"20250828210917-0s4nddn","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250828210917-0s4nddn","updated":"20250828210918"},"Children":[{"ID":"20250828210918-bn9dr7f","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250828210918-bn9dr7f","updated":"20250828210918"},"Children":[{"ID":"20250828210918-y5aen5b","Type":"NodeParagraph","Properties":{"id":"20250828210918-y5aen5b","updated":"20250828210918"},"Children":[{"Type":"NodeText","Data":"想分析图形内存的详细情况， 用 Allocated Memory 视图"}]}]},{"ID":"20250828210922-s9u89ta","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250828210922-s9u89ta","updated":"20250828210922"},"Children":[{"ID":"20250828210922-k46wq8g","Type":"NodeParagraph","Properties":{"id":"20250828210922-k46wq8g","updated":"20250828210929"},"Children":[{"Type":"NodeText","Data":"想准确查看 Untracked 未追踪部分 占用了多少内存、是否常驻；用 Resident Memory（常驻内存） 或 Allocated and Resident（分配和常驻）模式"}]}]},{"ID":"20250828210934-t2s5p48","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250828210934-t2s5p48","updated":"20250828210934"},"Children":[{"ID":"20250828210934-1kzb1kl","Type":"NodeParagraph","Properties":{"id":"20250828210934-1kzb1kl","updated":"20250828210934"},"Children":[{"Type":"NodeText","Data":"如果你遇到 Untracked 非常大，建议结合平台原生工具（如 Xcode Instruments 的 VM Tracker、Android 的 meminfo）来做进一步排查"}]}]}]},{"ID":"20250829100502-oy9pt1s","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20250829100502-oy9pt1s","updated":"20250829102456"},"Children":[{"Type":"NodeText","Data":"Managed Heap Utilization（托管堆使用率）"}]},{"ID":"20250829100551-31keczt","Type":"NodeParagraph","Properties":{"id":"20250829100551-31keczt","updated":"20250829100551"},"Children":[{"Type":"NodeText","Data":"主要作用：\n显示 Unity 脚本虚拟机（Scripting VM）所管理的内存的详细分类\n可以用于分析 C# 脚本对象的内存使用效率\n可以结合 GC 分析是否有频繁回收/堆扩容等问题"}]},{"ID":"20250829100622-swjgq5c","Type":"NodeParagraph","Properties":{"id":"20250829100622-swjgq5c","updated":"20250829101152"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250829101152-5blckt0.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250829100551-v0rl8kn","Type":"NodeParagraph","Properties":{"id":"20250829100551-v0rl8kn","updated":"20250829100607"},"Children":[{"Type":"NodeText","Data":"其中包括："}]},{"ID":"20250829100607-czr7uk1","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250829100607-czr7uk1","updated":"20250829100607"},"Children":[{"ID":"20250829100607-0tr51an","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250829100607-0tr51an","updated":"20250829100607"},"Children":[{"ID":"20250829100607-2hs7b9p","Type":"NodeParagraph","Properties":{"id":"20250829100607-2hs7b9p","updated":"20250829100607"},"Children":[{"Type":"NodeText","Data":"Empty Heap Space（空闲堆空间）"}]},{"ID":"20250829100612-4hehddl","Type":"NodeParagraph","Properties":{"id":"20250829100612-4hehddl","updated":"20250829100612"},"Children":[{"Type":"NodeText","Data":"可能是之前被对象使用过，或者在上一次堆扩展时预留的空间\n托管堆中空闲区域，可能是就对象被GC清理后的空位，堆扩容后的未使用空间"}]}]},{"ID":"20250829100607-cj1k2hw","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250829100607-cj1k2hw","updated":"20250829100607"},"Children":[{"ID":"20250829100607-yu4k3w5","Type":"NodeParagraph","Properties":{"id":"20250829100607-yu4k3w5","updated":"20250829101229"},"Children":[{"Type":"NodeText","Data":"Objects（托管对象占用内存）"}]},{"ID":"20250829100615-jnmajw1","Type":"NodeParagraph","Properties":{"id":"20250829100615-jnmajw1","updated":"20250829101227"},"Children":[{"Type":"NodeText","Data":"托管堆内存，正在被引用的托管对象，占用堆内存，GC 不会清除的内存"}]}]},{"ID":"20250829100607-135hylr","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250829100607-135hylr","updated":"20250829100607"},"Children":[{"ID":"20250829100607-xzbh026","Type":"NodeParagraph","Properties":{"id":"20250829100607-xzbh026","updated":"20250829101218"},"Children":[{"Type":"NodeText","Data":"Virtual Machine（虚拟机使用的内存）"}]},{"ID":"20250829100614-q1xjymr","Type":"NodeParagraph","Properties":{"id":"20250829100614-q1xjymr","updated":"20250829100614"},"Children":[{"Type":"NodeText","Data":"脚本运行时（Mono / IL2CPP）自身占用的非对象内存，比如类型元数据、静态字段、泛型支持等"}]}]}]},{"ID":"20250829100551-u1lbb9m","Type":"NodeParagraph","Properties":{"id":"20250829100551-u1lbb9m","updated":"20250829101239"},"Children":[{"Type":"NodeText","Data":"在排查问题时，主要关注："}]},{"ID":"20250829101243-xaw4erx","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250829101243-xaw4erx","updated":"20250829102456"},"Children":[{"ID":"20250829101247-4ymenq1","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250829101247-4ymenq1","updated":"20250829102456"},"Children":[{"ID":"20250829101247-ruu503h","Type":"NodeParagraph","Properties":{"id":"20250829101247-ruu503h","updated":"20250829101247"},"Children":[{"Type":"NodeText","Data":"托管对象（Managed Objects）所占内存，"}]},{"ID":"20250829101249-8683lom","Type":"NodeParagraph","Properties":{"id":"20250829101249-8683lom","updated":"20250829102456"},"Children":[{"Type":"NodeText","Data":"对比多个快照，看是不是存在对象一直不被释放，此时可能存在内存泄漏。\n或者看看对象创建速度是否超过了 GC 回收速度。"}]}]},{"ID":"20250829101247-1w2q7zl","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250829101247-1w2q7zl","updated":"20250829101305"},"Children":[{"ID":"20250829101247-s3l7qzn","Type":"NodeParagraph","Properties":{"id":"20250829101247-s3l7qzn","updated":"20250829101305"},"Children":[{"Type":"NodeText","Data":"空闲堆内存在 GC 触发后，是否有明显回收、收缩（即内存被释放出来）"}]}]},{"ID":"20250829101247-xtohuz7","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250829101247-xtohuz7","updated":"20250829101247"},"Children":[{"ID":"20250829101247-c4gt1yw","Type":"NodeParagraph","Properties":{"id":"20250829101247-c4gt1yw","updated":"20250829101247"},"Children":[{"Type":"NodeText","Data":"虚拟机内存是否不断增大"}]},{"ID":"20250829101256-nm2usgy","Type":"NodeParagraph","Properties":{"id":"20250829101256-nm2usgy","updated":"20250829101256"},"Children":[{"Type":"NodeText","Data":"如果存在可能是元数据膨胀或静态字段泄漏，即静态字段持有大量对象未释放，特别注意单例"}]}]},{"ID":"20250829101247-fcrhkwl","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250829101247-fcrhkwl","updated":"20250829101247"},"Children":[{"ID":"20250829101247-ixmhhr0","Type":"NodeParagraph","Properties":{"id":"20250829101247-ixmhhr0","updated":"20250829101247"},"Children":[{"Type":"NodeText","Data":"不要单独只看一个数字，要结合堆大小、使用率、类型分布、引用关系综合判断"}]}]}]},{"ID":"20250829100551-j7l4yer","Type":"NodeParagraph","Properties":{"id":"20250829100551-j7l4yer","updated":"20250829101314"},"Children":[{"Type":"NodeText","Data":"比较观察："}]},{"ID":"20250829101314-lt5ztnx","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250829101314-lt5ztnx","updated":"20250829101322"},"Children":[{"ID":"20250829101314-d03d2fb","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250829101314-d03d2fb","updated":"20250829101322"},"Children":[{"ID":"20250829101314-fe82zhf","Type":"NodeParagraph","Properties":{"id":"20250829101314-fe82zhf","updated":"20250829101322"},"Children":[{"Type":"NodeText","Data":"对比 托管对象所占内存 和 堆内存"}]},{"ID":"20250829101315-nbfkqaw","Type":"NodeParagraph","Properties":{"id":"20250829101315-nbfkqaw","updated":"20250829101315"},"Children":[{"Type":"NodeText","Data":"对象很少但堆很大，说明堆膨胀，可能存在内存碎片"}]}]},{"ID":"20250829101314-mtc882p","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250829101314-mtc882p","updated":"20250829101314"},"Children":[{"ID":"20250829101314-z6q3aw6","Type":"NodeParagraph","Properties":{"id":"20250829101314-z6q3aw6","updated":"20250829101314"},"Children":[{"Type":"NodeText","Data":"Empty Heap Space（空闲堆空间）高，已 GC 但堆未收缩，可能是 GC 没触发或碎片多"}]}]},{"ID":"20250829101314-27zys1f","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250829101314-27zys1f","updated":"20250829101314"},"Children":[{"ID":"20250829101314-70ffc0b","Type":"NodeParagraph","Properties":{"id":"20250829101314-70ffc0b","updated":"20250829101314"},"Children":[{"Type":"NodeText","Data":"Virtual Machine 增长快 泛型类过多或静态字段持有大对象未释放"}]}]}]},{"ID":"20250829100551-57bszfg","Type":"NodeParagraph","Properties":{"id":"20250829100551-57bszfg","updated":"20250829100551"},"Children":[{"Type":"NodeText","Data":"我们可以进行多次快照对比"}]},{"ID":"20250829101423-vau6cch","Type":"NodeParagraph","Properties":{"id":"20250829101423-vau6cch","updated":"20250829101525"},"Children":[{"Type":"NodeText","Data":"点击内存占用比例条的不同部分，在右侧的信息面板可以看到如下内容："}]},{"ID":"20250829102042-ee46wll","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20250829102042-ee46wll","updated":"20250829102329"},"Children":[{"Type":"NodeText","Data":"Empty Heap Space（空闲堆空间）"}]},{"ID":"20250829101644-defy1mm","Type":"NodeSuperBlock","Properties":{"id":"20250829101644-defy1mm","updated":"20250829102323"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20250829101623-zjqj59c","Type":"NodeParagraph","Properties":{"id":"20250829101623-zjqj59c","updated":"20250829101645"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250829101634-of3gmnw.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250829101615-q56ds3j","Type":"NodeBlockquote","Properties":{"id":"20250829101615-q56ds3j","updated":"20250829102323"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250829101617-9ytmodp","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20250829101617-9ytmodp","updated":"20250829102323"},"Children":[{"Type":"NodeText","Data":"空闲堆空间"}]},{"ID":"20250829101639-k0q92bt","Type":"NodeParagraph","Properties":{"id":"20250829101639-k0q92bt","updated":"20250829101704"},"Children":[{"Type":"NodeText","Data":"这个快照版本尚未能准确标识出哪个托管堆区段（Managed Heap Section）是当前活动的（Active）。因此，系统假设虚拟地址值最高的那个连续托管堆区段是活动的，这个判断大多数情况下是正确的。图中的进度条显示的是该活动区段中未使用内存的数量。"}]},{"ID":"20250829101709-zvhuyin","Type":"NodeParagraph","Properties":{"id":"20250829101709-zvhuyin","updated":"20250829101728"},"Children":[{"Type":"NodeText","Data":"当需要为新的托管对象（Managed Objects）分配内存时："}]},{"ID":"20250829101728-03q83qk","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250829101728-03q83qk","updated":"20250829102308"},"Children":[{"ID":"20250829101728-j5sfklm","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250829101728-j5sfklm","updated":"20250829101728"},"Children":[{"ID":"20250829101728-4y10cyc","Type":"NodeParagraph","Properties":{"id":"20250829101728-4y10cyc","updated":"20250829101730"},"Children":[{"Type":"NodeText","Data":"首先会检查当前活动的堆区段中是否有空闲空间，这是分配内存最快的方式（直接连续分配）"}]}]},{"ID":"20250829101728-ol6jupe","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250829101728-ol6jupe","updated":"20250829101728"},"Children":[{"ID":"20250829101728-juy364u","Type":"NodeParagraph","Properties":{"id":"20250829101728-juy364u","updated":"20250829101734"},"Children":[{"Type":"NodeText","Data":"如果活动堆区段中没有足够的连续空闲空间，脚本虚拟机（Scripting VM）就需要扫描“空闲块列表”和其他堆区段来寻找可用空间，这一步会更慢一些。"}]}]},{"ID":"20250829101728-ejwwzq8","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250829101728-ejwwzq8","updated":"20250829102308"},"Children":[{"ID":"20250829101728-o0n18vg","Type":"NodeParagraph","Properties":{"id":"20250829101728-o0n18vg","updated":"20250829102308"},"Children":[{"Type":"NodeText","Data":"如果还是找不到合适的位置，则会触发 垃圾回收（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"GC.Collection"},{"Type":"NodeText","Data":"​）"}]}]}]},{"ID":"20250829102258-8xou620","Type":"NodeParagraph","Properties":{"id":"20250829102258-8xou620","updated":"20250829102323"},"Children":[{"Type":"NodeText","Data":"而 GC 这一步分两种情况："}]},{"ID":"20250829101725-veotnls","Type":"NodeList","ListData":{},"Properties":{"id":"20250829101725-veotnls","updated":"20250829101848"},"Children":[{"ID":"20250829101835-e1ocey2","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829101835-e1ocey2","updated":"20250829101835"},"Children":[{"ID":"20250829101835-lol4472","Type":"NodeParagraph","Properties":{"id":"20250829101835-lol4472","updated":"20250829101835"},"Children":[{"Type":"NodeText","Data":"如果启用了 增量式 GC（Incremental GC）："}]},{"ID":"20250829101837-6k4pxwi","Type":"NodeParagraph","Properties":{"id":"20250829101837-6k4pxwi","updated":"20250829101837"},"Children":[{"Type":"NodeText","Data":"在找不到空间时，会立刻分配一个新的堆区段（扩展堆）来存放新对象，与此同时，垃圾回收会异步地进行"}]}]},{"ID":"20250829101836-eb6yasi","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829101836-eb6yasi","updated":"20250829101848"},"Children":[{"ID":"20250829101836-uphilh5","Type":"NodeParagraph","Properties":{"id":"20250829101836-uphilh5","updated":"20250829101836"},"Children":[{"Type":"NodeText","Data":"如果未启用增量式 GC："}]},{"ID":"20250829101841-vwoam6a","Type":"NodeParagraph","Properties":{"id":"20250829101841-vwoam6a","updated":"20250829101848"},"Children":[{"Type":"NodeText","Data":"系统会先尝试做一次完整的 GC，如果回收后仍然没有足够空间，才会新分配堆区段。另外，这部分内存中也可能仍然包含一些已“被放弃”的对象，即：上一次 GC 后已无引用的对象，但尚未被实际清理，等待下次 GC 时才会被回收。"}]}]}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20250829102329-em5p2e5","Type":"NodeParagraph","Properties":{"id":"20250829102329-em5p2e5","updated":"20250829102329"},"Children":[{"Type":"NodeText","Data":"重点排查："}]},{"ID":"20250829102329-o6zn27j","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250829102329-o6zn27j","updated":"20250829102329"},"Children":[{"ID":"20250829102329-yjrwbi3","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250829102329-yjrwbi3","updated":"20250829102329"},"Children":[{"ID":"20250829102329-fa17xdu","Type":"NodeParagraph","Properties":{"id":"20250829102329-fa17xdu","updated":"20250829102329"},"Children":[{"Type":"NodeText","Data":"堆有没有用满"}]}]},{"ID":"20250829102329-9bo82dp","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250829102329-9bo82dp","updated":"20250829102329"},"Children":[{"ID":"20250829102329-ayviaps","Type":"NodeParagraph","Properties":{"id":"20250829102329-ayviaps","updated":"20250829102329"},"Children":[{"Type":"NodeText","Data":"是不是频繁 GC 或膨胀"}]}]},{"ID":"20250829102329-0xc0e3j","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250829102329-0xc0e3j","updated":"20250829102329"},"Children":[{"ID":"20250829102329-884ingf","Type":"NodeParagraph","Properties":{"id":"20250829102329-884ingf","updated":"20250829102329"},"Children":[{"Type":"NodeText","Data":"有没有“看起来未使用但没被释放”的对象"}]}]}]},{"ID":"20250829102036-2h2grrl","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20250829102036-2h2grrl","updated":"20250829102443"},"Children":[{"Type":"NodeText","Data":"Objects（托管对象占用内存）"}]},{"ID":"20250829102244-6jn9c1b","Type":"NodeSuperBlock","Properties":{"id":"20250829102244-6jn9c1b","updated":"20250829102411"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20250829102204-nbeka9n","Type":"NodeParagraph","Properties":{"id":"20250829102204-nbeka9n","updated":"20250829102245"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250829102222-wufc9v9.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250829102223-i8ygrot","Type":"NodeBlockquote","Properties":{"id":"20250829102223-i8ygrot","updated":"20250829102411"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250829102239-ntt2k6y","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20250829102239-ntt2k6y","updated":"20250829102411"},"Children":[{"Type":"NodeText","Data":"对象"}]},{"ID":"20250829102339-u8cwegc","Type":"NodeParagraph","Properties":{"id":"20250829102339-u8cwegc","updated":"20250829102411"},"Children":[{"Type":"NodeText","Data":"用于托管对象（Managed Objects）的内存，即那些由 C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 脚本代码中定义的类型创建和使用的对象所占用的内存。这个数字仅包括仍然被引用或保持存活状态的对象的内存。尚未被回收器 (Garbage Collector) 收集的托管对象，可能位于 活动堆区段的空闲区域（Empty Active / Fragmented Heap Space） 中。\n"}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20250829102412-febjaob","Type":"NodeParagraph","Properties":{"id":"20250829102412-febjaob","updated":"20250829102413"},"Children":[{"Type":"NodeText","Data":"重点：\n这里统计的仅是“活跃托管对象”的内存使用，不会包括已失去引用但尚未 GC 的部分\n垃圾回收尚未处理的对象，虽然没有引用，但仍可能暂时占用堆空间（在空闲或碎片区域里）\n因此，Managed Objects 的数值只是堆使用的一部分，并不能代表堆中的全部存在内容"}]},{"ID":"20250829102417-r60i3en","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20250829102417-r60i3en","updated":"20250829102838"},"Children":[{"Type":"NodeText","Data":"Virtual Machine（虚拟机使用的内存）"}]},{"ID":"20250829102515-thjt4hf","Type":"NodeSuperBlock","Properties":{"id":"20250829102515-thjt4hf","updated":"20250829102643"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20250829102440-gcbwxbq","Type":"NodeParagraph","Properties":{"id":"20250829102440-gcbwxbq","updated":"20250829102515"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250829102441-yn72y4d.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250829102500-qiq2c4a","Type":"NodeBlockquote","Properties":{"id":"20250829102500-qiq2c4a","updated":"20250829102643"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250829102503-ll44yi8","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20250829102503-ll44yi8","updated":"20250829102643"},"Children":[{"Type":"NodeText","Data":"虚拟机"}]},{"ID":"20250829102625-4ym8orm","Type":"NodeParagraph","Properties":{"id":"20250829102625-4ym8orm","updated":"20250829102643"},"Children":[{"Type":"NodeText","Data":"虚拟机内存（Virtual Machine memory） 包括 Mono 或 IL2CPP 运行所需的数据，例如："}]},{"ID":"20250829102519-x445wbb","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250829102519-x445wbb","updated":"20250829102523"},"Children":[{"ID":"20250829102523-of63nfu","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250829102523-of63nfu","updated":"20250829102523"},"Children":[{"ID":"20250829102523-7e47f7r","Type":"NodeParagraph","Properties":{"id":"20250829102523-7e47f7r","updated":"20250829102523"},"Children":[{"Type":"NodeText","Data":"每一个被使用的托管类型（Managed Type）的 类型元数据（Type MetaData）"}]}]},{"ID":"20250829102523-f7mvdxs","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250829102523-f7mvdxs","updated":"20250829102523"},"Children":[{"ID":"20250829102523-c8niech","Type":"NodeParagraph","Properties":{"id":"20250829102523-c8niech","updated":"20250829102523"},"Children":[{"Type":"NodeText","Data":"字段与函数的定义（虚函数表 vTable）"}]}]},{"ID":"20250829102523-5scyls4","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250829102523-5scyls4","updated":"20250829102523"},"Children":[{"ID":"20250829102523-bxrs9ym","Type":"NodeParagraph","Properties":{"id":"20250829102523-bxrs9ym","updated":"20250829102523"},"Children":[{"Type":"NodeText","Data":"静态字段的数据"}]}]},{"ID":"20250829102523-52uv55j","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250829102523-52uv55j","updated":"20250829102523"},"Children":[{"ID":"20250829102523-6vwqxik","Type":"NodeParagraph","Properties":{"id":"20250829102523-6vwqxik","updated":"20250829102523"},"Children":[{"Type":"NodeText","Data":"泛型类型所需的支持数据"}]}]}]},{"ID":"20250829102517-ledyzr1","Type":"NodeParagraph","Properties":{"id":"20250829102517-ledyzr1","updated":"20250829102600"},"Children":[{"Type":"NodeText","Data":"当 Memory Profiler 捕获快照时，它会初始化在托管堆中发现的所有类型，并因此将这些类型的元数据“膨胀”成完整数据结构（inflate）。因此，在一次分析会话中，第一次和第二次快照之间虚拟机内存的增长，通常主要是由于这些类型被初始化导致的。"}]},{"ID":"20250829102604-weygsj1","Type":"NodeParagraph","Properties":{"id":"20250829102604-weygsj1","updated":"20250829102605"},"Children":[{"Type":"NodeText","Data":"尚未初始化的类型是指：没有任何代码访问过它们的类型相关数据，因此它们的静态构造函数（无论是显式的还是隐式的）尚未被调用。"}]},{"ID":"20250829102609-kd213li","Type":"NodeParagraph","Properties":{"id":"20250829102609-kd213li","updated":"20250829102609"},"Children":[{"Type":"NodeText","Data":"这种情况通常出现在数组或泛型集合类中 —— 虽然集合被创建并使用了，但其内部类型数据还没有被实际访问。"}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20250829102532-u2k2naw","Type":"NodeParagraph","Properties":{"id":"20250829102532-u2k2naw","updated":"20250829102555"},"Children":[{"Type":"NodeText","Data":"重点：\nMemory Profiler 抓快照时，会“触发”类型初始化，让一些原本没被使用的静态类型元数据加载进来，\n这会让第二次快照比第一次“看起来多了虚拟机内存”，其实是因为被初始化了，\n如果你在分析快照差异，看到 VM 内存上涨，不一定是泄漏，可能只是因为多扫了一些静态字段或泛型类"}]},{"ID":"20250829102838-d91nwro","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20250829102838-d91nwro","updated":"20250829104453"},"Children":[{"Type":"NodeText","Data":"Top Unity Objects Categories（Unity 对象内存占用最多的类型分类）"}]},{"ID":"20250829103139-bu31b25","Type":"NodeParagraph","Properties":{"id":"20250829103139-bu31b25","updated":"20250829103139"},"Children":[{"Type":"NodeText","Data":"主要作用：\n显示在当前快照中，是哪些 Unity 类型对象占用最多内存\n是我们针对某类型内容优化的数据依据之一"}]},{"ID":"20250829103113-7wai2ws","Type":"NodeParagraph","Properties":{"id":"20250829103113-7wai2ws","updated":"20250829103144"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250829103113-r3y1r09.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250829103139-2nfb8op","Type":"NodeList","ListData":{},"Properties":{"id":"20250829103139-2nfb8op","updated":"20250829103518"},"Children":[{"ID":"20250829103149-mt0cjs8","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829103149-mt0cjs8","updated":"20250829103149"},"Children":[{"ID":"20250829103149-r01tl5f","Type":"NodeParagraph","Properties":{"id":"20250829103149-r01tl5f","updated":"20250829103149"},"Children":[{"Type":"NodeText","Data":"Texture2D：静态纹理（材质贴图）所占内存空间"}]}]},{"ID":"20250829103148-qb8yzyd","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829103148-qb8yzyd","updated":"20250829103518"},"Children":[{"ID":"20250829103148-77nog2l","Type":"NodeParagraph","Properties":{"id":"20250829103148-77nog2l","updated":"20250829103148"},"Children":[{"Type":"NodeText","Data":"RenderTexture：渲染纹理（屏幕后处理、相机目标输出、屏幕截图、倒影、UI等等）所占内存空间"}]}]},{"ID":"20250829103149-w62tbbc","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829103149-w62tbbc","updated":"20250829103149"},"Children":[{"ID":"20250829103149-khvnme3","Type":"NodeParagraph","Properties":{"id":"20250829103149-khvnme3","updated":"20250829103149"},"Children":[{"Type":"NodeText","Data":"Shader：着色器所占内存，包含着色器变体"}]}]},{"ID":"20250829103213-evhwljj","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829103213-evhwljj","updated":"20250829103213"},"Children":[{"ID":"20250829103213-n4qigvp","Type":"NodeParagraph","Properties":{"id":"20250829103213-n4qigvp","updated":"20250829103224"},"Children":[{"Type":"NodeText","Data":"Mesh：模型网格数据"}]}]},{"ID":"20250829103226-elz519q","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829103226-elz519q","updated":"20250829103243"},"Children":[{"ID":"20250829103226-ncdau9m","Type":"NodeParagraph","Properties":{"id":"20250829103226-ncdau9m","updated":"20250829103243"},"Children":[{"Type":"NodeText","Data":"AnimationClip：动画切片数据"}]}]},{"ID":"20250829103150-9rkzbfz","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829103150-9rkzbfz","updated":"20250829103150"},"Children":[{"ID":"20250829103150-yrvx7kz","Type":"NodeParagraph","Properties":{"id":"20250829103150-yrvx7kz","updated":"20250829103150"},"Children":[{"Type":"NodeText","Data":"SceneVisibilityState：Unity编辑器用来记录“场景可见性“的数据结构，仅在编辑器中会看到"}]}]},{"ID":"20250829103150-7ckrvus","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829103150-7ckrvus","updated":"20250829103150"},"Children":[{"ID":"20250829103150-7us0z0y","Type":"NodeParagraph","Properties":{"id":"20250829103150-7us0z0y","updated":"20250829103155"},"Children":[{"Type":"NodeText","Data":"MonoManager：内部对象，非暴露类，Unity 引擎内部的脚本生命周期管理器"}]}]},{"ID":"20250829103151-htmtilw","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829103151-htmtilw","updated":"20250829103151"},"Children":[{"ID":"20250829103151-62eysyo","Type":"NodeParagraph","Properties":{"id":"20250829103151-62eysyo","updated":"20250829103151"},"Children":[{"Type":"NodeText","Data":"Others：其他，未归类到已知类型的原生对象，比如原生插件对象等等"}]}]}]},{"ID":"20250829103139-i4t9335","Type":"NodeParagraph","Properties":{"id":"20250829103139-i4t9335","updated":"20250829103255"},"Children":[{"Type":"NodeText","Data":"这些具体信息，都可以前往 Unity Objects 页签查看详细信息"}]},{"ID":"20250829103439-11gnyjo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250829103439-11gnyjo","updated":"20250829112712"},"Children":[{"Type":"NodeText","Data":"Unity Objects（Unity 对象页签）"}]},{"ID":"20250829104650-ngy83fd","Type":"NodeParagraph","Properties":{"id":"20250829104650-ngy83fd","updated":"20250829104657"},"Children":[{"Type":"NodeText","Data":"快速定位 Unity 对象内存占用的类型和具体实例"}]},{"ID":"20250829104657-pjo81vn","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250829104657-pjo81vn","updated":"20250829104657"},"Children":[{"ID":"20250829104657-06kvww8","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250829104657-06kvww8","updated":"20250829104657"},"Children":[{"ID":"20250829104657-roexw35","Type":"NodeParagraph","Properties":{"id":"20250829104657-roexw35","updated":"20250829104657"},"Children":[{"Type":"NodeText","Data":"查找内存占用最大的资源，判断这些资源是否可以压缩或者延迟加载等"}]}]},{"ID":"20250829104657-qfvf19v","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250829104657-qfvf19v","updated":"20250829104657"},"Children":[{"ID":"20250829104657-mj5djq5","Type":"NodeParagraph","Properties":{"id":"20250829104657-mj5djq5","updated":"20250829104657"},"Children":[{"Type":"NodeText","Data":"查找重复加载的资源"}]}]},{"ID":"20250829104657-bdpk8ni","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250829104657-bdpk8ni","updated":"20250829104657"},"Children":[{"ID":"20250829104657-fjyaftv","Type":"NodeParagraph","Properties":{"id":"20250829104657-fjyaftv","updated":"20250829104657"},"Children":[{"Type":"NodeText","Data":"查看运行时创建但是没有释放的资源"}]}]},{"ID":"20250829104657-dhc7fvq","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250829104657-dhc7fvq","updated":"20250829104657"},"Children":[{"ID":"20250829104657-o5hjaaz","Type":"NodeParagraph","Properties":{"id":"20250829104657-o5hjaaz","updated":"20250829104657"},"Children":[{"Type":"NodeText","Data":"查看脚本对象是否滞留内存"}]}]}]},{"ID":"20250829104650-tbqi9oe","Type":"NodeParagraph","Properties":{"id":"20250829104650-tbqi9oe","updated":"20250829104654"},"Children":[{"Type":"NodeText","Data":"常见的一些问题："}]},{"ID":"20250829104654-lsypa51","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250829104654-lsypa51","updated":"20250829104710"},"Children":[{"ID":"20250829104654-r7noytu","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250829104654-r7noytu","updated":"20250829104710"},"Children":[{"ID":"20250829104654-amdaax0","Type":"NodeParagraph","Properties":{"id":"20250829104654-amdaax0","updated":"20250829104710"},"Children":[{"Type":"NodeText","Data":"纹理贴图内存过高：可以检查下是否重复加载，未压缩，是否开启 Read / Write"}]}]},{"ID":"20250829104654-64uy34q","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250829104654-64uy34q","updated":"20250829104708"},"Children":[{"ID":"20250829104654-kvfm3ql","Type":"NodeParagraph","Properties":{"id":"20250829104654-kvfm3ql","updated":"20250829104708"},"Children":[{"Type":"NodeText","Data":"相同资源是否多次加载：Name 相同，但是 InstanceID 不同的对象"}]}]},{"ID":"20250829104654-rpx9xq6","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250829104654-rpx9xq6","updated":"20250829104654"},"Children":[{"ID":"20250829104654-aiwifyf","Type":"NodeParagraph","Properties":{"id":"20250829104654-aiwifyf","updated":"20250829104654"},"Children":[{"Type":"NodeText","Data":"动态资源未释放：脚本中没有及时释放材质、纹理等"}]}]},{"ID":"20250829104654-lnyseol","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250829104654-lnyseol","updated":"20250829104654"},"Children":[{"ID":"20250829104654-oi9pyhm","Type":"NodeParagraph","Properties":{"id":"20250829104654-oi9pyhm","updated":"20250829104654"},"Children":[{"Type":"NodeText","Data":"多个组件持有大资源引用"}]}]},{"ID":"20250829104654-2w96mmg","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20250829104654-2w96mmg","updated":"20250829104702"},"Children":[{"ID":"20250829104654-smxjyw5","Type":"NodeParagraph","Properties":{"id":"20250829104654-smxjyw5","updated":"20250829104702"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"MonoBehaviour"},{"Type":"NodeText","Data":"​ 组件长期驻留，是否存在脚本组件内存泄漏（占着引用没使用）"}]}]}]},{"ID":"20250829104652-wmc0hqq","Type":"NodeParagraph","Properties":{"id":"20250829104652-wmc0hqq","updated":"20250829104652"},"Children":[{"Type":"NodeText","Data":"等等"}]},{"ID":"20250829104718-iprout1","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20250829104718-iprout1","updated":"20250829112712"},"Children":[{"Type":"NodeText","Data":"界面上的功能参数"}]},{"ID":"20250829105138-yn9xuyo","Type":"NodeParagraph","Properties":{"id":"20250829105138-yn9xuyo","updated":"20250829105516"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250829105516-qa9mri1.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250829105527-3vva4dc","Type":"NodeList","ListData":{},"Properties":{"id":"20250829105527-3vva4dc","updated":"20250829112712"},"Children":[{"ID":"20250829105527-42wpthy","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-42wpthy","updated":"20250829105527"},"Children":[{"ID":"20250829105527-hpv4zoj","Type":"NodeParagraph","Properties":{"id":"20250829105527-hpv4zoj","updated":"20250829105752"},"Children":[{"Type":"NodeText","Data":"A：对所有 Unity 对象所占内存的组成进行详细分类分析"}]},{"ID":"20250829105753-pm2z0og","Type":"NodeParagraph","Properties":{"id":"20250829105753-pm2z0og","updated":"20250829105804"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250829105804-fc8z0um.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250829105753-ceu1ptl","Type":"NodeList","ListData":{},"Properties":{"id":"20250829105753-ceu1ptl","updated":"20250829105753"},"Children":[{"ID":"20250829105527-1ukztjh","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-1ukztjh","updated":"20250829105527"},"Children":[{"ID":"20250829105527-mcbokk5","Type":"NodeParagraph","Properties":{"id":"20250829105527-mcbokk5","updated":"20250829105733"},"Children":[{"Type":"NodeText","Data":"Allocated Memory（已分配内存）"}]},{"ID":"20250829105734-fmot8at","Type":"NodeParagraph","Properties":{"id":"20250829105734-fmot8at","updated":"20250829105734"},"Children":[{"Type":"NodeText","Data":"显示 Unity 已向操作系统申请的内存总量（可能在虚拟内存或被操作系统回收），一般比 驻留内存 大一些\n主要作用： 用来分析对象本身理论占用的内存量，可以快速判断大内存对象"}]}]},{"ID":"20250829105527-29qnw79","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-29qnw79","updated":"20250829105527"},"Children":[{"ID":"20250829105527-ce5ehnj","Type":"NodeParagraph","Properties":{"id":"20250829105527-ce5ehnj","updated":"20250829105725"},"Children":[{"Type":"NodeText","Data":"Resident Memory on Device（驻留的内存）"}]},{"ID":"20250829105705-upd0wxh","Type":"NodeParagraph","Properties":{"id":"20250829105705-upd0wxh","updated":"20250829105723"},"Children":[{"Type":"NodeText","Data":"实际驻留在设备物理内存中的部分，表示当前确实占据了内存，排除了后台运行或系统清理后的内容，反应对象现在是否还在内存中\n主要作用： 在设备内存紧张时判断哪些对象仍常驻，可用于作为优化运行时内存压力的重要依据"}]}]},{"ID":"20250829105527-kgeh2u0","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-kgeh2u0","updated":"20250829105527"},"Children":[{"ID":"20250829105527-487poj8","Type":"NodeParagraph","Properties":{"id":"20250829105527-487poj8","updated":"20250829105748"},"Children":[{"Type":"NodeText","Data":"Allocated and Resident Memory on Device（分配和驻留的内存）"}]},{"ID":"20250829105658-43s7qdr","Type":"NodeParagraph","Properties":{"id":"20250829105658-43s7qdr","updated":"20250829105916"},"Children":[{"Type":"NodeText","Data":"综合视图，显示对象分配的总内存以及在设备内存中的驻留情况，通常是最全面的视角。可以直观看出分类了多少，但真的再用的有多少\n主要作用： 找出大但驻留少的资源（说明是临时性的，加载后没用），找出分配不大但全部常驻的资源（说明常用）"}]}]}]}]},{"ID":"20250829105527-zs36dgp","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-zs36dgp","updated":"20250829105527"},"Children":[{"ID":"20250829105527-ng349os","Type":"NodeParagraph","Properties":{"id":"20250829105527-ng349os","updated":"20250829110533"},"Children":[{"Type":"NodeText","Data":"B：所选内容的详细信息（点击某个大类时显示内容）"}]},{"ID":"20250829110000-qge67f5","Type":"NodeParagraph","Properties":{"id":"20250829110000-qge67f5","updated":"20250829110014"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250829110014-t2aty1u.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250829110000-rvpg909","Type":"NodeList","ListData":{},"Properties":{"id":"20250829110000-rvpg909","updated":"20250829110000"},"Children":[{"ID":"20250829105527-oul8sy6","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-oul8sy6","updated":"20250829105527"},"Children":[{"ID":"20250829105527-vszdw6q","Type":"NodeParagraph","Properties":{"id":"20250829105527-vszdw6q","updated":"20250829105936"},"Children":[{"Type":"NodeText","Data":"Managed Type：对象的 C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 类型名"}]}]},{"ID":"20250829105527-eg6gvp4","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-eg6gvp4","updated":"20250829105527"},"Children":[{"ID":"20250829105527-j9n1rd1","Type":"NodeParagraph","Properties":{"id":"20250829105527-j9n1rd1","updated":"20250829105527"},"Children":[{"Type":"NodeText","Data":"Managed Assembly：该对象所属程序集"}]}]},{"ID":"20250829105527-w52lr30","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-w52lr30","updated":"20250829105527"},"Children":[{"ID":"20250829105527-hfut43s","Type":"NodeParagraph","Properties":{"id":"20250829105527-hfut43s","updated":"20250829105527"},"Children":[{"Type":"NodeText","Data":"Native Type：Unity原生对象的类型名称"}]}]},{"ID":"20250829105527-ke2rgur","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-ke2rgur","updated":"20250829105527"},"Children":[{"ID":"20250829105527-hqgo0o8","Type":"NodeParagraph","Properties":{"id":"20250829105527-hqgo0o8","updated":"20250829105943"},"Children":[{"Type":"NodeText","Data":"Children Count：该对象的子对象数量（它引用了多少其他对象）"}]},{"ID":"20250829105944-vzt7hky","Type":"NodeBlockquote","Properties":{"id":"20250829105944-vzt7hky","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20250829105951"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250829105951-7dhnp9k","Type":"NodeParagraph","Properties":{"id":"20250829105951-7dhnp9k","updated":"20250829105951"},"Children":[{"Type":"NodeText","Data":"注意：不是场景层级的子物体，而是内存引用结构中的“下层持有对象”，比如一个材质球可能持有一个着色器和多个纹理"}]}]}]}]}]},{"ID":"20250829105527-cj8w6te","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-cj8w6te","updated":"20250829112712"},"Children":[{"ID":"20250829105527-pk4mu7j","Type":"NodeParagraph","Properties":{"id":"20250829105527-pk4mu7j","updated":"20250829105541"},"Children":[{"Type":"NodeText","Data":"C：对象内存占用情况"}]},{"ID":"20250829110053-imdor05","Type":"NodeParagraph","Properties":{"id":"20250829110053-imdor05","updated":"20250829110132"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250829110132-qqzfkkw.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250829110053-mfg5d6n","Type":"NodeList","ListData":{},"Properties":{"id":"20250829110053-mfg5d6n","updated":"20250829112712"},"Children":[{"ID":"20250829105527-ifmx1yy","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-ifmx1yy","updated":"20250829105527"},"Children":[{"ID":"20250829105527-uv23pt8","Type":"NodeParagraph","Properties":{"id":"20250829105527-uv23pt8","updated":"20250829105527"},"Children":[{"Type":"NodeText","Data":"Description：对象简要说明，一般是对象名称"}]}]},{"ID":"20250829105527-7zztn90","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-7zztn90","updated":"20250829112625"},"Children":[{"ID":"20250829105527-iqraozh","Type":"NodeParagraph","Properties":{"id":"20250829105527-iqraozh","updated":"20250829112625"},"Children":[{"Type":"NodeText","Data":"Allocated Size：该对象在 Unity 进程内部分配器中记录的总分配内存大小"}]}]},{"ID":"20250829112609-nk4ocp3","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829112609-nk4ocp3","updated":"20250829112712"},"Children":[{"ID":"20250829112609-cgjy2vk","Type":"NodeParagraph","Properties":{"id":"20250829112609-cgjy2vk","updated":"20250829112712"},"Children":[{"Type":"NodeText","Data":"Resident Size：该对象实际驻留在设备物理内存中的内存大小"}]}]},{"ID":"20250829105527-wbaq0pn","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-wbaq0pn","updated":"20250829105527"},"Children":[{"ID":"20250829105527-ome2ly5","Type":"NodeParagraph","Properties":{"id":"20250829105527-ome2ly5","updated":"20250829105527"},"Children":[{"Type":"NodeText","Data":"%Impact：该对象占整体内存的百分比"}]}]},{"ID":"20250829105527-hf31su9","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-hf31su9","updated":"20250829110923"},"Children":[{"ID":"20250829105527-p1urzqk","Type":"NodeParagraph","Properties":{"id":"20250829105527-p1urzqk","updated":"20250829110923"},"Children":[{"Type":"NodeText","Data":"Native Size：对象在 Unity 原生内存（C++层）中分配的大小，比如纹理、材质、网格这些大多都是原生对象"}]}]},{"ID":"20250829105527-ao5rpv7","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-ao5rpv7","updated":"20250829105527"},"Children":[{"ID":"20250829105527-xa83hvt","Type":"NodeParagraph","Properties":{"id":"20250829105527-xa83hvt","updated":"20250829110149"},"Children":[{"Type":"NodeText","Data":"Managed Size：对象在托管内存（C#）中占用的大小， 比如 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"MonoBehaviour"},{"Type":"NodeText","Data":"​、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ScriptableObject"},{"Type":"NodeText","Data":"​、托管数组、类等对象"}]}]},{"ID":"20250829105527-uvsip5m","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829105527-uvsip5m","updated":"20250829110929"},"Children":[{"ID":"20250829105527-y0dk8kl","Type":"NodeParagraph","Properties":{"id":"20250829105527-y0dk8kl","updated":"20250829110929"},"Children":[{"Type":"NodeText","Data":"Graphics Size：对象在 GPU 图形内存（显存）中占用的估算大小， 比如纹理的像素，RenderTexture 的 RT 缓冲区，Mesh 的顶点/索引缓冲"}]}]}]},{"ID":"20250829110319-mjgytk7","Type":"NodeParagraph","Properties":{"id":"20250829110319-mjgytk7","updated":"20250829110801"},"Children":[{"Type":"NodeText","Data":"该表内的大类都可以展开查看每个类型下哪些资源占内存最多，并且每个子项可以点击，右侧会显示该资源的引用情况和，不同类型资源显示详细数据内容不同"}]},{"ID":"20250829110329-ydyp4wi","Type":"NodeParagraph","Properties":{"id":"20250829110329-ydyp4wi","updated":"20250829110852"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250829110852-n8vhvrw.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]}]},{"ID":"20250829104727-nn0wx4i","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20250829104727-nn0wx4i","updated":"20250829104753"},"Children":[{"Type":"NodeText","Data":"驻留内存（Resident Memory）"}]},{"ID":"20250829104734-13iwc7u","Type":"NodeParagraph","Properties":{"id":"20250829104734-13iwc7u","updated":"20250829104751"},"Children":[{"Type":"NodeText","Data":"真正对设备内存造成压力的，其实是驻留内存（Resident Memory）\n因为它才是实际驻留在物理内存（RAM）中的部分，也就是说系统此刻必须为它分配真实的内存"}]},{"ID":"20250829104745-gi24ti3","Type":"NodeParagraph","Properties":{"id":"20250829104745-gi24ti3","updated":"20250829104748"},"Children":[{"Type":"NodeText","Data":"一旦超过物理内存上限，就容易造成："}]},{"ID":"20250829104743-3hlae1a","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250829104743-3hlae1a","updated":"20250829104743"},"Children":[{"ID":"20250829104743-s93y2np","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250829104743-s93y2np","updated":"20250829104743"},"Children":[{"ID":"20250829104743-z1oo415","Type":"NodeParagraph","Properties":{"id":"20250829104743-z1oo415","updated":"20250829104743"},"Children":[{"Type":"NodeText","Data":"系统强制垃圾回收，导致卡顿，掉帧"}]}]},{"ID":"20250829104743-jukbu2x","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250829104743-jukbu2x","updated":"20250829104743"},"Children":[{"ID":"20250829104743-ohi4zhm","Type":"NodeParagraph","Properties":{"id":"20250829104743-ohi4zhm","updated":"20250829104743"},"Children":[{"Type":"NodeText","Data":"内存溢出（Out of Memory，简称 OOM），系统直接强行杀掉进程"}]}]}]},{"ID":"20250829104734-4ytnchj","Type":"NodeParagraph","Properties":{"id":"20250829104734-4ytnchj","updated":"20250829104736"},"Children":[{"Type":"NodeText","Data":"总结：驻留内存决定了程序的生死"}]},{"ID":"20250829104753-0ka6su4","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20250829104753-0ka6su4","updated":"20250829111342"},"Children":[{"Type":"NodeText","Data":"已分配内存（Allocated Memory）"}]},{"ID":"20250829104809-mh2e3u0","Type":"NodeParagraph","Properties":{"id":"20250829104809-mh2e3u0","updated":"20250829104809"},"Children":[{"Type":"NodeText","Data":"数值上可以超过物理限制，不会导致问题"}]},{"ID":"20250829104818-lguzuvm","Type":"NodeParagraph","Properties":{"id":"20250829104818-lguzuvm","updated":"20250829105017"},"Children":[{"Type":"NodeText","Data":"举例说明：\n比如申请了 6GB 内存，但其中只有 2.5GB 驻留在 RAM 中，\n就算操作系统没有 6GB 可用内存，依然会“允许”你申请成功（登记虚拟地址空间），它会允许你申请成功，\n但是如果你真正想要驻留超过上限的内存，系统会毫不留情的干掉你"}]},{"ID":"20250829104809-cxmwaev","Type":"NodeParagraph","Properties":{"id":"20250829104809-cxmwaev","updated":"20250829104809"},"Children":[{"Type":"NodeText","Data":"总结：申请不是问题，真正驻留、访问才决定生死"}]},{"ID":"20250829104809-fwc7xsn","Type":"NodeParagraph","Properties":{"id":"20250829104809-fwc7xsn","updated":"20250829104809"},"Children":[{"Type":"NodeText","Data":"既然已分配内存（Allocated Memory）不决定生死，那为什么还要统计它？\n原因：它虽不决定“立刻死亡”，但决定“健康状况和崩溃风险趋势”"}]},{"ID":"20250829104843-7f1sliy","Type":"NodeParagraph","Properties":{"id":"20250829104843-7f1sliy","updated":"20250829104843"},"Children":[{"Type":"NodeText","Data":"统计它的主要目的："}]},{"ID":"20250829104845-amu7nh7","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250829104845-amu7nh7","updated":"20250829104852"},"Children":[{"ID":"20250829104852-blejfib","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250829104852-blejfib","updated":"20250829104852"},"Children":[{"ID":"20250829104852-rj45u5o","Type":"NodeParagraph","Properties":{"id":"20250829104852-rj45u5o","updated":"20250829104852"},"Children":[{"Type":"NodeText","Data":"提前预警 内存溢出 风险"}]},{"ID":"20250829104903-k2vlia5","Type":"NodeParagraph","Properties":{"id":"20250829104903-k2vlia5","updated":"20250829104914"},"Children":[{"Type":"NodeText","Data":"已分配内存很高（Allocated Memory）意味着迟早会驻留，OOM 是时间问题"}]}]},{"ID":"20250829104852-gvk0qtx","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250829104852-gvk0qtx","updated":"20250829104852"},"Children":[{"ID":"20250829104852-ny24vxd","Type":"NodeParagraph","Properties":{"id":"20250829104852-ny24vxd","updated":"20250829104852"},"Children":[{"Type":"NodeText","Data":"衡量资源使用的总体趋势"}]},{"ID":"20250829104917-mu6sj86","Type":"NodeParagraph","Properties":{"id":"20250829104917-mu6sj86","updated":"20250829104917"},"Children":[{"Type":"NodeText","Data":"有些内存你还没用到或暂时没驻留，但它反映了程序在“计划”使用的资源规模，是设计是否合理的量化依据"}]}]},{"ID":"20250829104852-amn4ayc","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250829104852-amn4ayc","updated":"20250829104852"},"Children":[{"ID":"20250829104852-5cj0mbc","Type":"NodeParagraph","Properties":{"id":"20250829104852-5cj0mbc","updated":"20250829104852"},"Children":[{"Type":"NodeText","Data":"识别内存泄漏"}]},{"ID":"20250829104920-dzr2nae","Type":"NodeParagraph","Properties":{"id":"20250829104920-dzr2nae","updated":"20250829104926"},"Children":[{"Type":"NodeText","Data":"如果 已分配内存（Allocated Memory）一直上涨却没有回落，极可能是资源没有释放或发生了内存泄漏（特别是原生资源或 C++ 插件）"}]}]},{"ID":"20250829104852-i46ii9f","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250829104852-i46ii9f","updated":"20250829104852"},"Children":[{"ID":"20250829104852-nf7bsl3","Type":"NodeParagraph","Properties":{"id":"20250829104852-nf7bsl3","updated":"20250829104852"},"Children":[{"Type":"NodeText","Data":"优化内存分布结构"}]},{"ID":"20250829104931-t0qwwep","Type":"NodeParagraph","Properties":{"id":"20250829104931-t0qwwep","updated":"20250829104934"},"Children":[{"Type":"NodeText","Data":"不合理的内存使用分布（如 纹理相关 占一半，托管堆相关 占很少），可以通过观察 已分配内存（Allocated Memory） 各子类分布来发现"}]}]},{"ID":"20250829104852-8cu0dpe","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20250829104852-8cu0dpe","updated":"20250829104852"},"Children":[{"ID":"20250829104852-7qt1eb1","Type":"NodeParagraph","Properties":{"id":"20250829104852-7qt1eb1","updated":"20250829104852"},"Children":[{"Type":"NodeText","Data":"与平台限制进行对比"}]},{"ID":"20250829111237-92frq76","Type":"NodeParagraph","Properties":{"id":"20250829111237-92frq76","updated":"20250829111237"},"Children":[{"Type":"NodeText","Data":"虽然当前驻留量没爆，但你可能分配了超过平台上限的内存（比如 Android 中 4GB 上限），一旦压力加大就会踩雷"}]}]}]},{"ID":"20250829104809-qmqyfoo","Type":"NodeParagraph","Properties":{"id":"20250829104809-qmqyfoo","updated":"20250829104948"},"Children":[{"Type":"NodeText","Data":"再次总结："}]},{"ID":"20250829104951-ioh81sg","Type":"NodeList","ListData":{},"Properties":{"id":"20250829104951-ioh81sg","updated":"20250829104952"},"Children":[{"ID":"20250829104952-offh3pa","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250829104952-offh3pa","updated":"20250829104952"},"Children":[{"ID":"20250829104952-zsptab8","Type":"NodeParagraph","Properties":{"id":"20250829104952-zsptab8","updated":"20250829104952"},"Children":[{"Type":"NodeText","Data":"驻留内存（Resident Memory）：决定生死（是否内存溢出）"}]}]},{"ID":"20250829104953-qm192f3",