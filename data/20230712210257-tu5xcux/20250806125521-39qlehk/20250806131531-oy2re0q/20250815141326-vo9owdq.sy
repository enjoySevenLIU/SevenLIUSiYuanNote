wpeno7j","Type":"NodeParagraph","Properties":{"id":"20250815145240-wpeno7j","updated":"20250815145240"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250815145236-m8up0rg.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20250815145023-b5b6x76","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20250815145023-b5b6x76","updated":"20250815145320"},"Children":[{"ID":"20250815145023-9rnm2ch","Type":"NodeParagraph","Properties":{"id":"20250815145023-9rnm2ch","updated":"20250815145130"},"Children":[{"Type":"NodeText","Data":"Raw Hierarchy：原始层级视图"}]},{"ID":"20250815145130-f5yohuj","Type":"NodeParagraph","Properties":{"id":"20250815145130-f5yohuj","updated":"20250815145155"},"Children":[{"Type":"NodeText","Data":"更接近 GPU 实际命令流的视图，展示 未经整理的 GPU 操作列表 所有 GPU 调用按记录顺序直接列出（无父子结构）\n没有逻辑分组，也没有折叠结构，像一张“流水账”。\n适用于： 精细诊断性能问题时，确认某一个 Drawcall 或 GPU Pass 造成了卡顿，查看某条 GPU 调用命令具体花了多长时间"}]},{"ID":"20250815145301-vmih2xq","Type":"NodeParagraph","Properties":{"id":"20250815145301-vmih2xq","updated":"20250815145320"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250815145320-w9pz07i.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]}]}]},{"ID":"20250815144141-hethror","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20250815144141-hethror","updated":"20250815150216"},"Children":[{"ID":"20250815144141-9lq5lyf","Type":"NodeParagraph","Properties":{"id":"20250815144141-9lq5lyf","updated":"20250815145343"},"Children"