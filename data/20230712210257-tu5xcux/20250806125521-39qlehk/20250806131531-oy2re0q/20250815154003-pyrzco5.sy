":"20250815154214"},"Children":[{"Type":"NodeText","Data":"在游戏中如果出现以下问题时，可以着重观察这里的内容："}]},{"ID":"20250815154203-jxph0p1","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250815154203-jxph0p1","updated":"20250815154203"},"Children":[{"ID":"20250815154203-kh3hckm","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250815154203-kh3hckm","updated":"20250815154203"},"Children":[{"ID":"20250815154203-pl30uju","Type":"NodeParagraph","Properties":{"id":"20250815154203-pl30uju","updated":"20250815154203"},"Children":[{"Type":"NodeText","Data":"游戏卡顿、掉帧"}]},{"ID":"20250815154205-wd0boel","Type":"NodeParagraph","Properties":{"id":"20250815154205-wd0boel","updated":"20250815154205"},"Children":[{"Type":"NodeText","Data":"表现：游戏突然变慢、不定期小卡顿、操作延迟等\n可能原因：内存不足导致系统频繁进行 垃圾回收（GC），降低游戏帧率"}]}]},{"ID":"20250815154203-vrf1109","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250815154203-vrf1109","updated":"20250815154203"},"Children":[{"ID":"20250815154203-6o3az1e","Type":"NodeParagraph","Properties":{"id":"20250815154203-6o3az1e","updated":"20250815154203"},"Children":[{"Type":"NodeText","Data":"闪退、崩溃"}]},{"ID":"20250815154207-htvz9b2","Type":"NodeParagraph","Properties":{"id":"20250815154207-htvz9b2","updated":"20250815154207"},"Children":[{"Type":"NodeText","Data":"表现：玩着玩着突然黑屏退出、特定场景（如加载大地图）崩溃\n可能原因：设备分配不出更多内存，系统强制杀掉进程"}]}]},{"ID":"20250815154203-oeet130","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250815154203-oeet130","updated":"20250815154203"},"Children":[{"ID":"20250815154203-kyesrr7","Type":"NodeParagraph","Properties":{"id":"20250815154203-kyesrr7","updated":"20250815154203"},"Children":[{"Type":"NodeText","Data":"加载时间变长"}]},{"ID":"20250815154208-cbjcsqg","Type":"NodeParagraph","Properties":{"id":"20250815154208-cbjcsqg","updated":"20250815154208"},"Children":[{"Type":"NodeText","Data":"表现：加载界面等待时间变长，场景切换明显卡顿\n可能原因：加载资源时需要更多内存，系统调度与 GC 频繁运行。"}]}]},{"ID":"20250815154203-20ylceu","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250815154203-20ylceu","updated":"20250815154203"},"Children":[{"ID":"20250815154203-7cihnag","Type":"NodeParagraph","Properties":{"id":"20250815154203-7cihnag","updated":"20250815154203"},"Children":[{"Type":"NodeText","Data":"发热严重、掉电快"}]},{"ID":"20250815154209-azefjnu","Type":"NodeParagraph","Properties":{"id":"20250815154209-azefjnu","updated":"20250815154209"},"Children":[{"Type":"NodeText","Data":"表现：手机发烫严重、电池消耗快\n可能原因：设备内存使用达到极限，系统/游戏频繁调度内存资源，CPU、GPU 都高负载运转"}]}]},{"ID":"20250815154203-4r5ujku","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20250815154203-4r5ujku","updated":"20250815154203"},"Children":[{"ID":"20250815154203-3jdg3d0","Type":"NodeParagraph","Properties":{"id":"20250815154203-3jdg3d0","updated":"20250815154203"},"Children":[{"Type":"NodeText","Data":"低端设备无法运行"}]},{"ID":"20250815154210-rifs6g2","Type":"NodeParagraph","Properties":{"id":"20250815154210-rifs6g2","updated":"20250815154210"},"Children":[{"Type":"NodeText","Data":"表现：打开即闪退、进主界面就崩溃\n可能原因：老旧设备的可用内存更少，超出后甚至无法加载首屏"}]}]}]},{"ID":"20250815154150-r4flq2b","Type":"NodeParagraph","Properties":{"id":"20250815154150-r4flq2b","updated":"20250815154150"},"Children":[{"Type":"NodeText","Data":"等等"}]},{"ID":"20250815154221-4m7jqjw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250815154221-4m7jqjw","updated":"20250829133822"},"Children":[{"Type":"NodeText","Data":"Memory 中各参数功能的含义和作用"}]},{"ID":"20250828194520-4m9yoah","Type":"NodeBlockquote","Properties":{"id":"20250828194520-4m9yoah","updated":"20250828200513"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250828194520-i7i625q","Type":"NodeParagraph","Properties":{"id":"20250828194520-i7i625q","updated":"20250828200513"},"Children":[{"Type":"NodeText","Data":"注：如果你的工程内安装了 Memory Profiler Package 这个包，那么下方 Simple 显示的内容会有所不同\n这里演示的是未安装 Memory Profiler Package 的情况，关于 Memory Profiler Package 会在后续阐述 ——\u003e "},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250828200427-ljck1t6","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"UPL2-6——Memory Profiler Package"}]}]},{"ID":"20250815155056-pgz1k1n","Type":"NodeParagraph","Properties":{"id":"20250815155056-pgz1k1n","updated":"20250828194517"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250828194517-kkpbhou.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250815154505-4a859lf","Type":"NodeList","ListData":{},"Properties":{"id":"20250815154505-4a859lf","updated":"20250829133822"},"Children":[{"ID":"20250815154505-brl81l5","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250815154505-brl81l5","updated":"20250815155638"},"Children":[{"ID":"20250815154505-1lwc7qy","Type":"NodeParagraph","Properties":{"id":"20250815154505-1lwc7qy","updated":"20250828194846"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Memory（内存）分析窗口 在这里显示有关内存的相关统计信息"}]},{"ID":"20250815155216-hu4ds1u","Type":"NodeParagraph","Properties":{"id":"20250815155216-hu4ds1u","updated":"20250815155218"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250815155218-gufjp26.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250815155217-96gsoo5","Type":"NodeList","ListData":{},"Properties":{"id":"20250815155217-96gsoo5","updated":"20250815155638"},"Chi