":"20250828194945"},"Children":[{"Type":"NodeText","Data":"它可以帮助我们："}]},{"ID":"20250828194946-ruzphg3","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250828194946-ruzphg3","updated":"20250828194947"},"Children":[{"ID":"20250828194947-r9y01ra","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250828194947-r9y01ra","updated":"20250828194947"},"Children":[{"ID":"20250828194947-j7y7lud","Type":"NodeParagraph","Properties":{"id":"20250828194947-j7y7lud","updated":"20250828194947"},"Children":[{"Type":"NodeText","Data":"看懂 Unity 总共用了多少内存"}]}]},{"ID":"20250828194950-1xty60z","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250828194950-1xty60z","updated":"20250828194950"},"Children":[{"ID":"20250828194950-yvnp1v9","Type":"NodeParagraph","Properties":{"id":"20250828194950-yvnp1v9","updated":"20250828194950"},"Children":[{"Type":"NodeText","Data":"哪些资源类型是主要的内存消耗者"}]}]},{"ID":"20250828194954-2qlqo89","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250828194954-2qlqo89","updated":"20250828194954"},"Children":[{"ID":"20250828194954-9kycvno","Type":"NodeParagraph","Properties":{"id":"20250828194954-9kycvno","updated":"20250828194954"},"Children":[{"Type":"NodeText","Data":"GC 是否活跃（有没有频繁分配）"}]}]},{"ID":"20250828194957-kglek5n","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250828194957-kglek5n","updated":"20250828194957"},"Children":[{"ID":"20250828194957-wj38hv6","Type":"NodeParagraph","Properties":{"id":"20250828194957-wj38hv6","updated":"20250828195012"},"Children":[{"Type":"NodeText","Data":"是否存在异常占用（比如 Profiler 本身占用过大）"}]}]}]},{"ID":"20250828195012-mnkuw2n","Type":"NodeParagraph","Properties":{"id":"20250828195012-mnkuw2n","updated":"20250828195019"},"Children":[{"Type":"NodeText","Data":"等等"}]},{"ID":"20250828200336-81kmwf3","Type":"NodeBlockquote","Properties":{"id":"20250828200336-81kmwf3","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20250829133822"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250828200337-z5n5ofg","Type":"NodeParagraph","Properties":{"id":"20250828200337-z5n5ofg","updated":"20250829133822"},"Children":[{"Type":"NodeText","Data":"注意： 对于空场景都有 Textures、Meshs 等对象的分配和内存占用\n这是因为 Unity 即使是空场景，也会默认加载一些内建资源，\n比如内置字体、编辑器用到的各种图标、GUI 样式、Gizmos 相关资源、Profiler 自己的资源，这些内容其实不属于你的游戏资源"}]}]},{"ID":"20250828195006-0t6u2e2","Type":"NodeParagraph","Properties":{"id":"20250828195006-0t6u2e2","updated":"20250828195032"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250828195032-0jmcz39.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250815154505-g6vcvlv","Type":"NodeList","ListData":{},"Properties":{"id":"20250815154505-g6vcvlv","updated":"20250828200221"},"Children":[{"ID":"20250815154505-ic5umwb","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250815154505-ic5umwb","updated":"20250815154505"},"Children":[{"ID":"20250815154505-vhr24p3","Type":"NodeParagraph","Properties":{"id":"20250815154505-vhr24p3","updated":"20250828195322"},"Children":[{"Type":"NodeText","Data":"Normalized（规范化）： 将所有帧的内存占用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"按相同的最大值"},{"Type":"NodeText","Data":"进行统一缩放显示"}]},{"ID":"20250828195112-f9br8ti","Type":"NodeParagraph","Properties":{"id":"20250828195112-f9br8ti","updated":"20250828195128"},"Children":[{"Type":"NodeText","Data":"这样你可以更直观地比较多帧之间各类内存（比如贴图、堆内存、Profiler、Audio 等）的占用比例变化\n未勾选时，各帧是按自己的比例显示的，视觉对比就不太直观了\n勾选后可以帮助我们分析内存是否稳定，对比 不同类型资源的内存占比变化，从而查找 内存激增、泄漏等问题"}]}]},{"ID":"20250815154505-2uoy3do","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250815154505-2uoy3do","updated":"20250815154505"},"Children":[{"ID":"20250815154505-e3df3cj","Type":"NodeParagraph","Properties":{"id":"20250815154505-e3df3cj","updated":"20250828195714"},"Children":[{"Type":"NodeText","Data":"Total Committed Memory（总提交内存）： 表示 Unity 总共已分配的内存（虚拟内存），包括系统预留 + 实际使用"}]},{"ID":"20250828195836-sh1wnla","Type":"NodeParagraph","Properties":{"id":"20250828195836-sh1wnla","updated":"20250828195850"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250828195850-588uqtb.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250828195714-bqavouq","Type":"NodeParagraph","Properties":{"id":"20250828195714-bqavouq","updated":"20250828195725"},"Children":[{"Type":"NodeText","Data":"即 Unity 请求了多少内存资源，无论是否真正用了"}]},{"ID":"20250828195728-anaqt1v","Type":"NodeList","ListData":{},"Properties":{"id":"20250828195728-anaqt1v","updated":"20250828195728"},"Children":[{"ID":"20250828195726-c4uopsv","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250828195726-c4uopsv","updated":"20250828195726"},"Children":[{"ID":"20250828195726-t7i5td5","Type":"NodeParagraph","Properties":{"id":"20250828195726-t7i5td5","updated":"20250828195804"},"Children":[{"Type":"NodeText","Data":"Tracked Memory（跟踪的内存）： Unity 能追踪的内存（即 Memory Profiler 能看见的部分）包括 托管堆内存、图形资源、音视频等等"}]},{"ID":"20250828195755-ag6p0d3","Type":"NodeList","ListData":{},"Properties":{"id":"20250828195755-ag6p0d3","updated":"20250828195755"},"Children":[{"ID":"20250828195754-6mqdthh","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"2025