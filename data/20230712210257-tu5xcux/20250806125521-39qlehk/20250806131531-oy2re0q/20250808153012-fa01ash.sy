","updated":"20250808165734"},"Children":[{"ID":"20250808153449-0exyjuy","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250808153449-0exyjuy","updated":"20250808165712"},"Children":[{"ID":"20250808153449-bv4t617","Type":"NodeParagraph","Properties":{"id":"20250808153449-bv4t617","updated":"20250808153452"},"Children":[{"Type":"NodeText","Data":"找 CPU 性能瓶颈"}]},{"ID":"20250808153450-u45ervg","Type":"NodeParagraph","Properties":{"id":"20250808153450-u45ervg","updated":"20250808165712"},"Children":[{"Type":"NodeText","Data":"查看每帧中哪个模块耗时异常（TimeLine 颜色块明显突起），快速定位卡顿来源，哪帧卡了、哪个模块卡了"}]}]},{"ID":"20250808153449-gxf67lc","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250808153449-gxf67lc","updated":"20250808165719"},"Children":[{"ID":"20250808153449-lynlr3y","Type":"NodeParagraph","Properties":{"id":"20250808153449-lynlr3y","updated":"20250808153449"},"Children":[{"Type":"NodeText","Data":"找性能抖动"}]},{"ID":"20250808153455-libxbz9","Type":"NodeParagraph","Properties":{"id":"20250808153455-libxbz9","updated":"20250808165719"},"Children":[{"Type":"NodeText","Data":"检查 GC 是否频繁（黄色峰值），还是某个帧的脚本逻辑执行消耗过大（蓝色占比高）"}]}]},{"ID":"20250808153449-k10r33j","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250808153449-k10r33j","updated":"20250808165734"},"Children":[{"ID":"20250808153449-vmfli1l","Type":"NodeParagraph","Properties":{"id":"20250808153449-vmfli1l","updated":"20250808153449"},"Children":[{"Type":"NodeText","Data":"找优化依据"}]},{"ID":"20250808153457-zavqwy7","Type":"NodeParagraph","Properties":{"id":"20250808153457-zavqwy7","updated":"20250808165734"},"Children":[{"Type":"NodeText","Data":"明确是脚本、渲染、物理还是 VSync（垂直同步）等模块引起的卡顿"}]}]},{"ID":"20250808153449-madbban","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250808153449-madbban","updated":"20250808153502"},"Children":[{"ID":"20250808153449-wddzxfc","Type":"NodeParagraph","Properties":{"id":"20250808153449-wddzxfc","updated":"20250808153449"},"Children":[{"Type":"NodeText","Data":"帧率诊断"}]},{"ID":"20250808153459-sn6vvwz","Type":"NodeParagraph","Properties":{"id":"20250808153459-sn6vvwz","updated":"20250808153502"},"Children":[{"Type":"NodeText","Data":"对比 16ms（60FPS）/ 33ms（30FPS） 标尺，判断是否达标"}]}]}]},{"ID":"20250808153509-jk9zlrc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250808153509-jk9zlrc","name":"QualitySettings.vSyncCount","updated":"20250915195114"},"Children":[{"Type":"NodeText","Data":"垂直同步"}]},{"ID":"20250808153519-l23h9vc","Type":"NodeParagraph","Properties":{"id":"20250808153519-l23h9vc","updated":"20250808154302"},"Children":[{"Type":"NodeText","Data":"显示器通常以固定的频率刷新画面（如 60Hz 表示每秒刷新 60 次，每帧 16.67ms），而显卡渲染图像的速度通常不固定，有时快于显示器刷新，有时慢于显示器刷新\n这种差异，尤其是高帧率情况下可能导致画面出现撕裂异常，而垂直同步可以通过限制显卡来避免这种情况"}]},{"ID":"20250915194748-4e0sn24","Type":"NodeParagraph","Properties":{"id":"20250915194748-4e0sn24","updated":"20250915195114"},"Children":[{"Type":"NodeText","Data":"关于垂直同步带来的问题，详细可见："},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250915194759-rthbpbk","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"UPL4-4——垂直同步带来的等待问题"}]},{"ID":"20250808153717-rbbj7fn","Type":"NodeParagraph","Properties":{"id":"20250808153717-rbbj7fn","updated":"20250808153717"},"Children":[{"Type":"NodeText","Data":"垂直同步（VSync）会强制显卡："}]},{"ID":"20250808153616-jbfjyhs","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250808153616-jbfjyhs","updated":"20250808153616"},"Children":[{"ID":"20250808153616-macz6a1","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250808153616-macz6a1","updated":"20250808153616"},"Children":[{"ID":"20250808153616-8ht5gju","Type":"NodeParagraph","Properties":{"id":"20250808153616-8ht5gju","updated":"20250808153616"},"Children":[{"Type":"NodeText","Data":"等显示器准备好再提交新帧（即等一次“垂直回扫”信号），避免屏幕撕裂"}]}]},{"ID":"20250808153616-0wgm0kj","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250808153616-0wgm0kj","updated":"20250808153616"},"Children":[{"ID":"20250808153616-n3emuci","Type":"NodeParagraph","Properties":{"id":"20250808153616-n3emuci","updated":"20250808153616"},"Children":[{"Type":"NodeText","Data":"如果显卡渲染太快，它要等一等"}]}]},{"ID":"20250808153616-xhf09um","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250808153616-xhf09um","updated":"20250808153616"},"Children":[{"ID":"20250808153616-v4qv3fj","Type":"NodeParagraph","Properties":{"id":"20250808153616-v4qv3fj","updated":"20250808153616"},"Children":[{"Type":"NodeText","Data":"如果渲染太慢，它只能跳过一帧，延后一轮提交"}]}]}]},{"ID":"20250808153614-zlyt4et","Type":"NodeParagraph","Properties":{"id":"20250808153614-zlyt4et","updated":"20250808153635"},"Children":[{"Type":"NodeText","Data":"影响帧率主要有两种情况："}]},{"ID":"20250808153635-k7p4axj","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250808153635-k7p4axj","updated":"20250808153657"},"Children":[{"ID":"20250808153635-u82j982","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250808153635-u82j982","updated":"20250808153635"},"Children":[{"ID":"20250808153635-bqpd8si","Type":"NodeParagraph","Properties":{"id":"20250808153635-bqpd8si","updated":"20250808153639"},"Children":[{"Type":"NodeText","Data":"帧率略高于刷新率 → 强制等待"}]},{"ID":"20250808153642-r2940vl","Type":"NodeParagraph","Properties":{"id":"20250808153642-r2940vl","updated":"20250808153642"},"Children":[{"Type":"NodeText","Data":"比如显卡渲染能力是 90FPS，而显示器是 60Hz；VSync 开启后，GPU 只能 每 16.67ms 渲一帧 → 被“卡”在 60FPS"}]}]},{"ID":"20250808153635-itx1ay3","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250808153635-itx1ay3","updated":"20250808153657"},"Children":[{"ID":"20250808153635-fsn3pwc","Type":"NodeParagraph","Properties":{"id":"20250808153635-fsn3pwc","updated":"20250808153635"},"Children":[{"Type":"NodeText","Data":"帧率低于刷新率 → 被“降档”处理"}]},{"ID":"20250808153644-t1fwndc","Type":"NodeParagraph","Properties":{"id":"20250808153644-t1fwndc","updated":"20250808153657"},"Children":[{"Type":"NodeText","Data":"比如显卡当前只能 50FPS，VSync 要求必须整除刷新频率，于是 GPU 被 “降档” 到 30FPS（60Hz ÷ 2），这会造成严重卡顿或掉帧感"}]}]}]},{"ID":"20250808153519-xxd4259","Type":"NodeParagraph","Properties":{"id":"20250808153519-xxd4259","updated":"20250808154415"},"Children":[{"Type":"NodeText","Data":"垂直同步何时开关"}]},{"ID":"20250808153910-f1jyqco","Type":"NodeList","ListData":{},"Properties":{"id":"20250808153910-f1jyqco","updated":"20250808153915"},"Children":[{"ID":"20250808153910-rnnq4oe","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250808153910-rnnq4oe","updated":"20250808153910"},"Children":[{"ID":"20250808153910-faal668","Type":"NodeParagraph","Properties":{"id":"20250808153910-faal668","updated":"20250808153910"},"Children":[{"Type":"NodeText","Data":"开发调试时：通常关闭 VSync 观察真实的 GPU 性能瓶颈"}]}]},{"ID":"20250808153911-0up603a","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250808153911-0up603a","updated":"20250808153911"},"Children":[{"ID":"20250808153911-ajxfly5","Type":"NodeParagraph","Properties":{"id":"20250808153911-ajxfly5","updated":"20250808153911"},"Children":[{"Type":"NodeText","Data":"低端机运行卡顿时：关闭 VSync 可减少帧率锁死卡顿"}]}]},{"ID":"20250808153912-6ssqo7o","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250808153912-6ssqo7o","updated":"20250808153915"},"Children":[{"ID":"20250808153912-7uogtvs","Type":"NodeParagraph","Properties":{"id":"20250808153912-7uogtvs","updated":"20250808153915"},"Children":[{"Type":"NodeText","Data":"正式发包时：一般开启 VSync 防止撕裂（尤其是主机或高帧率设备），或者交给玩家在设置中进行设置"}]}]}]},{"ID":"20250808153519-7rh7bln","Type":"NodeParagraph","Properties":{"id":"20250808153519-7rh7bln","updated":"202508081544