:"NodeText","Data":"Animation：花费多少时间处理动画相关，比如带有蒙皮网格渲染器（Skinned Mesh Renderers）、Animation、Animator 等等和动画相关的组件"}]}]},{"ID":"20250808154927-pmmdbgs","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250808154927-pmmdbgs","updated":"20250808154927"},"Children":[{"ID":"20250808154927-17mzewr","Type":"NodeParagraph","Properties":{"id":"20250808154927-17mzewr","updated":"20250808154927"},"Children":[{"Type":"NodeText","Data":"GarbageCollector：花费多少时间处理GC（垃圾回收），即GC 垃圾回收造成的性能抖动"}]}]},{"ID":"20250808154927-0w8aq1g","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250808154927-0w8aq1g","updated":"20250808154927"},"Children":[{"ID":"20250808154927-8maps0j","Type":"NodeParagraph","Properties":{"id":"20250808154927-8maps0j","updated":"20250808155244"},"Children":[{"Type":"NodeText","Data":"VSync：花费多少时间等待"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250808153509-jk9zlrc","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"垂直同步"},{"Type":"NodeText","Data":"完成（可能会造成卡帧）"}]}]},{"ID":"20250808154927-1ehvlmf","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250808154927-1ehvlmf","updated":"20250808154927"},"Children":[{"ID":"20250808154927-1spag21","Type":"NodeParagraph","Properties":{"id":"20250808154927-1spag21","updated":"20250808154927"},"Children":[{"Type":"NodeText","Data":"Global ILLumination：花费多少时间来处理实时全局光照"}]}]},{"ID":"20250808154927-co4tnvl","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250808154927-co4tnvl","updated":"20250808154927"},"Children":[{"ID":"20250808154927-r8577jq","Type":"NodeParagraph","Properties":{"id":"20250808154927-r8577jq","updated":"20250808155610"},"Children":[{"Type":"NodeText","Data":"UI：花费多少时间来处理UI相关，比如 Canvas 更新、重建、批处理等 UI 绘制任务"}]}]},{"ID":"20250808154927-qck10qh","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250808154