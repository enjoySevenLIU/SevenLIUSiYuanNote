e":"NodeParagraph","Properties":{"id":"20250903202940-ufzwjqz","updated":"20250903202940"},"Children":[{"Type":"NodeText","Data":"表示本帧中为满足渲染需要，实际从磁盘中读取了多少 tile 资源，用于评估磁盘 I/O 开销和加载时延迟风险。"}]}]}]}]},{"ID":"20250903202427-4cfvidq","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250903202427-4cfvidq","updated":"20250903203229"},"Children":[{"ID":"20250903202948-hhbv3cu","Type":"NodeParagraph","Properties":{"id":"20250903202948-hhbv3cu","updated":"20250903203229"},"Children":[{"Type":"NodeText","Data":"Per Cache Statistics（各个缓存统计面板）"}]},{"ID":"20250903203012-xtava87","Type":"NodeParagraph","Properties":{"id":"20250903203012-xtava87","updated":"20250903203013"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250903203013-yhrxp3m.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250903203012-lk2xl42","Type":"NodeList","ListData":{},"Properties":{"id":"20250903203012-lk2xl42","updated":"20250903203012"},"Children":[{"ID":"20250903202427-xt44q2j","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250903202427-xt44q2j","updated":"20250903202427"},"Children":[{"ID":"20250903202427-khiln0e","Type":"NodeParagraph","Properties":{"id":"20250903202427-khiln0e","updated":"20250903203044"},"Children":[{"Type":"NodeText","Data":"Cache Format：缓存格式，表示此缓存存储的 tile 格式类型（如 R8、BC7、RGBA32 等）"}]},{"ID":"20250903203048-scbsaia","Type":"NodeParagraph","Properties":{"id":"20250903203048-scbsaia","updated":"20250903203048"},"Children":[{"Type":"NodeText","Data":"用于区分不同类型的纹理 tile 格式，每种格式会有独立的缓存池，利于资源管理与调优"}]}]},{"ID":"20250903202427-lexdofb","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250903202427-lexdofb","updated":"20250903202427"},"Children":[{"ID":"20250903202427-gyft64i","Type":"NodeParagraph","Properties":{"id":"20250903202427-gyft64i","updated":"20250903202427"},"Children":[{"Type":"NodeText","Data":"Demand： 当前帧对该格式的 tile 请求数量（即需要多少个 tile）"}]},{"ID":"20250903203051-8qwnf8c","Type":"NodeParagraph","Properties":{"id":"20250903203051-8qwnf8c","updated":"20250903203051"},"Children":[{"Type":"NodeText","Data":"评估当前帧该格式 tile 的使用强度，帮助判断某些格式是否过多使用或分配不均。"}]}]},{"ID":"20250903202427-1pbzoqs","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250903202427-1pbzoqs","updated":"20250903202427"},"Children":[{"ID":"20250903202427-6qgqj8k","Type":"NodeParagraph","Properties":{"id":"20250903202427-6qgqj8k","updated":"20250903202427"},"Children":[{"Type":"NodeText","Data":"Bias： 当前格式的最大 Mip 偏移（Mip Bias）"}]},{"ID":"20250903203055-kzgdsru","Type":"NodeParagraph","Properties":{"id":"20250903203055-kzgdsru","updated":"20250903203055"},"Children":[{"Type":"NodeText","Data":"用于反映系统为了满足性能而对该格式使用的降级渲染程度（越高表示画质越低，越模糊）。"}]}]},{"ID":"20250903202427-f1xrkpf","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250903202427-f1xrkpf","updated":"20250903202427"},"Children":[{"ID":"20250903202427-f8hu3im","Type":"NodeParagraph","Properties":{"id":"20250903202427-f8hu3im","updated":"20250903202427"},"Children":[{"Type":"NodeText","Data":"Size： 当前该格式 tile 占用的缓存大小（字节）"}]},{"ID":"20250903203058-xz49brn","Type":"NodeParagraph","Properties":{"id":"20250903203058-xz49brn","updated":"20250903203058"},"Children":[{"Type":"NodeText","Data":"用于评估该格式纹理实际占用的缓存空间，帮助优化内存分配策略或合并格式。"}]}]}]},{"ID":"20250903202427-qv82k4q","Type":"NodeParagraph","Properties":{"id":"20250903202427-qv82k4q","updated":"20250903203110"},"Children":[{"Type":"NodeText","Data":"该面板的信息可以帮助我们："}]},{"ID":"20250903203111-oqzqyz6","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250903203111-oqzqyz6","updated":"20250903203112"},"Children":[{"ID":"20250903203112-d3dhea5","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250903203112-d3dhea5","updated":"20250903203112"},"Children":[{"ID":"20250903203112-o6h5eqw","Type":"NodeParagraph","Properties":{"id":"20250903203112-o6h5eqw","updated":"20250903203112"},"Children":[{"Type":"NodeText","Data":"分析 不同压缩格式或通道数的纹理 tile 占用资源情况"}]}]},{"ID":"20250903203117-132beso","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250903203117-132beso","updated":"20250903203117"},"Children":[{"ID":"20250903203117-ro2rueo","Type":"NodeParagraph","Properties":{"id":"20250903203117-ro2rueo","updated":"20250903203117"},"Children":[{"Type":"NodeText","Data":"判断是否存在 某一格式缓存占用异常高 的情况"}]}]},{"ID":"20250903203120-8ok725x","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250903203120-8ok725x","updated":"20250903203120"},"Children":[{"ID":"20250903203120-j720sh8","Type":"NodeParagraph","Properties":{"id":"20250903203120-j720sh8","updated":"20250903203120"},"Children":[{"Type":"NodeText","Data":"找出因频繁降 mip 而造成画质下降的格式（高 Bias 值）"}]}]},{"ID":"20250903203123-54pjdeo","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250903203123-54pjdeo","updated":"20250903203123"},"Children":[{"ID":"20250903203123-y99p6ye","Type":"NodeParagraph","Properties":{"id":"20250903203123-y99p6ye","updated":"20250903203123"},"Children":[{"Type":"NodeText","Data":"精准调优 虚拟纹理格式分配、Tile Cache 配置"}]}]}]}]}]},{"ID":"20250903201555-nfotbqz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250903201555-nfotbqz","updated":"20250903203146"},"Children":[{"Type":"NodeText","Data":"Virtual Texturing 对于我们的意义"}]},{"ID":"20250903202043-efjz6kq","Type":"NodeParagraph","Properties":{"id":"20250903202043-efjz6kq","updated":"20250903202057"},"Children":[{"Type":"NodeText","Data":"虚拟纹理是一种将超大纹理拆分成小块（tile）并按需加载的技术，VT 模块可以帮助我们"}]},{"ID":"20250903202054-680jdq1","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250903202054-680jdq1","updated":"20250903202054"},"Children":[{"ID":"20250903202054-fm3d7g7","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250903202054-fm3d7g7","updated":"20250903202054"},"Children":[{"ID":"20250903202054-igs8lwb","Type":"NodeParagraph","Properties":{"id":"20250903202054-igs8lwb","updated":"20250903202054"},"Children":[{"Type":"NodeText","Data":"查看请求加载频率"}]},{"ID":"20250903202102-9earqsu","Type":"NodeParagraph","Properties":{"id":"20250903202102-9earqsu","updated":"20250903202103"},"Children":[{"Type":"NodeText","Data":"判断是否有纹理切片加载频繁，可能是摄像机过度抖动、流缓存过小等原因"}]}]},{"ID":"20250903202054-e52pql5","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250903202054-e52pql5","updated":"20250903202054"},"Children":[{"ID":"20250903202054-s5dg0b0","Type":"NodeParagraph","Properties":{"id":"20250903202054-s5dg0b0","updated":"20250903202111"},"Children":[{"Type":"NodeText","Data":"查看 Mip 偏移"}]},{"ID":"20250903202114-kck7akn","Type":"NodeParagraph","Properties":{"id":"20250903202114-kck7akn","updated":"20250903202114"},"Children":[{"Type":"NodeText","Data":"Unity 会在显存压力大时自动提升 Mipmap Level（强制模糊），这个字段越大说明系统在降级纹理质量，以维持性能，可用来检测设备是否出现“低分辨率纹理”退化问题"}]}]},{"ID":"20250903202054-0b0mo2z","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250903202054-0b0mo2z","updated":"20250903202054"},"Children":[{"ID":"20250903202054-dsqkgm0","Type":"NodeParagraph","Properties":{"id":"20250903202054-dsqkgm0","updated":"20250903202054"},"Children":[{"Type":"NodeText","Data":"分析GPU缓存使用大小"}]},{"ID":"20250903202116-b3r9ucb","Type":"NodeParagraph","Properties":{"id":"20250903202116-b3r9ucb","updated":"20250903202116"},"Children":[{"Type":"NodeText","Data":"缓存太小可能导致频繁 tile 加载、画面模糊、带宽压力大\n缓存太大则可能浪费 GPU 显存"}]}]},{"ID":"20250903202054-10unt4t","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250903202054-10unt4t","updated":"20250903202054"},"Children":[{"ID":"20250903202054-2kz1rb2","Type":"NodeParagraph","Properties":{"id":"20250903202054-2kz1rb2","updated":"20250903202054"},"Children":[{"Type":"NodeText","Data":"辅助判断显存压力是否过高"}]}]},{"ID":"20250903202054-m3wo02p","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20250903202054-m3wo02p","updated":"20250903202054"},"Children":[{"ID":"20250903202054-wg4bakd","Type":"NodeParagraph","Properties":{"id":"20250903202054-wg4bakd","updated":"20250903202054"},"Children":[{"Type":"NodeText","Data":"配合其他模块进行综合分析"}]}]}]},{"ID":"20250903202050-7ddqqt0","Type":"NodeParagraph","Properties":{"id":"20250903202050-7ddqqt0","updated":"20250903202050"},"Children":[{"Type":"NodeText","Data":"等等"}]},{"ID":"20250903202043-eold8fq","Type":"NodeParagraph","Properties":{"id":"20250903202043-eold8fq","updated":"20250903202119"},"Children":[{"Type":"NodeText","Data":"总之，VT 模块帮助你诊断虚拟纹理的切片加载状态、缓存使用、模糊原因以及显存是否配置合理\n是排查图片质量与贴图加载性能问题的核心工具之一"}]}]}