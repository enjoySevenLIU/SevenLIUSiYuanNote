15151816"},"Children":[{"ID":"20250815151816-69ovtfg","Type":"NodeParagraph","Properties":{"id":"20250815151816-69ovtfg","updated":"20250815151819"},"Children":[{"Type":"NodeText","Data":"Used Buffers：GPU 缓冲区和内存的总数（包括顶点、索引、计算缓冲区以及渲染所需的所有内部缓冲区）"}]}]},{"ID":"20250815151824-s83ld2q","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250815151824-s83ld2q","updated":"20250815151824"},"Children":[{"ID":"20250815151824-9bxx8a8","Type":"NodeParagraph","Properties":{"id":"20250815151824-9bxx8a8","updated":"20250815151830"},"Children":[{"Type":"NodeText","Data":"Vertex Buffer Upload In Frame：CPU 在该帧上传到 GPU 的几何体数量（顶点、法线、纹理数据）"}]}]},{"ID":"20250815151832-vlmzwfw","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250815151832-vlmzwfw","updated":"20250815151832"},"Children":[{"ID":"20250815151832-tladx4o","Type":"NodeParagraph","Properties":{"id":"20250815151832-tladx4o","updated":"20250815151839"},"Children":[{"Type":"NodeText","Data":"Index Buffer Upload In Frame：CPU 在该帧上传到 GPU 的三角形索引数据"}]}]},{"ID":"20250815151842-mou4nzq","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250815151842-mou4nzq","updated":"20250815151842"},"Children":[{"ID":"20250815151842-rvvb8mc","Type":"NodeParagraph","Properties":{"id":"20250815151842-rvvb8mc","updated":"20250815151855"},"Children":[{"Type":"NodeText","Data":"Shadow Casters：该帧中投射阴影的游戏对象数量。如果一个物体受到多个光源影响，那么每个光源产生的阴影都算在内"}]}]}]},{"ID":"20250815150947-ybtq38w","Type":"NodeParagraph","Properties":{"id":"20250815150947-ybtq38w","updated":"20250815152035"},"Children":[{"Type":"NodeText","Data":"使用建议：着重关注"}]},{"ID":"20250815151909-g4dwc13","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250815151909-g4dwc13","updated":"20250815152206"},"Children":[{"ID":"20250815151912-bb8fbsw","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250815151912-bb8fbsw","updated":"20250815151912"},"Children":[{"ID":"20250815151912-vkbm0dd","Type":"NodeParagraph","Properties":{"id":"20250815151912-vkbm0dd","updated":"20250815152117"},"Children":[{"Type":"NodeText","Data":"Draw Calls 数量"}]},{"ID":"20250815152117-t4wdzix","Type":"NodeParagraph","Properties":{"id":"20250815152117-t4wdzix","updated":"20250815152121"},"Children":[{"Type":"NodeText","Data":"它是 CPU 发给 GPU 的绘制命令数量，如果高了，CPU 开销大、容易成为瓶颈\n优化方向：合批（静态、动态合批、GPU Instancing），材质合并等等"}]}]},{"ID":"20250815151929-gderiic","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250815151929-gderiic","updated":"20250815151929"},"Children":[{"ID":"20250815151929-qluporm","Type":"NodeParagraph","Properties":{"id":"20250815151929-qluporm","updated":"20250815152041"},"Children":[{"Type":"NodeText","Data":"SetPass Calls 数量"}]},{"ID":"20250815152126-7hutxqr","Type":"NodeParagraph","Properties":{"id":"20250815152126-7hutxqr","updated":"20250815152139"},"Children":[{"Type":"NodeText","Data":"它是提交材质或着色器状态的次数，如果高了，GPU 开销大，状态切换频繁，阻碍批处理\n优化方向：减少材质和 Shader 变体 数量，合并材质等"}]}]},{"ID":"20250815151936-3rngn1w","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250815151936-3rngn1w","updated":"20250815151936"},"Children":[{"ID":"20250815151936-rcgm9h1","Type":"NodeParagraph","Properties":{"id":"20250815151936-rcgm9h1","updated":"20250815152045"},"Children":[{"Type":"NodeText","Data":"Batches 数量"}]},{"ID":"20250815152141-yzavhpc","Type":"NodeParagraph","Properties":{"id":"20250815152141-yzavhpc","updated":"20250815152146"},"Children":[{"Type":"NodeText","Data":"它是合批后的实际批次数，理论上越低越好\n可以用来评估合批优化是否生效"}]}]},{"ID":"20250815151942-rcqd0q7","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250815151942-rcqd0q7","updated":"20250815151942"},"Children":[{"ID":"20250815151942-wh2sjg6","Type":"NodeParagraph","Properties":{"id":"20250815151942-wh2sjg6","updated":"20250815152048"},"Children":[{"Type":"NodeText","Data":"Triangles / Vertices 数量"}]},{"ID":"20250815152151-72hrerx","Type":"NodeParagraph","Properties":{"id":"20250815152151-72hrerx","updated":"20250815152156"},"Children":[{"Type":"NodeText","Data":"它是实际渲染的面数和顶点数，特别是移动设备中建议控制在适当范围，比如低端机每帧不超过 50w 三角形，具体看设备"}]}]},{"ID":"20250815151950-5f7qsgc","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20250815151950-5f7qsgc","updated":"20250815152206"},"Children":[{"ID":"20250815151950-42c87sd","Type":"NodeParagraph","Properties":{"id":"20250815151950-42c87sd","updated":"20250815152201"},"Children":[{"Type":"NodeText","Data":"Render Textures"}]},{"ID":"20250815152202-cfmhtrl","Type":"NodeParagraph","Properties":{"id":"20250815152202-cfmhtrl","updated":"20250815152206"},"Children":[{"Type":"NodeText","Data":"它是当前帧中创建的渲染纹理数量和内存，如果高了，意味着内存开销大，频繁切换也会影响性能\n我们应该尽量复用 RenderTexture 减少临时对象创建"}]}]}]},{"ID":"20250815152107-6anpv67","Type":"NodeParagraph","Properties":{"id":"20250815152107-6anpv67","updated":"20250815152108"},"Children":[{"Type":"NodeText","Data":"等等"}]}]}]},{"ID":"20250815150601-utbx9sl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250815150601-utbx9sl","updated":"20250815150649"},"Children":[{"Type":"NodeText","Data":"Rendering 对于我们的意义"}]},{"ID":"20250815150642-ht8eo4r","Type":"NodeParagraph","Properties":{"id":"20250815150642-ht8eo4r","updated":"20250815150653"},"Children":[{"Type":"NodeText","Data":"Rendering 可以帮助我们："}]},{"ID":"20250815150649-szsdwu3","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250815150649-szsdwu3","updated":"20250815150649"},"Children":[{"ID":"20250815150649-q3t2gn5","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250815150649-q3t2gn5","updated":"20250815150649"},"Children":[{"ID":"20250815150649-qjttzgm","Type":"NodeParagraph","Properties":{"id":"20250815150649-qjttzgm","updated":"20250815150701"},"Children":[{"Type":"NodeText","Data":"定位 CPU 渲染压力的关键依据\n批处理次数多，意味着 DrawCall 高，意味着 CPU 消耗高\n材质切换次数，意味着 CPU 频繁设置材质，意味着可能带来批处理失败"}]}]},{"ID":"20250815150649-4b0nxqp","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250815150649-4b0nxqp","updated":"20250815150649"},"Children":[{"ID":"20250815150649-uf0r031","Type":"NodeParagraph","Properties":{"id":"20250815150649-uf0r031","updated":"20250815150704"},"Children":[{"Type":"NodeText","Data":"判断 GPU 处理压力是否过大"}]},{"ID":"20250815150706-hv1j9no","Type":"NodeParagraph","Properties":{"id":"20250815150706-hv1j9no","updated":"20250815150715"},"Children":[{"Type":"NodeText","Data":"三角形面数、顶点数都会直接影响 GPU 渲染耗时\n数据量过大往往是因为模型太复杂，粒子特效过多，动态对象过多"}]}]},{"ID":"20250815150649-fqrtag7","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250815150649-fqrtag7","updated":"20250815150649"},"Children":[{"ID":"20250815150649-h0a48r8","Type":"NodeParagraph","Properties":{"id":"20250815150649-h0a48r8","updated":"20250815150649"},"Children":[{"Type":"NodeText","Data":"判断画面复杂度对性能的影响"}]},{"ID":"20250815150717-r9xfcxu","Type":"NodeParagraph","Properties":{"id":"20250815150717-r9xfcxu","updated":"20250815150717"},"Children":[{"Type":"NodeText","Data":"当进入不同场景、摄像机角度变化、特效显示隐藏\n都可能带来各种数据的变化，这些数据可以让性能下降有据可查"}]}]},{"ID":"20250815150649-acx6udr","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250815150649-acx6udr","updated":"20250815150649"},"Children":[{"ID":"20250815150649-h1gc4y8","Type":"NodeParagraph","Properties":{"id":"20250815150649-h1gc4y8","updated":"20250815150649"},"Children":[{"Type":"NodeText","Data":"分析批处理的策略是否生效"}]},{"ID":"20250815150719-8z4n8e4","Type":"NodeParagraph","Properties":{"id":"20250815150719-8z4n8e4","updated":"20250815150719"},"Children":[{"Type":"NodeText","Data":"看看使用了静态、动态批处理后，批处理参数是否还是很高、"}]}]}]},{"ID":"20250815150645-uz8vxoa","Type":"NodeParagraph","Properties":{"id":"20250815150645-uz8vxoa","updated":"20250815150645"},"Children":[{"Type":"NodeText","Data":"等等"}]}]}