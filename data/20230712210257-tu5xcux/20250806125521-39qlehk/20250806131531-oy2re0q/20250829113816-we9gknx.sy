rties":{"id":"20250901200402-2qkf9gx","updated":"20250901200405"},"Children":[{"Type":"NodeText","Data":"Reset play count on play ：当开始运行或链接到新目标设备时，会重置列表中的数字"}]}]}]}]},{"ID":"20250901195651-46w5tu1","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-46w5tu1","updated":"20250901202202"},"Children":[{"ID":"20250901195651-9a55sue","Type":"NodeParagraph","Properties":{"id":"20250901195651-9a55sue","updated":"20250901195651"},"Children":[{"Type":"NodeText","Data":"下方详细信息"}]},{"ID":"20250901201716-gxcau2y","Type":"NodeParagraph","Properties":{"id":"20250901201716-gxcau2y","updated":"20250901201741"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250901201741-cjyim24.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250901201717-dyfhl7w","Type":"NodeList","ListData":{},"Properties":{"id":"20250901201717-dyfhl7w","updated":"20250901202202"},"Children":[{"ID":"20250901195651-qo2pxjz","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-qo2pxjz","updated":"20250901195651"},"Children":[{"ID":"20250901195651-c29ugaz","Type":"NodeParagraph","Properties":{"id":"20250901195651-c29ugaz","updated":"20250901195651"},"Children":[{"Type":"NodeText","Data":"Object：包含播放音频的音频源的游戏对象"}]}]},{"ID":"20250901195651-te2m6tx","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-te2m6tx","updated":"20250901195651"},"Children":[{"ID":"20250901195651-2137iff","Type":"NodeParagraph","Properties":{"id":"20250901195651-2137iff","updated":"20250901195651"},"Children":[{"Type":"NodeText","Data":"Asset：相应的游戏对象音频源正在播放的音频资源"}]}]},{"ID":"20250901195651-z9kiaca","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-z9kiaca","updated":"20250901195651"},"Children":[{"ID":"20250901195651-8akwo1f","Type":"NodeParagraph","Properties":{"id":"20250901195651-8akwo1f","updated":"20250901195651"},"Children":[{"Type":"NodeText","Data":"Volume：音频源应用于音频的音量。"}]}]},{"ID":"20250901195651-bz3xr8e","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-bz3xr8e","updated":"20250901195651"},"Children":[{"ID":"20250901195651-nej95sb","Type":"NodeParagraph","Properties":{"id":"20250901195651-nej95sb","updated":"20250901201809"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"VU Level：VU Level 显示的是音频音量电平（音量强度），类似于你在混音器上看到的“音量表”"}]},{"ID":"20250901201802-d1szj4m","Type":"NodeParagraph","Properties":{"id":"20250901201802-d1szj4m","updated":"20250901201802"},"Children":[{"Type":"NodeText","Data":"可用于判断：某个音频是否实际在播放、音量是否被设置为非常低、或是否被静音。为0则表示没有声音输出"}]}]},{"ID":"20250901195651-ij479p4","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-ij479p4","updated":"20250901195651"},"Children":[{"ID":"20250901195651-6dtmsef","Type":"NodeParagraph","Properties":{"id":"20250901195651-6dtmsef","updated":"20250901195651"},"Children":[{"Type":"NodeText","Data":"Audibility：音频播放的实际音量级别。 这是音频源的音量与混音器通道应用的其他衰减量之和"}]}]},{"ID":"20250901195651-qwdianb","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-qwdianb","updated":"20250901195651"},"Children":[{"ID":"20250901195651-h2ec6m3","Type":"NodeParagraph","Properties":{"id":"20250901195651-h2ec6m3","updated":"20250901195651"},"Children":[{"Type":"NodeText","Data":"Group：该音频所属的 Audio Mixer Group，即 Unity 中音频的混音分组"}]}]},{"ID":"20250901195651-h1i5qen","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-h1i5qen","updated":"20250901195651"},"Children":[{"ID":"20250901195651-k63a93v","Type":"NodeParagraph","Properties":{"id":"20250901195651-k63a93v","updated":"20250901201822"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Priority：这是 Unity 用于管理音频播放资源（尤其在移动端设备声道有限的情况下）的播放优先级值（范围 0~256，数值越小表示优先级越高）"}]},{"ID":"20250901201817-dijzkaf","Type":"NodeParagraph","Properties":{"id":"20250901201817-dijzkaf","updated":"20250901201817"},"Children":[{"Type":"NodeText","Data":"如果你发现某些音效“播放失败”或“被打断”，查看是否优先级过低。如果值高于128，容易被系统剔除"}]}]},{"ID":"20250901195651-fqj7ps5","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-fqj7ps5","updated":"20250901195651"},"Children":[{"ID":"20250901195651-18b6wfy","Type":"NodeParagraph","Properties":{"id":"20250901195651-18b6wfy","updated":"20250901195651"},"Children":[{"Type":"NodeText","Data":"Playes：Unity 播放音频的次数。"}]}]},{"ID":"20250901195651-6kmvmkr","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-6kmvmkr","updated":"20250901195651"},"Children":[{"ID":"20250901195651-ye9h6j3","Type":"NodeParagraph","Properties":{"id":"20250901195651-ye9h6j3","updated":"20250901195651"},"Children":[{"Type":"NodeText","Data":"Paused：如果音频在此帧中暂停，则显示 YES"}]}]},{"ID":"20250901195651-7bxd64s","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-7bxd64s","updated":"20250901195651"},"Children":[{"ID":"20250901195651-8lf71ei","Type":"NodeParagraph","Properties":{"id":"20250901195651-8lf71ei","updated":"20250901195651"},"Children":[{"Type":"NodeText","Data":"Muted：如果音频在此帧中已静音，则显示 YES"}]}]},{"ID":"20250901195651-koy98dy","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-koy98dy","updated":"20250901202202"},"Children":[{"ID":"20250901195651-uwk4lgj","Type":"NodeParagraph","Properties":{"id":"20250901195651-uwk4lgj","updated":"20250901202038"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Virtual：如果音频由于达到 Max Real Voice Count（最大真实语音数）而暂停，则显示 YES"}]},{"ID":"20250901201902-r5ch8u3","Type":"NodeParagraph","Properties":{"id":"20250901201902-r5ch8u3","updated":"20250901202202"},"Children":[{"Type":"NodeText","Data":"其中 Max Real Voice Count 可以设置 Unity 同时播放的音频源的最大数量，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"可以在音频项目设置 (Audio Project Settings) 中设置此属性"},{"Type":"NodeText","Data":"\n如果此处显示 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"true"},{"Type":"NodeText","Data":"​，则 Unity 会对该帧中具有更高可听度或优先级的其他音频设置更高优先级。\n虚拟化后，音频不会被播放"}]},{"ID":"20250901202100-rtz7a2z","Type":"NodeParagraph","Properties":{"id":"20250901202100-rtz7a2z","updated":"20250901202141"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250901202141-tr41okp.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20250901195651-n3qqqp6","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-n3qqqp6","updated":"20250901195651"},"Children":[{"ID":"20250901195651-ynx1sb7","Type":"NodeParagraph","Properties":{"id":"20250901195651-ynx1sb7","updated":"20250901201924"},"Children":[{"Type":"NodeText","Data":"OneShot：如果 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AudioSource.PlayOneShot()"},{"Type":"NodeText","Data":"​ 播放了音频，则显示 YES。"}]}]},{"ID":"20250901195651-67max41","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-67max41","updated":"20250901195651"},"Children":[{"ID":"20250901195651-bglsv7i","Type":"NodeParagraph","Properties":{"id":"20250901195651-bglsv7i","updated":"20250901201940"},"Children":[{"Type":"NodeText","Data":"Looped：如果 "},{"Type":"NodeTextMark","TextMarkType":"code block-ref","TextMarkBlockRefID":"20230710013331-si86ed5","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"AudioSource.Play()"},{"Type":"NodeText","Data":"​ 播放了音频，则显示 YES。"}]}]},{"ID":"20250901195651-d0wqbsc","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-d0wqbsc","updated":"20250901195651"},"Children":[{"ID":"20250901195651-icd1nfm","Type":"NodeParagraph","Properties":{"id":"20250901195651-icd1nfm","updated":"20250901202010"},"Children":[{"Type":"NodeText","Data":"Distance：音频源到音频监听器 ("},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AudioListener"},{"Type":"NodeText","Data":"​) 的距离。"}]}]},{"ID":"20250901195651-bnyepq6","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-bnyepq6","updated":"20250901195651"},"Children":[{"ID":"20250901195651-aw7v3t7","Type":"NodeParagraph","Properties":{"id":"20250901195651-aw7v3t7","updated":"20250901195651"},"Children":[{"Type":"NodeText","Data":"MinDist：音频源曲线编辑器中定义的最小距离。此参数在音频周围定义一个球形区域；在该区域中，音量保持在恒定水平。"}]}]},{"ID":"20250901195651-xqu2tq7","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-xqu2tq7","updated":"20250901195651"},"Children":[{"ID":"20250901195651-269nhdh","Type":"NodeParagraph","Properties":{"id":"20250901195651-269nhdh","updated":"20250901195651"},"Children":[{"Type":"NodeText","Data":"MaxDist：音频源曲线编辑器中定义的最大距离。此参数在音频周围定义一个球形区域；在该区域外，音量保持在恒定水平。"}]}]},{"ID":"20250901195651-aw9izsu","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-aw9izsu","updated":"20250901195651"},"Children":[{"ID":"20250901195651-0x6qa2q","Type":"NodeParagraph","Properties":{"id":"20250901195651-0x6qa2q","updated":"20250901195651"},"Children":[{"Type":"NodeText","Data":"Time：音频播放中的当前相对时间。音频暂停播放时，此时间也会停止。"}]}]},{"ID":"20250901195651-itj7psq","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250901195651-itj7psq","updat