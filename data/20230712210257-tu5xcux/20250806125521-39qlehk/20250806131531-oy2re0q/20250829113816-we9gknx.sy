agraph","Properties":{"id":"20250829114108-vpbc3li","updated":"20250829114108"},"Children":[{"Type":"NodeText","Data":"这对音频逻辑正确性、音效设计、平台兼容性都至关重要"}]},{"ID":"20250829114102-jmt1iip","Type":"NodeParagraph","Properties":{"id":"20250829114102-jmt1iip","updated":"20250829114106"},"Children":[{"Type":"NodeText","Data":"我们可以通过它定位音频相关的性能问题"}]},{"ID":"20250829114106-my7n6yw","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250829114106-my7n6yw","updated":"20250829114106"},"Children":[{"ID":"20250829114106-p95u0yt","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250829114106-p95u0yt","updated":"20250829114106"},"Children":[{"ID":"20250829114106-c4ijy0s","Type":"NodeParagraph","Properties":{"id":"20250829114106-c4ijy0s","updated":"20250829114106"},"Children":[{"Type":"NodeText","Data":"声音卡顿、延迟：可以着重查看 DSP CPU 是否过高，音频处理性能不足"}]}]},{"ID":"20250829114106-sfdey36","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250829114106-sfdey36","updated":"20250829114106"},"Children":[{"ID":"20250829114106-9aru2fw","Type":"NodeParagraph","Properties":{"id":"20250829114106-9aru2fw","updated":"20250829114106"},"Children":[{"Type":"NodeText","Data":"声音播放失败：检查 Playing Audio Sources（播放音频源）数量，是否达到系统上限"}]}]},{"ID":"20250829114106-bnw1j41","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250829114106-bnw1j41","updated":"20250829114106"},"Children":[{"ID":"20250829114106-6fh83wk","Type":"NodeParagraph","Properties":{"id":"20250829114106-6fh83wk","updated":"20250829114106"},"Children":[{"Type":"NodeText","Data":"音频加载慢：查看 Streaming Load Time（流式加载），确认是否未预加载"}]}]},{"ID":"20250829114106-vbf4hg2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250829114106-vbf4hg2","updated":"20250829114106"},"Children":[{"ID":"20250829114106-vwb86op","Type":"NodeParagraph","Properties":{"id":"202