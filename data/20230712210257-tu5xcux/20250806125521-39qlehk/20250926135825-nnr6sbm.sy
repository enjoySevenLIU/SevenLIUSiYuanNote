{"ID":"20250926135825-nnr6sbm","Spec":"1","Type":"NodeDocument","Properties":{"id":"20250926135825-nnr6sbm","title":"UPL7——物理引擎相关","type":"doc","updated":"20251031162713"},"Children":[{"ID":"20250926152325-tzxfbxi","Type":"NodeBlockquote","Properties":{"id":"20250926152325-tzxfbxi","updated":"20250926152416"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250926152326-q91ynpi","Type":"NodeParagraph","Properties":{"id":"20250926152326-q91ynpi","updated":"20250926152416"},"Children":[{"Type":"NodeText","Data":"物理相关性能分析详见："},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250902195926-0tkhu1p","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"UPL2-9——Physics 模块"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250902203726-7d6vy2m","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"UPL2-10——Physics (2D) 模块"}]}]},{"ID":"20250926135825-e20ov2w","Type":"NodeList","ListData":{},"Properties":{"id":"20250926135825-e20ov2w","updated":"20251031162713"},"Children":[{"ID":"20250926140026-pcb3izz","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250926140026-pcb3izz","updated":"20250926152318"},"Children":[{"ID":"20250926140026-0yfcywh","Type":"NodeParagraph","Properties":{"id":"20250926140026-0yfcywh","updated":"20250926152318"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250926140143-gbayc1h","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"Physics Debugger"},{"Type":"NodeText","Data":"（物理系统可视化调试工具，主要观察碰撞表现信息，而不是性能分析）"}]}]},{"ID":"20250926140035-t4g5o5b","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250926140035-t4g5o5b","updated":"20251031162355"},"Children":[{"ID":"20250926140035-ydwukd8","Type":"NodeParagraph","Properties":{"id":"20250926140035-ydwukd8","updated":"20250926140049"},"Children":[{"Type":"NodeText","Data":"工作机制相关"}]},{"ID":"20250926151515-fijcslm","Type":"NodeList","ListData":{},"Properties":{"id":"20250926151515-fijcslm","updated":"20251031162355"},"Children":[{"ID":"20250926151515-01k03a1","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250926151515-01k03a1","updated":"20251031162149"},"Children":[{"ID":"20250926151515-efh1zm0","Type":"NodeParagraph","Properties":{"id":"20250926151515-efh1zm0","updated":"20251031162149"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250926153348-m04qffc","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"时间步长和最大允许时间步长"},{"Type":"NodeText","Data":"（物理世界的更新间隔时间相关）"}]}]},{"ID":"20250926152132-6mqewc5","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250926152132-6mqewc5","updated":"20251031162253"},"Children":[{"ID":"20250926152132-vym49es","Type":"NodeParagraph","Properties":{"id":"20250926152132-vym49es","updated":"20251031162253"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20251009111152-26uqqgj","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"碰撞层矩阵"},{"Type":"NodeText","Data":"（控制基于层的物理碰撞，可以将两个不可能发生物理碰撞的层的物理碰撞勾选给取消掉）"}]}]},{"ID":"20250926152142-pbmoxxt","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250926152142-pbmoxxt","updated":"20251031162355"},"Children":[{"ID":"20250926152142-y080p6n","Type":"NodeParagraph","Properties":{"id":"20250926152142-y080p6n","updated":"20251031162355"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20251009111931-1jlsds4","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"物理系统基础设置"},{"Type":"NodeText","Data":"（包括解算器，碰撞检测，模拟模式等设置相关，包含 2D 和 3D 物理相关的各个全局设置项）"}]}]}]}]},{"ID":"20250926140049-ffdjxg0","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250926140049-ffdjxg0","updated":"20251031162652"},"Children":[{"ID":"20250926140049-ay6ekf9","