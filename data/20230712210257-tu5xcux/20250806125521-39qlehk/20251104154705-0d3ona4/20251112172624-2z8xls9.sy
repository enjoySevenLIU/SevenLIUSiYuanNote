{"ID":"20251112172624-2z8xls9","Spec":"1","Type":"NodeDocument","Properties":{"id":"20251112172624-2z8xls9","title":"UPL9-12——阴影质量","type":"doc","updated":"20251113101851"},"Children":[{"ID":"20251112172624-0335x5x","Type":"NodeBlockquote","Properties":{"id":"20251112172624-0335x5x","updated":"20251112172729"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251112172704-0xpmcx1","Type":"NodeParagraph","Properties":{"id":"20251112172704-0xpmcx1","updated":"20251112172707"},"Children":[{"Type":"NodeText","Data":"前置知识："}]},{"ID":"20251112172707-53to31z","Type":"NodeList","ListData":{},"Properties":{"id":"20251112172707-53to31z","updated":"20251112172729"},"Children":[{"ID":"20251112172709-96crplw","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112172709-96crplw","updated":"20251112172709"},"Children":[{"ID":"20251112172709-zzpe3v1","Type":"NodeParagraph","Properties":{"id":"20251112172709-zzpe3v1","updated":"20251112172722"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20241203123734-ash1spv","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"US3S6L1——阴影的基本原理"}]}]},{"ID":"20251112172723-dm8ijnz","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112172723-dm8ijnz","updated":"20251112172729"},"Children":[{"ID":"20251112172723-bggewu4","Type":"NodeParagraph","Properties":{"id":"20251112172723-bggewu4","updated":"20251112172729"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20241203124904-komok5k","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"US3S6L2——Unity中阴影的实现原理"}]}]}]}]},{"ID":"20251112172732-psajdx1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251112172732-psajdx1","updated":"20251112180905"},"Children":[{"Type":"NodeText","Data":"内置渲染管线设置阴影质量"}]},{"ID":"20251112172841-jdrxlnv","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251112172841-jdrxlnv","updated":"20251112180905"},"Children":[{"Type":"NodeText","Data":"工程设置中的质量设置"}]},{"ID":"20251112173219-tut6vst","Type":"NodeParagraph","Properties":{"id":"20251112173219-tut6vst","updated":"20251112180905"},"Children":[{"Type":"NodeText","Data":"相关设置在 Project Setting —— Quality —— Shadows 中："}]},{"ID":"20251112173356-ijwagdx","Type":"NodeSuperBlock","Properties":{"id":"20251112173356-ijwagdx","updated":"20251112175152"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20251112173251-8m449gb","Type":"NodeParagraph","Properties":{"id":"20251112173251-8m449gb","updated":"20251112173357"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251112173345-wfgqkgi.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251112173353-f3tvd3r","Type":"NodeList","ListData":{},"Properties":{"id":"20251112173353-f3tvd3r","updated":"20251112175152"},"Children":[{"ID":"20251112173353-gymfs3d","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112173353-gymfs3d","updated":"20251112174744"},"Children":[{"ID":"20251112173353-n7656m4","Type":"NodeParagraph","Properties":{"id":"20251112173353-n7656m4","updated":"20251112173419"},"Children":[{"Type":"NodeText","Data":"Shadowmask Mode：遮罩模式"}]},{"ID":"20251112173431-5gr07q2","Type":"NodeParagraph","Properties":{"id":"20251112173431-5gr07q2","updated":"20251112173432"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251112173432-4a72nk5.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251112173413-f6mp0d9","Type":"NodeList","ListData":{},"Properties":{"id":"20251112173413-f6mp0d9","updated":"20251112174744"},"Children":[{"ID":"20251112173438-fga7cad","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112173438-fga7cad","updated":"20251112173438"},"Children":[{"ID":"20251112173438-j4orh1p","Type":"NodeParagraph","Properties":{"id":"20251112173438-j4orh1p","updated":"20251112173451"},"Children":[{"Type":"NodeText","Data":"Shadowmask（阴影遮罩）"}]},{"ID":"20251112173452-j5eji3o","Type":"NodeParagraph","Properties":{"id":"20251112173452-j5eji3o","updated":"20251112173457"},"Children":[{"Type":"NodeText","Data":"静态物体的阴影都来自光照贴图，动态物体投射的阴影混合在 Shadowmask 里"}]}]},{"ID":"20251112173410-0escgnn","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112173410-0escgnn","updated":"20251112174744"},"Children":[{"ID":"20251112173410-tfy3jn6","Type":"NodeParagraph","Properties":{"id":"20251112173410-tfy3jn6","updated":"20251112173447"},"Children":[{"Type":"NodeText","Data":"Distance Shadowmask（距离阴影遮罩）"}]},{"ID":"20251112173436-ioamzws","Type":"NodeParagraph","Properties":{"id":"20251112173436-ioamzws","updated":"20251112173436"},"Children":[{"Type":"NodeText","Data":"近处用实时阴影，远处用光照贴图里的 Shadowmask，平衡性能和质量"}]}]}]},{"ID":"20251112173458-n1kgb3k","Type":"NodeParagraph","Properties":{"id":"20251112173458-n1kgb3k","updated":"20251112173501"},"Children":[{"Type":"NodeText","Data":"移动端建议选择 Distance Shadowmask"}]}]},{"ID":"20251112173353-st6pcpm","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112173353-st6pcpm","updated":"20251112175122"},"Children":[{"ID":"20251112173353-blphzsg","Type":"NodeParagraph","Properties":{"id":"20251112173353-blphzsg","updated":"20251112175122"},"Children":[{"Type":"NodeText","Data":"Shadows：阴影"}]},{"ID":"20251112173529-70hym9j","Type":"NodeParagraph","Properties":{"id":"20251112173529-70hym9j","updated":"20251112173529"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251112173529-cxcafvz.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251112173527-oovqr3h","Type":"NodeList","ListData":{},"Properties":{"id":"20251112173527-oovqr3h","updated":"20251112173542"},"Children":[{"ID":"20251112173542-o06j3ph","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112173542-o06j3ph","updated":"20251112173542"},"Children":[{"ID":"20251112173542-4gn6dnn","Type":"NodeParagraph","Properties":{"id":"20251112173542-4gn6dnn","updated":"20251112173600"},"Children":[{"Type":"NodeText","Data":"Disable Shadows（全局禁用阴影）"}]},{"ID":"20251112173602-j0mhxes","Type":"NodeParagraph","Properties":{"id":"20251112173602-j0mhxes","updated":"20251112173602"},"Children":[{"Type":"NodeText","Data":"即使光源（Light）里设置了投射阴影，物体也不会产生阴影"}]}]},{"ID":"20251112173545-5ywxpvw","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112173545-5ywxpvw","updated":"20251112173545"},"Children":[{"ID":"20251112173545-qs9tkzp","Type":"NodeParagraph","Properties":{"id":"20251112173545-qs9tkzp","updated":"20251112173545"},"Children":[{"Type":"NodeText","Data":"Hard Shadows Only（仅开启硬阴影）"}]},{"ID":"20251112173606-7i1pm2h","Type":"NodeParagraph","Properties":{"id":"20251112173606-7i1pm2h","updated":"20251112173630"},"Children":[{"Type":"NodeText","Data":"开启 硬阴影（边缘清晰锐利）\n性能消耗相对低，阴影看起来不自然，尤其是远处或柔光场景\n适用于移动端、低端设备或风格化游戏"}]}]},{"ID":"20251112173549-ywcj0i9","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112173549-ywcj0i9","updated":"20251112173549"},"Children":[{"ID":"20251112173549-2cwuibq","Type":"NodeParagraph","Properties":{"id":"20251112173549-2cwuibq","updated":"20251112173549"},"Children":[{"Type":"NodeText","Data":"Hard and Soft Shadows（硬和软阴影）"}]},{"ID":"20251112173615-ov117rt","Type":"NodeParagraph","Properties":{"id":"20251112173615-ov117rt","updated":"20251112173652"},"Children":[{"Type":"NodeText","Data":"同时支持 硬阴影和软阴影\n具体使用哪种，由 Light 组件中的 Shadows 的 Type 决定\n如果光源设置为 Soft Shadows 软阴影，效果更好，但是消耗高\n（阴影的边缘模糊，过渡更自然）\n适用于高端设备、需要真实感的场景"}]}]}]}]},{"ID":"20251112173353-iih5lgo","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112173353-iih5lgo","updated":"20251112175128"},"Children":[{"ID":"20251112173353-xdbzbzr","Type":"NodeParagraph","Properties":{"id":"20251112173353-xdbzbzr","updated":"20251112175128"},"Children":[{"Type":"NodeText","Data":"Shadow Resolution：阴影贴图分辨率"}]},{"ID":"20251112173810-y0jae7f","Type":"NodeParagraph","Properties":{"id":"20251112173810-y0jae7f","updated":"20251112173810"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251112173810-49r8hib.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251112173749-bfc2b5y","Type":"NodeList","ListData":{},"Properties":{"id":"20251112173749-bfc2b5y","updated":"20251112174909"},"Children":[{"ID":"20251112173815-yeunb0y","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112173815-yeunb0y","updated":"20251112173815"},"Children":[{"ID":"20251112173815-2yo3m5d","Type":"NodeParagraph","Properties":{"id":"20251112173815-2yo3m5d","updated":"20251112173844"},"Children":[{"Type":"NodeText","Data":"Low Resolution（低分辨率）：一般阴影贴图尺寸为 256 * 256 或 512 * 512"}]}]},{"ID":"20251112173819-98d9cfr","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112173819-98d9cfr","updated":"20251112174909"},"Children":[{"ID":"20251112173819-rmjufrj","Type":"NodeParagraph","Properties":{"id":"20251112173819-rmjufrj","updated":"20251112174909"},"Children":[{"Type":"NodeText","Data":"Midium Resolution（中等分辨率）：一般为 1024 * 1024"}]}]},{"ID":"20251112173824-7og8vba","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112173824-7og8vba","updated":"20251112173824"},"Children":[{"ID":"20251112173824-357k137","Type":"NodeParagraph","Properties":{"id":"20251112173824-357k137","updated":"20251112173851"},"Children":[{"Type":"NodeText","Data":"High Resolution（高分辨率）：一般为 2048 * 2048"}]}]},{"ID":"20251112173829-m351ya3","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112173829-m351ya3","updated":"20251112174907"},"Children":[{"ID":"20251112173829-8wrooos","Type":"NodeParagraph","Properties":{"id":"20251112173829-8wrooos","updated":"20251112174907"},"Children":[{"Type":"NodeText","Data":"Very High Resolution（超高分辨率）：一般为 4096 * 4096"}]}]}]},{"ID":"20251112173903-8kj8h27","Type":"NodeParagraph","Properties":{"id":"20251112173903-8kj8h27","updated":"20251112173909"},"Children":[{"Type":"NodeText","Data":"移动端、低端设备 建议 Low 或 Medium\n普通 PC、主机 建议  High\n高端硬件、追求极致画质 建议  Very High"}]}]},{"ID":"20251112173353-mith9a9","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112173353-mith9a9","updated":"20251112175132"},"Children":[{"ID":"20251112173353-al8kkhc","Type":"NodeParagraph","Properties":{"id":"20251112173353-al8kkhc","updated":"20251112175132"},"Children":[{"Type":"NodeText","Data":"Shadow Projection：阴影投射"}]},{"ID":"20251112173943-vymugyt","Type":"NodeParagraph","Properties":{"id":"20251112173943-vymugyt","updated":"20251112173943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251112173943-e9fpqgz.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251112173941-uymx1i2","Type":"NodeList","ListData":{},"Properties":{"id":"20251112173941-uymx1i2","updated":"20251112173946"},"Children":[{"ID":"20251112173946-zg3073b","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112173946-zg3073b","updated":"20251112173946"},"Children":[{"ID":"20251112173946-wcm68fg","Type":"NodeParagraph","Properties":{"id":"20251112173946-wcm68fg","updated":"20251112173949"},"Children":[{"Type":"NodeText","Data":"Close Fit（贴身适配）"}]},{"ID":"20251112173956-ohfvgnq","Type":"NodeParagraph","Properties":{"id":"20251112173956-ohfvgnq","updated":"20251112173956"},"Children":[{"Type":"NodeText","Data":"阴影贴图津贴摄像机视锥，近处更清晰，远处阴影容易模糊、抖动"}]}]},{"ID":"20251112173949-l9ih2m3","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112173949-l9ih2m3","updated":"20251112173949"},"Children":[{"ID":"20251112173949-ybjahmp","Type":"NodeParagraph","Properties":{"id":"20251112173949-ybjahmp","updated":"20251112173949"},"Children":[{"Type":"NodeText","Data":"Stable Fit（稳定适配）"}]},{"ID":"20251112173959-jp4mc3p","Type":"NodeParagraph","Properties":{"id":"20251112173959-jp4mc3p","updated":"20251112174007"},"Children":[{"Type":"NodeText","Data":"阴影贴图保持稳定缩放，减少阴影抖动，但是近处精度略差"}]}]}]},{"ID":"20251112174009-y338ski","Type":"NodeParagraph","Properties":{"id":"20251112174009-y338ski","updated":"20251112174010"},"Children":[{"Type":"NodeText","Data":"一般游戏用 Stable Fit，除非特别需要近景清晰"}]}]},{"ID":"20251112173353-zowddu7","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112173353-zowddu7","updated":"20251112173353"},"Children":[{"ID":"20251112173353-wziktne","Type":"NodeParagraph","Properties":{"id":"20251112173353-wziktne","updated":"20251112173353"},"Children":[{"Type":"NodeText","Data":"Shadow Distance： 阴影可见的最大距离（场景单位，通常是米）"}]},{"ID":"20251112174025-7bivo1m","Type":"NodeParagraph","Properties":{"id":"20251112174025-7bivo1m","updated":"20251112174037"},"Children":[{"Type":"NodeText","Data":"超过这个距离的物体不再投射阴影\n设置过大会增加性能开销\n设置过小可能导致远处物体没有阴影而违和"}]}]},{"ID":"20251112173353-b09rhst","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112173353-b09rhst","updated":"20251112175113"},"Children":[{"ID":"20251112173353-g189x68","Type":"NodeParagraph","Properties":{"id":"20251112173353-g189x68","updated":"20251112175113"},"Children":[{"Type":"NodeText","Data":"Shadow Near Plane Offset：摄像机近平面和阴影映射的偏移"}]},{"ID":"20251112174051-5nnqkgp","Type":"NodeParagraph","Properties":{"id":"20251112174051-5nnqkgp","updated":"20251112175111"},"Children":[{"Type":"NodeText","Data":"调整摄像机近平面和阴影映射的偏移，可以避免阴影抖动或裁剪问题，\n值越大，能减少阴影与物体分离，但可能造成阴影消失"}]}]},{"ID":"20251112173353-69919m5","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112173353-69919m5","updated":"20251112175152"},"Children":[{"ID":"20251112173353-35c8hnj","Type":"NodeParagraph","Properties":{"id":"20251112173353-35c8hnj","updated":"20251112175138"},"Children":[{"Type":"NodeText","Data":"Shadow Cascades：级联阴影"}]},{"ID":"20251112174157-84c5dew","Type":"NodeParagraph","Properties":{"id":"20251112174157-84c5dew","updated":"20251112174158"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251112174158-8k95gfm.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251112174155-veqxwd8","Type":"NodeBlockquote","Properties":{"id":"20251112174155-veqxwd8","updated":"20251112175152"},"Children":[{"ID":"20251112175150-jeisxii","Type":"NodeParagraph","Properties":{"id":"20251112175150-jeisxii","updated":"20251112175152"},"Children":[{"Type":"NodeText","Data":"级联阴影："}]},{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251112175149-psslrii","Type":"NodeParagraph","Properties":{"id":"20251112175149-psslrii","updated":"20251112175149"},"Children":[{"Type":"NodeText","Data":"定向光（如太阳光）要覆盖整个场景，阴影贴图分辨率是固定的。\n如果距离太远，阴影就会模糊、抖动（锯齿感明显）\n我们通过级联阴影把摄像机的可见范围（视锥体）切成几段，\n每一段单独分配一张阴影贴图\n近处的级联使用更多像素（阴影更清晰）\n远处的级联使用更少像素（阴影模糊一些，但不明显）"}]}]},{"ID":"20251112174204-nbz8sar","Type":"NodeList","ListData":{},"Properties":{"id":"20251112174204-nbz8sar","updated":"20251112174204"},"Children":[{"ID":"20251112174203-vskzrwy","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112174203-vskzrwy","updated":"20251112174203"},"Children":[{"ID":"20251112174203-8kw24hu","Type":"NodeParagraph","Properties":{"id":"20251112174203-8kw24hu","updated":"20251112174236"},"Children":[{"Type":"NodeText","Data":"No Cascades：不使用级联"}]},{"ID":"20251112174216-ylh36tb","Type":"NodeParagraph","Properties":{"id":"20251112174216-ylh36tb","updated":"20251112174222"},"Children":[{"Type":"NodeText","Data":"整个摄像机可见范围只用一张阴影贴图，\n性能消耗最低，但是远处阴影模糊明显"}]}]},{"ID":"20251112174208-4mdnder","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112174208-4mdnder","updated":"20251112174208"},"Children":[{"ID":"20251112174208-rwkjg4q","Type":"NodeParagraph","Properties":{"id":"20251112174208-rwkjg4q","updated":"20251112174306"},"Children":[{"Type":"NodeText","Data":"Two Cascades：把相机的可见范围分成两段"}]},{"ID":"20251112174301-rqbz5wa","Type":"NodeParagraph","Properties":{"id":"20251112174301-rqbz5wa","updated":"20251112174305"},"Children":[{"Type":"NodeText","Data":"近处和远处分别使用一张阴影贴图\n近景阴影清晰度提升，性能开销中等，分段过少，远景仍然比较模糊"}]}]},{"ID":"20251112174213-xv9ffgn","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112174213-xv9ffgn","updated":"20251112174213"},"Children":[{"ID":"20251112174213-02ft085","Type":"NodeParagraph","Properties":{"id":"20251112174213-02ft085","updated":"20251112174313"},"Children":[{"Type":"NodeText","Data":"Four Cascades： 把相机的可见范围分成四段"}]},{"ID":"20251112174313-849d7f5","Type":"NodeParagraph","Properties":{"id":"20251112174313-849d7f5","updated":"20251112174338"},"Children":[{"Type":"NodeText","Data":"每一段单独使用一张阴影贴图\n近处阴影非常清晰，整体过渡平滑，\n性能开销最大，因为要生成并采样更多阴影贴图"}]}]}]},{"ID":"20251112174338-3ljlimp","Type":"NodeParagraph","Properties":{"id":"20251112174338-3ljlimp","updated":"20251112174348"},"Children":[{"Type":"NodeText","Data":"移动端推荐：No Cascades 或 Two Cascades\nPC、主机推荐：Four Cascades（效果最好）"}]}]},{"ID":"20251112173353-ify2py1","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112173353-ify2py1","updated":"20251112173353"},"Children":[{"ID":"20251112173353-w0tka2s","Type":"NodeParagraph","Properties":{"id":"20251112173353-w0tka2s","updated":"20251112174500"},"Children":[{"Type":"NodeText","Data":"Cascade splits：每个级联的分割比例 从左到右 从近到远"}]},{"ID":"20251112174500-hvhlnch","Type":"NodeParagraph","Properties":{"id":"20251112174500-hvhlnch","updated":"20251112174500"},"Children":[{"Type":"NodeText","Data":"段数由 Shadow Cascades 决定"}]}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20251112172853-l0r8bt0","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251112172853-l0r8bt0","updated":"20251112180146"},"Children":[{"Type":"NodeText","Data":"光源组件中的相关参数"}]},{"ID":"20251112175311-q7r2xup","Type":"NodeBlockquote","Properties":{"id":"20251112175311-q7r2xup","updated":"20251112175434"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251112175314-day09yw","Type":"NodeParagraph","Properties":{"id":"20251112175314-day09yw","updated":"20251112175347"},"Children":[{"Type":"NodeText","Data":"内置管线的光源组件具体可见："},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20230709200536-yy6ragq","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"U1L11——光源组件"}]}]},{"ID":"20251112175613-s8vk5yz","Type":"NodeSuperBlock","Properties":{"id":"20251112175613-s8vk5yz","updated":"20251112180146"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20251112175434-1unwud6","Type":"NodeParagraph","Properties":{"id":"20251112175434-1unwud6","updated":"20251112175613"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251112175559-bxuki1n.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251112175610-7q29nso","Type":"NodeList","ListData":{},"Properties":{"id":"20251112175610-7q29nso","updated":"20251112180146"},"Children":[{"ID":"20251112175610-ldwjs8x","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112175610-ldwjs8x","updated":"20251112175610"},"Children":[{"ID":"20251112175610-emgli3v","Type":"NodeParagraph","Properties":{"id":"20251112175610-emgli3v","updated":"20251112175624"},"Children":[{"Type":"NodeText","Data":"Shadow Type（阴影类型）"}]},{"ID":"20251112175625-9cbfjnj","Type":"NodeList","ListData":{},"Properties":{"id":"20251112175625-9cbfjnj","updated":"20251112175625"},"Children":[{"ID":"20251112175624-1neto2l","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112175624-1neto2l","updated":"20251112175624"},"Children":[{"ID":"20251112175624-0riuvdr","Type":"NodeParagraph","Properties":{"id":"20251112175624-0riuvdr","updated":"20251112175624"},"Children":[{"Type":"NodeText","Data":"No Shadows ：不投射阴影"}]}]},{"ID":"20251112175628-3vjn0vv","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112175628-3vjn0vv","updated":"20251112175628"},"Children":[{"ID":"20251112175628-wbaiuqi","Type":"NodeParagraph","Properties":{"id":"20251112175628-wbaiuqi","updated":"20251112175628"},"Children":[{"Type":"NodeText","Data":"Hard Shadows：阴影边缘清晰，性能好，但效果生硬"}]}]},{"ID":"20251112175632-1wpintf","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112175632-1wpintf","updated":"20251112175632"},"Children":[{"ID":"20251112175632-k2vf2q8","Type":"NodeParagraph","Properties":{"id":"20251112175632-k2vf2q8","updated":"20251112175632"},"Children":[{"Type":"NodeText","Data":"Soft Shadows：阴影边缘有模糊过渡，更自然，但性能消耗更大。"}]}]}]}]},{"ID":"20251112175610-cg00t0s","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112175610-cg00t0s","updated":"20251112175651"},"Children":[{"ID":"20251112175610-1zblvk4","Type":"NodeParagraph","Properties":{"id":"20251112175610-1zblvk4","updated":"20251112175610"},"Children":[{"Type":"NodeText","Data":"Baked Shadow Angle（烘焙阴影角度）"}]},{"ID":"20251112175641-mreu7v3","Type":"NodeParagraph","Properties":{"id":"20251112175641-mreu7v3","updated":"20251112175651"},"Children":[{"Type":"NodeText","Data":"仅用于 烘焙光源 (Baked Light)，控制软阴影的模糊角度\n值越大，阴影边缘越模糊\n实时光源不会用到这个参数"}]}]},{"ID":"20251112175610-bx8cxke","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112175610-bx8cxke","updated":"20251112180146"},"Children":[{"ID":"20251112175610-d3cic76","Type":"NodeParagraph","Properties":{"id":"20251112175610-d3cic76","updated":"20251112175610"},"Children":[{"Type":"NodeText","Data":"Realtime Shadows（实时阴影相关设置）"}]},{"ID":"20251112175610-y52elub","Type":"NodeList","ListData":{},"Properties":{"id":"20251112175610-y52elub","updated":"20251112180146"},"Children":[{"ID":"20251112175610-h7i3ron","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112175610-h7i3ron","updated":"20251112175610"},"Children":[{"ID":"20251112175610-qwzn1ar","Type":"NodeParagraph","Properties":{"id":"20251112175610-qwzn1ar","updated":"20251112175753"},"Children":[{"Type":"NodeText","Data":"Strength（阴影强度 0"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"~"}]},{"Type":"NodeText","Data":"1）"}]},{"ID":"20251112175709-ns85f90","Type":"NodeList","ListData":{},"Properties":{"id":"20251112175709-ns85f90","updated":"20251112175709"},"Children":[{"ID":"20251112175709-5xvjxvk","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112175709-5xvjxvk","updated":"20251112175709"},"Children":[{"ID":"20251112175709-wqjgtgn","Type":"NodeParagraph","Properties":{"id":"20251112175709-wqjgtgn","updated":"20251112175711"},"Children":[{"Type":"NodeText","Data":"1：完全黑色阴影"}]}]},{"ID":"20251112175712-wfddikp","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112175712-wfddikp","updated":"20251112175712"},"Children":[{"ID":"20251112175712-cql9gnm","Type":"NodeParagraph","Properties":{"id":"20251112175712-cql9gnm","updated":"20251112175714"},"Children":[{"Type":"NodeText","Data":"0.5：半透明阴影"}]}]},{"ID":"20251112175714-ev8xeo7","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112175714-ev8xeo7","updated":"20251112175714"},"Children":[{"ID":"20251112175714-0vvfcoo","Type":"NodeParagraph","Properties":{"id":"20251112175714-0vvfcoo","updated":"20251112175714"},"Children":[{"Type":"NodeText","Data":"0：阴影不可见"}]}]}]}]},{"ID":"20251112175610-4xbne7v","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112175610-4xbne7v","updated":"20251112180146"},"Children":[{"ID":"20251112175610-l96sllu","Type":"NodeParagraph","Properties":{"id":"20251112175610-l96sllu","updated":"20251112175610"},"Children":[{"Type":"NodeText","Data":"Resolution（阴影贴图分辨率）"}]},{"ID":"20251112180103-dse1xq1","Type":"NodeList","ListData":{},"Properties":{"id":"20251112180103-dse1xq1","updated":"20251112180146"},"Children":[{"ID":"20251112180105-lt7miq8","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112180105-lt7miq8","updated":"20251112180146"},"Children":[{"ID":"20251112180105-hrn9ck1","Type":"NodeParagraph","Properties":{"id":"20251112180105-hrn9ck1","updated":"20251112180146"},"Children":[{"Type":"NodeText","Data":"Use Quality Settings：使用质量设置中的"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20251112173353-xdbzbzr","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"全局设置"},{"Type":"NodeText","Data":"质量，也可以单独设置"}]}]},{"ID":"20251112180103-g665ocl","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112180103-g665ocl","updated":"20251112180103"},"Children":[{"ID":"20251112180103-kbckolv","Type":"NodeParagraph","Properties":{"id":"20251112180103-kbckolv","updated":"20251112180103"},"Children":[{"Type":"NodeText","Data":"Low Resolution（低分辨率）：一般阴影贴图尺寸为 256 * 256 或 512 * 512"}]}]},{"ID":"20251112180103-p7ofcd5","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112180103-p7ofcd5","updated":"20251112180103"},"Children":[{"ID":"20251112180103-9901ju8","Type":"NodeParagraph","Properties":{"id":"20251112180103-9901ju8","updated":"20251112180103"},"Children":[{"Type":"NodeText","Data":"Midium Resolution（中等分辨率）：一般为 1024 * 1024"}]}]},{"ID":"20251112180103-gd38m59","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112180103-gd38m59","updated":"20251112180103"},"Children":[{"ID":"20251112180103-00xi6rp","Type":"NodeParagraph","Properties":{"id":"20251112180103-00xi6rp","updated":"20251112180103"},"Children":[{"Type":"NodeText","Data":"High Resolution（高分辨率）：一般为 2048 * 2048"}]}]},{"ID":"20251112180103-xrxqeph","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112180103-xrxqeph","updated":"20251112180103"},"Children":[{"ID":"20251112180103-sp1j5rd","Type":"NodeParagraph","Properties":{"id":"20251112180103-sp1j5rd","updated":"20251112180103"},"Children":[{"Type":"NodeText","Data":"Very High Resolution（超高分辨率）：一般为 4096 * 4096"}]}]}]}]},{"ID":"20251112175610-lx2iy1u","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112175610-lx2iy1u","updated":"20251112175610"},"Children":[{"ID":"20251112175610-ghaz59j","Type":"NodeParagraph","Properties":{"id":"20251112175610-ghaz59j","updated":"20251112175758"},"Children":[{"Type":"NodeText","Data":"Bias（偏移）"}]},{"ID":"20251112175759-8x6p0wk","Type":"NodeParagraph","Properties":{"id":"20251112175759-8x6p0wk","updated":"20251112175807"},"Children":[{"Type":"NodeText","Data":"控制阴影深度偏移，用来减少 阴影自遮挡问题\n值越大，阴影与物体会分离\n通常在 0.05 "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"~"}]},{"Type":"NodeText","Data":" 0.1 范围内调整"}]}]},{"ID":"20251112175610-465lfcz","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112175610-465lfcz","updated":"20251112175610"},"Children":[{"ID":"20251112175610-d3xeozi","Type":"NodeParagraph","Properties":{"id":"20251112175610-d3xeozi","updated":"20251112175610"},"Children":[{"Type":"NodeText","Data":"Normal Bias（法线偏移）"}]},{"ID":"20251112175812-llgnrdo","Type":"NodeParagraph","Properties":{"id":"20251112175812-llgnrdo","updated":"20251112175817"},"Children":[{"Type":"NodeText","Data":"按照表面法线方向偏移采样位置\n主要减少阴影抖动和摩尔纹\n值太大会让阴影“漂浮”，太小则容易自遮挡"}]}]},{"ID":"20251112175610-4nva7vm","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112175610-4nva7vm","updated":"20251112175610"},"Children":[{"ID":"20251112175610-j51myys","Type":"NodeParagraph","Properties":{"id":"20251112175610-j51myys","updated":"20251112175610"},"Children":[{"Type":"NodeText","Data":"Near Plane（近裁剪面）"}]},{"ID":"20251112175821-4gvysrc","Type":"NodeParagraph","Properties":{"id":"20251112175821-4gvysrc","updated":"20251112175826"},"Children":[{"Type":"NodeText","Data":"定义阴影摄像机的近平面\n值太小：精度低，阴影抖动明显\n值太大： 可能裁剪掉近处的阴影"}]}]}]}]}]},{"Type":"NodeSuperBlockCloseMarke