226"},"Children":[{"Type":"NodeText","Data":"默认跟随 URP Asset 设置，如果覆盖，可以选择不同的采样质量"}]},{"ID":"20251112182321-syapnuz","Type":"NodeParagraph","Properties":{"id":"20251112182321-syapnuz","updated":"20251112182443"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251112182443-quu52c2.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20251112181848-h0ehcid","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251112181848-h0ehcid","updated":"20251112182500"},"Children":[{"ID":"20251112181848-paje1rz","Type":"NodeParagraph","Properties":{"id":"20251112181848-paje1rz","updated":"20251112182332"},"Children":[{"Type":"NodeText","Data":"Custom Shadow Layers (自定义阴影层级)"}]},{"ID":"20251112182332-q20cry5","Type":"NodeParagraph","Properties":{"id":"20251112182332-q20cry5","updated":"20251112182341"},"Children":[{"Type":"NodeText","Data":"默认情况下，光源的阴影会影响所有受光物体\n勾选后，可以选择特定的 Shadow Layer，只让光源对指定层的物体投射阴影\n常用于优化（只让关键物体投射阴影）、或特殊效果（比如只让角色的光源影响角色本身）。"}]},{"ID":"20251112182459-o3a2ghj","Type":"NodeParagraph","Properties":{"id":"20251112182459-o3a2ghj","updated":"20251112182500"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251112182500-lfktuqb.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]}]}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20251112173117-o7kj6uj","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251112173117-o7kj6uj","updated":"20251112182935"},"Children":[{"Type":"NodeText","Data":"渲染组件中的相关参数"}]},{"ID":"20251112182831-6320mk