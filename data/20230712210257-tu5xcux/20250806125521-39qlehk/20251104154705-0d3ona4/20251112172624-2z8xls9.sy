"updated":"20251112182839"},"Children":[{"Type":"NodeText","Data":"On：始终投射阴影"}]}]},{"ID":"20251112182843-n2t000u","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112182843-n2t000u","updated":"20251112182843"},"Children":[{"ID":"20251112182843-khnloiq","Type":"NodeParagraph","Properties":{"id":"20251112182843-khnloiq","updated":"20251112182843"},"Children":[{"Type":"NodeText","Data":"Two Sided：双面几何体（如平面）也能投射阴影"}]}]},{"ID":"20251112182847-iuak0v8","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112182847-iuak0v8","updated":"20251112182847"},"Children":[{"ID":"20251112182847-k0i216h","Type":"NodeParagraph","Properties":{"id":"20251112182847-k0i216h","updated":"20251112182850"},"Children":[{"Type":"NodeText","Data":"Shadows Only：物体本身不可见，但仍然投射阴影\n（常用于特殊效果，比如只显示阴影的隐形角色）"}]}]}]}]},{"ID":"20251112182723-rtb1w1b","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112182723-rtb1w1b","updated":"20251112182935"},"Children":[{"ID":"20251112182723-737jcyq","Type":"NodeParagraph","Properties":{"id":"20251112182723-737jcyq","updated":"20251112182910"},"Children":[{"Type":"NodeText","Data":"Static Shadow Caster：静态阴影投射体"}]},{"ID":"20251112182904-0yudoui","Type":"NodeParagraph","Properties":{"id":"20251112182904-0yudoui","updated":"20251112182935"},"Children":[{"Type":"NodeText","Data":"启用后，物体会被当作 静态阴影投射体。\n意味着它不会在运行时动态更新阴影，而是作为静态几何体来处理\n可以减少性能开销（因为不需要每帧更新阴影）\n如果物体在运行时会移动/旋转，那么它的阴影也不会跟随更新，可能造成错误。\n一般用于 建筑、地形、石头、不会动的大型物体"}]}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20251112182832-zuchywq","Type":"NodeParagraph","Properties":{"id":"20251112182832-zuchywq","updated":"20251112182832"}}]}