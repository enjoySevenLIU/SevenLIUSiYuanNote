据"}]},{"ID":"20251112115212-xw7ekte","Type":"NodeParagraph","Properties":{"id":"20251112115212-xw7ekte","updated":"20251112115217"},"Children":[{"Type":"NodeText","Data":"在 Shader 开发中"}]},{"ID":"20251112115217-rinq0cs","Type":"NodeList","ListData":{},"Properties":{"id":"20251112115217-rinq0cs","updated":"20251112115224"},"Children":[{"ID":"20251112115217-sshl4fq","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112115217-sshl4fq","updated":"20251112115222"},"Children":[{"ID":"20251112115217-qe70458","Type":"NodeParagraph","Properties":{"id":"20251112115217-qe70458","updated":"20251112115222"},"Children":[{"Type":"NodeText","Data":"顶点着色器阶段：需要自定义结构体决定需要传入和使用哪些模型数据"}]}]},{"ID":"20251112115220-4hy5x3a","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112115220-4hy5x3a","updated":"20251112115224"},"Children":[{"ID":"20251112115220-2f8mtsn","Type":"NodeParagraph","Properties":{"id":"20251112115220-2f8mtsn","updated":"20251112115224"},"Children":[{"Type":"NodeText","Data":"片元着色器阶段：需要自定义结构体决定从顶点着色器中传出哪些数据"}]}]}]},{"ID":"20251112115212-rge8pjt","Type":"NodeParagraph","Properties":{"id":"20251112115212-rge8pjt","updated":"20251112115212"},"Children":[{"Type":"NodeText","Data":"我们应该尽量避免传入和传出不需要使用的数据"}]},{"ID":"20251112115226-og7cmti","Type":"NodeParagraph","Properties":{"id":"20251112115226-og7cmti","updated":"20251112115242"},"Children":[{"Type":"NodeText","Data":"比如："}]},{"ID":"20251112115242-p5lpfe3","Type":"NodeList","ListData":{},"Properties":{"id":"20251112115242-p5lpfe3","updated":"20251112115242"},"Children":[{"ID":"20251112115242-k73a138","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112115242-k73a138","updated":"20251112115242"},"Children":[{"ID":"20251112115242-4vafnfl","Type":"NodeParagraph","Properties":{"id":"20251112115242-4vafnfl","updated":"20251112115242"},"Children":[{"Type":"NodeText","Data":"在顶点着色器中如果不需要用到法线、切线等数据，就不要在结构体中进行声明"}]}]},{"ID":"20251112115243-8rkjgd9","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112115243-8rkjgd9","updated":"20251112115243"},"Children":[{"ID":"20251112115243-kfirqk9","Type":"NodeParagraph","Properties":{"id":"20251112115243-kfirqk9","updated":"20251112115243"},"Children":[{"Type":"NodeText","Data":"在片元着色器中不需要用到的数据也不要从顶点传出，否则会进行插值相关的计算"}]}]}]},{"ID":"20251112115250-l8dljxa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251112115250-l8dljxa","updated":"20251112115315"},"Children":[{"Type":"NodeText","Data":"只公开所需的变量"}]},{"ID":"20251112115256-2plxvts","Type":"NodeParagraph","Properties":{"id":"20251112115256-2plxvts","updated":"20251112115313"},"Children":[{"Type":"NodeText","Data":"在 Shader 中的应该只保留真正需要外部控制的变量成为材质参数\n这样可以减少常量缓冲区传输的开销，还可以让 Inspector 窗口更简洁\n如果某些成员是固定值，可以直接写死在 Shader 中，不用公开成材质参数"}]},{"ID":"20251112115315-7pvqyn2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251112115315-7pvqyn2","updated":"20251112115507"},"Children":[{"Type":"NodeText","Data":"预计算"}]},{"ID":"20251112115326-umi8hta","Type":"NodeParagraph","Properties":{"id":"20251112115326-umi8hta","updated":"20251112115340"},"Children":[{"Type":"NodeText","Data":"对于一些常用不变的数据，我们可以提前计算好，放在 CPU 或者纹理贴图中，不要每帧都在 Shader 中重复计算"}]},{"ID":"20251112115331-1mcbo17","Type":"NodeParagraph","Properties":{"id":"20251112115331-1mcbo17","updated":"20251112115344"},"Children":[{"Type":"NodeText","Data":"举例："}]},{"ID":"20251112115344-rog1mks","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251112115344-rog1mks","updated":"20251112115344"},"Children":[{"ID":"20251112115344-2w2enbd","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251112115344-2w2enbd","updated":"20251112115344"},"Children":[{"ID":"20251112115344-ibkivb8","Type":"NodeParagraph","Properties":{"id":"20251112115344-ibkivb8","updated":"20251112115344"},"Children":[{"Type":"NodeText","Data":"光照烘焙贴图就是把光照结果预先算好放入了光照纹理中，直接取出来使用"}]}]},{"ID":"20251112115344-9l221lj","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251112115344-9l221lj","updated":"20251112115344"},"Children":[{"ID":"20251112115344-doozzz3","Type":"NodeParagraph","Properties":{"id":"20251112115344-doozzz3","updated":"20251112115354"},"Children":[{"Type":"NodeText","Data":"一些复杂函数结果，可以预烘焙为 LUT 纹理，Shader 内直接从其中采样即可"}]},{"ID":"20251112115357-xtxpt92","Type":"NodeBlockquote","Properties":{"id":"20251112115357-xtxpt92","updated":"20251112115358"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251112115358-ah0dmcw","Type":"NodeParagraph","Properties":{"id":"20251112115358-ah0dmcw","updated":"20251112115400"},"Children":[{"Type":"NodeText","Data":"LUT 纹理：Look-Up Table（查找表纹理）"}]},{"ID":"20251112115404-jsttkcm","Type":"NodeParagraph","Properties":{"id":"20251112115404-jsttkcm","updated":"20251112115407"},"Children":[{"Type":"NodeText","Data":"把复杂、昂贵的计算结果 提前存到一张纹理里，在 Shader 中直接通过坐标去“查表”取结果，用一次纹理采样（内存带宽消耗）替代复杂的数学计算"}]},{"ID":"20251112115406-afv68ll","Type":"NodeParagraph","Properties":{"id":"20251112115406-afv68ll","updated":"20251112115451"},"Children":[{"Type":"NodeText","Data":"比如：\n假设你要频繁算 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"pow(x,2.2)"},{"Type":"NodeText","Data":"​ 来做 Gamma 校正，如果不用 LUT 纹理，每次计算开销大："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"float gammaCorrect = pow(x, 2.2);"},{"Type":"NodeText","Data":"​\n我们可以先在 CPU 或工具里预生成一个 256 像素宽的 1D 纹理，存放 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[0,1]"},{"Type":"NodeText","Data":"​ 区间的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"pow(x,2.2)"},{"Type":"NodeText","Data":"​ 值\n在 Shader 中我们直接在该纹理中采样即可："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"float gammaCorrect = tex2D(_GammaLUT, float2(x, 0)).r;"},{"Type":"NodeText","Data":"​"}]}]}]}]},{"ID":"20251112115456-efgz57d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251112115456-efgz57d","updated":"20251112115530"},"Children":[{"Type":"NodeText","Data":"减少逐像素计算"}]},{"ID":"20251112115512-cl4x98x","Type":"NodeParagraph","Properties":{"id":"20251112115512-cl4x98x","updated":"20251112115516"},"Children":[{"Type":"NodeText","Data":"能在顶点阶段计算的，就不要放在片元阶段，因为 顶点数量 绝大多数情况下都是远远小于 像素数量 的\n顶点 到 片元阶段 中插值计算的效率 是优于 在片元中逐像素计算的\n比如：如果只是顶点颜色渐变，直接在顶点算好，再插值到片元"}]},{"ID":"20251112115512-kwa4xim","Type":"NodeBlockquote","Properties":{"id":"20251112115512-kwa4xim","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20251112115522"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251112115522-hym3u9h","Type":"NodeParagraph","Properties":{"id":"20251112115522-hym3u9h","updated":"20251112115522"},"Children":[{"Type":"NodeText","Data":"注意：并不是所有效果都适合从片元转移到顶点计算"}]}]},{"ID":"20251112115530-pkdo6g3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251112115530-pkdo6g3","updated":"20251112115634"},"Children":[{"Type":"NodeText","Data":"合并多次计算"}]},{"ID":"20251112115551-cm1cnme","Type":"NodeParagraph","Properties":{"id":"20251112115551-cm1cnme","updated":"20251112115603"},"Children":[{"Type":"NodeText","Data":"在 Shader 编程时，避免重复算同样的表达式，应该把结果存起来复用"}]},{"ID":"20251112115603-vwt05m2","Type":"NodeList","ListData":{},"Properties":{"id":"20251112115603-vwt05m2","updated":"20251112115621"},"Children":[{"ID":"20251112115603-q2zlxx8","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112115603-q2zlxx8","updated":"20251112115603"},"Children":[{"ID":"20251112115603-np37e4p","Type":"NodeParagraph","Properties":{"id":"20251112115603-np37e4p","updated":"20251112115607"},"Children":[{"Type":"NodeText","Data":"错误做法："}]},{"ID":"20251112115608-96txlzc","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251112115608-96txlzc","updated":"20251112115615"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"float a = sin(x) * 0.5;\nfloat b = sin(x) * 2.0;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]},{"ID":"20251112115605-c76cgwm","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112115605-c76cgwm","updated":"20251112115621"},"Children":[{"ID":"20251112115605-m03zmrn","Type":"NodeParagraph","Properties":{"id":"20251112115605-m03zmrn","updated":"20251112115618"},"Children":[{"Type":"NodeText","Data":"正确做法："}]},{"ID":"20251112115619-dtmz6id","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251112115619-dtmz6id","updated":"20251112115621"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"float s = sin(x);\nfloat a = s * 0.5;\nfloat b = s * 2.0;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]}]},{"ID":"20251112115634-vf3gdj5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251112115634-vf3gdj5","updated":"20251112162215"},"Children":[{"Type":"NodeText","Data":"利用常量缓冲区"}]},{"ID":"20251112115641-xitmk17","Type":"NodeParagraph","Properties":{"id":"20251112115641-xitmk17","updated":"20251112115651"},"Children":[{"Type":"NodeText","Data":"应该把多个 Shader 共享的常量数据（灯光参数、矩阵、全局材质参数），放到常量缓冲区（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CBUFFER"},{"Type":"NodeText","Data":"​）中\n这样的好处是 一次传输，多处使用，减少 CPU 到 GPU 的频繁数据更新"}]},{"ID":"20251112115641-b997f5h","Type":"NodeParagraph","Properties":{"id":"20251112115641-b997f5h","updated":"20251112115728"},"Children":[{"Type":"NodeText","Data":"常量缓冲区（Constant Buffer，简称 CBuffer）是 GPU 内存中一块 专门存放统一变量（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Uniforms"},{"Type":"NodeText","Data":"​）的区域，使用方式："}]},{"ID":"20251112162105-mn29wwc","Type":"NodeParagraph","Properties":{"id":"20251112162105-mn29wwc","updated":"20251112162105"},"Children":[{"Type":"NodeText","Data":"Shader 代码中："}]},{"ID":"20251112115718-f878opp","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251112115718-f878opp","updated":"20251112115723"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"CBUFFER_START(自定义名字 或 Unity内置常量缓冲区名)\n    float4 _BaseColor;\n    float _Roughness;\nCBUFFER_END\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251112115714-2vflgpz","Type":"NodeParagraph","Properties":{"id":"20251112115714-2vflgpz","updated":"20251112115732"},"Children":[{"Type":"NodeText","Data":"内置常量缓冲区名"}]},{"ID":"20251112115732-e8v0zhm","Type":"NodeList","ListData":{},"Properties":{"id":"20251112115732-e8v0zhm","updated":"20251112115752"},"Children":[{"ID":"20251112115732-5odxvkc","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112115732-5odxvkc","updated":"20251112115752"},"Children":[{"ID":"20251112115732-s10do3k","Type":"NodeParagraph","Properties":{"id":"20251112115732-s10do3k","updated":"20251112115752"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"UnityPerCamera"},{"Type":"NodeText","Data":"​：相机相关（矩阵、位置）"}]}]},{"ID":"20251112115733-v4v4q0m","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112115733-v4v4q0m","updated":"20251112115750"},"Children":[{"ID":"20251112115733-c1nkjhs","Type":"NodeParagraph","Properties":{"id":"20251112115733-c1nkjhs","updated":"20251112115750"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"UnityPerFrame"},{"Type":"NodeText","Data":"​：时间、屏幕尺寸、帧率相关"}]}]},{"ID":"20251112115737-97kvsl9","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112115737-97kvsl9","updated":"20251112115749"},"Children":[{"ID":"20251112115737-ibppswx","Type":"NodeParagraph","Properties":{"id":"20251112115737-ibppswx","updated":"20251112115749"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"UnityPerDraw"},{"Type":"NodeText","Data":"​：物体的世界矩阵等"}]}]},{"ID":"20251112115738-58wgfjo","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251112115738-58wgfjo","updated":"20251112115747"},"Children":[{"ID":"20251112115738-bumhq63","Type":"NodeParagraph","Properties":{"id":"20251112115738-bumhq63","updated":"20251112115747"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"UnityPerMaterial"},{"Type":"NodeText","Data":"​：材质参数"}]}]}]},{"ID":"20251112115641-91btn9o","Type":"NodeParagraph","Properties":{"id":"20251112115641-91btn9o","updated":"20251112115809"},"Children":[{"Type":"NodeText","Data":"C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 代码中："}]},{"ID":"20251112115757-qeg0ing","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251112115757-qeg0ing","updated":"20251112115802"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"int BaseColorID = Shader.PropertyToID(\"_BaseColor\");\nint RoughnessID = Shader.PropertyToID(\"_Roughness\");\nMaterialPropertyBlock mpb = new MaterialPropertyBlock();\nrenderer.GetPropertyBlock(mpb);\nmpb.SetColor(BaseColorID, Color.red);\nmpb.SetFloat(RoughnessID, 0.5f);\nrenderer.SetPropertyBlock(mpb);\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251112162215-jvhdeuv","Type":"NodeParagraph","Properties":{"id":"20251112162215-jvhdeuv","updated":"20251112162215"}}]}