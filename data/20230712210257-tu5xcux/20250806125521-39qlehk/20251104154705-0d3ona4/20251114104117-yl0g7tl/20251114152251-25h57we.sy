ark","TextMarkType":"code","TextMarkTextContent":"ComputeBuffer"},{"Type":"NodeText","Data":"​ 的步长参数（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"stride"},{"Type":"NodeText","Data":"​）必须等于 GPU 端结构体（或者基本类型）实际字节数"}]}]},{"ID":"20251114154026-dmzr4go","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251114154026-dmzr4go","updated":"20251114171712"},"Children":[{"ID":"20251114154026-j3zak5r","Type":"NodeParagraph","Properties":{"id":"20251114154026-j3zak5r","updated":"20251114154132"},"Children":[{"Type":"NodeText","Data":"特殊缓冲类型 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AppendStructuredBuffer\u0026lt;T\u0026gt;"},{"Type":"NodeText","Data":"​ / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ConsumeStructuredBuffer\u0026lt;T\u0026gt;"},{"Type":"NodeText","Data":"​"}]},{"ID":"20251114154047-00e43sd","Type":"NodeParagraph","Properties":{"id":"20251114154047-00e43sd","updated":"20251114171712"},"Children":[{"Type":"NodeText","Data":"在 C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 端需要使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"new ComputeBuffer(count, stride, ComputeBufferType.Append)"},{"Type":"NodeText","Data":"​，其中 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"count"},{"Type":"NodeText","Data":"​ 代表缓冲区最多有几个元素\n其中 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AppendStructuredBuffer"},{"Type":"NodeText","Data":"​ 在使用前调用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"buffer.SetCounterValue(0)"},{"Type":"NodeText","Data":"​，而 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ConsumeStructuredBuffer"},{"Type":"NodeText","Data":"​ 需要输入数据"}]}]}]}]},{"ID":"20251114170306-gmyuo6c","Type":"NodeParagraph","Properties":{"id":"20251114170306-gmyuo6c","updated":"20251114170828"},"Children":[{"Type":"NodeText","Data":"传递结构体时，在 C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 需要定义相同的结构体，传递时必须要使用缓冲区，最常用的就是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"StructuredBuffer\u0026lt;T\u0026gt;"},{"Type":"NodeText","Data":"​ / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RWStructuredBuffer\u0026lt;T\u0026gt;"},{"Type":"NodeText","Data":"​"}]},{"ID":"20251121113104-3b85242","Type":"NodeBlockquote","Properties":{"id":"20251121113104-3b85242","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20251121113104"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251121113104-salf75g","Type":"NodeParagraph","Properties":{"id":"20251121113104-salf75g","updated":"20251121113104"},"Children":[{"Type":"NodeText","Data":"注意：新版本中有一个 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"GraphicsBuffer"},{"Type":"NodeText","Data":"​ 类，它的用法和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ComputeBuffer"},{"Type":"NodeText","Data":"​ 类似，它可以和 SRP 等管线更好地配合"}]}]},{"ID":"20251114170830-d5v5squ","Type":"NodeParagraph","Properties":{"id":"20251114170830-d5v5squ","updated":"20251114170957"},"Children":[{"Type":"NodeText","Data":"假设要输入以下 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ComputeShader"},{"Type":"NodeText","Data":"​ 变量（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Test"},{"Type":"NodeText","Data":"​ 结构体通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"StructuredBuffer\u0026lt;T\u0026gt;"},{"Type":"NodeText","Data":"​ 传递）："}]},{"ID":"20251114170958-3fgd488","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114170958-3fgd488","updated":"20251114171132"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"struct Test\n{\n    float3 position;\n    float3 velocity;\n    float lifetime;\n};\n\nStructuredBuffer\u003cTest\u003e buffer;\n// RWStructuredBuffer\u003cTest\u003e buffer2;\t\t// 传递方式和StructuredBuffer\u003cT\u003e一致\nByteAddressBuffer buffer3;\n// RWByteAddressBuffer buffer4;\t\t\t\t// 传递方式和ByteAddressBuffer一致\nAppendStructuredBuffer\u003cfloat\u003e buffer5;\nConsumeStructuredBuffer\u003cfloat\u003e buffer6;\n\n[numthreads(8,8,1)]\nvoid CSMain (uint3 id : SV_DispatchThreadID) { /*...*/ }\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114171141-o1vdd8f","Type":"NodeParagraph","Properties":{"id":"20251114171141-o1vdd8f","updated":"20251114171149"},"Children":[{"Type":"NodeText","Data":"在 C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 中："}]},{"ID":"20251114171247-jaens8o","Type":"NodeList","ListData":{},"Properties":{"id":"20251114171247-jaens8o","updated":"20251121113054"},"Children":[{"ID":"20251114171247-uh3v13d","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251114171247-uh3v13d","updated":"20251114171247"},"Children":[{"ID":"20251114171247-9pr3isa","Type":"NodeParagraph","Properties":{"id":"20251114171247-9pr3isa","updated":"20251114171403"},"Children":[{"Type":"NodeText","Data":"传递结构体 / 多个结构体时，使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"StructuredBuffer\u0026lt;T\u0026gt;"},{"Type":"NodeText","Data":"​ / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RWStructuredBuffer\u0026lt;T\u0026gt;"},{"Type":"NodeText","Data":"​"}]},{"ID":"20251114171314-wlqocr2","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114171314-wlqocr2","updated":"20251114171349"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"public ComputeShader computeShader;     // 声明 computeShader 变量，可以通过 Inspector 窗口关联，也可以动态加载\n\n// 一个 Test 结构体大小为 28 byte\nstruct Test\n{\n    Vector3 position;   // 12 byte\n    Vector3 velocity;   // 12 byte\n    float lifetime;     // 4 byte\n}\n\nvoid Start()\n{\n    int index = computeShader.FindKernel(\"CSMain\");     // 获取 computeShader 中名为 CSMain 的函数索引\n\n    // StructuredBuffer / RWStructuredBuffer\n    // 假设要传递3个结构体数据，结构体大小为 28 byte，通过 StructuredBuffer 传递\n    var list = new List\u003cTest\u003e();\n    list.Add(new Test());\n    list.Add(new Test());\n    list.Add(new Test());\n    var computeBuffer = new ComputeBuffer(list.Count, 28);\n    computeBuffer.SetData(list);\n    computeShader.SetBuffer(index, \"buffer\", computeBuffer);\n\n    computeShader.Dispatch(index, 64, 64, 0);           // 启动 CSMain 的计算\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]},{"ID":"20251114171354-oiz3yku","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251114171354-oiz3yku","updated":"20251114171354"},"Children":[{"ID":"20251114171354-k45egnf","Type":"NodeParagraph","Properties":{"id":"20251114171354-k45egnf","updated":"20251114171423"},"Children":[{"Type":"NodeText","Data":"传递多个基本类型时，可以使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ByteAddressBuffer"},{"Type":"NodeText","Data":"​ / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RWByteAddressBuffer"},{"Type":"NodeText","Data":"​"}]},{"ID":"20251114171425-d80i79z","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114171425-d80i79z","updated":"20251114171451"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"public ComputeShader computeShader;     // 声明 computeShader 变量，可以通过 Inspector 窗口关联，也可以动态加载\n\nvoid Start()\n{\n    int index = computeShader.FindKernel(\"CSMain\");     // 获取 computeShader 中名为 CSMain 的函数索引\n\n    // ByteAddressBuffer / RWByteAddressBuffer\n    // 假设要传递64个int数据，通过 ByteAddressBuffer 传递\n    var list2 = new List\u003cint\u003e();\n    for (int i = 0; i \u003c 64; i++)\n    {\n        list2.Add(i);\n    }\n    var computeBuffer2 = new ComputeBuffer(64, 4, ComputeBufferType.Raw);\n    computeBuffer2.SetData(list2);\n    computeShader.SetBuffer(index2, \"buffer3\", computeBuffer2);\n\n    computeShader.Dispatch(index, 64, 64, 0);           // 启动 CSMain 的计算\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]},{"ID":"20251114171458-b3kebk7","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251114171458-b3kebk7","updated":"20251121113054"},"Children":[{"ID":"20251114171458-txalszt","Type":"NodeParagraph","Properties":{"id":"20251114171458-txalszt","updated":"20251114171536"},"Children":[{"Type":"NodeText","Data":"传递只能加或者只能减的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AppendStructuredBuffer\u0026lt;T\u0026gt;"},{"Type":"NodeText","Data":"​ / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ConsumeStructuredBuffer\u0026lt;T\u0026gt;"},{"Type":"NodeText","Data":"​ 的缓冲区时"}]},{"ID":"20251114171536-gjompa1","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114171536-gjompa1","updated":"20251114171639"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"public ComputeShader computeShader;     // 声明 computeShader 变量，可以通过 Inspector 窗口关联，也可以动态加载\n\nvoid Start()\n{\n    int index = computeShader.FindKernel(\"CSMain\");     // 获取 computeShader 中名为 CSMain 的函数索引\n\n    // AppendStructuredBuffer / ConsumeStructuredBuffer\n    // 假设 AppendStructuredBuffer 最多能加 10 个 float(4byte) 数据，ConsumeStructuredBuffer 包含 10 个float(4byte)数据\n    var computeBuffer3 = new ComputeBuffer(10, 4, ComputeBufferType.Append);\n    var computeBuffer4 = new ComputeBuffer(10, 4, ComputeBufferType.Append);\n    // 如果是只能加的 AppendStructuredBuffer，需要设置为0，\n    computeBuffer3.SetCounterValue(0);  // 告诉ComputeShader，AppendStructuredBuffer内无数据\n    computeShader.SetBuffer(index2, \"buffer5\", computeBuffer3);\n    // 如果是只能减的 ConsumeStructuredBuffer，需要设置其数据\n    var list3 = new List\u003cfloat\u003e();\n    for (int i = 0; i \u003c 10; i++)\n    {\n        list2.Add(i);\n    }\n    computeBuffer4.SetData(list3);\n    computeShader.SetBuffer(index2, \"buffer6\", computeBuffer4);\n\n    computeShader.Dispatch(index, 64, 64, 0);           // 启动 CSMain 的计算\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]}]},{"ID":"20251114154106-exxwhov","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251114154106-exxwhov","name":"computeShader.SetTexture()","updated":"20251114172605"},"Children":[{"Type":"NodeText","Data":"纹理类型输入"}]},{"ID":"20251114154243-lf00fae","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114154243-lf00fae","updated":"20251114154254"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"computeShader.SetTexture(入口函数索引, 变量名, 纹理对象)\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114154414-knti04e","Type":"NodeParagraph","Properties":{"id":"20251114154414-knti04e","updated":"20251114154428"},"Children":[{"Type":"NodeText","Data":"其中输入的纹理对象类型："}]},{"ID":"20251114154231-wp5skoy","Type":"NodeList","ListData":{},"Properties":{"id":"20251114154231-wp5skoy","updated":"20251114154304"},"Children":[{"ID":"20251114154304-7jmpt0o","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251114154304-7jmpt0o","updated":"20251114154304"},"Children":[{"ID":"20251114154304-5eksa7l","Type":"NodeParagraph","Properties":{"id":"20251114154304-5eksa7l","updated":"20251114172029"},"Children":[{"Type":"NodeText","Data":"普通 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Texture2D"},{"Type":"NodeText","Data":"​：只能读，不能写，适合作为输入，ComputeShader 使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Texture2D\u0026lt;T\u0026gt;"},{"Type":"NodeText","Data":"​ 接收"}]}]},{"ID":"20251114154305-ntmil5y","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251114154305-ntmil5y","updated":"20251114154305"},"Children":[{"ID":"20251114154305-6015byc","Type":"NodeParagraph","Properties":{"id":"20251114154305-6015byc","updated":"20251114172036"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​：可随机写，适合作为输出，ComputeShader 使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RWTexture2D\u0026lt;T\u0026gt;"},{"Type":"NodeText","Data":"​ 接收"}]},{"ID":"20251114154300-j3i3gms","Type":"NodeBlockquote","Properties":{"id":"20251114154300-j3i3gms","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20251114154313"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251114154313-o765vus","Type":"NodeParagraph","Properties":{"id":"20251114154313-o765vus","updated":"20251114154313"},"Children":[{"Type":"NodeText","Data":"注意："}]},{"ID":"20251114154323-aaw2ej9","Type":"NodeParagraph","Properties":{"id":"20251114154323-aaw2ej9","updated":"20251114154405"},"Children":[{"Type":"NodeText","Data":"如果需要传入 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​ 对象，需要将其 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"enableRandomWrite"},{"Type":"NodeText","Data":"​ 属性设置为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"true"},{"Type":"NodeText","Data":"​，代表可随机写入，一般是用于写入的纹理资源\n​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RWTexture2D"},{"Type":"NodeText","Data":"​ / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RWTexture3D"},{"Type":"NodeText","Data":"​ 绑定的纹理必须是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"enableRandomWrite = true"},{"Type":"NodeText","Data":"​ 的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​"}]}]}]}]},{"ID":"20251114172503-a1wgtxd","Type":"NodeParagraph","Properties":{"id":"20251114172503-a1wgtxd","updated":"20251114172506"},"Children":[{"Type":"NodeText","Data":"假设要输入以下 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ComputeShader"},{"Type":"NodeText","Data":"​ 变量："}]},{"ID":"20251114172503-yr4ba9v","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114172503-yr4ba9v","updated":"20251114172513"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"Texture2D\u003cfloat4\u003e tex;\nRWTexture2D\u003cfloat4\u003e tex2;\n\n[numthreads(8,8,1)]\nvoid CSMain (uint3 id : SV_DispatchThreadID) { /*...*/ }\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114172515-arckbz0","Type":"NodeParagraph","Properties":{"id":"20251114172515-arckbz0","updated":"20251114172524"},"Children":[{"Type":"NodeText","Data":"在 C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 中："}]},{"ID":"20251114172524-nskzp6o","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114172524-nskzp6o","updated":"20251114172605"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"public ComputeShader computeShader;     // 声明 computeShader 变量，可以通过 Inspector 窗口关联，也可以动态加载\npublic Texture2D texture;\n\nvoid Start()\n{\n    int index = computeShader.FindKernel(\"CSMain\");     // 获取 computeShader 中名为 CSMain 的函数索引\n\n    // 传递只读的Texture2D\n    computeShader.SetTexture(index, \"tex\", texture);\n    // 传递可读写的RenderTexture\n    var renderTexture = new RenderTexture(512, 512, 1);\n    renderTexture.enableRandomWrite = true;     // 对于可读可写的RenderTexture，必须设置其可以随机写入\n    computeShader.SetTexture(index, \"tex2\", renderTexture);\n\n    computeShader.Dispatch(index, 64, 64, 0);           // 启动 CSMain 的计算\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114154410-527woin","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251114154410-527woin","updated":"20251114172942"},"Children":[{"Type":"NodeText","Data":"常量缓冲区输入"}]},{"ID":"20251114154446-3iyy8r6","Type":"NodeParagraph","Properties":{"id":"20251114154446-3iyy8r6","updated":"20251114172727"},"Children":[{"Type":"NodeText","Data":"只需要匹配 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"cbuffer"},{"Type":"NodeText","Data":"​ 中声明的变量名直接使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SetXXX()"},{"Type":"NodeText","Data":"​ 方法进行设置即可，和 C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 设置 Compute Shader 基本类型变量一样"}]},{"ID":"20251114172907-fhk46l6","Type":"NodeParagraph","Properties":{"id":"20251114172907-fhk46l6","updated":"20251114172913"},"Children":[{"Type":"NodeText","Data":"假设要输入以下 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ComputeShader"},{"Type":"NodeText","Data":"​ 常量缓冲区："}]},{"ID":"20251114172907-i4wuj8y","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114172907-i4wuj8y","updated":"20251114172922"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"cbuffer Params\n{\n    float deltaTime;\n    float intensity;\n    int count;\n};\n\n[numthreads(8,8,1)]\nvoid CSMain (uint3 id : SV_DispatchThreadID) { /*...*/ }\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114172925-k3u3iha","Type":"NodeParagraph","Properties":{"id":"20251114172925-k3u3iha","updated":"20251114172929"},"Children":[{"Type":"NodeText","Data":"在 C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 中："}]},{"ID":"20251114172934-ihlnddq","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114172934-ihlnddq","updated":"20251114172942"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"public ComputeShader computeShader;     // 声明 computeShader 变量，可以通过 Inspector 窗口关联，也可以动态加载\npublic Texture2D texture;\n\nvoid Start()\n{\n    int index = computeShader.FindKernel(\"CSMain\");     // 获取 computeShader 中名为 CSMain 的函数索引\n\n    // 设置常量缓冲区的值\n    computeShader.SetFloat(\"deltaTime\", 1.0f);\n    computeShader.SetFloat(\"intensity\", 2.5f);\n    computeShader.SetInt(\"count\", 10);\n\n    computeShader.Dispatch(index, 64, 64, 0);           // 启动 CSMain 的计算\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]}