k","TextMarkType":"code","TextMarkTextContent":"Set"},{"Type":"NodeText","Data":"​ 相关方法都需要在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Dispatch"},{"Type":"NodeText","Data":"​ 之前调用"}]}]},{"ID":"20251114152447-41sueyw","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251114152447-41sueyw","updated":"20251114152447"},"Children":[{"ID":"20251114152447-v7q70ji","Type":"NodeParagraph","Properties":{"id":"20251114152447-v7q70ji","updated":"20251114152516"},"Children":[{"Type":"NodeText","Data":"所有变量名需要和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ComputeShader"},{"Type":"NodeText","Data":"​ 内声明一致"}]}]}]}]},{"ID":"20251114154834-o3ecuil","Type":"NodeParagraph","Properties":{"id":"20251114154834-o3ecuil","updated":"20251114170914"},"Children":[{"Type":"NodeText","Data":"假设要输入以下 ComputeShader 变量："}]},{"ID":"20251114154820-n4p3mj4","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114154820-n4p3mj4","updated":"20251114154951"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"bool b;\nint i;\nuint ui;\nfloat f;\n\n[numthreads(8,8,1)]\nvoid CSMain (uint3 id : SV_DispatchThreadID) { /*...*/ }\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114155005-o8ncx70","Type":"NodeParagraph","Properties":{"id":"20251114155005-o8ncx70","updated":"20251114164133"},"Children":[{"Type":"NodeText","Data":"在 C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 中："}]},{"ID":"20251114154955-n1wz4s2","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114154955-n1wz4s2","updated":"20251114155038"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"public ComputeShader computeShader;     // 声明 computeShader 变量，可以通过 Inspector 窗口关联，也可以动态加载\n\nvoid Start()\n{\n    int index = computeShader.FindKernel(\"CSMain\");     // 获取 computeShader 中名为 CSMain 的函数索引\n\n    computeShader.SetBool(\"b\", true);\n    computeShader.SetInt(\"i\", 100);\n    computeShader.SetInt(\"ui\", 999);\n    computeShader.SetFloat(\"f\", 1.0f);\n\n    computeShader.Dispatch(index, 64, 64, 0);           // 启动 CSMain 的计算\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114152755-5ztgu2p","Type":"NodeHeading","HeadingLevel":3,"Properties":{"alias":"computeShader.SetFloats(),computeShader.SetInts()","id":"20251114152755-5ztgu2p","name":"computeShader.SetVector()","updated":"20251114174406"},"Children":[{"Type":"NodeText","Data":"向量数据输入"}]},{"ID":"20251114152806-hxneftz","Type":"NodeParagraph","Properties":{"id":"20251114152806-hxneftz","updated":"20251114161354"},"Children":[{"Type":"NodeText","Data":"向量数据类型都是通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SetVector"},{"Type":"NodeText","Data":"​ 进行输入，有几个元素就传几个元素数值进去即可，\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"但是，如果是非 4 维的向量，建议使用"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"code strong","TextMarkTextContent":"SetFloats"},{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"、"},{"Type":"NodeTextMark","TextMarkType":"code strong","TextMarkTextContent":"SetInts"},{"Type":"NodeText","Data":"​（存疑，需要进一步验证）"}]},{"ID":"20251114152806-4m050tj","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251114152806-4m050tj","updated":"20251114152903"},"Children":[{"ID":"20251114152903-ytb5raf","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251114152903-ytb5raf","updated":"20251114152903"},"Children":[{"ID":"20251114152903-q8qc0c4","Type":"NodeParagraph","Properties":{"id":"20251114152903-q8qc0c4","updated":"20251114153123"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"float2"},{"Type":"NodeText","Data":"​"}]},{"ID":"20251114155324-nbof0ua","Type":"NodeParagraph","Properties":{"id":"20251114155324-nbof0ua","updated":"20251114155400"},"Children":[{"Type":"NodeText","Data":"需要传入 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Vector4"},{"Type":"NodeText","Data":"​ 类型向量，Compute Shader 内部会自动截取前两个分量"}]},{"ID":"20251114152927-p71zwk2","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114152927-p71zwk2","updated":"20251114152945"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"computeShader.SetVector(\"name\", new Vector4(x, y, 0, 0))\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114152938-tiznt11","Type":"NodeParagraph","Properties":{"id":"20251114152938-tiznt11","updated":"20251114152938"},"Children":[{"Type":"NodeText","Data":"建议："}]},{"ID":"20251114152936-4fyv37q","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114152936-4fyv37q","updated":"20251114152957"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"computeShader.SetFloats(\"name\", ....)\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]},{"ID":"20251114152903-bms9yr2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251114152903-bms9yr2","updated":"20251114152903"},"Children":[{"ID":"20251114152903-ypp9l9v","Type":"NodeParagraph","Properties":{"id":"20251114152903-ypp9l9v","updated":"20251114153126"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"float3"},{"Type":"NodeText","Data":"​"}]},{"ID":"20251114155405-me5m2p1","Type":"NodeParagraph","Properties":{"id":"20251114155405-me5m2p1","updated":"20251114155409"},"Children":[{"Type":"NodeText","Data":"需要传入 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Vector4"},{"Type":"NodeText","Data":"​ 类型向量，Compute Shader 内部会自动截取前三个分量"}]},{"ID":"20251114152929-y24et9l","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114152929-y24et9l","updated":"20251114153140"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"computeShader.SetVector(\"name\", new Vector4(x, y, z, 0))\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114153132-31leb7k","Type":"NodeParagraph","Properties":{"id":"20251114153132-31leb7k","updated":"20251114153153"},"Children":[{"Type":"NodeText","Data":"建议："}]},{"ID":"20251114153153-rinoo0c","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114153153-rinoo0c","updated":"20251114153159"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"computeShader.SetFloats(\"name\", ....)\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]},{"ID":"20251114152903-0s0sdq0","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251114152903-0s0sdq0","updated":"20251114152903"},"Children":[{"ID":"20251114152903-ldkvs1q","Type":"NodeParagraph","Properties":{"id":"20251114152903-ldkvs1q","updated":"20251114153209"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"float4"},{"Type":"NodeText","Data":"​"}]},{"ID":"20251114152930-e8ao1c3","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114152930-e8ao1c3","updated":"20251114153208"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"computeShader.SetVector(\"name\", new Vector4(x, y, z, w))\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]}]},{"ID":"20251114155637-1bmz74w","Type":"NodeParagraph","Properties":{"id":"20251114155637-1bmz74w","updated":"20251114170910"},"Children":[{"Type":"NodeText","Data":"假设要输入以下 ComputeShader 变量："}]},{"ID":"20251114155637-bc25z0n","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114155637-bc25z0n","updated":"20251114155643"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"float2 f2;\nfloat3 f3;\nfloat4 f4;\nint2 i2;\nint3 i3;\nint4 i4;\n\n[numthreads(8,8,1)]\nvoid CSMain (uint3 id : SV_DispatchThreadID) { /*...*/ }\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114155650-k0g2gnn","Type":"NodeParagraph","Properties":{"id":"20251114155650-k0g2gnn","updated":"20251114155652"},"Children":[{"Type":"NodeText","Data":"在 C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 中："}]},{"ID":"20251114155650-1iwkyez","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114155650-1iwkyez","updated":"20251114155848"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"public ComputeShader computeShader;     // 声明 computeShader 变量，可以通过 Inspector 窗口关联，也可以动态加载\n\nvoid Start()\n{\n    int index = computeShader.FindKernel(\"CSMain\");     // 获取 computeShader 中名为 CSMain 的函数索引\n\n    computeShader.SetVector(\"f2\", new Vector4(1, 2, 0, 0));\n    computeShader.SetVector(\"f3\", new Vector4(1, 2, 3, 0));\n    computeShader.SetVector(\"f4\", new Vector4(1, 2, 3, 4));\n    // int类型向量也使用Vector4传递\n    computeShader.SetVector(\"i2\", new Vector4(1, 2, 0, 0));\n    computeShader.SetVector(\"i3\", new Vector4(1, 2, 3, 0));\n    computeShader.SetVector(\"i4\", new Vector4(1, 2, 3, 4));\n\n    computeShader.Dispatch(index, 64, 64, 0);           // 启动 CSMain 的计算\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114173059-8nqqd7z","Type":"NodeParagraph","Properties":{"id":"20251114173059-8nqqd7z","updated":"20251114173608"},"Children":[{"Type":"NodeText","Data":"对于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Vector2"},{"Type":"NodeText","Data":"​ 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Vector3"},{"Type":"NodeText","Data":"​ 向量以及 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"int"},{"Type":"NodeText","Data":"​ 类型向量，使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SetVector"},{"Type":"NodeText","Data":"​ 方法传递由于会将值放在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Vector4"},{"Type":"NodeText","Data":"​ 内，\n因此 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Vector4"},{"Type":"NodeText","Data":"​ 内部分分量会被抛弃，在部分平台上有风险，因此，对于非 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Vector4"},{"Type":"NodeText","Data":"​ 数据的传递，建议使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SetFloats"},{"Type":"NodeText","Data":"​ 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SetInts"},{"Type":"NodeText","Data":"​ 方法"}]},{"ID":"20251114173256-ou742sg","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114173256-ou742sg","updated":"20251114173545"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"public ComputeShader computeShader;     // 声明 computeShader 变量，可以通过 Inspector 窗口关联，也可以动态加载\n\nvoid Start()\n{\n    int index = computeShader.FindKernel(\"CSMain\");     // 获取 computeShader 中名为 CSMain 的函数索引\n\n    computeShader.SetFloats(\"f2\", 1, 2);\n    computeShader.SetFloats(\"f3\", 1, 2, 3);\n    computeShader.SetVector(\"f4\", new Vector4(1, 2, 3, 4));\n    computeShader.SetInts(\"i2\", 1, 2);\n    computeShader.SetInts(\"i3\", 1, 2, 3);\n    computeShader.SetInts(\"i4\", 1, 2, 3, 4);\n\n    computeShader.Dispatch(index, 64, 64, 0);           // 启动 CSMain 的计算\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114173830-r27ucjd","Type":"NodeParagraph","Properties":{"id":"20251114173830-r27ucjd","updated":"20251114173902"},"Children":[{"Type":"NodeText","Data":"对于数组类型变量，也可以使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SetFloats"},{"Type":"NodeText","Data":"​ 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SetInts"},{"Type":"NodeText","Data":"​ 方法传递"}]},{"ID":"20251114173902-1a2vgkx","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114173902-1a2vgkx","updated":"20251114174214"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"float fArray[10];\n\n[numthreads(8,8,1)]\nvoid CSMain (uint3 id : SV_DispatchThreadID) { /*...*/ }\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114174235-y2nuioe","Type":"NodeParagraph","Properties":{"id":"20251114174235-y2nuioe","updated":"20251114174235"},"Children":[{"Type":"NodeText","Data":"在 C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 中："}]},{"ID":"20251114174235-4fgbo6h","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114174235-4fgbo6h","updated":"20251114174406"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"public ComputeShader computeShader;     // 声明 computeShader 变量，可以通过 Inspector 窗口关联，也可以动态加载\n\nvoid Start()\n{\n    int index = computeShader.FindKernel(\"CSMain\");     // 获取 computeShader 中名为 CSMain 的函数索引\n\n    computeShader.SetFloats(\"fArray\", 1, 2, 3, 4, 5, 6, 7, 8);\n\n    computeShader.Dispatch(index, 64, 64, 0);           // 启动 CSMain 的计算\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114153310-8li8xt9","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251114153310-8li8xt9","name":"computeShader.SetMatrix()","updated":"20251114170857"},"Children":[{"Type":"NodeText","Data":"矩阵数据输入"}]},{"ID":"20251114153324-8s6ci0k","Type":"NodeList","ListData":{},"Properties":{"id":"20251114153324-8s6ci0k","updated":"20251114153332"},"Children":[{"ID":"20251114153332-leoc7gh","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251114153332-leoc7gh","updated":"20251114153332"},"Children":[{"ID":"20251114153332-rbugckr","Type":"NodeParagraph","Properties":{"id":"20251114153332-rbugckr","updated":"20251114153339"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"float4x4"},{"Type":"NodeText","Data":"​"}]},{"ID":"20251114153339-88w89ko","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114153339-88w89ko","updated":"20251114153356"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"computeShader.SetMatrix(\"name\", Matrix4x4)\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]}]},{"ID":"20251114153406-fjatyfc","Type":"NodeParagraph","Properties":{"id":"20251114153406-fjatyfc","updated":"20251114153510"},"Children":[{"Type":"NodeText","Data":"如果想要传小于 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"4 \\times 4"},{"Type":"NodeText","Data":" 的矩阵，还是使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SetMatrix()"},{"Type":"NodeText","Data":"​ 传 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Matrix4x4"},{"Type":"NodeText","Data":"​ 类型矩阵，然后在 Compute Shader 中进行截取转换"}]},{"ID":"20251114153434-wmhxvxl","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114153434-wmhxvxl","updated":"20251114153626"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"// 常量参数\nfloat4x4 _M;   // 用 SetMatrix 传\n\n[numthreads(8,8,1)]\nvoid CSMain (uint3 id : SV_DispatchThreadID)\n{\n    // 需要 3x3 时：\n    float3x3 M3 = (float3x3)_M;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114161603-nc5x7bg","Type":"NodeParagraph","Properties":{"id":"20251114161603-nc5x7bg","updated":"20251114170857"},"Children":[{"Type":"NodeText","Data":"假设要输入以下 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ComputeShader"},{"Type":"NodeText","Data":"​ 变量："}]},{"ID":"20251114161623-msfjvxq","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114161623-msfjvxq","updated":"20251114164240"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"float4x4 f44;\nfloat4x4 f33; // 传递使用4x4矩阵，实际作为3x3矩阵使用\nfloat4x4 f22; // 传递使用4x4矩阵，实际作为2x2矩阵使用\n\n[numthreads(8,8,1)]\nvoid CSMain (uint3 id : SV_DispatchThreadID)\n{\n    // 对于非4x4的矩阵传递，因为只能传递4x4矩阵，因此我们需要手动去截取\n    float3x3 m33 = (float3x3)f33;   // 需要手动去截取矩阵\n    float2x2 m22 = (float2x2)f22;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114164138-sdqf9au","Type":"NodeParagraph","Properties":{"id":"20251114164138-sdqf9au","updated":"20251114164139"},"Children":[{"Type":"NodeText","Data":"在 C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 中："}]},{"ID":"20251114164140-vau07r8","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114164140-vau07r8","updated":"20251114164204"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"public ComputeShader computeShader;     // 声明 computeShader 变量，可以通过 Inspector 窗口关联，也可以动态加载\n\nvoid Start()\n{\n    int index = computeShader.FindKernel(\"CSMain\");     // 获取 computeShader 中名为 CSMain 的函数索引\n\n    computeShader.SetMatrix(\"f44\", Matrix4x4.identity);\n    computeShader.SetMatrix(\"f33\", Matrix4x4.identity);\n    computeShader.SetMatrix(\"f22\", Matrix4x4.identity);\n\n    computeShader.Dispatch(index, 64, 64, 0);           // 启动 CSMain 的计算\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114153531-6bs35pt","Type":"NodeHeading","HeadingLevel":3,"Properties":{"alias":"ComputeBuffer,computeBuffer.SetData(),ComputeBufferType","id":"20251114153531-6bs35pt","name":"computeShader.SetBuffer()","updated":"20251121113104"},"Children":[{"Type":"NodeText","Data":"复合类型输入"}]},{"ID":"20251114153732-ur3pvhz","Type":"NodeParagraph","Properties":{"id":"20251114153732-ur3pvhz","updated":"20251114153831"},"Children":[{"Type":"NodeText","Data":"Compute Shader 的结构体和缓冲区数据需要通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ComputeBuffer"},{"Type":"NodeText","Data":"​ 传入\n这个 Buffer 相当于 CPU 和 GPU 之间的共享显存区域\nGPU 端（HLSL）和 CPU 端（C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":"）都要定义完全相同的结构布局\n因此必须满足以下三个关键点:"}]},{"ID":"20251114153831-umkvv0w","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251114153831-umkvv0w","updated":"20251114153831"},"Children":[{"ID":"20251114153831-apvj9bx","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"P