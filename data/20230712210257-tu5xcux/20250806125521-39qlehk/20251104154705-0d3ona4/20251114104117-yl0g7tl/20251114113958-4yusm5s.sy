14114952-cg5rw7b","updated":"20251114115002"},"Children":[{"Type":"NodeText","Data":"用于将一组常量打包在一起传给 ComputeShader，按块上传数据更高效，驱动可以批量上传并放进高效缓存"}]},{"ID":"20251114114941-s3apm0h","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114114941-s3apm0h","updated":"20251114152206"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"cbuffer 自定义常量区名（常用 Params）: register(b[寄存器索引])\t// \": register(b[寄存器索引])\" 部分可省略\n{\n    // 各类型数据\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114115008-3m1yzoh","Type":"NodeBlockquote","Properties":{"id":"20251114115008-3m1yzoh","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20251114115102"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251114115016-o8zslgi","Type":"NodeParagraph","Properties":{"id":"20251114115016-o8zslgi","updated":"20251114115052"},"Children":[{"Type":"NodeText","Data":"注意：\n后面的寄存器索引相关 : "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"register(b[寄存器索引])"},{"Type":"NodeText","Data":"​ 可省略，省略后Unity会自动分配\n如果要写，所以必须是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"b0"},{"Type":"NodeText","Data":"​ 到 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"b13"},{"Type":"NodeText","Data":"​，代表14个常量缓冲区\n在编写 Compute Shader 时，应当尽量使用较少的 cbuffer，并注意每个平台的最大常量缓冲区数量"}]}]},{"ID":"20251114152147-i4wwo2f","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114152147-i4wwo2f","updated":"20251114152149"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"cbuffer Params : register(b0)\n{\n    float deltaTime;\n    float intensity;\n    int count;\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]}