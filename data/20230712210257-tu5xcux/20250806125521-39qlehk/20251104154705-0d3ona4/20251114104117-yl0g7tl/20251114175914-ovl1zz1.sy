a":"比如："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[numthreads(8, 8, 1)]"},{"Type":"NodeText","Data":"​，表示每个线程组有 8 "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":" 8 "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":" 1 = 64 个线程"}]}]},{"ID":"20251114180305-h9qtutz","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251114180305-h9qtutz","updated":"20251120112811"},"Children":[{"ID":"20251114180305-5en18hi","Type":"NodeParagraph","Properties":{"id":"20251114180305-5en18hi","updated":"20251114180347"},"Children":[{"Type":"NodeText","Data":"C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 侧调用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Dispatch"},{"Type":"NodeText","Data":"​ 时传入的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"x"},{"Type":"NodeText","Data":"​、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"y"},{"Type":"NodeText","Data":"​、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"z"},{"Type":"NodeText","Data":"​ 决定一共有多少个线程组"}]},{"ID":"20251114180349-gc9slyg","Type":"NodeParagraph","Properties":{"id":"20251114180349-gc9slyg","updated":"20251120112811"},"Children":[{"Type":"NodeText","Data":"比如：入口函数："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[numthreads(8, 8, 1)]"},{"Type":"NodeText","Data":"​，C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 调用："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Dispatch(kernel, 64, 64, 1);"},{"Type":"NodeText","Data":"​\n表示一共会开启 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"(64 * 8, 64 * 8, 1 * 1) = (512, 512, 1) = 512 * 512 * 1 = 262144"},{"Type":"NodeText","Data":"​ 个线程"}]}]}]},{"ID":"20251114180301-lqieqv2","Type":"NodeParagraph","Properties":{"id":"20251114180301-lqieqv2","updated":"20251114180534"},"Children":[{"Type":"NodeText","Data":"也就是说他们两共同决定了线程总数："}]},{"ID":"20251114180535-kkttr51","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251114180535-kkttr51","updated":"20251114180537"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"总线程数 = numthreads(x,y,z) * Dispatch(groupsX,groupsY,groupsZ)\n        = (groupsX * x, groupsY * y, groupsZ * y)\n        = groupsX * x * groupsY * y * groupsZ * y\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251114180301-hgxv5uu","Type":"NodeBlockquote","Properties":{"id":"20251114180301-hgxv5uu","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20251114180657"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251114180609-ikhkju5","Type":"NodeParagraph","Properties":{"id":"20251114180609-ikhkju5","updated":"20251114180646"},"Children":[{"Type":"NodeText","Data":"注意：每个轴的线程或线程组数不能设置为 0，最小为 1，即 x, y, z \u003e= 1"}]},{"ID":"20251114180624-awv9v0s","Type":"NodeList","ListData":{},"Properties":{"id":"20251114180624-awv9v0s","updated":"20251114180657"},"Children":[{"ID":"20251114180624-ii0cwqw","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251114180624-ii0cwqw","updated":"20251114180624"},"Children":[{"ID":"20251114180624-038l88v","Type":"NodeParagraph","Properties":{"id":"20251114180624-038l88v","updated":"20251114180635"},"Children":[{"Type":"NodeText","Data":"如果是 1D 任务（一维数据，比如处理线性数组计算）：x,1,1"}]}]},{"ID":"20251114180625-tiqdogt","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"2025111418062