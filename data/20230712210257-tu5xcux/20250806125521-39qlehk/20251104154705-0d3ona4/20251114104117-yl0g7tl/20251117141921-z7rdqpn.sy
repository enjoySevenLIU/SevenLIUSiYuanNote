{"ID":"20251117141921-z7rdqpn","Spec":"1","Type":"NodeDocument","Properties":{"id":"20251117141921-z7rdqpn","title":"UPL9-17-f——获取 GPU 数据","type":"doc","updated":"20251120171408"},"Children":[{"ID":"20251120165951-3131hgt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251120165951-3131hgt","updated":"20251120170901"},"Children":[{"Type":"NodeText","Data":"本章代码关键字"}]},{"ID":"20251120165956-jp8nusa","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251120165956-jp8nusa","updated":"20251120170901"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"computeBuffer.GetData()\t\t\t\t\t// 同步获取ComputeBuffer对象的计算结果，传入需要获取结果的数组即可\nAsyncGPUReadback.Request()\t\t\t\t// 异步读取GPU计算结果请求，需要传入要异步获取数据的对象，例如ComputeBuffer和RenderTexture\nAsyncGPUReadbackRequest\t\t\t\t\t// 异步读取GPU计算结果的请求类，通过该类获取计算结果\nasyncGPUReadbackRequest.GetData\u003c\u003e()\t\t// 获取GPU计算结果，返回NativeArray\u003c\u003e，泛型参数如果是数组传入数组元素的类型，如果是数组传入Color类型\nasyncGPUReadbackRequest.hasError\t\t// GPU计算是否有报错\nRenderTexture.active\t\t\t\t\t// 当前GPU输出缓冲的指针，指向一个RenderTexture\ntexture.ReadPixels()\t\t\t\t\t// 从RenderTexture.active指向的内容读取像素数据，读取范围和偏移由Rect结构体决定\ntexture.SetPixelData()\t\t\t\t\t// 从NativeArray\u003cColor\u003e直接读取颜色数据\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251117141921-g5nprr2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251117141921-g5nprr2","updated":"20251120150417"},"Children":[{"Type":"NodeText","Data":"哪些数据可以被获取"}]},{"ID":"20251117142003-t1ds5cy","Type":"NodeParagraph","Properties":{"id":"20251117142003-t1ds5cy","updated":"20251117142026"},"Children":[{"Type":"NodeText","Data":"想要在 CPU 侧（C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 中）获取通过 Compute Shader 在 GPU 中计算完成的数据，必须要满足以下的条件："}]},{"ID":"20251117142026-ki7dti0","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251117142026-ki7dti0","updated":"20251120150417"},"Children":[{"ID":"20251117142026-h02wqg2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251117142026-h02wqg2","updated":"20251120150405"},"Children":[{"ID":"20251117142026-z4hx7k4","Type":"NodeParagraph","Properties":{"id":"20251117142026-z4hx7k4","updated":"20251117142026"},"Children":[{"Type":"NodeText","Data":"数据在 GPU 中必须是 可读写 的资源"}]},{"ID":"20251117142029-m0tru7v","Type":"NodeParagraph","Properties":{"id":"20251117142029-m0tru7v","updated":"20251117142029"},"Children":[{"Type":"NodeText","Data":"常见的可读写资源包括："}]},{"ID":"20251117142038-d1pg7yc","Type":"NodeList","ListData":{},"Properties":{"id":"20251117142038-d1pg7yc","updated":"20251120150405"},"Children":[{"ID":"20251117142039-txbu43t","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251117142039-txbu43t","updated":"20251120150405"},"Children":[{"ID":"20251117142039-sxvpvp7","Type":"NodeParagraph","Properties":{"id":"20251117142039-sxvpvp7","updated":"20251120150405"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RWStructuredBuffer"},{"Type":"NodeText","Data":"​ / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RWByteAddressBuffer"},{"Type":"NodeText","Data":"​（对应 C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ComputeBuffer"},{"Type":"NodeText","Data":"​）"}]}]},{"ID":"20251117142040-d4w9z8z","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251117142040-d4w9z8z","updated":"20251120150357"},"Children":[{"ID":"20251117142040-z0pgilr","Type":"NodeParagraph","Properties":{"id":"20251117142040-z0pgilr","updated":"20251120150357"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RWTexture2D"},{"Type":"NodeText","Data":"​ / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RWTexture3D"},{"Type":"NodeText","Data":"​（对应 C"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"#"}]},{"Type":"NodeText","Data":" 的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​）"}]}]}]},{"ID":"20251117142037-3kvok97","Type":"NodeParagraph","Properties":{"id":"20251117142037-3kvok97","updated":"20251117142037"},"Children":[{"Type":"NodeText","Data":"只有 GPU 写入了这些资源，CPU 才有可获取的结果"}]}]},{"ID":"20251117142026-flk40v5","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251117142026-flk40v5","updated":"20251120150417"},"Children":[{"ID":"20251117142026-rumj82f","Type":"NodeParagraph","Properties":{"id":"20251117142026-rumj82f","updated":"20251117142107"},"Children":[{"Type":"NodeText","Data":"数据在 CPU 和 GPU 之间必须通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ComputeBuffer"},{"Type":"NodeText","Data":"​ 或 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Texture"},{"Type":"NodeText","Data":"​ 形式传递"}]},{"ID":"20251117142058-ymgsq1d","Type":"NodeBlockquote","Properties":{"id":"20251117142058-ymgsq1d","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20251120150417"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251117142059-qqx6xuc","Type":"NodeParagraph","Properties":{"id":"20251117142059-qqx6xuc","updated":"20251117142113"},"Children":[{"Type":"NodeText","Data":"注意："}]},{"ID":"20251117142113-2l82xuz","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251117142113-2l82xuz","updated":"20251120150417"},"Children":[{"ID":"20251117142113-jqb34mn","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251117142113-jqb34mn","updated":"20251117142130"},"Children":[{"ID":"20251117142113-i702d3i","Type":"NodeParagraph","Properties":{"id":"20251117142113-i702d3i","updated":"20251117142130"},"Children":[{"Type":"NodeText","Data":"对于 标量类型、向量类型、矩阵类型 如果想要读取，需要使用可读写缓冲区进行包裹利用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ComputeBuffer"},{"Type":"NodeText","Data":"​ 进行传递"}]}]},{"ID":"20251117142113-r6lfw2o","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251117142113-r6lfw2o","updated":"20251120150417"},"Children":[{"ID":"20251117142113-09r5b12","Type":"NodeParagraph","Properties":{"id":"20251117142113-09r5b12","updated":"20251120150417"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"cbuffer"},{"Type":"NodeText","Data":"​（常量缓冲区）是单向的，只能 CPU 到 GPU，不可反向读取"}]}]}]}]}]}]},{"ID":"20251117142131-xi4wy1u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251117142131-xi4wy1u","updated":"20251120155743"},"Children":[{"Type":"NodeText","Data":"获取 GPU 侧计算好的数据 —— ComputeBuffer"}]},{"ID":"20251120153807-tsp68fa","Type":"NodeParagraph","Properties":{"id":"20251120153807-tsp68fa","updated":"20251120154047"},"Children":[{"Type":"NodeText","Data":"假设我们通过 Compute Shader 计算一个 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"int"},{"Type":"NodeText","Data":"​ 数组和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Test"},{"Type":"NodeText","Data":"​ 结构体数组，通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"buffer"},{"Type":"NodeText","Data":"​ 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"buffer2"},{"Type":"NodeText","Data":"​ 接收计算结果"}]},{"ID":"20251120154011-7whrlrt","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251120154011-7whrlrt","updated":"20251120154021"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"#pragma kernel CSMain\n#pragma kernel CSMain2\n\nstruct Test\n{\n    float3 pos;\n    float3 v;\n    float lifeTime;\n};\n\nRWStructuredBuffer\u003cint\u003e buffer;\nRWStructuredBuffer\u003cTest\u003e buffer2;\n\n[numthreads(32,1,1)]\nvoid CSMain (uint3 id : SV_DispatchThreadID)\n{\n    buffer[id.x] = id.x;\n}\n\n[numthreads(32,1,1)]\nvoid CSMain2 (uint3 id : SV_DispatchThreadID)\n{\n    Test t = buffer2[id.x];\n    t.pos.x = id.x;\n    t.v.y = id.x * 10;\n    t.lifeTime = 999;\n    buffer2[id.x] = t;  // 修改完结构体需要再存回去\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251117142216-iqmybvl","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251117142216-iqmybvl","name":"computeBuffer.GetData()","updated":"20251120155743"},"Children":[{"Type":"NodeText","Data":"同步获取 ComputeBuffer 数据"}]},{"ID":"20251117142348-z3kznaz","Type":"NodeParagraph","Properties":{"id":"20251117142348-z3kznaz","updated":"20251117142409"},"Children":[{"Type":"NodeText","Data":"该获取方式主要是利用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ComputeBuffer"},{"Type":"NodeText","Data":"​ 中的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"GetData"},{"Type":"NodeText","Data":"​ 方法\n但是该方法会阻塞 CPU，会等待 GPU 计算完成后得到数据才会继续执行后面的逻辑"}]},{"ID":"20251120154224-vln67l1","Type":"NodeBlockquote","Properties":{"id":"20251120154224-vln67l1","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20251120154339"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251120154225-dxbaz9e","Type":"NodeParagraph","Properties":{"id":"20251120154225-dxbaz9e","updated":"20251120154339"},"Children":[{"Type":"NodeText","Data":"注意：GPU 一定是用来处理大量数据的，若数据量不大，则 CPU 和 GPU 的通信成本可能大于 GPU 的计算成本，反而不如直接使用 CPU 循环处理"}]}]},{"ID":"20251117142410-72l9we1","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251117142410-72l9we1","updated":"20251120155557"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"using UnityEngine;\n\n// size = 12 + 12 + 4 = 28 byte\npublic struct Test\n{\n    public Vector3 pos;\n    public Vector3 v;\n    public float lifetime;\n}\n\npublic class Lesson98 : MonoBehaviour\n{\n    public ComputeShader computeShader;\n\n    void Start()\n    {\n        // 设置int数组计算缓冲区数据\n        var computeBuffer = new ComputeBuffer(1000000, sizeof(int));\n        var array = new int[1000000];\n        computeBuffer.SetData(array);\n        // 设置Test结构体数组计算缓冲区数据\n        var computeBuffer2 = new ComputeBuffer(2000000, 28);\n        var array2 = new Test[1000000];\n        computeBuffer2.SetData(array2);\n        // 将两个缓冲区设置到ComputeShader中\n        var index = computeShader.FindKernel(\"CSMain\");\n        var index2 = computeShader.FindKernel(\"CSMain2\");\n        computeShader.SetBuffer(index, \"buffer\", computeBuffer);\n        computeShader.SetBuffer(index2, \"buffer2\", computeBuffer2);\n        // 计算启动线程组数量，启动ComputeShader\n        int groupNums = Mathf.CeilToInt(1000000f / 32f);\n        computeShader.Dispatch(index, groupNums, 1, 1);\n        int groupNums2 = Mathf.CeilToInt(2000000f / 32f);\n        computeShader.Dispatch(index2, groupNums2, 1, 1);\n\n        computeBuffer.GetData(array);\n        print($\"array: [0]: {array[0]}, [50]: {array[50]}, [500]: {array[500]}, [5000]: {array[5000]}, [50000]: {array[50000]}\");\n        computeBuffer2.GetData(array2);\n        print($\"array2[0]: pos: {array2[0].pos}, v: {array2[0].v}, lifeTime: {array2[0].lifetime}\");\n        print($\"array2[50]: pos: {array2[50].pos}, v: {array2[50].v}, lifeTime: {array2[50].lifetime}\");\n        print($\"array2[500]: pos: {array2[500].pos}, v: {array2[500].v}, lifeTime: {array2[500].lifetime}\");\n        print($\"array2[5000]: pos: {array2[5000].pos}, v: {array2[5000].v}, lifeTime: {array2[5000].lifetime}\");\n    }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251120155558-j8s895c","Type":"NodeParagraph","Properties":{"id":"20251120155558-j8s895c","updated":"20251120155559"},"Children":[{"Type":"NodeText","Data":"输出："}]},{"ID":"20251120155600-c5zplvj","Type":"NodeParagraph","Properties":{"id":"20251120155600-c5zplvj","updated":"20251120155723"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251120155723-ip0j3es.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251120155724-syevd5e","Type":"NodeParagraph","Properties":{"id":"20251120155724-syevd5e","updated":"20251120155743"},"Children":[{"Type":"NodeText","Data":"可以看到，两个数组在 GPU 中计算了数据"}]},{"ID":"20251117142257-g9gpxz8","Type":"NodeHeading","HeadingLevel":3,"Properties":{"alias":"asyncGPUReadbackRequest.GetData\u0026lt;\u0026gt;(),asyncGPUReadbackRequest.hasError","id":"20251117142257-g9gpxz8","name":"AsyncGPUReadback.Request()","updated":"20251120161507"},"Children":[{"Type":"NodeText","Data":"异步获取 ComputeBuffer 数据"}]},{"ID":"20251117142349-c9jj9r3","Type":"NodeParagraph","Properties":{"id":"20251117142349-c9jj9r3","updated":"20251120161011"},"Children":[{"Type":"NodeText","Data":"若不想阻塞 CPU，待 GPU 计算完成后自动回调，则可以使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AsyncGPUReadback.Request()"},{"Type":"NodeText","Data":"​ 方法来异步读取数据，\n需要传入要异步等待获取数据的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ComputeBuffer"},{"Type":"NodeText","Data":"​ 对象，以及参数为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AsyncGPUReadbackRequest"},{"Type":"NodeText","Data":"​ 回调函数，异步获取时最快也得下一帧返回信息"}]},{"ID":"20251120160938-zbvqpgp","Type":"NodeParagraph","Properties":{"id":"20251120160938-zbvqpgp","updated":"20251120161309"},"Children":[{"Type":"NodeText","Data":"通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"asyncGPUReadbackRequest.hasError"},{"Type":"NodeText","Data":"​ 可以判断计算过程中是否出错，若未出错再去通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AsyncGPUReadbackRequest"},{"Type":"NodeText","Data":"​ 获取数据\n通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"asyncGPUReadbackRequest.GetData\u0026lt;\u0026gt;()"},{"Type":"NodeText","Data":"​ 传入数据元素的类型，获取 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"NativeArray\u0026lt;\u0026gt;"},{"Type":"NodeText","Data":"​ 数组，通过该数组即可读取计算结果"}]},{"ID":"20251117144551-976zy7a","Type":"NodeBlockquote","Properties":{"id":"20251117144551-976zy7a","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20251120161420"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251117144552-6xiu2vm","Type":"NodeParagraph","Properties":{"id":"20251117144552-6xiu2vm","updated":"20251120161420"},"Children":[{"Type":"NodeText","Data":"注意：回调函数中参数的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"asyncGPUReadbackRequest.GetData\u0026lt;\u0026gt;()"},{"Type":"NodeText","Data":"​ 方法，传入的泛型是结构体，代表单个元素的类型\n​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"asyncGPUReadbackRequest.GetData\u0026lt;\u0026gt;()"},{"Type":"NodeText","Data":"​ 方法会返回一个 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"NativeArray\u0026lt;\u0026gt;"},{"Type":"NodeText","Data":"​ 数组，建议直接使用，而不建议在此基础上再做任何强转，例如转换为 C# 数组等"}]}]},{"ID":"20251117144559-xlejga6","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251117144559-xlejga6","updated":"20251120161507"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"using UnityEngine;\nusing UnityEngine.Rendering;\n\n// size = 12 + 12 + 4 = 28 byte\npublic struct Test\n{\n    public Vector3 pos;\n    public Vector3 v;\n    public float lifetime;\n}\n\npublic class Lesson98 : MonoBehaviour\n{\n    public ComputeShader computeShader;\n\n    void Start()\n    {\n        // 设置int数组计算缓冲区数据\n        var computeBuffer = new ComputeBuffer(1000000, sizeof(int));\n        var array = new int[1000000];\n        computeBuffer.SetData(array);\n        // 设置Test结构体数组计算缓冲区数据\n        var computeBuffer2 = new ComputeBuffer(2000000, 28);\n        var array2 = new Test[1000000];\n        computeBuffer2.SetData(array2);\n        // 将两个缓冲区设置到ComputeShader中\n        var index = computeShader.FindKernel(\"CSMain\");\n        var index2 = computeShader.FindKernel(\"CSMain2\");\n        computeShader.SetBuffer(index, \"buffer\", computeBuffer);\n        computeShader.SetBuffer(index2, \"buffer2\", computeBuffer2);\n        // 计算启动线程组数量，启动ComputeShader\n        int groupNums = Mathf.CeilToInt(1000000f / 32f);\n        computeShader.Dispatch(index, groupNums, 1, 1);\n        int groupNums2 = Mathf.CeilToInt(2000000f / 32f);\n        computeShader.Dispatch(index2, groupNums2, 1, 1);\n\n        AsyncGPUReadback.Request(computeBuffer, (request) =\u003e\n        {\n            if (!request.hasError)\n            {\n                var array = request.GetData\u003cint\u003e();\t\t// return NativeArray\u003cint\u003e\n                print($\"array: [0]: {array[0]}, [50]: {array[50]}, [500]: {array[500]}, [5000]: {array[5000]}, [50000]: {array[50000]}\");\n            }\n        });\n\n        AsyncGPUReadback.Request(computeBuffer2, (request) =\u003e\n        {\n            if (!request.hasError)\n            {\n                var array2 = request.GetData\u003cTest\u003e();\t// return NativeArray\u003cTest\u003e\n                print($\"array2[0]: pos: {array2[0].pos}, v: {array2[0].v}, lifeTime: {array2[0].lifetime}\");\n                print($\"array2[50]: pos: {array2[50].pos}, v: {array2[50].v}, lifeTime: {array2[50].lifetime}\");\n                print($\"array2[500]: pos: {array2[500].pos}, v: {array2[500].v}, lifeTime: {array2[500].lifetime}\");\n                print($\"array2[5000]: pos: {array2[5000].pos}, v: {array2[5000].v}, lifeTime: {array2[5000].lifetime}\");\n            }\n        });\n    }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251120160705-wm05gam","Type":"NodeParagraph","Properties":{"id":"20251120160705-wm05gam","updated":"20251120160707"},"Children":[{"Type":"NodeText","Data":"输出："}]},{"ID":"20251120160708-oretlvh","Type":"NodeParagraph","Properties":{"id":"20251120160708-oretlvh","updated":"20251120160736"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251120155723-ip0j3es.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251117142145-1hbg7s0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251117142145-1hbg7s0","updated":"20251120165540"},"Children":[{"Type":"NodeText","Data":"获取 GPU 侧计算好的数据 —— Texture"}]},{"ID":"20251120162110-g27o486","Type":"NodeParagraph","Properties":{"id":"20251120162110-g27o486","updated":"20251120162336"},"Children":[{"Type":"NodeText","Data":"假设我们通过 Compute Shader 计算一个贴图的颜色，\n让贴图的左下角为黑色 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RGBA(0,0,0,1)"},{"Type":"NodeText","Data":"​，右下角为红色 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RGBA(1,0,0,1)"},{"Type":"NodeText","Data":"​，左上角为绿色 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RGBA(0,1,0,1)"},{"Type":"NodeText","Data":"​，右上角为红色绿色混合 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RGBA(1,1,0,1)"},{"Type":"NodeText","Data":"​"}]},{"ID":"20251120162344-v570idc","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251120162344-v570idc","updated":"20251120162350"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"#pragma kernel CSMain\n\nfloat textureWidth;             // 贴图的宽度\nfloat textureHeight;            // 贴图的高度\nRWTexture2D\u003cfloat4\u003e Result;\n\n[numthreads(8,8,1)]\nvoid CSMain (uint3 id : SV_DispatchThreadID)\n{\n    // 根据坐标计算像素颜色\n    Result[id.xy] = float4(id.x / textureWidth, id.y / textureHeight, 0, 1);\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251117144707-sd2u4cm","Type":"NodeHeading","HeadingLevel":3,"Properties":{"alias":"RenderTexture.active","id":"20251117144707-sd2u4cm","name":"texture.ReadPixels()","updated":"20251120165540"},"Children":[{"Type":"NodeText","Data":"同步获取 Texture 数据"}]},{"ID":"20251117164747-ingzm9i","Type":"NodeParagraph","Properties":{"id":"20251117164747-ingzm9i","updated":"20251117165038"},"Children":[{"Type":"NodeText","Data":"利用传入 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​ 数据进行写入，写入完成后利用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Texture"},{"Type":"NodeText","Data":"​ 装载结果数据"}]},{"ID":"20251120165035-les11b3","Type":"NodeParagraph","Properties":{"id":"20251120165035-les11b3","updated":"20251120165427"},"Children":[{"Type":"NodeText","Data":"具体做法是，先将 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture.active"},{"Type":"NodeText","Data":"​ （相当于当前 GPU 输出缓冲的指针）设置为传入到 Compute Shader 内的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​\n然后通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"texture.ReadPixels()"},{"Type":"NodeText","Data":"​ 从 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture.active"},{"Type":"NodeText","Data":"​ 读取像素，读取范围就是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​ 的尺寸\n读取完毕后需要使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"texture.Apply()"},{"Type":"NodeText","Data":"​ 应用读取结果"}]},{"ID":"20251120165428-h4liixp","Type":"NodeBlockquote","Properties":{"id":"20251120165428-h4liixp","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20251120165540"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251120165428-lye76wg","Type":"NodeParagraph","Properties":{"id":"20251120165428-lye76wg","updated":"20251120165540"},"Children":[{"Type":"NodeText","Data":"注意，使用完毕后需要将 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture.active"},{"Type":"NodeText","Data":"​ 设置为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"null"},{"Type":"NodeText","Data":"​，释放当前 GPU 输出缓冲的指针，防止影响后续渲染流程\n然后，将计算完毕的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​ 释放（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Release()"},{"Type":"NodeText","Data":"​）掉，避免内存泄漏"}]}]},{"ID":"20251117145048-eqi6lrj","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251117145048-eqi6lrj","updated":"20251120163902"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"using UnityEngine;\nusing UnityEngine.Rendering;\nusing UnityEngine.UI;\n\npublic class Lesson98 : MonoBehaviour\n{\n    public ComputeShader computeShader2;\n    public RawImage image;\n\n    void Start()\n    {\n        // 创建RenderTexture，设置属性，传递到ComputeShader中\n        var renderTexture = new RenderTexture(512, 512, 0);\n        renderTexture.enableRandomWrite = true;\n        renderTexture.Create();                 // 让GPU侧为当前数据分配显存\n        var index3 = computeShader2.FindKernel(\"CSMain\");\n        computeShader2.SetFloat(\"textureWidth\", renderTexture.width);\n        computeShader2.SetFloat(\"textureHeight\", renderTexture.height);\n        computeShader2.SetTexture(index3, \"Result\", renderTexture);\n        // 计算启动线程组数量，确保线程组所有线程覆盖所有像素，启动ComputeShader\n        var groupNumX = Mathf.CeilToInt(renderTexture.width / 8f);\n        var groupNumY = Mathf.CeilToInt(renderTexture.height / 8f);\n        computeShader2.Dispatch(index3, groupNumX, groupNumY, 1);\n\n        // 同步获取结果，如果要同步获取贴图结果，一定要使用Texture类型转存，将计算完毕的贴图显示在UI上\n        var texture = new Texture2D(renderTexture.width, renderTexture.height, TextureFormat.RGBA32, false);\n        RenderTexture.active = renderTexture;   // 将当前GPU输出缓冲的指针指向计算出来的RenderTexture上\n        // 将当前GPU输出缓冲的指针指向的RenderTexture数据读入texture中\n        texture.ReadPixels(new Rect(0, 0, renderTexture.width, renderTexture.height), 0, 0);\n        texture.Apply();                        // 让Texture生效\n        image.texture = texture;\n        RenderTexture.active = null;            // 释放当前GPU输出缓冲的指针，防止影响后续渲染流程\n        renderTexture.Release();                // 释放使用完毕的RenderTexture资源   \n    }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251120163824-9ewgu8w","Type":"NodeParagraph","Properties":{"id":"20251120163824-9ewgu8w","updated":"20251120163827"},"Children":[{"Type":"NodeText","Data":"渲染结果："}]},{"ID":"20251120163827-txvhwvi","Type":"NodeParagraph","Properties":{"id":"20251120163827-txvhwvi","updated":"20251120163827"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251120163827-gqec72t.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251117165131-499ydyk","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251117165131-499ydyk","name":"texture.SetPixelData()","updated":"20251120171408"},"Children":[{"Type":"NodeText","Data":"异步获取 Texture 数据"}]},{"ID":"20251117165136-a9zvmhy","Type":"NodeParagraph","Properties":{"id":"20251117165136-a9zvmhy","updated":"20251120165610"},"Children":[{"Type":"NodeText","Data":"若不想阻塞 CPU，待 GPU 计算完成后自动回调，则可以使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AsyncGPUReadback"},{"Type":"NodeText","Data":"​ 来异步读取数据\n需要传入要异步等待获取数据的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​ 对象，以及参数为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AsyncGPUReadbackRequest"},{"Type":"NodeText","Data":"​ 回调函数，异步获取时最快也得下一帧返回信息"}]},{"ID":"20251120165620-7hrlzth","Type":"NodeParagraph","Properties":{"id":"20251120165620-7hrlzth","updated":"20251120165822"},"Children":[{"Type":"NodeText","Data":"通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"asyncGPUReadbackRequest.hasError"},{"Type":"NodeText","Data":"​ 可以判断计算过程中是否出错，若未出错再去通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AsyncGPUReadbackRequest"},{"Type":"NodeText","Data":"​ 获取数据\n通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"asyncGPUReadbackRequest.GetData\u0026lt;\u0026gt;()"},{"Type":"NodeText","Data":"​ 传入 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Color"},{"Type":"NodeText","Data":"​ 类型，获取 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"NativeArray\u0026lt;Color\u0026gt;"},{"Type":"NodeText","Data":"​ 颜色数据信息，\n通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"texture.SetPixelData()"},{"Type":"NodeText","Data":"​ 即可从 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"NativeArray\u0026lt;Color\u0026gt;"},{"Type":"NodeText","Data":"​ 读取计算结果"}]},{"ID":"20251117165154-2lbxswc","Type":"NodeBlockquote","Properties":{"id":"20251117165154-2lbxswc","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20251120165736"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251117165154-e0j89il","Type":"NodeParagraph","Properties":{"id":"20251117165154-e0j89il","updated":"20251120165736"},"Children":[{"Type":"NodeText","Data":"注意：在纹理回调中可以直接获取颜色数据 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"NativeArray\u0026lt;Color\u0026gt;"},{"Type":"NodeText","Data":"​，然后通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"texture.SetPixelData()"},{"Type":"NodeText","Data":"​ 赋值给纹理"}]}]},{"ID":"20251117165159-49ap3ws","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251117165159-49ap3ws","updated":"20251120164528"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"using UnityEngine;\nusing UnityEngine.Rendering;\nusing UnityEngine.UI;\n\npublic class Lesson98 : MonoBehaviour\n{\n    public ComputeShader computeShader2;\n    public RawImage image;\n\n    void Start()\n    {\n        // 创建RenderTexture，设置属性，传递到ComputeShader中\n        var renderTexture = new RenderTexture(512, 512, 0);\n        renderTexture.enableRandomWrite = true;\n        renderTexture.Create();                 // 让GPU侧为当前数据分配显存\n        var index3 = computeShader2.FindKernel(\"CSMain\");\n        computeShader2.SetFloat(\"textureWidth\", renderTexture.width);\n        computeShader2.SetFloat(\"textureHeight\", renderTexture.height);\n        computeShader2.SetTexture(index3, \"Result\", renderTexture);\n        // 计算启动线程组数量，确保线程组所有线程覆盖所有像素，启动ComputeShader\n        var groupNumX = Mathf.CeilToInt(renderTexture.width / 8f);\n        var groupNumY = Mathf.CeilToInt(renderTexture.height / 8f);\n        computeShader2.Dispatch(index3, groupNumX, groupNumY, 1);\n        // 异步获取结果\n        AsyncGPUReadback.Request(renderTexture, 0, (request) =\u003e\n        {\n            if (!request.hasError)\n            {\n                var texture = new Texture2D(renderTexture.width, renderTexture.height, TextureFormat.RGBA32, false);\n                var data = request.GetData\u003cColor\u003e();    // 获取RenderTexture计算完毕的颜色数据\n                texture.SetPixelData(data, 0);          // 将颜色数据写入texture中\n                texture.Apply();                        // 让Texture生效\n                image.texture = texture;            \n                renderTexture.Release();                // 释放使用完毕的RenderTexture资源   \n            }\n        });\n    }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251120164540-rh67f4y","Type":"NodeParagraph","Properties":{"id":"20251120164540-rh67f4y","updated":"20251120164540"},"Children":[{"Type":"NodeText","Data":"渲染结果："}]},{"ID":"20251120164434-l9v8zew","Type":"NodeParagraph","Properties":{"id":"20251120164434-l9v8zew","updated":"20251120164434"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251120163827-gqec72t.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251120171408-ewx4g81","Type":"NodeParagraph","Properties":{"id":"20251120171408-ewx4g81","updated":"20251120171408"}}]}