61z","Type":"NodeParagraph","Properties":{"id":"20251104180240-8dfl61z","updated":"20251104180640"},"Children":[{"Type":"NodeText","Data":"在 Hierarchy 窗口内会显示所有对象，不会筛选，但只有在 Hierarchy 窗口内选择了带 Mesh Renderer 或者 Occlusion Area 对象才会显示内容"}]}]},{"ID":"20251104180055-5vyhvbi","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251104180055-5vyhvbi","updated":"20251104180850"},"Children":[{"ID":"20251104180055-p1dhfwt","Type":"NodeParagraph","Properties":{"id":"20251104180055-p1dhfwt","updated":"20251104180436"},"Children":[{"Type":"NodeText","Data":"Renderers（渲染器）："}]},{"ID":"20251104180454-uuh4lid","Type":"NodeParagraph","Properties":{"id":"20251104180454-uuh4lid","updated":"20251104181003"},"Children":[{"Type":"NodeText","Data":"在 Hierarchy 窗口内会筛选出所有的带 Mesh Renderer 的对象，点击其中一个对象会显示如下内容：\n"}]},{"ID":"20251104180708-puv1054","Type":"NodeParagraph","Properties":{"id":"20251104180708-puv1054","updated":"20251104180709"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251104180709-c95jcs4.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251104181004-jki1il0","Type":"NodeParagraph","Properties":{"id":"20251104181004-jki1il0","updated":"20251104181011"},"Children":[{"Type":"NodeText","Data":"此时可以设置该对象是否为 Occluder Static（静态遮挡物）以及 Occludee Static（静态被遮挡物）"}]}]},{"ID":"20251104175824-1uo75ce","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251104175824-1uo75ce","updated":"20251104181726"},"Children":[{"ID":"20251104175824-ywmz3ge","Type":"NodeParagraph","Properties":{"id":"20251104175824-ywmz3ge","updated":"20251104181415"},"Children":[{"Type":"NodeText","Data":"Occlusion Area（遮挡区域）："}]},{"ID":"20251104181622-isj6r1m","Type":"NodeParagraph","Properties":{"id":"20251104181622-isj6r1m","updated":"20251104181726"},"Children":[{"Type":"NodeText","Data":"在 Hierarchy 窗口内会筛选出所有的带 Occlusion Area 的对象，关于 Occlusion Area，详见下文："},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20251104181349-xjh5bpn","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"Occlusion Area"}]},{"ID":"20251104180929-evyloxs","Type":"NodeParagraph","Properties":{"id":"20251104180929-evyloxs","updated":"20251104181000"},"Children":[{"Type":"NodeText","Data":"当未选中任何一个带 Occlusion Area 的对象时，会显示如下内容："}]},{"ID":"20251104181023-knxrj3i","Type":"NodeParagraph","Properties":{"id":"20251104181023-knxrj3i","updated":"20251104181024"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251104181024-rdniya6.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251104181027-z6dvu4y","Type":"NodeParagraph","Properties":{"id":"20251104181027-z6dvu4y","updated":"20251104181056"},"Children":[{"Type":"NodeText","Data":"点击 Create New Occlusion Area 即可创建一个新的带 Occlusion Area 的对象"}]}]}]}]},{"ID":"20251104175751-2yks8sl","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251104175751-2yks8sl","updated":"20251105115837"},"Children":[{"ID":"20251104175952-91r9yum","Type":"NodeParagraph","Properties":{"id":"20251104175952-91r9yum","updated":"20251104180000"},"Children":[{"Type":"NodeText","Data":"Bake 页签"}]},{"ID":"20251104182843-seuit4p","Type":"NodeSuperBlock","Properties":{"id":"20251104182843-seuit4p","updated":"20251105115837"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20251104182838-9qnvnhl","Type":"NodeParagraph","Properties":{"id":"20251104182838-9qnvnhl","updated":"20251104182844"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251104182839-qy2w3fr.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251104175751-x7j7wzl","Type":"NodeList","ListData":{},"Properties":{"id":"20251104175751-x7j7wzl","updated":"20251105115837"},"Children":[{"ID":"20251105110347-2ngwcjg","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251105110347-2ngwcjg","updated":"20251105110347"},"Children":[{"ID":"20251105110347-7n83w66","Type":"NodeParagraph","Properties":{"id":"20251105110347-7n83w66","updated":"20251105110618"},"Children":[{"Type":"NodeText","Data":"Set Default parameters：设置为默认值，点击后直接还原下方参数"}]},{"ID":"20251105110542-ljqhblm","Type":"NodeBlockquote","Properties":{"id":"20251105110542-ljqhblm","updated":"20251105110542"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251105110542-20010kb","Type":"NodeParagraph","Properties":{"id":"20251105110542-20010kb","updated":"20251105110554"},"Children":[{"Type":"NodeText","Data":"下方提示：默认参数可确保任意给定场景都能快速计算，并获得良好的遮挡剔除结果。由于这些参数始终与具体场景相关，因此在逐场景基础上对参数进行微调将获得更佳效果。所有参数都依赖于场景的单位尺度，因此在设置默认值之前，必须正确设置单位尺度参数。"}]}]}]},{"ID":"20251104175751-s7ky64x","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251104175751-s7ky64x","updated":"20251104175751"},"Children":[{"ID":"20251104175751-23uojn2","Type":"NodeParagraph","Properties":{"id":"20251104175751-23uojn2","updated":"20251104182858"},"Children":[{"Type":"NodeText","Data":"Smallest Occluder：最小遮挡物"}]},{"ID":"20251104182858-nrdww2a","Type":"NodeParagraph","Properties":{"id":"20251104182858-nrdww2a","updated":"20251104182939"},"Children":[{"Type":"NodeText","Data":"小于该尺寸的物体不会被当作遮挡者\n太小的物体（比如椅子腿、路灯杆）即使当作遮挡者，对整体遮挡效果意义不大，反而增加计算复杂度"}]},{"ID":"20251104182918-qqfqcsj","Type":"NodeParagraph","Properties":{"id":"20251104182918-qqfqcsj","updated":"20251104183049"},"Children":[{"Type":"NodeText","Data":"比如：如果设为 5，那么宽高深任意方向小于 5 个单位的物体，不会被烘焙进“遮挡源”"}]},{"ID":"20251104182924-6p1j2ol","Type":"NodeParagraph","Properties":{"id":"20251104182924-6p1j2ol","updated":"20251104182927"},"Children":[{"Type":"NodeText","Data":"建议："}]},{"ID":"20251104182928-v7gl4ij","Type":"NodeList","ListData":{},"Properties":{"id":"20251104182928-v7gl4ij","updated":"20251104182928"},"Children":[{"ID":"20251104182927-ylc703b","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251104182927-ylc703b","updated":"20251104182927"},"Children":[{"ID":"20251104182927-cngvq7s","Type":"NodeParagraph","Properties":{"id":"20251104182927-cngvq7s","updated":"20251104182930"},"Children":[{"Type":"NodeText","Data":"大场景（城市/山体） → 数值设大（比如 5"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"~"}]},{"Type":"NodeText","Data":"10）"}]}]},{"ID":"20251104182931-cl6l7vv","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251104182931-cl6l7vv","updated":"20251104182931"},"Children":[{"ID":"20251104182931-forymw1","Type":"NodeParagraph","Properties":{"id":"20251104182931-forymw1","updated":"20251104182931"},"Children":[{"Type":"NodeText","Data":"小场景（室内/走廊） → 数值设小（比如 1"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"~"}]},{"Type":"NodeText","Data":"2）"}]}]}]}]},{"ID":"20251104175751-0vybhml","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251104175751-0vybhml","updated":"20251104175751"},"Children":[{"ID":"20251104175751-6bkcs2q","Type":"NodeParagraph","Properties":{"id":"20251104175751-6bkcs2q","updated":"20251104182950"},"Children":[{"Type":"NodeText","Data":"Smallest Hole：最小孔洞"}]},{"ID":"20251104182950-xlzues6","Type":"NodeParagraph","Properties":{"id":"20251104182950-xlzues6","updated":"20251104183006"},"Children":[{"Type":"NodeText","Data":"小于该尺寸的孔洞会被“填上”，不会算作能透过去的空间\n避免一些小缝隙（比如窗框、门缝）被计算成“可见路径”，导致不合理的可见性判断"}]},{"ID":"20251104183006-yz4h5lw","Type":"NodeParagraph","Properties":{"id":"20251104183006-yz4h5lw","updated":"20251104183033"},"Children":[{"Type":"NodeText","Data":"比如：如果设为 0.25，那么小于 0.25 单位的洞（例如小裂缝）会被忽略，当成墙壁"}]},{"ID":"20251104183021-1btihm4","Type":"NodeParagraph","Properties":{"id":"20251104183021-1btihm4","updated":"20251104183023"},"Children":[{"Type":"NodeText","Data":"建议："}]},{"ID":"20251104183024-my8gwxp","Type":"NodeList","ListData":{},"Properties":{"id":"20251104183024-my8gwxp","updated":"20251104183024"},"Children":[{"ID":"20251104183023-j5r2dno","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251104183023-j5r2dno","updated":"20251104183023"},"Children":[{"ID":"20251104183023-tt7pp2i","Type":"NodeParagraph","Properties":{"id":"20251104183023-tt7pp2i","updated":"20251104183026"},"Children":[{"Type":"NodeText","Data":"室内场景 → 设小一些，保证窗户、门洞能算作可见"}]}]},{"ID":"20251104183026-iyiwsqj","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251104183026-iyiwsqj","updated":"20251104183026"},"Children":[{"ID":"20251104183026-3vl2a56","Type":"NodeParagraph","Properties":{"id":"20251104183026-3vl2a56","updated":"20251104183026"},"Children":[{"Type":"NodeText","Data":"城市/森林 → 设大一些，忽略不重要的小缝隙"}]}]}]}]},{"ID":"20251104175751-jh7d855","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251104175751-jh7d855","updated":"20251105115837"},"Children":[{"ID":"20251104175751-kaxvioh","Type":"NodeParagraph","Properties":{"id":"20251104175751-kaxvioh","updated":"20251104183105"},"Children":[{"Type":"NodeText","Data":"Backface Threshold：背面阈值"}]},{"ID":"20251104183105-8f2152g","Type":"NodeParagraph","Properties":{"id":"20251104183105-8f2152g","updated":"20251104183144"},"Children":[{"Type":"NodeText","Data":"决定一个物体有多少背面可以参与遮挡。遮挡计算时，通常只考虑物体面向摄像机的正面，但有些情况下，背面（比如反向法线）也能阻挡视线"}]},{"ID":"20251105115835-0sr8ghh","Type":"NodeBlockquote","Properties":{"id":"20251105115835-0sr8ghh","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20251105115837"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251105115837-2eoylim","Type":"NodeParagraph","Properties":{"id":"20251105115837-2eoylim","updated":"20251105120156"},"Children":[{"Type":"NodeText","Data":"注意，这里的正面一般指的是我们会观察到的模型的外表面，而背面就是模型的内部面，一般是透明的，也存在部分单面墙，能看到贴图的一面是正面，而透明的一面就是背面"}]}]},{"ID":"20251104183207-4ehq02m","Type":"NodeParagraph","Properties":{"id":"20251104183207-4ehq02m","updated":"20251104183207"},"Children":[{"Type":"NodeText","Data":"数值范围：0"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"~"}]},{"Type":"NodeText","Data":"100%"}]},{"ID":"20251104183145-77kd4a5","Type":"NodeList","ListData":{},"Properties":{"id":"20251104183145-77kd4a5","updated":"20251104183145"},"Children":[{"ID":"20251104183144-dvld98b","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251104183144-dvld98b","updated":"20251104183144"},"Children":[{"ID":"20251104183144-y9ln3k6","Type":"NodeParagraph","Properties":{"id":"20251104183144-y9ln3k6","updated":"20251104183144"},"Children":[{"Type":"NodeText","Data":"0 → 完全不考虑背面；"}]}]},{"ID":"20251104183147-cnm6qco","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251104183147-cnm6qco","updated":"20251104183147"},"Children":[{"ID":"20251104183147-b9fj08m","Type":"NodeParagraph","Properties":{"id":"20251104183147-b9fj08m","updated":"20251104183151"},"Children":[{"Type":"NodeText","Data":"100 → 所有背面都能参与遮挡"}]}]}]},{"ID":"20251104183158-ia9avax","Type":"NodeParagraph","Properties":{"id":"20251104183158-ia9avax","updated":"20251105120237"},"Children":[{"Type":"NodeText","Data":"建议： 默认值（100%）就够用，除非场景特殊（比如很多单面平面作为墙）"}]}]},{"ID":"20251105110925-bbtrego","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251105110925-bbtrego","updated":"20251105110933"},"Children":[{"ID":"20251105110925-ebexsvi","Type":"NodeParagraph","Properties":{"id":"20251105110925-ebexsvi","updated":"20251105110933"},"Children":[{"Type":"NodeText","Data":"Clear：清除烘焙数据"}]}]},{"ID":"20251105110915-2m9g3hs","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251105110915-2m9g3hs","updated":"20251105110915"},"Children":[{"ID":"20251105110915-p7mtuw4","Type":"NodeParagraph","Properties":{"id":"20251105110915-p7mtuw4","updated":"20251105110923"},"Children":[{"Type":"NodeText","Data":"Bake：开始烘焙"}]}]}]},{"Type":"NodeSuperBlockCloseMarker"}]}]},{"ID":"20251105105247-7obyjge","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251105105247-7obyjge","updated":"20251105203108"},"Children":[{"ID":"20251105105247-cd5d66s","Type":"NodeParagraph","Properties":{"id":"20251105105247-cd5d66s","updated":"20251105110049"},"Children":[{"Type":"NodeText","Data":"Visualization 页签"}]},{"ID":"20251104175751-q822khk","Type":"NodeParagraph","Properties":{"id":"20251104175751-q822khk","updated":"20251105202735"},"Children":[{"Type":"NodeText","Data":"当选中该 可视化 (Visualization) 页签，再选择开启遮挡剔除的摄像机时，可以实时的预览遮挡剔除效果"}]},{"ID":"20251105202502-q15690v","Type":"NodeParagraph","Properties":{"id":"20251105202502-q15690v","updated":"20251105202523"},"Children":[{"Type":"NodeText","Data":"默认 Scene 窗口："}]},{"ID":"20251105202424-psnixcx","Type":"NodeParagraph","Properties":{"id":"20251105202424-psnixcx","updated":"20251105202501"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251105202501-izdz59h.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251105202509-3995caw","Type":"NodeParagraph","Properties":{"id":"20251105202509-3995caw","updated":"20251105202540"},"Children":[{"Type":"NodeText","Data":"开启遮挡剔除预览后 Scene 窗口："}]},{"ID":"20251105202512-qaz1052","Type":"NodeParagraph","Properties":{"id":"20251105202512-qaz1052","updated":"20251105202557"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251105202557-jz2gbgb.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251105202659-svgrf9q","Type":"NodeParagraph","Properties":{"id":"20251105202659-svgrf9q","updated":"20251105202756"},"Children":[{"Type":"NodeText","Data":"在 右下角可以设置不同预览效果："}]},{"ID":"20251105202756-ljvn4cz","Type":"NodeParagraph","Properties":{"id":"20251105202756-ljvn4cz","updated":"20251105202829"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251105202829-ndk3k8e.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251105202835-y56bs5q","Type":"NodeList","ListData":{},"Properties":{"id":"20251105202835-y56bs5q","updated":"20251105203108"},"Children":[{"ID":"20251105202836-fyf6351","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251105202836-fyf6351","updated":"20251105203056"},"Children":[{"ID":"20251105202836-rrxjmag","Type":"NodeParagraph","Properties":{"id":"20251105202836-rrxjmag","updated":"20251105203056"},"Children":[{"Type":"NodeText","Data":"Camera Volumes：摄像机空间"}]},{"ID":"20251105202939-ziypy8e","Type":"NodeParagraph","Properties":{"id":"20251105202939-ziypy8e","updated":"20251105202942"},"Children":[{"Type":"NodeText","Data":"启用此选项后，您会看到黄线，这些黄线指示 Unity 为其生成遮挡剔除数据的场景区域。\n这取决于场景几何体以及在场景中使用 Occlusion Areas 选项定义的任何视图体积 (View Volumes)。当摄像机在黄线之外时，Unity 不会执行遮挡剔除。"}]},{"ID":"20251105202939-6uxxfry","Type":"NodeParagraph","Properties":{"id":"20251105202939-6uxxfry","updated":"20251105202949"},"Children":[{"Type":"NodeText","Data":"您还可以看到灰线，这些灰线指示摄像机当前位置所对应的遮挡剔除数据中的单元格以及当前单元格中的细分。\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Smallest Hole"},{"Type":"NodeText","Data":" 设置定义了单元格内细分的最小大小：值越小，每个单元格产生的细分越多且越小，从而使精度提高并且文件增大。"}]}]},{"ID":"20251105202844-51poqx3","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251105202844-51poqx3","updated":"20251105203037"},"Children":[{"ID":"20251105202844-fvzn1a9","Type":"NodeParagraph","Properties":{"id":"20251105202844-fvzn1a9","updated":"20251105203037"},"Children":[{"Type":"NodeText","Data":"Visibility Lines：可视范围线"}]},{"ID":"20251105202953-u43fxge","Type":"NodeParagraph","Properties":{"id":"20251105202953-u43fxge","updated":"20251105202958"},"Children":[{"Type":"NodeText","Data":"启用此选项后，您会看到绿线，这些绿线指示当前选择的摄像机可以看到的内容。"}]}]},{"ID":"20251105202849-9fjnh1x","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251105202849-9fjnh1x","updated":"20251105203108"},"Children":[{"ID":"20251105202849-e68gbpz","Type":"NodeParagraph","Properties":{"id":"20251105202849-e68gbpz","updated":"20251105203108"},"Children":[{"Type":"NodeText","Data":"Portals：入口"}]},{"ID":"20251105202959-4maq2n8","Type":"NodeParagraph","Properties":{"id":"20251105202959-4maq2n8","updated":"20251105203004"},"Children":[{"Type":"NodeText","Data":"启用此选项后，您可以看到一些线代表遮挡数据中单元格之间的连接。当前可见的入口是当前所选摄像机可以看到的入口。"}]}]}]}]}]},{"ID":"20251104181349-xjh5bpn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251104181349-xjh5bpn","name":"Occlusion Area","updated":"20251105210549"},"Children":[{"Type":"NodeText","Data":"遮挡区域"}]},{"ID":"20251104181412-ggjighx","Type":"NodeParagraph","Properties":{"id":"20251104181412-ggjighx","updated":"20251105200623"},"Children":[{"Type":"NodeText","Data":"Occlusion Area 是一个 体积框（Box Volume），用来提示 Unity 的遮挡剔除烘焙系统哪些区域是摄像机可能存在的位置，从而在这一块区域进行精确的遮挡剔除烘焙"}]},{"ID":"20251104181422-8m4hl8f","Type":"NodeParagraph","Properties":{"id":"20251104181422-8m4hl8f","updated":"20251105201551"},"Children":[{"Type":"NodeText","Data":"我们可以创建一个“盒子”空间，在这个区域内会启用精确的遮挡剔除烘焙计算，它的作用是用于优化性能的，\n如果不在场景上添加任何 Occlusion Area，则 Unity 会默认创建一个包含所有 Occluder Static 和 Occludee Static 对象的 Occlusion Area 再烘焙，即所有区域全部精确烘焙\n如果场景很大、到处都做精细的遮挡剔除烘焙，可能会导致大量不必要的数据，漫长的烘焙时间，且运行时计算量加大，反而可能拖慢性能，"}]},{"ID":"20251105201544-sws3vbx","Type":"NodeParagraph","Properties":{"id":"20251105201544-sws3vbx","updated":"20251105201606"},"Children":[{"Type":"NodeText","Data":"加上 Occlusion Area（遮挡区域） 后，Unity 只在该区域范围内进行精密的遮挡计算，可以用于"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"精确控制在启用更精确的遮挡剔除"}]},{"ID":"20251105201424-j46sneo","Type":"NodeParagraph","Properties":{"id":"20251105201424-j46sneo","updated":"20251105201742"},"Children":[{"Type":"NodeText","Data":"在物体繁多的建筑物内部场景会更有用，也可以在没有 Occluder Static 或 Occludee Static 对象但摄像机可到达的区域使用，确保那块区域的遮挡剔除生效"}]},{"ID":"20251105105746-78y46mp","Type":"NodeParagraph","Properties":{"id":"20251105105746-78y46mp","updated":"20251105201751"},"Children":[{"Type":"NodeText","Data":"在 Scene 内拖动绿色框体的白色圆柱体即可调整 Occlusion Area 的边界，Occlusion Area 应该框住"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"摄像机的移动范围"}]},{"ID":"20251105110714-ccqno2d","Type":"NodeParagraph","Properties":{"id":"20251105110714-ccqno2d","updated":"20251105110847"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251105110847-l67bsq9.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251104181558-fhnfs92","Type":"NodeBlockquote","Properties":{"id":"20251104181558-fhnfs92","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20251104181558"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251104181558-ciwcf66","Type":"NodeParagraph","Properties":{"id":"20251104181558-ciwcf66","updated":"20251104181558"},"Children":[{"Type":"NodeText","Data":"注意："}]},{"ID":"20251104181558-lfldy69","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251104181558-lfldy69","updated":"20251104181558"},"Children":[{"ID":"20251104181558-tw36rv4","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251104181558-tw36rv4","updated":"20251104181558"},"Children":[{"ID":"20251104181558-ayhoda4","Type":"NodeParagraph","Properties":{"id":"20251104181558-ayhoda4","updated":"20251104181558"},"Children":[{"Type":"NodeText","Data":"它主要影响静态几何的遮挡剔除"}]}]},{"ID":"20251104181558-hnvtb5l","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251104181558-hnvtb5l","updated":"20251104181558"},"Children":[{"ID":"20251104181558-l7glekh","Type":"NodeParagraph","Properties":{"id":"20251104181558-l7glekh","updated":"20251104181558"},"Children":[{"Type":"NodeText","Data":"可以创建多个 Occlusion Area，把不同场景分开管理"}]}]}]}]},{"ID":"20251104181820-55mks1r","Type":"NodeSuperBlock","Properties":{"id":"20251104181820-55mks1r","updated":"20251104182323"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20251104181728-lwcncd5","Type":"NodeParagraph","Properties":{"id":"20251104181728-lwcncd5","updated":"20251104181821"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251104181748-rw2rxq0.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251104181750-enwmf2o","Type":"NodeList","ListData":{},"Properties":{"id":"20251104181750-enwmf2o","updated":"20251104182323"},"Children":[{"ID":"20251104181751-icnkd4j","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251104181751-icnkd4j","updated":"20251104181751"},"Children":[{"ID":"20251104181751-6kz4h7s","Type":"NodeParagraph","Properties":{"id":"20251104181751-6kz4h7s","updated":"20251104181839"},"Children":[{"Type":"NodeText","Data":"Size：遮挡区域包围盒的尺寸"}]}]},{"ID":"20251104181753-5zbdjw4","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251104181753-5zbdjw4","updated":"20251104181753"},"Children":[{"ID":"20251104181753-17jh5iy","Type":"NodeParagraph","Properties":{"id":"20251104181753-17jh5iy","updated":"20251104181849"},"Children":[{"Type":"NodeText","Data":"Center：遮挡区域包围盒的中心点偏移位置"}]}]},{"ID":"20251104181756-effbs4z","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251104181756-effbs4z","updated":"20251104182323"},"Children":[{"ID":"20251104181756-u6ucfpe","Type":"NodeParagraph","Properties":{"id":"20251104181756-u6ucfpe","updated":"20251104182315"},"Children":[{"Type":"NodeText","Data":"Is View Volume：是否是视图体积（开启才能生效）"}]},{"ID":"20251104182239-7xa5ovf","Type":"NodeParagraph","Properties":{"id":"20251104182239-7xa5ovf","updated":"20251104182323"},"Children":[{"Type":"NodeText","Data":"视图体积是摄像机可能处于运行时的场景区域，\n如果启用此属性，遮挡区域 (Occlusion Area) 将定义视图体积。\n如果禁用此属性，遮挡区域 (Occlusion Area) 不会定义视图体积。\n必须启用此属性才能使遮挡区域 (Occlusion Area) 生效。"}]}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20251104181821-48dmpwy","Type":"NodeParagraph","Properties":{"id":"20251104181821-48dmpwy","updated":"20251105210512"},"Children":[{"Type":"NodeText","Data":"不使用 Occlusion Area 标识的遮挡剔除烘焙结果："}]},{"ID":"20251105202011-2d0n5jw","Type":"NodeParagraph","Properties":{"id":"20251105202011-2d0n5jw","updated":"20251105210532"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251105202011-sl07rgc.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251105202015-bcggs2y","Type":"NodeParagraph","Properties":{"id":"20251105202015-bcggs2y","updated":"20251105210516"},"Children":[{"Type":"NodeText","Data":"使用 Occlusion Area 标识的遮挡剔除烘焙结果："}]},{"ID":"20251105202024-aa1fj33","Type":"NodeParagraph","Properties":{"id":"20251105202024-aa1fj33","updated":"20251105210539"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251105202052-0d89tsq.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251105202021-fqdgo7h","Type":"NodeParagraph","Properties":{"id":"20251105202021-fqdgo7h","updated":"20251105210549"},"Children":[{"Type":"NodeText","Data":"可以看到，如果不适用 Occlusion Area 标识，则所有区域的格子密度都较高，而启用烘焙区域后，格子只在 Occlusion Area 框定处附近密度较高"}]},{"ID":"20251105203205-8yshjc9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251105203205-8yshjc9","name":"Occlusion Portal","updated":"20251105204708"},"Children":[{"Type":"NodeText","Data":"遮挡入口"}]},{"ID":"20251105204828-xu5pbnv","Type":"NodeParagraph","Properties":{"id":"20251105204828-xu5pbnv","updated":"20251106094838"},"Children":[{"Type":"NodeText","Data":"遮挡入口 (Occlusion Portal) 可以用于在关闭状态下遮挡，而在开启状态下不遮挡的对象\n遮挡入口关闭时，它将遮挡其他游戏对象。遮挡入口打开时，它不会遮挡其他游戏对象。\n适用于遮挡剔除场景中 门 等的物体，可以在 门 即将打开 或者 完全关闭 时用脚本控制其 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"open"},{"Type":"NodeText","Data":"​ 属性使其启用遮挡"}]},{"ID":"20251105205028-vxxmpe9","Type":"NodeBlockquote","Properties":{"id":"20251105205028-vxxmpe9","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20251105205549"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251105205053-eq2rzh9","Type":"NodeParagraph","Properties":{"id":"20251105205053-eq2rzh9","updated":"20251105205549"},"Children":[{"Type":"NodeText","Data":"注意：使用 Occlusion Portal 对象不需要设置为 Occluder Static 或 Occludee Static，同时要参与到遮挡剔除的烘焙中"}]}]},{"ID":"20251105204824-pq9rke9","Type":"NodeSuperBlock","Properties":{"id":"20251105204824-pq9rke9","updated":"20251105204708"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20251105204656-s2xlqdy","Type":"NodeParagraph","Properties":{"id":"20251105204656-s2xlqdy","updated":"20251105204825"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251105204656-nqy7s7x.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251105204658-441xlac","Type":"NodeList","ListData":{},"Properties":{"id":"20251105204658-441xlac","updated":"20251105204708"},"Children":[{"ID":"20251105204659-yzznxy6","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251105204659-yzznxy6","updated":"20251105204659"},"Children":[{"ID":"20251105204659-sa093km","Type":"NodeParagraph","Properties":{"id":"20251105204659-sa093km","updated":"20251105204826"},"Children":[{"Type":"NodeText","Data":"Open：入口是否开启"}]},{"ID":"20251105204826-fw4gdjc","Type":"NodeParagraph","Properties":{"id":"20251105204826-fw4gdjc","updated":"20251105204826"},"Children":[{"Type":"NodeText","Data":"如果开启，则此区域将不进行遮挡剔除，摄像机可透过此入口观察到物体"}]}]},{"ID":"20251105204701-3xe25n2","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251105204701-3xe25n2","updated":"20251105204701"},"Children":[{"ID":"20251105204701-96i66yz","Type":"NodeParagraph","Properties":{"id":"20251105204701-96i66yz","updated":"20251105204719"},"Children":[{"Type":"NodeText","Data":"Center：中心点"}]}]},{"ID":"20251105204704-h0434ac","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251105204704-h0434ac","updated":"20251105204708"},"Children":[{"ID":"20251105204704-aqdmupc","Type":"NodeParagraph","Properties":{"id":"20251105204704-aqdmupc","updated":"20251105204708"},"Children":[{"Type":"NodeText","Data":"Size：尺寸"}]}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20251105203224-86o7sa8","Type":"NodeParagraph","Properties":{"id":"20251105203224-86o7sa8","updated":"20251105204128"},"Children":[{"Type":"NodeText","Data":"假设有这个这样的场景，中间的门是遮挡入口："}]},{"ID":"20251105204114-0tpykob","Type":"NodeParagraph","Properties":{"id":"20251105204114-0tpykob","updated":"20251105204115"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251105204115-gmb4719.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251105204133-r7x6y7z","Type":"NodeParagraph","Properties":{"id":"20251105204133-r7x6y7z","updated":"20251105204220"},"Children":[{"Type":"NodeText","Data":"当遮挡入口的 Open 属性为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"false"},{"Type":"NodeText","Data":"​ 时预览遮挡剔除结果："}]},{"ID":"20251105204223-ab65wcc","Type":"NodeParagraph","Properties":{"id":"20251105204223-ab65wcc","updated":"20251105204505"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251105204504-415tnfv.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251105204208-hxbk48p","Type":"NodeParagraph","Properties":{"id":"20251105204208-hxbk48p","updated":"20251105204222"},"Children":[{"Type":"NodeText","Data":"当遮挡入口的 Open 属性为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"true"},{"Type":"NodeText","Data":"​ 时预览遮挡剔除结果："}]},{"ID":"20251105204522-hymjtki","Type":"NodeParagraph","Properties":{"id":"20251105204522-hymjtki","updated":"20251105204522"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251105204522-sn5vsq5.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251105204524-9dmrwsk","Type":"NodeParagraph","Properties":{"id":"20251105204524-9dmrwsk","updated":"20251105204638"},"Children":[{"Type":"NodeText","Data":"可以看到，遮挡入口可以起到仅在不开启时进行遮挡的效果，适用于场景中的门的场景"}]},{"ID":"20251105204628-pqc7x04","Type":"NodeParagraph","Properties":{"id":"20251105204628-pqc7x04","updated":"20251105204628"}}]}