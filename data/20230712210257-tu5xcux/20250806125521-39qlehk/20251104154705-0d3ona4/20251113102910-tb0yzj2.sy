pe":"NodeText","Data":"太阳光（主光源）用 Mixed (混合)"}]}]},{"ID":"20251113103242-itwgf7n","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251113103242-itwgf7n","updated":"20251113103242"},"Children":[{"ID":"20251113103242-655zam7","Type":"NodeParagraph","Properties":{"id":"20251113103242-655zam7","updated":"20251113110204"},"Children":[{"Type":"NodeText","Data":"室内灯光（蜡烛、台灯等复杂室内环境光源）用 Baked (烘焙)"}]}]},{"ID":"20251113103243-ylb5aca","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251113103243-ylb5aca","updated":"20251113103243"},"Children":[{"ID":"20251113103243-ova7rg3","Type":"NodeParagraph","Properties":{"id":"20251113103243-ova7rg3","updated":"20251113110205"},"Children":[{"Type":"NodeText","Data":"特效等（会移动或随时间变化的光源）用 Realtime (实时)"}]}]}]}]},{"ID":"20251113103153-1e0sb4y","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251113103153-1e0sb4y","updated":"20251113144953"},"Children":[{"ID":"20251113103153-fdlvuul","Type":"NodeParagraph","Properties":{"id":"20251113103153-fdlvuul","updated":"20251113103249"},"Children":[{"Type":"NodeText","Data":"打开 Lighting 设置窗口"}]},{"ID":"20251113103250-k576s1o","Type":"NodeParagraph","Properties":{"id":"20251113103250-k576s1o","updated":"20251113144754"},"Children":[{"Type":"NodeText","Data":"进行相关光照烘焙设置（具体参数请见下文），设置完毕后点击 Generate Lighting，烘焙光照"}]},{"ID":"20251113144907-uggdkf8","Type":"NodeParagraph","Properties":{"id":"20251113144907-uggdkf8","updated":"20251113144953"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251113144953-kd4o257.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]}]},{"ID":"20251113144708-8kplkfg","Type":"NodeParagraph","Properties":{"id":"2025