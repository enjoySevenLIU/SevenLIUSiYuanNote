1821-nua4htn","Type":"NodeParagraph","Properties":{"id":"20251106141821-nua4htn","updated":"20251106141821"},"Children":[{"Type":"NodeText","Data":"布局重建：主要进行布局计算"}]}]},{"ID":"20251106141821-tjrt879","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251106141821-tjrt879","updated":"20251111103657"},"Children":[{"ID":"20251106141821-08axy2h","Type":"NodeParagraph","Properties":{"id":"20251106141821-08axy2h","updated":"20251111103657"},"Children":[{"Type":"NodeText","Data":"图形重建：主要进行网格生成（比如合并 UI 元素网格信息、前提是材质相同）"}]}]},{"ID":"20251106141822-rjb9yf9","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251106141822-rjb9yf9","updated":"20251106141822"},"Children":[{"ID":"20251106141822-o774x5u","Type":"NodeParagraph","Properties":{"id":"20251106141822-o774x5u","updated":"20251106141822"},"Children":[{"Type":"NodeText","Data":"材质重建：主要进行材质状态更新"}]}]}]},{"ID":"20251106141728-v4wgudq","Type":"NodeParagraph","Properties":{"id":"20251106141728-v4wgudq","updated":"20251106141838"},"Children":[{"Type":"NodeText","Data":"所谓“画布污染”，就是有子元素打了脏标记，导致整个 Canvas 的顶点缓存需要刷新\n如果 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Canvas"},{"Type":"NodeText","Data":"​ 很大，就会让大量 UI 元素一并重建，带来性能消耗"}]},{"ID":"20251106141728-6f3xf9u","Type":"NodeParagraph","Properties":{"id":"20251106141728-6f3xf9u","updated":"20251106141849"},"Children":[{"Type":"NodeText","Data":"可能带来画布污染的情况："}]},{"ID":"20251106141849-cq2ktmj","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251106141849-cq2ktmj","updated":"20251106141911"},"Children":[{"ID":"20251106141849-a26h2n0","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251106141849-a26h2n0","updated":"20251106141855"},"Children":[{"ID":"20251106141849-j26gsqg","Type":"NodeParagraph","Properties":{"id":"20251106141849-j26gsqg","updated":"20251106141855"},"Children":[{"Type":"NodeText","Data":"修改 UI 元素的 "},{"Type":