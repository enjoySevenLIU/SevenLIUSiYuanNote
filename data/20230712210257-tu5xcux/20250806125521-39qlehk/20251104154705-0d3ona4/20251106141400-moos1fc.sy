":"20251110200739"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code block-ref","TextMarkBlockRefID":"20230813020700-cvcemvb","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"ScrollRect"},{"Type":"NodeText","Data":"​ 是 UGUI 中一个 可滚动的 UI 容器，常用于列表、背包、排行榜 等功能"}]},{"ID":"20251110200742-tcgtq2d","Type":"NodeParagraph","Properties":{"id":"20251110200742-tcgtq2d","updated":"20251110200848"},"Children":[{"Type":"NodeText","Data":"它的工作流程大概如下所述："}]},{"ID":"20251110200747-t18s5fp","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251110200747-t18s5fp","updated":"20251110200820"},"Children":[{"ID":"20251110200747-7c2qaze","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251110200747-7c2qaze","updated":"20251110200752"},"Children":[{"ID":"20251110200747-0jaksry","Type":"NodeParagraph","Properties":{"id":"20251110200747-0jaksry","updated":"20251110200752"},"Children":[{"Type":"NodeText","Data":"有一个 显示区域（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Viewport"},{"Type":"NodeText","Data":"​）和一个 实际内容节点（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Content"},{"Type":"NodeText","Data":"​）"}]}]},{"ID":"20251110200747-z65l5cd","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251110200747-z65l5cd","updated":"20251110200755"},"Children":[{"ID":"20251110200747-cn7mibx","Type":"NodeParagraph","Properties":{"id":"20251110200747-cn7mibx","updated":"20251110200755"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Content"},{"Type":"NodeText","Data":"​ 下放了很多子元素（背包格子、排行榜玩家信息等等）"}]}]},{"ID":"20251110200747-rml6a4v","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251110200747-rml6a4v","updated":"20251110200803"},"Children":[{"ID":"20251110200747-dkk35wq","Type":"NodeParagraph","Properties":{"id":"20251110200747-dkk35wq","updated":"20251110200803"},"Children":[{"Type":"NodeText","Data":"滚动时，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ScrollRect"},{"Type":"NodeText","Data":"​ 会移动 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Content"},{"Type":"NodeText","Data":"​ 的位置，驱动子元素的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RectTransform"},{"Type":"NodeText","Data":"​ 变化"}]}]},{"ID":"20251110200747-5re24rv","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20251110200747-5re24rv","updated":"20251110200820"},"Children":[{"ID":"20251110200747-523obo8","Type":"NodeParagraph","Properties":{"id":"20251110200747-523obo8","updated":"20251110200820"},"Children":[{"Type":"NodeText","Data":"因为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RectTransform"},{"Type":"NodeText","Data":"​ 在变，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Canvas"},{"Type":"NodeText","Data":"​ 会认为子元素脏了（dirty），触发 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Canvas"},{"Type":"NodeText","Data":"​ 重建"}]}]}]},{"ID":"20251110200745-enm7t5p","Type":"NodeParagraph","Properties":{"id":"20251110200745-enm7t5p","updated":"20251110200834"},"Children":[{"Type":"NodeText","Data":"因此，当 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Content"},{"Type":"NodeText","Data":"​ 下子元素很多时（几百几千个），哪怕屏幕只显示几十个，滚动时所有元素都会被算一次布局和渲染"}]},{"ID":"20251110200723-tzzc7rl","Type":"NodeParagraph","Properties":{"id":"20251110200723-tzzc7rl","updated":"20251110200843"},"Children":[{"Type":"NodeText","Data":"因此，由于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ScrollRect"},{"Type":"NodeText","Data":"​ 的本身工作机制，当子元素太多时，就会带来一些无意义的性能开销"}]},{"ID":"20251110200854-2b84bqk","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251110200854-2b84bqk","updated":"20251110201116"},"Children":[{"Type":"NodeText","Data":"优化 ScrollRect 核心思想"}]},{"ID":"20251110200907-h3g00fs","Type":"NodeParagraph","Properties":{"id":"20251110200907-h3g00fs","updated":"20251110200916"},"Children":[{"Type":"NodeText","Data":"核心优化思想：只保留 在屏幕可见的元素，其他元素不参与渲染"}]},{"ID":"20251110200916-btc0u4a","Type":"NodeParagraph","Properties":{"id":"20251110200916-btc0u4a","updated":"20251110200920"},"Children":[{"Type":"NodeText","Data":"它的核心优化思路就是"}]},{"ID":"20251110200920-4wzvqdo","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251110200920-4wzvqdo","updated":"20251110200925"},"Children":[{"ID":"20251110200920-7xv7mzy","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251110200920-7xv7mzy","updated":"20251110200920"},"Children":[{"ID":"20251110200920-micqd90","Type":"NodeParagraph","Properties":{"id":"20251110200920-micqd90","updated":"20251110200920"},"Children":[{"Type":"NodeText","Data":"利用缓存池复用对象，只显示可见范围内的元素"}]}]},{"ID":"20251110200920-73r2iqr","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251110200920-73r2iqr","updated":"20251110200925"},"Children":[{"ID":"20251110200920-jl6m08x","Type":"NodeParagraph","Properties":{"id":"20251110200920-jl6m08x","updated":"20251110200925"},"Children":[{"Type":"NodeText","Data":"使用自定义布局，不使用 Unity 自带的布局组件"}]}]}]},{"ID":"20251110200907-304p3aq","Type":"NodeParagraph","Properties":{"id":"20251110200907-304p3aq","updated":"20251110200939"},"Children":[{"Type":"NodeText","Data":"除此之外，我们应该把 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ScrollRect"},{"Type":"NodeText","Data":"​ 相关内容单独放入一个独立的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Canvas"},{"Type":"NodeText","Data":"​ 中，达到动静分离的目的"}]},{"ID":"20251110201116-wbacpfm","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251110201116-wbacpfm","updated":"20251110201153"},"Children":[{"Type":"NodeText","Data":"ScrollRe