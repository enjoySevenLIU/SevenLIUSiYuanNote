20251106142006"},"Children":[{"Type":"NodeText","Data":"为了避免 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Canvas"},{"Type":"NodeText","Data":"​ 的重建带来的性能消耗\n我们可以把会频繁变化的 UI 元素单独放在一个小 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Canvas"},{"Type":"NodeText","Data":"​ 当中\n避免一个小元素的更新导致整个大 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Canvas"},{"Type":"NodeText","Data":"​ 重建"}]},{"ID":"20251106141946-8n1f62m","Type":"NodeParagraph","Properties":{"id":"20251106141946-8n1f62m","updated":"20251106142012"},"Children":[{"Type":"NodeText","Data":"我们可以把UI元素分成三大类"}]},{"ID":"20251106142012-r8ya7ch","Type":"NodeList","ListData":{},"Properties":{"id":"20251106142012-r8ya7ch","updated":"20251106142019"},"Children":[{"ID":"20251106142012-s07fhc7","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251106142012-s07fhc7","updated":"20251106142016"},"Children":[{"ID":"20251106142012-0g31z2f","Type":"NodeParagraph","Properties":{"id":"20251106142012-0g31z2f","updated":"20251106142016"},"Children":[{"Type":"NodeText","Data":"静态：静态 UI 元素永远不会改变，比如背景图、说明文字、Logo、装饰性分割线等等"}]}]},{"ID":"20251106142012-dpu0izm","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251106142012-dpu0izm","updated":"20251106142019"},"Children":[{"ID":"20251106142012-pbucekq","Type":"NodeParagraph","Properties":{"id":"20251106142012-pbucekq","updated":"20251106142019"},"Children":[{"Type":"NodeText","Data":"偶尔动态：只会偶尔为了做出响应时而改变，比如 UI 按钮按下，拖动条，拥有金币数 等等"}]}]},{"ID":"20251106142013-5o1ef6p","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251106142013-5o1ef6p","updated":"20251106142013"},"Children":[{"ID":"20251106142013-b0ay88t","Type":"NodeParagraph","Properties":{"id":"20251106142013-b0ay88t","updated":"20251106142013"},"Children":[{"Type":"NodeText","Data":"持续动态：会持续甚至每帧发生变化的元素，比如战斗中血条流动动画、计时器、秒表文本、摇杆UI等等"}]}]}]},{"ID":"20251106142009