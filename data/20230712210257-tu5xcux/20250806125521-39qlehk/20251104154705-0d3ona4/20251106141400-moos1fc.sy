},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251106144134-5gfoddg","Type":"NodeParagraph","Properties":{"id":"20251106144134-5gfoddg","updated":"20251106144216"},"Children":[{"Type":"NodeText","Data":"注意：通过禁用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Canvas"},{"Type":"NodeText","Data":"​（画布）的方式去隐藏 UI 元素的前提是 动静分离、多 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Canvas"},{"Type":"NodeText","Data":"​ 合理分配\n否则禁用一个 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Canvas"},{"Type":"NodeText","Data":"​ 可能会让很多不相关 UI 一起消失"}]}]},{"ID":"20251106144222-uubh1l2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251106144222-uubh1l2","updated":"20251111110305"},"Children":[{"Type":"NodeText","Data":"避免在 UI 使用 Animator"}]},{"ID":"20251106144258-numgb3a","Type":"NodeParagraph","Properties":{"id":"20251106144258-numgb3a","updated":"20251106144359"},"Children":[{"Type":"NodeText","Data":"如果在 UI 中使用 "},{"Type":"NodeTextMark","TextMarkType":"code block-ref","TextMarkBlockRefID":"20230803225001-deaj6ud","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"Animator"},{"Type":"NodeText","Data":"​ 组件来播放一些 UI 动画\n​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Animator"},{"Type":"NodeText","Data":"​ 会在每帧根据动画状态机计算 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Transform"},{"Type":"NodeText","Data":"​ 或其他属性变化"}]},{"ID":"20251106144311-zyfknod","Type":"NodeParagraph","Properties":{"id":"20251106144311-zyfknod","updated":"20251106144313"},"Children":[{"Type":"NodeText","Data":"比如："}]},{"ID":"20251106144313-tc2tjva","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251106144313-tc2tjva","updated":"20251106144313"},"Children":[{"ID":"20251106144313-orrx4th","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251106144313-orrx4th","updated":"20251106144313"},"Children":[{"ID":"20