aph","Properties":{"id":"20251110204033-i3d9z3z","updated":"20251110204033"},"Children":[{"Type":"NodeText","Data":"控制几何复杂度"}]}]}]},{"ID":"20251110204033-4wdx1br","Type":"NodeParagraph","Properties":{"id":"20251110204033-4wdx1br","updated":"20251110204033"},"Children":[{"Type":"NodeText","Data":"等等"}]},{"ID":"20251110204048-medte6q","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20251110204048-medte6q","updated":"20251110204204"},"Children":[{"Type":"NodeText","Data":"控制 OverDraw"}]},{"ID":"20251110204055-b9dqctx","Type":"NodeParagraph","Properties":{"id":"20251110204055-b9dqctx","updated":"20251110204200"},"Children":[{"Type":"NodeText","Data":"粒子大部分是半透明的，为了进行透明度混合，往往不会进行深度写入，导致多个粒子叠加时同一像素被反复计算，我们需要尽量减少这种计算"}]},{"ID":"20251110204101-aj804ep","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251110204101-aj804ep","updated":"20251110204203"},"Children":[{"ID":"20251110204101-90s10e7","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251110204101-90s10e7","updated":"20251110204101"},"Children":[{"ID":"20251110204101-hewo83o","Type":"NodeParagraph","Properties":{"id":"20251110204101-hewo83o","updated":"20251110204101"},"Children":[{"Type":"NodeText","Data":"减少粒子数量和粒子尺寸"}]},{"ID":"20251110204101-wrvwgb6","Type":"NodeParagraph","Properties":{"id":"20251110204101-wrvwgb6","updated":"20251110204142"},"Children":[{"Type":"NodeText","Data":"因为 粒子数量 "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":" 粒子尺寸 决定了 覆盖面积"}]}]},{"ID":"20251110204101-x0dm8q2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251110204101-x0dm8q2","updated":"20251110204101"},"Children":[{"ID":"20251110204101-qwo0p42","Type":"NodeParagraph","Properties":{"id":"20251110204101-qwo0p42","updated":"20251110204101"},"Children":[{"Type":"NodeText","Data":"使用修剪透明度（Trim Alpha），裁剪掉贴图边缘的空透明区域"}]},{"ID":"20251110204104-qch4mck","Type":"NodeParagraph","Properties":{"id":"20251110204104-qch4mck","updated":"20251110204134"},"Children":[{"Type":"NodeText","Data":"一般在美术导出图片前裁减掉无效透明区域，或用图集工具自动忽略无效透明边缘\n比如一张图 512"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":"512，但是其中的有效图形只占 128"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":"128 的区域，完全可以把四周透明区域裁减掉"}]}]},{"ID":"20251110204101-wfrhcan","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251110204101-wfrhcan","updated":"20251110204101"},"Children":[{"ID":"20251110204101-c8cg1kg","Type":"NodeParagraph","Properties":{"id":"20251110204101-c8cg1kg","updated":"20251110204101"},"Children":[{"Type":"NodeText","Data":"设置合理的 开始大小参数（Start Size）"}]},{"ID":"20251110204152-d032bhh","Type":"NodeParagraph","Properties":{"id":"20251110204152-d032bhh","updated":"20251110204152"},"Children":[{"Type":"NodeText","Data":"避免大面积的满屏效果"}]}]},{"ID":"20251110204101-vqnptrd","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20251110204101-vqnptrd","updated":"20251110204203"},"Children":[{"ID":"20251110204101-6dghs99","Type":"NodeParagraph","Properties":{"id":"20251110204101-6dghs99","updated":"20251110204203"},"Children":[{"Type":"NodeText","Data":"使用 LOD"}]},{"ID":"20251110204153-7e40rw0","Type":"NodeParagraph","Properties":{"id":"20251110204153-7e40rw0","updated":"20251110204153"},"Children":[{"Type":"NodeText","Data":"远处粒子直接换成雾面贴图或后处理效果的体积雾效果"}]}]}]},{"ID":"20251110204057-mkig1xk","Type":"NodeParagraph","Properties":{"id":"20251110204057-mkig1xk","updated":"20251110204057"},"Children":[{"Type":"NodeText","Data":"等等"}]},{"ID":"20251110204204-gofaju0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20251110204204-gofaju0","updated":"20251110204244"},"Children":[{"Type":"NodeText","Data":"降低几何复杂度"}]},{"ID":"20251110204218-hmq2kaq","Type":"NodeParagraph","Properties":{"id":"20251110204218-hmq2kaq","updated":"20251110204232"},"Children":[{"Type":"NodeText","Data":"粒子也需要被渲染才能被我们看到，降低几何复杂度，可以较少着色器中顶点处理部分的开销"}]},{"ID":"20251110204222-0pm4zd1","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251110204222-0pm4zd1","updated":"20251110204222"},"Children":[{"ID":"20251110204222-n0ixn4e","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251110204222-n0ixn4e","updated":"20251110204222"},"Children":[{"ID":"20251110204222-1orw71z","Type":"NodeParagraph","Properties":{"id":"20251110204222-1orw71z","updated":"20251110204222"},"Children":[{"Type":"NodeText","Data":"使用广告牌粒子"}]},{"ID":"20251110204222-99oo9mq","Type":"NodeParagraph","Properties":{"id":"20251110204222-99oo9mq","updated":"20251110204222"},"Children":[{"Type":"NodeText","Data":"广告牌效果一般只需要使用一个四边形即可"}]}]},{"ID":"20251110204222-hodndzk","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251110204222-hodndzk","updated":"20251110204222"},"Children":[{"ID":"20251110204222-b4saehp","Type":"NodeParagraph","Properties":{"id":"20251110204222-b4saehp","updated":"20251110204222"},"Children":[{"Type":"NodeText","Data":"合理使用拖尾模块（Trails）"}]},{"ID":"20251110204223-ogz6b1l","Type":"NodeParagraph","Properties":{"id":"20251110204223-ogz6b1l","updated":"20251110204223"},"Children":[{"Type":"NodeText","Data":"拖尾效果会把单个粒子拉成数十个顶点，会增加GPU顶点处理阶段的压力\n我们可以调大拖尾效果的采样间距，限制最大顶点数"}]}]},{"ID":"20251110204222-e93p4dr","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251110204222-e93p4dr","updated":"20251110204222"},"Children":[{"ID":"20251110204222-9yffpi5","Type":"NodeParagraph","Properties":{"id":"20251110204222-9yffpi5","updated":"20251110204222"},"Children":[{"Type":"NodeText","Data":"合适使用网格粒子"}]},{"ID":"20251110204225-k8t1s98","Type":"NodeParagraph","Properties":{"id":"20251110204225-k8t1s98","updated":"20251110204225"},"Children":[{"Type":"NodeText","Data":"如果一定要使用网格粒子，也尽量使用低模\n因为一个网格粒子可能就会包含数百顶点，会大幅增加顶点处理压力"}]}]}]},{"ID":"20251110204244-w3o135v","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20251110204244-w3o135v","updated":"20251110204310"},"Children":[{"Type":"NodeText","Data":"减少片元着色开销"}]},{"ID":"20251110204252-pf0fzxm","Type":"NodeParagraph","Properties":{"id":"20251110204252-pf0fzxm","updated":"20251110204259"},"Children":[{"Type":"NodeText","Data":"粒子也需要被渲染才能被我们看到，如果从渲染层面上，减少着色器中计算开销就可以降低粒子的开销"}]},{"ID":"20251110204257-lki1cwn","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251110204257-lki1cwn","updated":"20251110204309"},"Children":[{"ID":"20251110204257-cr9osg3","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251110204257-cr9osg3","updated":"20251110204257"},"Children":[{"ID":"20251110204257-x6kauu5","Type":"NodeParagraph","Properties":{"id":"20251110204257-x6kauu5","updated":"20251110204257"},"Children":[{"Type":"NodeText","Data":"降低着色器复杂度"}]},{"ID":"20251110204301-e4fobpb","Type":"NodeParagraph","Properties":{"id":"20251110204301-e4fobpb","updated":"20251110204303"},"Children":[{"Type":"NodeText","Data":"减少纹理采样，尽量用一张纹理即可，尽量避免使用法线、遮罩相关纹理\n避免在片元着色器中产生分支，或使用高开销函数\n大多数情况下不太需要给粒子投射阴影，受光影响也需谨慎使用"}]}]},{"ID":"20251110204257-33te0s4","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251110204257-33te0s4","updated":"20251110204309"},"Children":[{"ID":"20251110204257-243x69t","Type":"NodeParagraph","Properties":{"id":"20251110204257-243x69t","updated":"20251110204257"},"Children":[{"Type":"NodeText","Data":"优化贴图"}]},{"ID":"20251110204305-qxq53xv","Type":"NodeParagraph","Properties":{"id":"20251110204305-qxq53xv","updated":"20251110204309"},"Children":[{"Type":"NodeText","Data":"可以减少序列帧动画帧数，降低其分辨率\n可以压缩贴图，移动端优先使用 ASTC、ETC2 等压缩格式"}]}]}]},{"ID":"20251110204255-ssma83y","Type":"NodeParagraph","Properties":{"id":"20251110204255-ssma83y","updated":"20251110204255"},"Children":[{"Type":"NodeText","Data":"等等"}]},{"ID":"20251110204310-o71804b","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20251110204310-o71804b","updated":"20251110204349"},"Children":[{"Type":"NodeText","Data":"替代手段"}]},{"ID":"20251110204323-lrd3byq","Type":"NodeParagraph","Properties":{"id":"20251110204323-lrd3byq","updated":"20251110204323"},"Children":[{"Type":"NodeText","Data":"在一些表现效果中，我们应该尽量使用不那么消耗性能的手段去替代高消耗表现"}]},{"ID":"20251110204326-mmm0op9","Type":"NodeParagraph","Properties":{"id":"20251110204326-mmm0op9","updated":"20251110204329"},"Children":[{"Type":"NodeText","Data":"比如："}]},{"ID":"20251110204329-77r537r","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251110204329-77r537r","updated":"20251110204329"},"Children":[{"ID":"20251110204329-rey8m8v","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251110204329-rey8m8v","updated":"20251110204329"},"Children":[{"ID":"20251110204329-2vds06n","Type":"NodeParagraph","Properties":{"id":"20251110204329-2vds06n","updated":"20251110204329"},"Children":[{"Type":"NodeText","Data":"能用不透明就不要使用半透明粒子"}]},{"ID":"20251110204345-ce3ir7x","Type":"NodeParagraph","Properties":{"id":"20251110204345-ce3ir7x","updated":"20251110204345"},"Children":[{"Type":"NodeText","Data":"一些游戏中的弹壳、碎屑效果，我们可以使用几何渲染队列的粒子，不要使用半透明"}]}]},{"ID":"20251110204329-8osua1h","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251110204329-8osua1h","updated":"20251110204329"},"Children":[{"ID":"20251110204329-iqx4vsa","Type":"NodeParagraph","Properties":{"id":"20251110204329-iqx4vsa","updated":"20251110204329"},"Children":[{"Type":"NodeText","Data":"后处理效果替代"}]},{"ID":"20251110204344-w8j1g0g","Type":"NodeParagraph","Properties":{"id":"20251110204344-w8j1g0g","updated":"20251110204344"},"Children":[{"Type":"NodeText","Data":"大范围的雾、火焰，可以改为屏幕后处理效果去实现"}]}]},{"ID":"20251110204329-2gvb1ts","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251110204329-2gvb1ts","updated":"20251110204329"},"Children":[{"ID":"20251110204329-uol9nku","Type":"NodeParagraph","Properties":{"id":"20251110204329-uol9nku","updated":"20251110204340"},"Children":[{"Type":"NodeText","Data":"使用 VFX Graph（2018.3 引入的一套基于节点的 GPU 粒子特效系统）"}]},{"ID":"20251110204331-39afuv2","Type":"NodeParagraph","Properties":{"id":"20251110204331-39afuv2","updated":"20251110204337"},"Children":[{"Type":"NodeText","Data":"依赖于 SRP 管线，只支持 URP 和 HDRP 项目，内置渲染管线不支持\n如果你的粒子效果有上万粒子，可以考虑使用它来制作"}]}]}]},{"ID":"20251110204349-r59p5l2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251110204349-r59p5l2","updated":"20251110204420"},"Children":[{"Type":"NodeText","Data":"更多粒子系统优化方案"}]},{"ID":"20251110204403-y43466f","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251110204403-y43466f","updated":"20251110204419"},"Children":[{"ID":"20251110204405-qpd1huk","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251110204405-qpd1huk","updated":"20251110204419"},"Children":[{"ID":"20251110204405-pa0ujzq","Type":"NodeParagraph","Properties":{"id":"20251110204405-pa0ujzq","updated":"20251110204419"},"Children":[{"Type":"NodeText","Data":"为移动应用优化粒子效果："},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://learn.unity.com/tutorial/optimizing-particle-effects-for-mobile-applications","TextMarkTextContent":"https://learn.unity.com/tutorial/optimizing-particle-effects-for-mobile-applications"}]}]},{"ID":"20251110204405-zykehfk","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251110204405-zykehfk","updated":"20251110204415"},"Children":[{"ID":"20251110204405-74ffr35","Type":"NodeParagraph","Properties":{"id":"20251110204405-74ffr35","updated":"20251110204415"},"Children":[{"Type":"NodeText","Data":"内置渲染管线中的粒子系统优化："},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://docs.unity3d.com/6000.2/Documentation/Manual/particle-system-optimization.html","TextMarkTextContent":"https://docs.unity3d.com/6000.2/Documentation/Manual/particle-system-optimization.html"}]}]}]},{"ID":"20251110204420-4akkm67","Type":"NodeParagraph","Properties":{"id":"20251110204420-4akkm67","updated":"20251110204420"}}]}