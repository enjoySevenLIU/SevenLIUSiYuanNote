14737-g4b6w9o","updated":"20251111114737"},"Children":[{"ID":"20251111114737-b3pwchl","Type":"NodeParagraph","Properties":{"id":"20251111114737-b3pwchl","updated":"20251111114740"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"OnParticleTrigger"},{"Type":"NodeText","Data":"​（粒子开启 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Trigger"},{"Type":"NodeText","Data":"​ 模块时会进入回调）"}]}]}]},{"ID":"20251111114740-4z00le4","Type":"NodeParagraph","Properties":{"id":"20251111114740-4z00le4","updated":"20251111114741"},"Children":[{"Type":"NodeText","Data":"这两个函数，单个粒子都可能触发，可能造成成千上万次的调用，导致 CPU 性能开销极大\n他们非常不适合大规模高发射率的粒子使用，如果一定要使用，可以结合 Unity 的多线程 Job System 使用"}]}]},{"ID":"20251110203555-t39jzyf","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251110203555-t39jzyf","updated":"20251111114854"},"Children":[{"ID":"20251110203555-gglbft2","Type":"NodeParagraph","Properties":{"id":"20251110203555-gglbft2","updated":"20251111114854"},"Children":[{"Type":"NodeText","Data":"减少粒子组件中 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"GetParticles()"},{"Type":"NodeText","Data":"​ 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SetParticles()"},{"Type":"NodeText","Data":"​ 方法的使用"}]},{"ID":"20251110203731-klmubcf","Type":"NodeList","ListData":{},"Properties":{"id":"20251110203731-klmubcf","updated":"20251110203732"},"Children":[{"ID":"20251110203732-qrbovej","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251110203732-qrbovej","updated":"20251110203732"},"Children":[{"ID":"20251110203732-ymq3i4g","Type":"NodeParagraph","Properties":{"id":"20251110203732-ymq3i4g","updated":"20251110203744"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"GetParticles()"},{"Type":"NodeText","Data":"​ 会把当前存活的所有粒子数据（位置、速度、颜色、大小、剩余寿命等）拷贝到一个数组或 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"List"},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20251110203733-0aj323o","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251110203733-0aj323o","updated":"20251110203733"},"Children":[{"ID":"20251110203733-w7tzvpj","Type":"NodeParagraph","Properties":{"id":"20251110203733-w7tzvpj","updated":"20251110203738"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SetParticles()"},{"Type":"NodeText","Data":"​ 则把你修改后的粒子数据写回去，覆盖粒子系统中的粒子状态"}]}]}]},{"ID":"20251110203729-m7f9721","Type":"NodeParagraph","Properties":{"id":"20251110203729-m7f9721","updated":"20251110203755"},"Children":[{"Type":"NodeText","Data":"每次调用都会进行托管数组和原生引起内部数据的拷贝，非常耗性能\n千万不要每帧频繁调用它们，否则甚至会导致 CPU 卡死\n如果一定要使用，可以结合 Unity 的多线程 Job System 使用"}]}]}]}]},{"ID":"20251110203547-solxrju","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251110203547-solxrju","updated":"20251110203845"},"Children":[{"ID":"20251110203534-znlzcdf","Type":"NodeParagraph","Properties":{"id":"20251110203534-znlzcdf","updated":"20251110203534"},"Children":[{"Type":"NodeText","Data":"排序开销："}]},{"ID":"20251110203802-ok9f5rg","Type":"NodeParagraph","Properties":{"id":"20251110203802-ok9f5rg","updated":"20251110203845"},"Children":[{"Type":"NodeText","Data":"粒子往往都是半透明渲染的，半透明物体需要按照 从远到近 的顺序绘制，否则会出现混合错误，\n所以 Unity 在渲染粒子前，CPU 需要对所有粒子进行 基于深度的排序，\n这个过程就会带来开销，我们应该减少排序带来的开销"}]},{"ID":"20251110203836-dwqhvso","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251110203836-dwqhvso","updated":"20251110203841"},"Children":[{"ID":"20251110203836-mmrvnnn","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251110203836-mmrvnnn","updated":"20251110203836"},"Children":[{"ID":"20251110203836-1kf6h80","Type":"NodeParagraph","Properties":{"id":"20251110203836-1kf6h80","updated":