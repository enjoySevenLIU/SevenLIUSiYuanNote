e":"NodeParagraph","Properties":{"id":"20251113172812-4rw5wr3","updated":"20251113172812"},"Children":[{"Type":"NodeText","Data":"Blend Distance（混合举例）"}]},{"ID":"20251113173653-d8cps4b","Type":"NodeParagraph","Properties":{"id":"20251113173653-d8cps4b","updated":"20251113173702"},"Children":[{"Type":"NodeText","Data":"探针与周围探针或天空盒反射的混合过渡距离\n数值越大，边界过渡更平滑\n建议 0.5 "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"~"}]},{"Type":"NodeText","Data":" 2"}]}]},{"ID":"20251113172812-57sz6su","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251113172812-57sz6su","updated":"20251113172812"},"Children":[{"ID":"20251113172812-nmmqwik","Type":"NodeParagraph","Properties":{"id":"20251113172812-nmmqwik","updated":"20251113172812"},"Children":[{"Type":"NodeText","Data":"Box Size (X,Y,Z)（盒子尺寸）"}]},{"ID":"20251113173714-w2lbw7d","Type":"NodeParagraph","Properties":{"id":"20251113173714-w2lbw7d","updated":"20251113173719"},"Children":[{"Type":"NodeText","Data":"探针影响范围（立方体大小） 决定该探针影响哪些物体\n一般设置为能包裹目标区域的大小"}]}]},{"ID":"20251113172812-uixs92z","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251113172812-uixs92z","updated":"20251113172812"},"Children":[{"ID":"20251113172812-0wtrifj","Type":"NodeParagraph","Properties":{"id":"20251113172812-0wtrifj","updated":"20251113172812"},"Children":[{"Type":"NodeText","Data":"Box Offset (X,Y,Z)（盒子偏移）"}]},{"ID":"20251113173723-rti16pf","Type":"NodeParagraph","Properties":{"id":"20251113173723-rti16pf","updated":"20251113173727"},"Children":[{"Type":"NodeText","Data":"探针中心相对于物体位置的偏移\n可用于微调探针采样中心，使反射效果更合理"}]}]}]}]},{"ID":"20251113172812-5aprers","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251113172812-5aprers","updated":"20251113172812"},"Children":[{"ID":"20251113172812-7jkxgil","Type":"NodeParagraph","Properties":{"id":"20251113172812-7jkxgil","updated":"20251113172812"},"Children