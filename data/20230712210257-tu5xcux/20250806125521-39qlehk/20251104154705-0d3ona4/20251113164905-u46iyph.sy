ragraph","Properties":{"id":"20251113173455-qexiaxf","updated":"20251113173458"},"Children":[{"Type":"NodeText","Data":"占用一帧大量 GPU 时间，但最快完成\n有一点时间切分优化，但用户看不出来"}]}]},{"ID":"20251113173439-84f4a3h","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251113173439-84f4a3h","updated":"20251113173439"},"Children":[{"ID":"20251113173439-7t8fuid","Type":"NodeParagraph","Properties":{"id":"20251113173439-7t8fuid","updated":"20251113173502"},"Children":[{"Type":"NodeText","Data":"Individual Faces：每帧只渲染一个面"}]},{"ID":"20251113173506-1of9m8n","Type":"NodeParagraph","Properties":{"id":"20251113173506-1of9m8n","updated":"20251113173506"},"Children":[{"Type":"NodeText","Data":"平均分摊到 6 帧内，减少性能峰值"}]}]},{"ID":"20251113173444-bz5ibld","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251113173444-bz5ibld","updated":"20251113173444"},"Children":[{"ID":"20251113173444-fv9367x","Type":"NodeParagraph","Properties":{"id":"20251113173444-fv9367x","updated":"20251113173510"},"Children":[{"Type":"NodeText","Data":"No Time Slicing：没有时间切片，一次性渲染完"}]},{"ID":"20251113173514-m0v74cw","Type":"NodeParagraph","Properties":{"id":"20251113173514-m0v74cw","updated":"20251113173514"},"Children":[{"Type":"NodeText","Data":"没有时间切分优化，最直接的全量渲染"}]}]}]}]}]}]}]}]},{"ID":"20251113172812-b9rc004","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251113172812-b9rc004","updated":"20251113174709"},"Children":[{"ID":"20251113172812-x3h8v73","Type":"NodeParagraph","Properties":{"id":"20251113172812-x3h8v73","updated":"20251113172812"},"Children":[{"Type":"NodeText","Data":"Runtime Settings（运行时设置）"}]},{"ID":"20251113172812-ed0nu35","Type":"NodeList","ListData":{},"Properties":{"id":"20251113172812-ed0nu35","updated":"20251113174709"},"Children":[{"ID":"20251113172812-ks2rll8","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251113172812-ks2rll8","updated":"2