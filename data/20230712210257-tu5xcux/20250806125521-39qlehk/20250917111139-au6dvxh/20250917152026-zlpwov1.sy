程度上可以替代协程，例如："}]},{"ID":"20250917163059-4sp1wm3","Type":"NodeList","ListData":{},"Properties":{"id":"20250917163059-4sp1wm3","updated":"20250917163059"},"Children":[{"ID":"20250917163059-rw3s4xn","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250917163059-rw3s4xn","updated":"20250917163059"},"Children":[{"ID":"20250917163059-2nzrh1f","Type":"NodeParagraph","Properties":{"id":"20250917163059-2nzrh1f","updated":"20250917163059"},"Children":[{"Type":"NodeText","Data":"使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"await Awaitable.NextFrameAsync()"},{"Type":"NodeText","Data":"​ 代替 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"yield return null"},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20250917163059-u06tsrc","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250917163059-u06tsrc","updated":"20250917163059"},"Children":[{"ID":"20250917163059-qrfnqtc","Type":"NodeParagraph","Properties":{"id":"20250917163059-qrfnqtc","updated":"20250917163059"},"Children":[{"Type":"NodeText","Data":"使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"await Awaitable.WaitForSecondsAsync()"},{"Type":"NodeText","Data":"​ 代替 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"yield return WaitForSeconds()"},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20250917163059-p9qbwv3","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250917163059-p9qbwv3","updated":"20250917163059"},"Children":[{"ID":"20250917163059-s1mypxj","Type":"NodeParagraph","Properties":{"id":"20250917163059-s1mypxj","updated":"20250917163059"},"Children":[{"Type":"NodeText","Data":"返回值继承自 "},{"Type":"NodeTextMark","TextMarkType":"code block-ref","TextMarkBlockRefID":"20230713172426-34da2hk","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"AsyncOperation"},{"Type":"NodeText","Data":"​ 的方法可以 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"await"},{"Type":"NodeText","Data":"​"}]}]}]},{"ID":"20250917163059-8vxcfmi","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250917163059-8vxcfmi","updated":"20250917163059"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"private async void TestAsync()\n{\n    await Awaitable.NextFrameAsync();\n    await Resources.LoadAsync(\"GameObject\");\n    await Awaitable.WaitForSecondsAsync(1f);\n}\n\nprivate IEnumerator TestCoroutine()\n{\n    yield return null;\n    yield return Resources.LoadAsync(\"GameObject\");\n    yield return new WaitForSeconds(1f);\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250917163059-cxxofs0","Type":"NodeParagraph","Properties":{"id":"20250917163059-cxxofs0","updated":"20250917163059"},"Children":[{"Type":"NodeText","Data":"和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Task\u0026lt;\u0026gt;"},{"Type":"NodeText","Data":"​ 类似，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Awaitable\u0026lt;\u0026gt;"},{"Type":"NodeText","Data":"​ 可以让 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"async"},{"Type":"NodeText","Data":"​ 方法返回值"}]},{"ID":"20250917163059-b5fahq2","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250917163059-b5fahq2","updated":"20250917163059"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"private async Awaitable\u003cGameObject\u003e TestAsync()\n{\n    var operation = Resources.LoadAsync\u003cGameObject\u003e(\"GameObject\");\n    await operation;\n    return operation.asset as GameObject;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]}]}