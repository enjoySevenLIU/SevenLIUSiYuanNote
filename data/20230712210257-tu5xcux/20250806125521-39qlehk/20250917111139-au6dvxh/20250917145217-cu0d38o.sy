aph","Properties":{"id":"20250917145414-faabl0t","updated":"20250917145414"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"GetComponent"},{"Type":"NodeText","Data":"​ 寻找组件相关API"}]}]},{"ID":"20250917145415-qnvix8d","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250917145415-qnvix8d","updated":"20250917145415"},"Children":[{"ID":"20250917145415-t321cm1","Type":"NodeParagraph","Properties":{"id":"20250917145415-t321cm1","updated":"20250917145415"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Find"},{"Type":"NodeText","Data":"​ 寻找对象相关API"}]}]}]},{"ID":"20250917145413-eb6ia0z","Type":"NodeParagraph","Properties":{"id":"20250917145413-eb6ia0z","updated":"20250917145413"},"Children":[{"Type":"NodeText","Data":"等等"}]},{"ID":"20250917145422-1gckgjp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250917145422-1gckgjp","updated":"20250917150620"},"Children":[{"Type":"NodeText","Data":"降低执行频率"}]},{"ID":"20250917145538-ss9y572","Type":"NodeParagraph","Properties":{"id":"20250917145538-ss9y572","updated":"20250917145600"},"Children":[{"Type":"NodeText","Data":"我们时长会在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Update"},{"Type":"NodeText","Data":"​ 中重复执行一些逻辑，如果超出需要的频率重复调用某些代码，会造成性能的浪费\n比如：怪物 AI 中，怪物需要不停的朝玩家寻路并移动，如果我们在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Update"},{"Type":"NodeText","Data":"​ 中不停每帧重复寻路会造成不必要的性能浪费"}]},{"ID":"20250917145538-kiu82at","Type":"NodeParagraph","Properties":{"id":"20250917145538-kiu82at","updated":"20250917145609"},"Children":[{"Type":"NodeText","Data":"我们可以通过降低执行频率来避免性能浪费，最常用的方式就是自定义更新间隔"}]},{"ID":"20250917150235-3n78d8p","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250917150235-3n78d8p","updated":"20250917150620"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"private float _updateTime = 0.25f;      // 间隔多久更新一次\nprivate float _timer;                   // 计时\n\nvoid Update()\n{\n    // 将每帧执行的逻辑变成每隔一段事件执行的逻辑\n    _timer += Time.deltaTime;\n    if (_timer \u003e _updateTime)\n    {\n        MonsterAILogic();\n        _timer = 0;\n    }\n}\n\n// 假设是执行怪物AI逻辑的函数\nprivate void MonsterAILogic() { }\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250917145615-7yc013b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250917145615-7yc013b","updated":"20250917145651"},"Children":[{"Type":"NodeText","Data":"减少复杂计算"}]},{"ID":"20250917145621-p9jdbre","Type":"NodeParagraph","Properties":{"id":"20250917145621-p9jdbre","updated":"20250917145638"},"Children":[{"Type":"NodeText","Data":"我们要尽量减少在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Update"},{"Type":"NodeText","Data":"​ 中进行复杂的数学计算，对于一些不变的计算结果\n应该在初始化时（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Awake"},{"Type":"NodeText","Data":"​、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Start"},{"Type":"NodeText","Data":"​ 中）就计算好 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Update"},{"Type":"NodeText","Data":"​ 中直接使用"}]},{"ID":"20250917145651-hjvdnv7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250917145651-hjvdnv7","updated":"20250917150951"},"Children":[{"Type":"NodeText","Data":"事件驱动代替每帧检测"}]},{"ID":"20250917145706-9vsf9ld","Type":"NodeParagraph","Properties":{"id":"20250917145706-9vsf9ld","updated":"20250917150951"},"Children":[{"Type":"NodeText","Data":"利用观察者模式取代在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Update"},{"Type":"NodeText","Data":"​ 中每帧进行状态检测，例如：将 玩家每帧检测怪物血量判断怪物死亡 改为 怪物死亡时通知玩家怪物死亡\n观察者模式的一个实践就是 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"事件中心"},{"Type":"NodeText","Data":"，相关实现可参考："},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20240416175650-evwvijq","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"UFL4——事件中心模块"}]},{"ID":"20250917145820-s2inb2m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250917145820-s2inb2m","updated":"20250917152214"},"Children":[{"Type":"NodeText","Data":"分帧执行"}]},{"ID":"20250917145832-9tqnkyj","Type":"NodeParagraph","Properties":{"id":"20250917145832-9tqnkyj","updated":"20250917151947"},"Children":[{"Type":"NodeText","Data":"对大批量对象更新时，使用异步方法，或者自行记录的方式进行分帧处理，避免单帧卡顿"}]},{"ID":"20250917152213-dxzoe5r","Type":"NodeBlockquote","Properties":{"id":"20250917152213-dxzoe5r","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20250917152214"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250917152214-4gjp669","Type":"NodeParagraph","Properties":{"id":"20250917152214-4gjp669","updated":"20250917152309"},"Children":[{"Type":"NodeText","Data":"Unity 的协同程序也可以达到对应效果，但是协程自身存在也有一些性能问题需要解决，详见："},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250917152026-zlpwov1","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"UPL5-4——协程相关"}]}]},{"ID":"20250917151134-4wiwdxg","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250917151134-4wiwdxg","updated":"20250917151515"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"private int _index;\nprivate int _monsterNum = 10;\nprivate List\u003cGameObject\u003e monsters = new List\u003cGameObject\u003e(10000);\n\nvoid Update()\n{\n    // 每帧遍历指定数量的怪物\n    for (int i = 0; i \u003c _monsterNum; i++)\n    {\n        if (_index \u003e= monsters.Count)\n            _index = 0;\n        monsters[_index].GetType();     // 假设这是要让怪物执行的逻辑\n        _index++;\n    }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250917145837-bw286ar","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250917145837-bw286ar","updated":"20250917161925"},"Children":[{"Type":"NodeText","Data":"自定义 Update 管理器（统一管理 Update 更新）"}]},{"ID":"20250917145850-m8o7v7k","Type":"NodeParagraph","Properties":{"id":"20250917145850-m8o7v7k","updated":"20250917145901"},"Children":[{"Type":"NodeText","Data":"在 Unity 中，如果每个继承 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"MonoBehaviour"},{"Type":"NodeText","Data":"​ 的脚本独立处理 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Update"},{"Type":"NodeText","Data":"​ 生命周期函数"}]},{"ID":"20250917145904-atkhpzu","Type":"NodeParagraph","Properties":{"id":"20250917145904-atkhpzu","updated":"20250917145950"},"Children":[{"Type":"NodeText","Data":"当这样的对象过多时，由于引擎底层机制（Unity 底层 C++ 层调用 C# 会有跨语言的开销、内存连续访问问题），会增加性能的开销\n如果我们对 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Update"},{"Type":"NodeText","Data":"​ 进行统一管理，可以大幅提升性能，并且独立调用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Update"},{"Type":"NodeText","Data":"​ 生命周期函数的对象越多，统一管理器的优势就越明显（特别是中大型对象场景中对象非常多时）"}]},{"ID":"20250917145955-qeudb52","Type":"NodeParagraph","Properties":{"id":"20250917145955-qeudb52","updated":"20250917145956"},"Children":[{"Type":"NodeText","Data":"优化方式："}]},{"ID":"20250917145958-p2dw4iw","Type":"NodeParagraph","Properties":{"id":"20250917145958-p2dw4iw","updated":"20250917150110"},"Children":[{"Type":"NodeText","Data":"通过一个统一更新管理器 统一 对所有需要 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Update"},{"Type":"NodeText","Data":"​ 更新的脚本进行管理，只需要一个 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Update"},{"Type":"NodeText","Data":"​ 生命周期函数 执行所有对象的更新\n对应的实现可参考公共 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"MonoBehaviour"},{"Type":"NodeText","Data":"​ 管理器，相关内容："},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20240415162818-ogrh42a","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"UFL2——公共Mono模块"},{"Type":"NodeText","Data":"\n公共 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"MonoBehaviour"},{"Type":"NodeText","Data":"​ 管理器中是通过 事件 记录所有Update函数的，也可以通过列表记录对象的形式调用"}]},{"ID":"20250917161925-atiljs6","Type":"NodeParagraph","Properties":{"id":"20250917161925-atiljs6","updated":"20250917161925"}}]}