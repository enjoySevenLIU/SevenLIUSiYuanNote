:"20250918141015-71lekwx","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250918141015-71lekwx","updated":"20250918141024"},"Children":[{"ID":"20250918141015-8z2q7jn","Type":"NodeParagraph","Properties":{"id":"20250918141015-8z2q7jn","updated":"20250918141024"},"Children":[{"Type":"NodeText","Data":"预加载（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Resources"},{"Type":"NodeText","Data":"​、AB 包、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Addressables"},{"Type":"NodeText","Data":"​、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"UnityWebRequest"},{"Type":"NodeText","Data":"​ 等等）"}]}]},{"ID":"20250918141015-w4pkw12","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250918141015-w4pkw12","updated":"20250918141015"},"Children":[{"ID":"20250918141015-3f4z8b7","Type":"NodeParagraph","Properties":{"id":"20250918141015-3f4z8b7","updated":"20250918141015"},"Children":[{"Type":"NodeText","Data":"预实例化（把想要预渲染的对象实例化到场景中，最好设置到一个专门用于预渲染的层级）"}]}]}]}]},{"ID":"20250918140955-hv3j3jy","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250918140955-hv3j3jy","updated":"20250918140955"},"Children":[{"ID":"20250918140955-9332oqf","Type":"NodeParagraph","Properties":{"id":"20250918140955-9332oqf","updated":"20250918140955"},"Children":[{"Type":"NodeText","Data":"预渲染结束后，失活摄像机，避免额外开销"}]}]}]},{"ID":"20250918140951-mvlujc0","Type":"NodeParagraph","Properties":{"id":"20250918140951-mvlujc0","updated":"20250918141029"},"Children":[{"Type":"NodeText","Data":"关键注意点："}]},{"ID":"20250918141029-3ml6wq5","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250918141029-3ml6wq5","updated":"20250918141759"},"Children":[{"ID":"20250918141029-eift1iq","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250918141029-eift1iq","updated":"20250918141759"},"Children":[{"ID":"20250918141029-94t3q4c","Type":"NodeParagraph","Properties":{"id":"20250918141029-94t3q4c","updated":"20250918141759"},"Children":[{"Type":"NodeText","Data":"使用新的专门用于预渲染的摄像机"}]}]},{"ID":"20250918141029-0yhay7i","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250918141029-0yhay7i","updated":"20250918141740"},"Children":[{"ID":"20250918141029-6z71737","Type":"NodeParagraph","Properties":{"id":"20250918141029-6z71737","updated":"20250918141740"},"Children":[{"Type":"NodeText","Data":"创建新的专门用于预渲染的层级"}]}]},{"ID":"20250918141029-ys4e74i","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250918141029-ys4e74i","updated":"20250918141031"},"Children":[{"ID":"20250918141029-fpgl8d1","Type":"NodeParagraph","Properties":{"id":"20250918141029-fpgl8d1","updated":"20250918142150"},"Children":[{"Type":"NodeText","Data":"需要一个 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​ 关联在用于预渲染的摄像机"}]}]}]},{"ID":"20250918144050-8m90fpn","Type":"NodeParagraph","Properties":{"id":"20250918144050-8m90fpn","updated":"20250918144104"},"Children":[{"Type":"NodeText","Data":"通过该方法预渲染的脚本思路如下："}]},{"ID":"20250918144105-q986vfj","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250918144105-q986vfj","updated":"20250918144339"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"using System.Collections;\nusing System.Collections.Generic;\nusing UnityEngine;\n\npublic class PreRenderHelper : MonoBehaviour\n{\n    public Camera hiddenCamera;\n    public RenderTexture renderTex;\n\n    public void PreRender(List\u003cstring\u003e resNameList)\n    {\n        StartCoroutine(PreRenderCoroutine(resNameList));\n    }\n\n    private IEnumerator PreRenderCoroutine(List\u003cstring\u003e resNameList)\n    {\n        // 目前renderTex是创建好的，以后为了节约内存，可以动态创建一个临时的RenderTexture\n        if (hiddenCamera == null || renderTex == null)\n        {\n            Debug.LogWarning(\"用于预渲染的摄像机和渲染文理未设置\");\n            yield break;\n        }\n        hiddenCamera.targetTexture = renderTex;\n        hiddenCamera.enabled = true;\n        \n        foreach (var resName in resNameList)\n        {\n            // 预加载资源，Resources, AssetBundle, Addressable...\n            // 预实例化逻辑\n            var obj = new GameObject(resName);\n            // 需要把实例化的内容层级改到对应的预渲染层，并且要把它的位置放到预渲染摄像机能看到的位置\n            obj.layer = LayerMask.NameToLayer(\"PreRender\");\n        }\n        \n        // 等待摄像机和GUI渲染完成后执行\n        yield return new WaitForEndOfFrame();\n        \n        hiddenCamera.enabled = false;\n        hiddenCamera.targetTexture = null;\n        // 把代码动态创建的RenderTexture给释放移除掉\n        renderTex.Release();\n        renderTex = null;\n    }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250918141145-i6nky43","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20250918141145-i6nky43","updated":"20250918150813"},"Children":[{"Type":"NodeText","Data":"Unity 预渲染相关 API"}]},{"ID":"20250918141204-nun00tu","Type":"NodeBlockquote","Properties":{"id":"20250918141204-nun00tu","updated":"20250918141357"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250918141212-guyz4y1","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20250918141212-guyz4y1","updated":"20250918141357"},"Children":[{"Type":"NodeText","Data":"Shader 关键字和变体"}]},{"ID":"20250918141220-fvr20je","Type":"NodeParagraph","Properties":{"id":"20250918141220-fvr20je","updated":"20250918141357"},"Children":[{"Type":"NodeText","Data":"关于 Shader 关键字和变体，详情可见："},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250128170153-so50dgr","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"US5L3——Shader变体和关键字"}]},{"ID":"20250918141327-f90betv","Type":"NodeParagraph","Properties":{"id":"20250918141327-f90betv","updated":"20250918141327"},"Children":[{"Type":"NodeText","Data":"Shader Variant（变体）指的是一个 Shader 的特定配置，通过不同的 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"关键字（Keywords）"},{"Type":"NodeText","Data":"和 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设置组合"},{"Type":"NodeText","Data":" 来实现不同的效果\n每一种关键字组合或设置都会生成一个独立的 Shader 变体，最终以二进制形式存储在构建文件中供运行时使用"}]},{"ID":"20250918141327-xq9b9lv","Type":"NodeParagraph","Properties":{"id":"20250918141327-xq9b9lv","updated":"20250918141327"},"Children":[{"Type":"NodeText","Data":"说人话：Shader 变体就是基于一个 Shader 文件当中的代码，编译生成多个版本的 Shader 它基于关键字来生成各种不同的版本"}]},{"ID":"20250918141327-yp0d2rw","Type":"NodeParagraph","Properties":{"id":"20250918141327-yp0d2rw","updated":"20250918141327"},"Children":[{"Type":"NodeText","Data":"举例说明：一个 Shader 中有两个关键字，每个关键字有两种状态（启用或禁用），最终生成的变体数量就是 2"},{"Type":"NodeTextMark","TextMarkType":"sup","TextMarkTextContent":"2"},{"Type":"NodeText","Data":" = 4"}]},{"ID":"20250918141327-qtwvdgq","Type":"NodeList","ListData":{},"Properties":{"id":"20250918141327-qtwvdgq","updated":"20250918141327"},"Children":[{"ID":"20250918141327-0ah5vvr","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250918141327-0ah5vvr","updated":"20250918141327"},"Children":[{"ID":"20250918141327-dil530o","Type":"NodeParagraph","Properties":{"id":"20250918141327-dil530o","updated":"20250918141327"},"Children":[{"Type":"NodeText","Data":"变体 1：没有启用任何关键字（默认）。\n"}]}]},{"ID":"20250918141327-7txn9p4","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250918141327-7txn9p4","updated":"20250918141327"},"Children":[{"ID":"20250918141327-qjsc39x","Type":"NodeParagraph","Properties":{"id":"20250918141327-qjsc39x","updated":"20250918141327"},"Children":[{"Type":"NodeText","Data":"变体 2：启用了 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"关键字1"},{"Type":"NodeText","Data":"。\n"}]}]},{"ID":"20250918141327-pnsrwhv","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250918141327-pnsrwhv","updated":"20250918141327"},"Children":[{"ID":"20250918141327-bat4tbz","Type":"NodeParagraph","Properties":{"id":"20250918141327-bat4tbz","updated":"20250918141327"},"Children":[{"Type":"NodeText","Data":"变体 3：启用了 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"关键字2"},{"Type":"NodeText","Data":"。\n"}]}]},{"ID":"20250918141327-7nwx5ld","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250918141327-7nwx5ld","updated":"20250918141327"},"Children":[{"ID":"20250918141327-uhhyp60","Type":"NodeParagraph","Properties":{"id":"20250918141327-uhhyp60","updated":"20250918141327"},"Children":[{"Type":"NodeText","Data":"变体 4：同时启用了 关键字1 和 关键字2"}]}]}]},{"ID":"20250918141327-4cnqfj0","Type":"NodeParagraph","Properties":{"id":"20250918141327-4cnqfj0","updated":"20250918141327"},"Children":[{"Type":"NodeText","Data":"运行时，Unity 会根据具体设置选择与之匹配的变体来使用，Unity 的一些内置功能会隐式的生成变体，比如："}]},{"ID":"20250918141327-a5zpfgw","Type":"NodeList","ListData":{},"Properties":{"id":"20250918141327-a5zpfgw","updated":"20250918141327"},"Children":[{"ID":"20250918141327-ylnmc6d","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250918141327-ylnmc6d","updated":"20250918141327"},"Children":[{"ID":"20250918141327-lpx39t5","Type":"NodeParagraph","Properties":{"id":"20250918141327-lpx39t5","updated":"20250918141327"},"Children":[{"Type":"NodeText","Data":"光照模式 —— "},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20241128125933-atvirum","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"US3S5L6——多种光源综合实现"}]}]},{"ID":"20250918141327-axfdzyp","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250918141327-axfdzyp","updated":"20250918141327"},"Children":[{"ID":"2025