{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250918141436-vedmwes","updated":"20250918141436"},"Children":[{"ID":"20250918141436-28xmni2","Type":"NodeParagraph","Properties":{"id":"20250918141436-28xmni2","updated":"20250918141436"},"Children":[{"Type":"NodeText","Data":"在 Project 窗口 右键 → Create → Shader → Shader Variant Collection（着色器变体集合）"}]}]},{"ID":"20250918141436-a5acsog","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250918141436-a5acsog","updated":"20250918150248"},"Children":[{"ID":"20250918141436-jezus38","Type":"NodeParagraph","Properties":{"id":"20250918141436-jezus38","updated":"20250918150248"},"Children":[{"Type":"NodeText","Data":"在 Inspector 窗口中手动添加想要预热的 Shader，点击 + 号选择想要预热的Shader变体"}]},{"ID":"20250918145759-jnwvxi0","Type":"NodeParagraph","Properties":{"id":"20250918145759-jnwvxi0","updated":"20250918150220"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250918150220-ki52pma.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20250918141436-2cca827","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250918141436-2cca827","updated":"20250918141451"},"Children":[{"ID":"20250918141436-pelpi2q","Type":"NodeParagraph","Properties":{"id":"20250918141436-pelpi2q","updated":"20250918145641"},"Children":[{"Type":"NodeText","Data":"在脚本中获取到 Shader Variant Collection 利用其中的 API "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WarmUp()"},{"Type":"NodeText","Data":"​ 进行预编译"}]},{"ID":"20250918145642-4kwpcc2","Type":"NodeParagraph","Properties":{"id":"20250918145642-4kwpcc2","updated":"20250918145730"},"Children":[{"Type":"NodeText","Data":"一般是加载场景时才去进行预编译，预编译前可以通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"isWarmedUp"},{"Type":"NodeText","Data":"​ 属性判断变体集合是否已经预热"}]}]}]},{"ID":"20250918145610-oqloob7","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250918145610-oqloob7","updated":"20250918145631"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"public ShaderVariantCollection shaderVariantCollection;\n\nprivate void Start()\n{\n    if (shaderVariantCollection != null \u0026\u0026 !shaderVariantCollection.isWarmedUp)\n    {\n        shaderVariantCollection.WarmUp();\n    }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250918145937-s92chqq","Type":"NodeParagraph","Properties":{"id":"20250918145937-s92chqq","updated":"20250918150724"},"Children":[{"Type":"NodeText","Data":"在实际项目中，我们更多可以在编辑器环境下通过代码动态收集 Shader 变体到 Shader Variant Collection 内，然后打包后在合适的时机一次性预热好"}]},{"ID":"20250918150749-u1wu54o","Type":"NodeBlockquote","Properties":{"id":"20250918150749-u1wu54o","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20250918150813"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250918150813-gh6mghi","Type":"NodeParagraph","Properties":{"id":"20250918150813-gh6mghi","updated":"20250918150813"},"Children":[{"Type":"NodeText","Data":"注意：预热 Shader 还是需要在合适的时机进行，比如加载界面时"}]}]},{"ID":"20250918141459-j3ayaoy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"alias":"Graphics.ExecuteCommandBuffer","id":"20250918141459-j3ayaoy","name":"CommandBuffer","updated":"20250918153502"},"Children":[{"Type":"NodeText","Data":"利用 Unity API 进行预渲染"}]},{"ID":"20250918141511-mrwls4w","Type":"NodeParagraph","Properties":{"id":"20250918141511-mrwls4w","updated":"20250918141521"},"Children":[{"Type":"NodeText","Data":"如果我们不希望创建隐藏摄像机，那么我们可以利用这种方式进行预渲染，可以直接以脚本命令触发一次 CPU 到 GPU 的通信"}]},{"ID":"20250918141523-jdiib2e","Type":"NodeParagraph","Properties":{"id":"20250918141523-jdiib2e","updated":"20250918151502"},"Children":[{"Type":"NodeText","Data":"预渲染方式：\n利用 Unity 中的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CommandBuffer"},{"Type":"NodeText","Data":"​（命令缓冲区）进行一次 CPU 到 GPU 的数据上传\n通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Renderer"},{"Type":"NodeText","Data":"​（渲染器）获取到材质，在利用材质获取到 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Pass"},{"Type":"NodeText","Data":"​（渲染通道）\n利用这些数据进行一次预热，可以有效避免首次渲染时造成的卡顿，这样做的好处是"}]},{"ID":"20250918141548-0nkmddl","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250918141548-0nkmddl","updated":"20250918141556"},"Children":[{"ID":"20250918141548-ezwemxs","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250918141548-ezwemxs","updated":"20250918141552"},"Children":[{"ID":"20250918141548-5mrjq8v","Type":"NodeParagraph","Properties":{"id":"20250918141548-5mrjq8v","updated":"20250918141552"},"Children":[{"Type":"NodeText","Data":"不需要创建相机，直接用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CommandBuffer"},{"Type":"NodeText","Data":"​ 提交绘制命令"}]}]},{"ID":"20250918141548-j9btfnl","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250918141548-j9btfnl","updated":"20250918141548"},"Children":[{"ID":"20250918141548-vmbaijk","Type":"NodeParagraph","Properties":{"id":"20250918141548-vmbaijk","updated":"20250918141548"},"Children":[{"Type":"NodeText","Data":"用很小的 RT（默认 64×64）减少性能消耗"}]}]},{"ID":"20250918141548-hvhhb2r","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250918141548-hvhhb2r","updated":"20250918141548"},"Children":[{"ID":"20250918141548-gytlgz6","Type":"NodeParagraph","Properties":{"id":"20250918141548-gytlgz6","updated":"20250918141548"},"Children":[{"Type":"NodeText","Data":"不会影响游戏画面"}]}]},{"ID":"20250918141548-zzv9h0b","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250918141548-zzv9h0b","updated":"20250918141556"},"Children":[{"ID":"20250918141548-pqcmdiq","Type":"NodeParagraph","Properties":{"id":"20250918141548-pqcmdiq","updated":"20250918141556"},"Children":[{"Type":"NodeText","Data":"可批量调用，对不同 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Renderer"},{"Type":"NodeText","Data":"​ 或 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Pass"},{"Type":"NodeText","Data":"​ 预热"}]}]}]},{"ID":"20250918152041-0yzkz5l","Type":"NodeParagraph","Properties":{"id":"20250918152041-0yzkz5l","updated":"20250918152051"},"Children":[{"Type":"NodeText","Data":"渲染的大致思路如下："}]},{"ID":"20250918152135-qgoqdup","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250918152135-qgoqdup","updated":"20250918152927"},"Children":[{"ID":"20250918152146-qpr1suh","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250918152146-qpr1suh","updated":"20250918152146"},"Children":[{"ID":"20250918152146-ukvdb5k","Type":"NodeParagraph","Properties":{"id":"20250918152146-ukvdb5k","updated":"20250918152736"},"Children":[{"Type":"NodeText","Data":"获取需要预渲染对象的渲染器 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Renderer"},{"Type":"NodeText","Data":"​，并指定预渲染的渲染通道 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Pass"},{"Type":"NodeText","Data":"​ 名字"}]}]},{"ID":"20250918152312-vpdqm28","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250918152312-vpdqm28","updated":"20250918152312"},"Children":[{"ID":"20250918152312-zv38l56","Type":"NodeParagraph","Properties":{"id":"20250918152312-zv38l56","updated":"20250918152350"},"Children":[{"Type":"NodeText","Data":"通过渲染器获取其关联的材质，通过预渲染的 Pass 名字找到索引"}]}]},{"ID":"20250918152350-t7uzwn3","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250918152350-t7uzwn3","updated":"20250918152350"},"Children":[{"ID":"20250918152350-zlbpjbu","Type":"NodeParagraph","Properties":{"id":"20250918152350-zlbpjbu","updated":"20250918152538"},"Children":[{"Type":"NodeText","Data":"创建指令缓冲区 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CommandBuffer"},{"Type":"NodeText","Data":"​，通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CommandBuffer"},{"Type":"NodeText","Data":"​ 申请一个临时的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​，并指定 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​ 作为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CommandBuffer"},{"Type":"NodeText","Data":"​ 的渲染目标"}]}]},{"ID":"20250918152538-z15htb0","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250918152538-z15htb0","updated":"20250918152538"},"Children":[{"ID":"20250918152538-sqbz8df","Type":"NodeParagraph","Properties":{"id":"20250918152538-sqbz8df","updated":"20250918152818"},"Children":[{"Type":"NodeText","Data":"准备 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​，清空其中的颜色和深度，然后使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Renderer"},{"Type":"NodeText","Data":"​ 及其材质，指定子网格索引和渲染通道 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Pass"},{"Type":"NodeText","Data":"​ 索引，将内容绘制在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​ 上"}]}]},{"ID":"20250918152818-1q29ht6","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20250918152818-1q29ht6","updated":"20250918152927"},"Children":[{"ID":"20250918152818-ell0lme","Type":"NodeParagraph","Properties":{"id":"20250918152818-ell0lme","updated":"20250918152927"},"Children":[{"Type":"NodeText","Data":"通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Graphics.ExecuteCommandBuffer"},{"Type":"NodeText","Data":"​ 立刻执行指令缓冲区 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CommandBuffer"},{"Type":"NodeText","Data":"​，执行完毕后释放 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​ 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CommandBuffer"},{"Type":"NodeText","Data":"​"}]}]}]},{"ID":"20250918144803-w3a4y0h","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250918144803-w3a4y0h","updated":"20250918153502"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"/// \u003csummary\u003e\n/// 对指定 Renderer 使用 CommandBuffer 进行一次离屏渲染（哑渲染），\n/// 以触发指定 Pass 的 Shader 编译、资源上传等预热操作。\n/// \u003c/summary\u003e\n/// \u003cparam name=\"r\"\u003e需要预热的 Renderer（其材质会被用来渲染）\u003c/param\u003e\n/// \u003cparam name=\"passName\"\u003eShader Pass 名（如 \"ForwardBase\", \"ShadowCaster\" 等）\u003c/param\u003e\n/// \u003cparam name=\"width\"\u003e临时 RenderTexture 宽度（默认 64），越小越节约性能\u003c/param\u003e\n/// \u003cparam name=\"height\"\u003e临时 RenderTexture 高度（默认 64），越小越节约性能\u003c/param\u003e\npublic static void WarmUpRenderer(Renderer renderer, string passName, int width = 64, int height = 64)\n{\n    // 获取 Renderer 使用的共享材质（不会实例化）\n    Material material = renderer.sharedMaterial;\n    // 查找该材质中指定 Pass 的索引\n    int pass = material.FindPass(passName);\n    if (pass \u003c 0)\n    {\n        // 如果没找到该 Pass，打印警告并退出\n        Debug.LogWarning($\"没有找到 Pass: {passName}\");\n        return;\n    }\n    // 创建一个 CommandBuffer（命令缓冲区），用来批量提交 GPU 绘制指令\n    // name 名字可以随意自定义，它的作用只是在调试工具中可以显示出来，方便你知道这个缓冲区的作用\n    CommandBuffer commandBuffer = new() { name = $\"Warmup Renderer: {renderer.name}_{passName}\" };\n    // 为临时 RenderTexture 申请一个 ID（Shader 属性 ID）\n    // 把字符串转换成一个唯一的整数ID，这个字符串也可以自定义\n    int tempID = Shader.PropertyToID(\"_WarmupRT\");\n    // 申请一个临时 RenderTexture（指定ID、宽高、无 MSAA、ARGB32 格式）\n    commandBuffer.GetTemporaryRT(tempID, width, height, 0, FilterMode.Point, RenderTextureFormat.ARGB32);\n    // 设置该临时 RenderTexture 作为渲染目标\n    commandBuffer.SetRenderTarget(tempID);\n    // 清空 RenderTexture（清颜色 \u0026 深度）\n    commandBuffer.ClearRenderTarget(true, true, Color.clear);\n    // 使用该 Renderer 和材质，使用指定索引子网格（第三个参数），指定渲染通道索引 进行绘制\n    commandBuffer.DrawRenderer(renderer, material, 0, pass);\n    \n    // 立即执行这个 CommandBuffer（提交给 GPU）\n    // 关键步骤\n    Graphics.ExecuteCommandBuffer(commandBuffer);\n    \n    // 释放临时 RenderTexture 资源（避免显存泄漏）\n    commandBuffer.ReleaseTemporaryRT(tempID);\n    // 释放命令缓冲区本身\n    commandBuffer.Release();\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]}