:{"id":"20251124150849-xseoxal","updated":"20251124150909"},"Children":[{"Type":"NodeText","Data":"配置 Animator Culling 模式"}]}]},{"ID":"20251124150849-0dzf8w1","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20251124150849-0dzf8w1","updated":"20251124150918"},"Children":[{"ID":"20251124150849-txlautt","Type":"NodeParagraph","Properties":{"id":"20251124150849-txlautt","updated":"20251124150918"},"Children":[{"Type":"NodeText","Data":"按需使用 GPU Skinning"}]}]},{"ID":"20251124150849-acf7hd9","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20251124150849-acf7hd9","updated":"20251124150917"},"Children":[{"ID":"20251124150849-jbuniss","Type":"NodeParagraph","Properties":{"id":"20251124150849-jbuniss","updated":"20251124150917"},"Children":[{"Type":"NodeText","Data":"实现动画 LOD 系统"}]}]}]},{"ID":"20251124115931-649xs7e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251124115931-649xs7e","updated":"20251125155237"},"Children":[{"Type":"NodeText","Data":"网格资源导入优化"}]},{"ID":"20251124115955-ndcz357","Type":"NodeParagraph","Properties":{"id":"20251124115955-ndcz357","updated":"20251124115955"},"Children":[{"Type":"NodeText","Data":"网格导入设置是优化的第一道关卡"}]},{"ID":"20251124120200-2313c4y","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251124120200-2313c4y","updated":"20251125155237"},"Children":[{"ID":"20251124120212-hnhtp5x","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251124120212-hnhtp5x","updated":"20251124150203"},"Children":[{"ID":"20251124120212-wl4wc3n","Type":"NodeParagraph","Properties":{"id":"20251124120212-wl4wc3n","updated":"20251124150203"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20230807200532-2g5x86q","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"Mesh Compression"},{"Type":"NodeText","Data":"（网格压缩）"}]},{"ID":"20251124120218-1x9qf3z","Type":"NodeList","ListData":{},"Properties":{"id":"20251124120218-1x9qf3z","updated":"20251124120219"},"Children":[{"ID":"20251124120219-q5eagwu","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124120219-q5eagwu","updated":"20251124120219"},"Children":[{"ID":"20251124120219-7u8k5d2","Type":"NodeParagraph","Properties":{"id":"20251124120219-7u8k5d2","updated":"20251124120219"},"Children":[{"Type":"NodeText","Data":"Off：无压缩，最高精度，绝对精确，没有任何视觉损失"}]}]},{"ID":"20251124120220-shuy36z","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124120220-shuy36z","updated":"20251124120220"},"Children":[{"ID":"20251124120220-8ym64ow","Type":"NodeParagraph","Properties":{"id":"20251124120220-8ym64ow","updated":"20251124120220"},"Children":[{"Type":"NodeText","Data":"Low：施加非常轻微的压缩。对顶点数据的精度损失几乎不可见"}]}]},{"ID":"20251124120220-i9ichc7","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124120220-i9ichc7","updated":"20251124120220"},"Children":[{"ID":"20251124120220-1t5273b","Type":"NodeParagraph","Properties":{"id":"20251124120220-1t5273b","updated":"20251124120220"},"Children":[{"Type":"NodeText","Data":"Medium：平衡压缩率和视觉质量"}]}]},{"ID":"20251124120221-tadu3lh","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124120221-tadu3lh","updated":"20251124120221"},"Children":[{"ID":"20251124120221-d63k3fv","Type":"NodeParagraph","Properties":{"id":"20251124120221-d63k3fv","updated":"20251124120221"},"Children":[{"Type":"NodeText","Data":"High：激进地压缩顶点数据以追求最大程度的体积缩减"}]}]}]},{"ID":"20251124120215-p3bs86i","Type":"NodeParagraph","Properties":{"id":"20251124120215-p3bs86i","updated":"20251124120254"},"Children":[{"Type":"NodeText","Data":"作用：目的是减小网格资产在磁盘上的文件大小以及在运行时内存中的占用\n它通过降低顶点数据的精度来实现这一目标，本质上是在内存、磁盘空间和顶点精度之间进行权衡\n压缩的不是多边形数量，而是每个顶点的位置、法线、UV 等数据的存储精度\n但是过高压缩会带来闪烁、法线接缝、法线贴图异常等等副作用\n压缩带来的问题在静态模型上往往不明显，但在骨骼动画模型上会被放大\n务必在动画状态下测试设置为 High 压缩级别的角色，观察关节处是否有抖动"}]},{"ID":"20251124120234-9nr3mlq","Type":"NodeParagraph","Properties":{"id":"20251124120234-9nr3mlq","updated":"20251124120247"},"Children":[{"Type":"NodeText","Data":"建议："}]},{"ID":"20251124120247-u55836x","Type":"NodeList","ListData":{},"Properties":{"id":"20251124120247-u55836x","updated":"20251124120247"},"Children":[{"ID":"20251124120247-5efsdt7","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124120247-5efsdt7","updated":"20251124120247"},"Children":[{"ID":"20251124120247-r82zkwi","Type":"NodeParagraph","Properties":{"id":"20251124120247-r82zkwi","updated":"20251124120247"},"Children":[{"Type":"NodeText","Data":"重要角色、主角，会近距离观察 → Low 或 Medium"}]}]},{"ID":"20251124120248-j55xrc9","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124120248-j55xrc9","updated":"20251124120248"},"Children":[{"ID":"20251124120248-hcszp66","Type":"NodeParagraph","Properties":{"id":"20251124120248-hcszp66","updated":"20251124120248"},"Children":[{"Type":"NodeText","Data":"主要道具，玩家会经常互动 → Medium"}]}]},{"ID":"20251124120248-t5i7one","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124120248-t5i7one","updated":"20251124120248"},"Children":[{"ID":"20251124120248-0u9x570","Type":"NodeParagraph","Properties":{"id":"20251124120248-0u9x570","updated":"20251124120248"},"Children":[{"Type":"NodeText","Data":"大量使用的场景物件/远景物体 → High"}]}]}]}]},{"ID":"20251124120257-f3laj3l","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251124120257-f3laj3l","updated":"20251125155237"},"Children":[{"ID":"20251124120257-9kj2wtk","Type":"NodeParagraph","Properties":{"id":"20251124120257-9kj2wtk","updated":"20251124120440"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20230807200532-59q8tv6","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"Read/Write"},{"Type":"NodeText","Data":"（是否允许 CPU 读写）"}]},{"ID":"20251124120311-twhfoie","Type":"NodeList","ListData":{},"Properties":{"id":"20251124120311-twhfoie","updated":"20251124120312"},"Children":[{"ID":"20251124120312-jkmqpgf","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124120312-jkmqpgf","updated":"20251124120312"},"Children":[{"ID":"20251124120312-8nkebo2","Type":"NodeParagraph","Properties":{"id":"20251124120312-8nkebo2","updated":"20251124120316"},"Children":[{"Type":"NodeText","Data":"勾选：CPU 和 GPU 都可访问网格数据"}]}]},{"ID":"20251124120313-rh30891","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124120313-rh30891","updated":"20251124120313"},"Children":[{"ID":"20251124120313-s2n0mi2","Type":"NodeParagraph","Properties":{"id":"20251124120313-s2n0mi2","updated":"20251124120321"},"Children":[{"Type":"NodeText","Data":"不勾选：仅 GPU 可访问，上传后释放 CPU 内存"}]}]}]},{"ID":"20251124120308-gct87tv","Type":"NodeParagraph","Properties":{"id":"20251124120308-gct87tv","updated":"20251125155237"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"建议：运行时不需要修改的网格务必取消勾选，许多内存飙升问题就出在忘记关这里"}]}]},{"ID":"20251124120350-loae37v","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251124120350-loae37v","updated":"20251124120350"},"Children":[{"ID":"20251124120350-ymuiofn","Type":"NodeParagraph","Properties":{"id":"20251124120350-ymuiofn","updated":"20251124120411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20230807200532-54cnrsw","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"Optimize Mesh"},{"Type":"NodeText","Data":"（优化网格）"}]},{"ID":"20251124120527-js30gig","Type":"NodeParagraph","Properties":{"id":"20251124120527-js30gig","updated":"20251124120609"},"Children":[{"Type":"NodeText","Data":"通过重新组织网格数据，来提高 GPU 的渲染效率\n优化前：就像把一本工具书的页码完全打乱，找每个工具都要翻来翻去\n优化后：就像把书按章节和索引整理好，查找工具时速度飞快"}]},{"ID":"20251124120548-5p5vctx","Type":"NodeList","ListData":{},"Properties":{"id":"20251124120548-5p5vctx","updated":"20251124120548"},"Children":[{"ID":"20251124120548-euu33rp","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124120548-euu33rp","updated":"20251124120548"},"Children":[{"ID":"20251124120522-f8aip1i","Type":"NodeParagraph","Properties":{"id":"20251124120522-f8aip1i","updated":"20251124120602"},"Children":[{"Type":"NodeText","Data":"Everything (优化所有内容):"}]},{"ID":"20251124120554-ritsaup","Type":"NodeParagraph","Properties":{"id":"20251124120554-ritsaup","updated":"20251124120554"},"Children":[{"Type":"NodeText","Data":"这是最全面、最激进的优化，它会同时优化 Polygon Order（多边形顺序） 和 Vertex Order（顶点顺序）\n通常能带来最好的性能提升，可能会干扰一些依赖于特定顶点顺序的自定义着色器或脚本"}]}]},{"ID":"20251124120548-a8e6wib","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124120548-a8e6wib","updated":"20251124120548"},"Children":[{"ID":"20251124120522-qxsrave","Type":"NodeParagraph","Properties":{"id":"20251124120522-qxsrave","updated":"20251124120601"},"Children":[{"Type":"NodeText","Data":"Polygon Order (优化多边形顺序):"}]},{"ID":"20251124120555-3hzoay2","Type":"NodeParagraph","Properties":{"id":"20251124120555-3hzoay2","updated":"20251124120555"},"Children":[{"Type":"NodeText","Data":"只优化三角形的绘制顺序，而不改变顶点的内存布局\n当你的脚本或着色器依赖于原始的顶点顺序时（这种情况比较罕见）\n作为一个折中方案，如果 Everything 导致问题，可以回退到此选项试试"}]}]},{"ID":"20251124120548-0dm9qz0","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124120548-0dm9qz0","updated":"20251124120548"},"Children":[{"ID":"20251124120522-vmkxlz8","Type":"NodeParagraph","Properties":{"id":"20251124120522-vmkxlz8","updated":"20251124120603"},"Children":[{"Type":"NodeText","Data":"Vertex Order (优化顶点顺序):"}]},{"ID":"20251124120557-5er0gsn","Type":"NodeParagraph","Properties":{"id":"20251124120557-5er0gsn","updated":"20251124120557"},"Children":[{"Type":"NodeText","Data":"只优化顶点在内存中的布局顺序，而不改变三角形的绘制顺序"}]}]},{"ID":"20251124144921-xgj4agj","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124144921-xgj4agj","updated":"20251124144921"},"Children":[{"ID":"20251124144921-1eu1qj6","Type":"NodeParagraph","Properties":{"id":"20251124144921-1eu1qj6","updated":"20251124144929"},"Children":[{"Type":"NodeText","Data":"None：不优化"}]}]}]},{"ID":"20251124144907-11pqo11","Type":"NodeParagraph","Properties":{"id":"20251124144907-11pqo11","updated":"20251124144916"},"Children":[{"Type":"NodeText","Data":"建议：始终勾选 Everything，能提升渲染性能，出现渲染问题时再选择 Polygon Order (优化多边形顺序)"}]}]},{"ID":"20251124144954-ce9m3hj","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20251124144954-ce9m3hj","updated":"20251124145021"},"Children":[{"ID":"20251124144954-yyws4bv","Type":"NodeParagraph","Properties":{"id":"20251124144954-yyws4bv","updated":"20251124145021"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20230807200532-7qna8vv","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"Generate Colliders"},{"Type":"NodeText","Data":"（生成碰撞体）"}]},{"ID":"20251124145009-rn6951p","Type":"NodeList","ListData":{},"Properties":{"id":"20251124145009-rn6951p","updated":"20251124145016"},"Children":[{"ID":"20251124145009-g5cd32u","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124145009-g5cd32u","updated":"20251124145013"},"Children":[{"ID":"20251124145009-16zm0zd","Type":"NodeParagraph","Properties":{"id":"20251124145009-16zm0zd","updated":"20251124145013"},"Children":[{"Type":"NodeText","Data":"勾选：自动生成 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"MeshCollider"},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20251124145009-h5oqlck","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124145009-h5oqlck","updated":"20251124145016"},"Children":[{"ID":"20251124145009-ygidyzl","Type":"NodeParagraph","Properties":{"id":"20