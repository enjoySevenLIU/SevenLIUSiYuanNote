07"},"Children":[{"Type":"NodeText","Data":"AssetBundle 包构建是资源管理的基石"}]},{"ID":"20251124155346-iqsaaix","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251124155346-iqsaaix","updated":"20251125165357"},"Children":[{"ID":"20251124155353-8csqzi7","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251124155353-8csqzi7","updated":"20251125165357"},"Children":[{"ID":"20251124155353-r1m0a9n","Type":"NodeParagraph","Properties":{"id":"20251124155353-r1m0a9n","updated":"20251124155412"},"Children":[{"Type":"NodeText","Data":"AssetBundle 包压缩方式"}]},{"ID":"20251124155356-rnvj9vz","Type":"NodeParagraph","Properties":{"id":"20251124155356-rnvj9vz","updated":"20251124155418"},"Children":[{"Type":"NodeText","Data":"AssetBundle 分三种压缩方式："}]},{"ID":"20251124155424-iagcejv","Type":"NodeList","ListData":{},"Properties":{"id":"20251124155424-iagcejv","updated":"20251125165357"},"Children":[{"ID":"20251124155427-lhxseyw","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124155427-lhxseyw","updated":"20251124155427"},"Children":[{"ID":"20251124155427-n7o3lg7","Type":"NodeParagraph","Properties":{"id":"20251124155427-n7o3lg7","updated":"20251124155436"},"Children":[{"Type":"NodeText","Data":"LZMA：压缩大小最小，加载速度最慢，内存消耗最大，使用场景，首次安装包构建，小体积下载"}]}]},{"ID":"20251124155432-dg7cet0","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124155432-dg7cet0","updated":"20251124155432"},"Children":[{"ID":"20251124155432-r6wx9xu","Type":"NodeParagraph","Properties":{"id":"20251124155432-r6wx9xu","updated":"20251124155438"},"Children":[{"Type":"NodeText","Data":"LZ4：压缩大小中等，加载速度较快，内存消耗小，适合上线项目"}]}]},{"ID":"20251124155433-sa2pbrv","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124155433-sa2pbrv","updated":"20251125165357"},"Children":[{"ID":"20251124155433-vozbk67","Type":"NodeParagraph","Properties":{"id":"20251124155433-vozbk67","updated":"20251125165357"},"Children":[{"Type":"NodeText","Data":"Uncompressed（不压缩）：压缩大小最大，加载速度最快，内存消耗小，适合大量小文件，频繁加载的情况"}]}]}]},{"ID":"20251124155451-kpzusvx","Type":"NodeParagraph","Properties":{"id":"20251124155451-kpzusvx","updated":"20251124155508"},"Children":[{"Type":"NodeText","Data":"90% 的项目推荐用LZ4\nLZ4 是唯一同时兼顾加载速度 + 流式加载能力 + 内存占用合理的格式，是线上热更新 AB 包的行业标准\nLZMA 最大的缺点：必须整体解压，占据巨大额外内存\nLZMA 构建出的 AB 虽然是最小的\n但运行时 Unity 会将整个 AB 原样读入内存，再进行一次整体解压，解压后数据也在内存中\n结果就导致内存占用也大，加载时间还长"}]}]},{"ID":"20251124155524-vmdbhug","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251124155524-vmdbhug","updated":"20251124155524"},"Children":[{"ID":"20251124155524-eel27u8","Type":"NodeParagraph","Properties":{"id":"20251124155524-eel27u8","updated":"20251124155539"},"Children":[{"Type":"NodeText","Data":"AssetBundle 包依赖关系"}]},{"ID":"20251124155554-zkknxm3","Type":"NodeParagraph","Properties":{"id":"20251124155554-zkknxm3","updated":"20251124155608"},"Children":[{"Type":"NodeText","Data":"将公共资源提取到共享 AB 包，避免 AB 包之间双向依赖，控制单个 AB 包的依赖数量"}]}]},{"ID":"20251124155540-tuv64ku","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251124155540-tuv64ku","updated":"20251124155655"},"Children":[{"ID":"20251124155540-wlyq5lo","Type":"NodeParagraph","Properties":{"id":"20251124155540-wlyq5lo","updated":"20251124155552"},"Children":[{"Type":"NodeText","Data":"AB 包粒度规划"}]},{"ID":"20251124155621-llc6vcp","Type":"NodeList","ListData":{},"Properties":{"id":"20251124155621-llc6vcp","updated":"20251124155655"},"Children":[{"ID":"20251124155621-t27sliy","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124155621-t27sliy","updated":"20251124155648"},"Children":[{"ID":"20251124155615-aavyk6z","Type":"NodeParagraph","Properties":{"id":"20251124155615-aavyk6z","updated":"20251124155648"},"Children":[{"Type":"NodeText","Data":"细粒度：大量小 AB 包"}]},{"ID":"202511241556