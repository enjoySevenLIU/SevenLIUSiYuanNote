25154204"},"Children":[{"ID":"20251124113541-jhbq3j6","Type":"NodeParagraph","Properties":{"id":"20251124113541-jhbq3j6","updated":"20251124113553"},"Children":[{"Type":"NodeText","Data":"纹理流送 (Texture Streaming)"}]},{"ID":"20251124113553-gfmpb0f","Type":"NodeList","ListData":{},"Properties":{"id":"20251124113553-gfmpb0f","updated":"20251125154204"},"Children":[{"ID":"20251124113553-lfhjqhq","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124113553-lfhjqhq","updated":"20251124113553"},"Children":[{"ID":"20251124113553-vlkw6f8","Type":"NodeParagraph","Properties":{"id":"20251124113553-vlkw6f8","updated":"20251125153117"},"Children":[{"Type":"NodeText","Data":"作用：按需将纹理 mip 级别加载到显存"}]}]},{"ID":"20251124113554-ydyxrsv","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124113554-ydyxrsv","updated":"20251124113554"},"Children":[{"ID":"20251124113554-eo6cvh4","Type":"NodeParagraph","Properties":{"id":"20251124113554-eo6cvh4","updated":"20251124113554"},"Children":[{"Type":"NodeText","Data":"适用：大型开放世界，内存敏感项目"}]},{"ID":"20251124113557-pzkscpu","Type":"NodeParagraph","Properties":{"id":"20251124113557-pzkscpu","updated":"20251125153524"},"Children":[{"Type":"NodeText","Data":"如果不开启，一个 2048"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":"2048 的纹理，会将其所有Mip级别（1024"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":"1024, 512"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":"512, ..., 1"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":"1）都加载到内存\n而开启后，假设一个在远处的小物体，可能只需要 256"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":"256 或 128"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":"128 的 Mip 级别就能满足视觉需求\n系统就只加载这个低级别到内存，从而节省大量的内存"}]}]},{"ID":"20251124113707-qa5wq6m","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124113707-qa5wq6m","updated":"20251125154031"},"Children":[{"ID":"20251124113707-uke9l41","Type":"NodeParagraph","Properties":{"id":"20251124113707-uke9l41","updated":"20251125153850"},"Children":[{"Type":"NodeText","Data":"设置：在 Project Setting - Quality 设置中开启 Mipmap Streaming"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（Unity 2022 及以前版本此设置项名为 Texture Streaming）"}]},{"ID":"20251125153544-zs8dl3k","Type":"NodeParagraph","Properties":{"id":"20251125153544-zs8dl3k","updated":"20251125154031"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251125154031-d9iq7ar.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20251124113713-7tihsfp","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251124113713-7tihsfp","updated":"20251125154204"},"Children":[{"ID":"20251124113713-2kiken8","Type":"NodeParagraph","Properties":{"id":"20251124113713-2kiken8","updated":"20251124113713"},"Children":[{"Type":"NodeText","Data":"预算：设置纹理流送内存预算"}]},{"ID":"20251125154039-kpf3bm8","Type":"NodeParagraph","Properties":{"id":"20251125154039-kpf3bm8","updated":"20251125154056"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251125154056-6mvasxx.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251124113739-3aer3pz","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251124113739-3aer3pz","updated":"20251125154204"},"Children":[{"ID":"20251124113801-b0orawr","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251124113801-b0orawr","updated":"20251124113801"},"Children":[{"ID":"20251124113801-ppcym64","Type":"NodeParagraph","Properties":{"id":"20251124113801-ppcym64","updated":"20251125153534"},"Children":[{"Type":"NodeText","Data":"Add All Cameras (添加所有摄像机)："}]},{"ID":"20251124113802-vako6ww","Type":"NodeParagraph","Properties":{"id":"20251124113802-vako6ww","updated":"20251124113804"},"Children":[{"Type":"NodeText","Data":"勾选后场景中所有摄像机都会参与计算，不勾选只有被标记为 Main Camera 的摄像机会参与计算"}]}]},{"ID":"20251124113801-njx6jvq","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251124113801-njx6jvq","updated":"20251125154128"},"Children":[{"ID":"20251124113801-7h58gvz","Type":"NodeParagraph","Properties":{"id":"20251124113801-7h58gvz","updated":"20251124113807"},"Children":[{"Type":"NodeText","Data":"Memory Budget (内存预算)"}]},{"ID":"20251124113813-1tyd2fl","Type":"NodeParagraph","Properties":{"id":"20251124113813-1tyd2fl","updated":"20251125154128"},"Children":[{"Type":"NodeText","Data":"设定 Mipmap Streaming 系统可以使用的总内存预算（单位为 MB）\n系统会尝试将活动纹理所需的 Mip 级别控制在这个预算内，如果预算太低，可能会导致纹理频繁流送，产生性能波动"}]}]},{"ID":"20251124113801-z3gy2wq","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251124113801-z3gy2wq","updated":"20251124113801"},"Children":[{"ID":"20251124113801-moq8wnb","Type":"NodeParagraph","Properties":{"id":"20251124113801-moq8wnb","updated":"20251124113801"},"Children":[{"Type":"NodeText","Data":"Renderers Per Frame (每帧渲染器数量)"}]},{"ID":"20251124113817-v5c6hrx","Type":"NodeParagraph","Properties":{"id":"20251124113817-v5c6hrx","updated":"20251124113817"},"Children":[{"Type":"NodeText","Data":"每帧最多计算多少个渲染器所需的 Mip 级别\n在大型场景中，如果发现远处纹理加载过慢，可以适当调高此值（如 1024）\n如果遇到 CPU 峰值，则降低它"}]}]},{"ID":"20251124113801-v5f5jrw","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20251124113801-v5f5jrw","updated":"20251125154204"},"Children":[{"ID":"20251124113801-x5cga8f","Type":"NodeParagraph","Properties":{"id":"20251124113801-x5cga8f","updated":"20251124113801"},"Children":[{"Type":"NodeText","Data":"Max Level Reduction (最大级别缩减)"}]},{"ID":"20251124113819-q6k327f","Type":"NodeParagraph","Properties":{"id":"20251124113819-q6k327f","updated":"20251125154204"},"Children":[{"Type":"NodeText","Data":"允许纹理的 Mip 级别相对于其最大值最多降低多少级\n这是一个质量保护参数，值为 2 意味着一个 2048"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":"2048（最大 mip 为11级）的纹理\n最多只能被降低到使用 512"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":"512（降低 2 级后为第 9 级）的 Mip，而不会被降到更模糊的 256"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":"256 级别"}]}]},{"ID":"20251124113801-zwe7t25","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20251124113801-zwe7t25","updated":"20251125154104"},"Children":[{"ID":"20251124113801-cmkkz7o","Type":"NodeParagraph","Properties":{"id":"20251124113801-cmkkz7o","updated":"20251125154104"},"Children":[{"Type":"NodeText","Data":"Max IO Requests (最大 I/O 请求数)"}]},{"ID":"20251124113842-v55w41c","Type":"NodeParagraph","Properties":{"id":"20251124113842-v55w41c","updated":"20251124113842"},"Children":[{"Type":"NodeText","Data":"限制每帧同时进行的磁盘读取请求数量\n这是一个 I/O 保护参数，从硬盘加载 Mip 数据会产生 I/O 操作\n此参数防止系统在一帧内发起过多请求，阻塞磁盘\n对于安装在 SSD 上的项目，可以设置得较高（如 1024）\n对于机械硬盘或网络流送，应设置得较低（如 128-256）"}]}]}]}]}]}]},{"ID":"20251124113907-h8xvjoz","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251124113907-h8xvjoz","updated":"20251125154547"},"Children":[{"ID":"202