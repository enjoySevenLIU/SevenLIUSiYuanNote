250926145632"},"Children":[{"Type":"NodeText","Data":"Inertia Tensor scale（惯性张量比例）： 控制显示的惯性张量 Gizmo 的缩放 例如把它调大，更容易看清楚刚体的主惯性轴方向"}]}]}]}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20250926145633-2kwoyoo","Type":"NodeParagraph","Properties":{"id":"20250926145633-2kwoyoo","updated":"20250926150010"},"Children":[{"Type":"NodeText","Data":"调试建议： 这个界面就是一个 调试工具颜色设置界面，可以让我们自定义颜色、细节显示，方便我们更清楚直观的观察物理系统对象的变化"}]},{"ID":"20250926150040-4xowa23","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250926150040-4xowa23","updated":"20250926150245"},"Children":[{"Type":"NodeText","Data":"Contacts（联系方式）页签"}]},{"ID":"20250926150158-nas2cwa","Type":"NodeParagraph","Properties":{"id":"20250926150158-nas2cwa","updated":"20250926150207"},"Children":[{"Type":"NodeText","Data":"显示物体之间的物理接触信息\n用途：调试 碰撞为什么没有触发、为什么会穿模、为什么弹力怪异，能看到碰撞点在哪里、法线指向哪里"}]},{"ID":"20250926150404-w1rmizs","Type":"NodeParagraph","Properties":{"id":"20250926150404-w1rmizs","updated":"20250926150458"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250926150458-01bg5av.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250926150257-pwt3a3n","Type":"NodeSuperBlock","Properties":{"id":"20250926150257-pwt3a3n","updated":"20250926150245"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20250926150209-44yg7x1","Type":"NodeParagraph","Properties":{"id":"20250926150209-44yg7x1","updated":"20250926150258"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250926141237-bl4xvyt.png"},{"Type":"NodeCl