":"20251011102327"},"Children":[{"ID":"20251011102327-ksuxuwo","Type":"NodeParagraph","Properties":{"id":"20251011102327-ksuxuwo","updated":"20251011102327"},"Children":[{"Type":"NodeText","Data":"Nothing：不显示任何 2D 物理相关的 Gizmos"}]}]},{"ID":"20251011102327-9afe5kj","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251011102327-9afe5kj","updated":"20251011102327"},"Children":[{"ID":"20251011102327-fkj1fz4","Type":"NodeParagraph","Properties":{"id":"20251011102327-fkj1fz4","updated":"20251011102327"},"Children":[{"Type":"NodeText","Data":"Everything：显示所有可用的 Collider Gizmos（相当于全选）"}]}]},{"ID":"20251011102327-r5dhsd3","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251011102327-r5dhsd3","updated":"20251011102327"},"Children":[{"ID":"20251011102327-1rmcvio","Type":"NodeParagraph","Properties":{"id":"20251011102327-1rmcvio","updated":"20251011102327"},"Children":[{"Type":"NodeText","Data":"All Colliders：显示场景中所有的 2D Collider"}]}]},{"ID":"20251011102327-qsvmtrh","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251011102327-qsvmtrh","updated":"20251011102327"},"Children":[{"ID":"20251011102327-m5fkfoj","Type":"NodeParagraph","Properties":{"id":"20251011102327-m5fkfoj","updated":"20251011103803"},"Children":[{"Type":"NodeText","Data":"Colliders Outlined：显示碰撞体的轮廓线，常用来直观检查碰撞体形状"}]}]},{"ID":"20251011102327-yvnjpaz","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251011102327-yvnjpaz","updated":"20251011102327"},"Children":[{"ID":"20251011102327-mkr9wrz","Type":"NodeParagraph","Properties":{"id":"20251011102327-mkr9wrz","updated":"20251011103804"},"Children":[{"Type":"NodeText","Data":"Colliders Filled：显示碰撞体的填充区域，一般用来区分重叠的碰撞体"}]}]},{"ID":"20251011102327-iqxmibk","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251011102327-iqxmibk","updated":"20251011103820"},"Children":[{"ID":"202510