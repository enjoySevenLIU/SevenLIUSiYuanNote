-wc3hhb4","Type":"NodeParagraph","Properties":{"id":"20251031152149-wc3hhb4","updated":"20251031152206"},"Children":[{"Type":"NodeText","Data":"启用后显示下方两个属性，该值默认不启用"}]},{"ID":"20251031151715-to1vmvs","Type":"NodeList","ListData":{},"Properties":{"id":"20251031151715-to1vmvs","updated":"20251031151947"},"Children":[{"ID":"20251031151947-io8d7ol","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251031151947-io8d7ol","updated":"20251031151947"},"Children":[{"ID":"20251031151947-r2r0fju","Type":"NodeParagraph","Properties":{"id":"20251031151947-r2r0fju","updated":"20251031152017"},"Children":[{"Type":"NodeText","Data":"Inter-Collision Distance"}]},{"ID":"20251031152039-0f1gyzt","Type":"NodeParagraph","Properties":{"id":"20251031152039-0f1gyzt","updated":"20251031152112"},"Children":[{"Type":"NodeText","Data":"定义每个相互碰撞的布料粒子周围球体的直径（以世界单位为单位）。\nUnity 确保这些球体在模拟过程中不会重叠。距离应小于配置中两个粒子之间的最小距离。如果距离更大，布料碰撞可能会违反距离约束，导致抖动。"}]}]},{"ID":"20251031151958-gwrs14t","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251031151958-gwrs14t","updated":"20251031151958"},"Children":[{"ID":"20251031151958-f9kf379","Type":"NodeParagraph","Properties":{"id":"20251031151958-f9kf379","updated":"20251031152035"},"Children":[{"Type":"NodeText","Data":"Inter-Collision Stiffness"}]},{"ID":"20251031152117-qunh2ni","Type":"NodeParagraph","Properties":{"id":"20251031152117-qunh2ni","updated":"20251031152128"},"Children":[{"Type":"NodeText","Data":"定义当相互碰撞的布料粒子比距离值更近时，它们之间的分离力的强度。\n该值是 PhysX 乘以分离力的系数；布料求解器随后根据您提供的该值计算刚度。"}]}]}]}]}]},{"Type":"NodeSuperBlockCloseMarker"}]},{"ID":"20251009114744-pouealr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251009114744-pouealr","updated":"20251031172748"},"Children":[{"Type":"NodeText","Data":"2D 物理系统设置"}]},{"ID":"20251011102339-lvd7465","Type":"NodeSuperBlock","Properties":{"id":"20251011102339-lvd7465","updated":"20251031172748"},"Children":[{"Type":"NodeSuperBlockOpenMarker"},{"Type":"NodeSuperBlockLayoutMarker","Data":"col"},{"ID":"20251011102318-uoeuwbb","Type":"NodeParagraph","Properties":{"id":"20251011102318-uoeuwbb","updated":"20251011102339"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20251011102319-9km32c5.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20251011102327-0tuspnj","Type":"NodeList","ListData":{},"Properties":{"id":"20251011102327-0tuspnj","updated":"20251031172748"},"Children":[{"ID":"20251011102327-g0upokp","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251011102327-g0upokp","updated":"20251011102327"},"Children":[{"ID":"20251011102327-zaxl5tm","Type":"NodeParagraph","Properties":{"id":"20251011102327-zaxl5tm","updated":"20251011102327"},"Children":[{"Type":"NodeText","Data":"常规设置"}]},{"ID":"20251011102327-chu24s6","Type":"NodeList","ListData":{},"Properties":{"id":"20251011102327-chu24s6","updated":"20251011102327"},"Children":[{"ID":"20251011102327-ian13d3","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251011102327-ian13d3","updated":"20251011102327"},"Children":[{"ID":"20251011102327-ah4n0la","Type":"NodeParagraph","Properties":{"id":"20251011102327-ah4n0la","updated":"20251011102419"},"Children":[{"Type":"NodeText","Data":"Gravity（重力的方向与大小）"}]},{"ID":"20251011102408-6vhqe14","Type":"NodeParagraph","Properties":{"id":"20251011102408-6vhqe14","updated":"20251011102408"},"Children":[{"Type":"NodeText","Data":"设置 2D 世界中的重力方向和大小，默认为朝下的重力"}]}]},{"ID":"20251011102327-q4t93so","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251011102327-q4t93so","updated":"20251011102327"},"Children":[{"ID":"20251011102327-vgufsrs","Type":"NodeParagraph","Properties":{"id":"20251011102327-vgufsrs","updated":"20251011102327"},"Children":[{"Type":"NodeText","Data":"Default Material（默认物理材质）"}]},{"ID":"20251011102423-x53n2uf","Type":"NodeParagraph","Properties":{"id":"20251011102423-x53n2uf","updated":"20251011102431"},"Children":[{"Type":"NodeText","Data":"默认的 2D 物理材质（Physics Material 2D），\n当 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Collider2D"},{"Type":"NodeText","Data":"​ 没有指定材质时使用"}]}]}]}]},{"ID":"20251011102327-7e2grqq","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251011102327-7e2grqq","updated":"20251031153458"},"Children":[{"ID":"20251011102327-o3r72q9","Type":"NodeParagraph","Properties":{"id":"20251011102327-o3r72q9","updated":"20251011102327"},"Children":[{"Type":"NodeText","Data":"解算相关"}]},{"ID":"20251011102327-uxa27n3","Type":"NodeList","ListData":{},"Properties":{"id":"20251011102327-uxa27n3","updated":"20251031153458"},"Children":[{"ID":"20251011102327-59ky4d6","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251011102327-59ky4d6","updated":"20251031152405"},"Children":[{"ID":"20251011102327-tf10u9e","Type":"NodeParagraph","Properties":{"id":"20251011102327-tf10u9e","updated":"20251031152405"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Velocity Iterations（速度迭代次数）"}]},{"ID":"20251011102447-bysson9","Type":"NodeParagraph","Properties":{"id":"20251011102447-bysson9","updated":"20251011102447"},"Children":[{"Type":"NodeText","Data":"数值越高，物体碰撞时速度的计算越精确，但性能消耗也更大"}]}]},{"ID":"20251011102327-68ovgr3","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251011102327-68ovgr3","updated":"20251031152407"},"Children":[{"ID":"20251011102327-taq0pff","Type":"NodeParagraph","Properties":{"id":"20251011102327-taq0pff","updated":"20251031152407"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Position Iterations（位置迭代次数）"}]},{"ID":"20251011102451-5vkzhp1","Type":"NodeParagraph","Properties":{"id":"20251011102451-5vkzhp1","updated":"20251011102451"},"Children":[{"Type":"NodeText","Data":"影响物体在碰撞中的位置校正精度。"}]}]},{"ID":"20251011102327-zejjir6","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251011102327-zejjir6","updated":"20251011102327"},"Children":[{"ID":"20251011102327-vevsme4","Type":"NodeParagraph","Properties":{"id":"20251011102327-vevsme4","updated":"20251011102456"},"Children":[{"Type":"NodeText","Data":"Bounce Threshold（反弹阈值）"}]},{"ID":"20251011102457-0n0x1ei","Type":"NodeParagraph","Properties":{"id":"20251011102457-0n0x1ei","updated":"20251011102457"},"Children":[{"Type":"NodeText","Data":"低于此速度的碰撞不会产生弹性反弹，避免小抖动"}]}]},{"ID":"20251031153405-0nkhnwp","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251031153405-0nkhnwp","updated":"20251031153458"},"Children":[{"ID":"20251031153405-q0iragu","Type":"NodeParagraph","Properties":{"id":"20251031153405-q0iragu","updated":"20251031153411"},"Children":[{"Type":"NodeText","Data":"修正相关属性"}]},{"ID":"20251031153426-22uj16u","Type":"NodeList","ListData":{},"Properties":{"id":"20251031153426-22uj16u","updated":"20251031153458"},"Children":[{"ID":"20251011102327-8z94uhf","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251011102327-8z94uhf","updated":"20251031153444"},"Children":[{"ID":"20251011102327-g8bbmfh","Type":"NodeParagraph","Properties":{"id":"20251011102327-g8bbmfh","updated":"20251011102327"},"Children":[{"Type":"NodeText","Data":"Max Linear Correction（最大线性位置修正）"}]},{"ID":"20251011102500-5xxm9ql","Type":"NodeParagraph","Properties":{"id":"20251011102500-5xxm9ql","updated":"20251011102500"},"Children":[{"Type":"NodeText","Data":"用于防止物体因浮点误差穿透时的修正量"}]}]},{"ID":"20251011102327-1wagijq","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251011102327-1wagijq","updated":"20251031153458"},"Children":[{"ID":"20251011102327-s4kmdut","Type":"NodeParagraph","Properties":{"id":"20251011102327-s4kmdut","updated":"20251011102327"},"Children":[{"Type":"NodeText","Data":"Max Angular Correction（最大角度修正）"}]},{"ID":"20251011102506-4k8934c","Type":"NodeParagraph","Properties":{"id":"20251011102506-4k8934c","updated":"20251011102524"},"Children":[{"Type":"NodeText","Data":"与上面类似，但针对旋转"}]}]}]},{"ID":"20251031153421-5j5odiv","Type":"NodeParagraph","Properties":{"id":"20251031153421-5j5odiv","updated":"20251031153421"},"Children":[{"Type":"NodeText","Data":"在物理模拟里，由于"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"浮点误差"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大时间步长"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"高速运动"},{"Type":"NodeText","Data":"，物体可能会发生轻微的 重叠"}]},{"ID":"20251031153421-1asznrg","Type":"NodeParagraph","Properties":{"id":"20251031153421-1asznrg","updated":"20251031153421"},"Children":[{"Type":"NodeText","Data":"Box2D 的解算器会通过 位置校正 来把物体推开，避免它们无限重叠，但是如果“推开量”没有限制："}]},{"ID":"20251031153421-eu4oker","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251031153421-eu4oker","updated":"20251031153421"},"Children":[{"ID":"20251031153421-ujpf54j","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251031153421-ujpf54j","updated":"20251031153421"},"Children":[{"ID":"20251031153421-lto28kf","Type":"NodeParagraph","Properties":{"id":"20251031153421-lto28kf","updated":"20251031153421"},"Children":[{"Type":"NodeText","Data":"可能一次性把物体推出很远，导致抖动或跳跃"}]}]},{"ID":"20251031153421-6ppdltg","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251031153421-6ppdltg","updated":"20251031153421"},"Children":[{"ID":"20251031153421-z3t88cq","Type":"NodeParagraph","Properties":{"id":"20251031153421-z3t88cq","updated":"20251031153421"},"Children":[{"Type":"NodeText","Data":"特别是高速物体/薄物体，可能瞬移到奇怪的位置"}]}]}]},{"ID":"20251031153421-1gd892c","Type":"NodeParagraph","Properties":{"id":"20251031153421-1gd892c","updated":"20251031153421"},"Children":[{"Type":"NodeText","Data":"因此 Box2D 给出两个安全阈值：\n限制一次迭代中，线性位置和旋转 修正的最大距离"}]},{"ID":"20251031153421-5hf5yc5","Type":"NodeParagraph","Properties":{"id":"20251031153421-5hf5yc5","updated":"20251031153421"},"Children":[{"Type":"NodeText","Data":"举例说明："}]},{"ID":"20251031153421-mmiexe9","Type":"NodeParagraph","Properties":{"id":"20251031153421-mmiexe9","updated":"20251031153421"},"Children":[{"Type":"NodeText","Data":"假设两个刚体发生了 0.5 米的重叠：Max Linear Correction "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"="}]},{"Type":"NodeText","Data":" 0.2（默认）\n引擎只允许这次迭代最多修正 0.2 米，可能需要多次迭代（每帧内多次解算）逐步把它们分开\n如果把这个值调大（比如 1），一次迭代可能就能修正 0.5 米的重叠，但可能导致物体瞬间弹开，不稳定"}]}]},{"ID":"20251011102327-qo1vrtr","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251011102327-qo1vrtr","updated":"20251011102327"},"Children":[{"ID":"20251011102327-extw2v4","Type":"NodeParagraph","Properties":{"id":"20251011102327-extw2v4","updated":"20251011102327"},"Children":[{"Type":"NodeText","Data":"Max Translation Speed（最大线速度）"}]},{"ID":"20251011102740-j9n1p22","Type":"NodeParagraph","Properties":{"id":"20251011102740-j9n1p22","updated":"20251011102740"},"Children":[{"Type":"NodeText","Data":"防止物体因速度过大导致物理计算不稳定"}]}]},{"ID":"20251011102327-cne7k2m","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251011102327-cne7k2m","updated":"20251011102327"},"Children":[{"ID":"20251011102327-nau0rhn","Type":"NodeParagraph","Properties":{"id":"20251011102327-nau0rhn","updated":"20251011102327"},"Children":[{"Type":"NodeText","Data":"Max Rotation Speed（最大角速度）"}]},{"ID":"20251011102743-cjwctag","Type":"NodeParagraph","Properties":{"id":"20251011102743-cjwctag","updated":"20251011102743"},"Children":[{"Type":"NodeText","Data":"同样是防止过大旋转速度带来的不稳定"}]}]}]}]},{"ID":"20251011102327-ww0dbs6","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251011102327-ww0dbs6","updated":"20251011102954"},"Children":[{"ID":"20251011102327-yjr0dvv","Type":"NodeParagraph","Properties":{"id":"20251011102327-yjr0dvv","updated":"20251011102327"},"Children":[{"Type":"NodeText","Data":"穿透修正相关"}]},{"ID":"20251011102327-a5eeffc","Type":"NodeList","ListData":{},"Properties":{"id":"20251011102327-a5eeffc","updated":"20251011102954"},"Children":[{"ID":"20251011102327-j9xcjqs","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251011102327-j9xcjqs","updated":"20251011102327"},"Children":[{"ID":"20251011102327-ikqp4qp","Type":"NodeParagraph","Properties":{"id":"20251011102327-ikqp4qp","updated":"20251011102327"},"Children":[{"Type":"NodeText","Data":"Baumgarte Scale（位置修正系数）"}]},{"ID":"20251011102801-7px1exp","Type":"NodeParagraph","Properties":{"id":"20251011102801-7px1exp","updated":"20251011102801"},"Children":[{"Type":"NodeText","Data":"决定在碰撞时，穿透误差的修正比例 表现为温柔的推开"}]}]},{"ID":"20251011102327-rhzz65k","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251011102327-rhzz65k","updated":"20251011102327"},"Children":[{"ID":"20251011102327-d3mjywr","Type":"NodeParagraph","Properties":{"id":"20251011102327-d3mjywr","updated":"20251011102327"},"Children":[{"Type":"NodeText","Data":"Baumgarte Time Of Impact Scale（TOI 修正系数）"}]},{"ID":"20251011102806-y8xsi1u","Type":"NodeParagraph","Properties":{"id":"20251011102806-y8xsi1u","updated":"20251011102809"},"Children":[{"Type":"NodeText","Data":"主要用于高速物体的连续碰撞检测\n表现为粗暴推开，因为高速物体必须马上分开，否则会穿透"}]}]},{"ID":"20251011102855-ivdtogz","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","id":"20251011102855-ivdtogz","updated":"20251011102954"},"Children":[{"ID":"20251011102855-oowz0bh","Type":"NodeParagraph","Properties":{"id":"20251011102855-oowz0bh","updated":"20251011102859"},"Children":[{"Type":"NodeText","Data":"举例："}]},{"ID":"20251011102831-fjg9dmp","Type":"NodeParagraph","Properties":{"id":"20251011102831-fjg9dmp","updated":"20251011102926"},"Children":[{"Type":"NodeText","Data":"假设两个物体重叠了 0.1m："}]},{"ID":"20251011102937-h7zkmla","Type":"NodeParagraph","Properties":{"id":"20251011102937-h7zkmla","updated":"20251011102952"},"Children":[{"Type":"NodeText","Data":"Baumgarte Scale "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"="}]},{"Type":"NodeText","Data":" 0.2，每次迭代修正 0.1 "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":" 0.2 "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"="}]},{"Type":"NodeText","Data":" 0.02m，大约需要 5 次迭代才能完全分离\nBaumgarte TOI Scale "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"="}]},{"Type":"NodeText","Data":" 0.75，每次迭代修正 0.1 "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"*"}]},{"Type":"NodeText","Data":" 0.75 "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"="}]},{"Type":"NodeText","Data":" 0.075m，只要 2 次迭代就能分离，更快"}]},{"ID":"20251011102952-bmcpcd4","Type":"NodeParagraph","Properties":{"id":"20251011102952-bmcpcd4","updated":"20251011102954"},"Children":[{"Type":"NodeText","Data":"主要用于修正连续碰撞检测的物体"}]}]}]}]},{"ID":"20251011102327-tb23hdi","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251011102327-tb23hdi","updated":"20251011103040"},"Children":[{"ID":"20251011102327-n1pe2za","Type":"NodeParagraph","Properties":{"id":"20251011102327-n1pe2za","updated":"20251011102327"},"Children":[{"Type":"NodeText","Data":"休眠相关"}]},{"ID":"20251011102327-ad5ahm2","Type":"NodeList","ListData":{},