								"updated": "20250918205416"
							},
							"Children": [
								{
									"ID": "20250918205416-4728a8b",
									"Type": "NodeListItem",
									"ListData": {
										"BulletChar": 42,
										"Marker": "Kg=="
									},
									"Properties": {
										"id": "20250918205416-4728a8b",
										"updated": "20250918205416"
									},
									"Children": [
										{
											"ID": "20250918205416-3vnur1r",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20250918205416-3vnur1r",
												"updated": "20250918205705"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "顶点 ≤ 225 或 300（Unity 2021 之前为 300）"
												}
											]
										}
									]
								},
								{
									"ID": "20250918205416-gx8xoan",
									"Type": "NodeListItem",
									"ListData": {
										"BulletChar": 42,
										"Marker": "Kg=="
									},
									"Properties": {
										"id": "20250918205416-gx8xoan",
										"updated": "20250918205416"
									},
									"Children": [
										{
											"ID": "20250918205416-amsonmn",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20250918205416-amsonmn",
												"updated": "20250918205721"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "顶点 × 顶点属性 ≤ 900"
												}
											]
										}
									]
								}
							]
						},
						{
							"ID": "20250918205412-0stl8cf",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250918205412-0stl8cf",
								"updated": "20250918205734"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "即，每个网格最多 225 或 300 个顶点。并且着色器使用的顶点属性不能超过 900\n其中，顶点属性是在 Shader 中会用来进行渲染计算的数据，常用属性有 顶点的 位置、法线、切线、多套 UV 纹理、顶点颜色、骨骼权重、骨骼索引等等"
								}
							]
						},
						{
							"ID": "20250918205507-0l2ic1f",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250918205507-0l2ic1f",
								"updated": "20250918205757"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "对于简单 Shader 来说，一般至少需要 位置、法线、UV 3 个属性，则："
								}
							]
						},
						{
							"ID": "20250918205537-f24twwa",
							"Type": "NodeList",
							"ListData": {},
							"Properties": {
								"id": "20250918205537-f24twwa",
								"updated": "20250918205539"
							},
							"Children": [
								{
									"ID": "20250918205539-iklm96p",
									"Type": "NodeListItem",
									"ListData": {
										"BulletChar": 42,
										"Marker": "Kg=="
									},
									"Properties": {
										"id": "20250918205539-iklm96p",
										"updated": "20250918205539"
									},
									"Children": [
										{
											"ID": "20250918205539-y3cbfc3",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20250918205539-y3cbfc3",
												"updated": "20250918205902"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "若顶点最多 225 个，则 顶点 × 顶点属性 为 225 × 3 = 675"
												}
											]
										}
									]
								},
								{
									"ID": "20250918205539-ktem947",
									"Type": "NodeListItem",
									"ListData": {
										"BulletChar": 42,
										"Marker": "Kg=="
									},
									"Properties": {
										"id": "20250918205539-ktem947",
										"updated": "20250918205539"
									},
									"Children": [
										{
											"ID": "20250918205539-qkr8cnj",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20250918205539-qkr8cnj",
												"updated": "20250918205914"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "若顶点最多 300 个，则 顶点 × 顶点属性 为 300 × 3 = 900"
												}
											]
										}
									]
								}
							]
						},
						{
							"ID": "20250918205534-o4vgqqj",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250918205534-o4vgqqj",
								"updated": "20250918205922"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "此时 顶点数量 满足条件，顶点 × 顶点属性 也满足条件，就会进行动态批处理"
								}
							]
						},
						{
							"ID": "20250918205926-zu3ycve",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250918205926-zu3ycve",
								"updated": "20250918210039"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "若对于一些复杂Shader，假设使用 5 个 属性，那么网格的顶点上限 就是 900 ÷ 5 = 180 个顶点\n只要超出 225 顶点（Unity 2021 之前为 300）或 顶点 × 顶点属性超过 900 任意一个限制，该网格将不会被动态批处理"
								}
							]
						}
					]
				},
				{
					"ID": "20250918205344-ihrhoi4",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Delimiter": 46,
						"Marker": "Mi4=",
						"Num": 2
					},
					"Properties": {
