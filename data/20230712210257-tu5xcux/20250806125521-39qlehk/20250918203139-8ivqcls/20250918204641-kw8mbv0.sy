							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250918210054-bjs09gg",
								"updated": "20250918234418"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "一般骨骼动画模型会使用蒙皮网格渲染器，因为每帧 CPU 都要做蒙皮变形，数据不适合直接合并\n只有 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "MeshRenderer"
								},
								{
									"Type": "NodeText",
									"Data": "​（网格渲染器）和 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "ParticleSystem"
								},
								{
									"Type": "NodeText",
									"Data": "​（粒子系统）能进行动态批处理"
								}
							]
						}
					]
				},
