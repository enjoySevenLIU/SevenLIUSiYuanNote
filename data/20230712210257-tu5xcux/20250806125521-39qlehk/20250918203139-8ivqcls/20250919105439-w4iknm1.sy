odeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250919110817-ejz40qk.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]}]},{"ID":"20250919110431-8bltrab","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250919110431-8bltrab","updated":"20250919145457"},"Children":[{"Type":"NodeText","Data":"静态批处理的限制"}]},{"ID":"20250919110443-2ffrx40","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250919110443-2ffrx40","updated":"20250919145457"},"Children":[{"ID":"20250919110451-xmhc9w2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250919110451-xmhc9w2","updated":"20250919110451"},"Children":[{"ID":"20250919110451-6ultfv9","Type":"NodeParagraph","Properties":{"id":"20250919110451-6ultfv9","updated":"20250919110538"},"Children":[{"Type":"NodeText","Data":"必须是勾选了 Batching Static 的物体"}]}]},{"ID":"20250919110451-ugsosai","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250919110451-ugsosai","updated":"20250919110451"},"Children":[{"ID":"20250919110451-xwhv8a3","Type":"NodeParagraph","Properties":{"id":"20250919110451-xwhv8a3","updated":"20250919110530"},"Children":[{"Type":"NodeText","Data":"必须是相同材质，不同材质的对象会放入不同批次并且渲染状态必须一致，即"}]},{"ID":"20250919110540-b5fy0ur","Type":"NodeList","ListData":{},"Properties":{"id":"20250919110540-b5fy0ur","updated":"20250919110545"},"Children":[{"ID":"20250919110545-jc8wfer","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250919110545-jc8wfer","updated":"20250919110545"},"Children":[{"ID":"20250919110545-y42a2nv","Type":"NodeParagraph","Properties":{"id":"20250919110545-y42a2nv","updated":"20250919110545"},"Children":[{"Type":"NodeText","Data":"相同渲染队列"}]}]},{"ID":"20250919110547-1jcrmd6","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250919110547-1jcrmd6","updated":"20250919110547"},"Children":[{"ID":"20250919110547-dblersh","Type":"NodeParagraph","Properties":{"id":"20250919110547-dblersh","updated":"20250919110557"},"Children":[{"Type":"NodeText","Data":"相同光照贴图、UV 缩放"}]}]},{"ID":"20250919110547-7a9oq9y","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250919110547-7a9oq9y","updated":"20250919110547"},"Children":[{"ID":"20250919110547-tv1znm5","Type":"NodeParagraph","Properties":{"id":"20250919110547-tv1znm5","updated":"20250919110547"},"Children":[{"Type":"NodeText","Data":"相同反射探针光照探针使用"}]}]},{"ID":"20250919110547-19r96lw","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250919110547-19r96lw","updated":"20250919110547"},"Children":[{"ID":"20250919110547-grz0pqb","Type":"NodeParagraph","Properties":{"id":"20250919110547-grz0pqb","updated":"20250919110547"},"Children":[{"Type":"NodeText","Data":"相同阴影相关设置"}]}]},{"ID":"20250919110547-h9t6p4b","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250919110547-h9t6p4b","updated":"20250919110547"},"Children":[{"ID":"20250919110547-myzrpmz","Type":"NodeParagraph","Properties":{"id":"20250919110547-myzrpmz","updated":"20250919110552"},"Children":[{"Type":"NodeText","Data":"相同 Shader 关键字状态"}]}]},{"ID":"20250919110548-uzs2vy4","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250919110548-uzs2vy4","updated":"20250919110548"},"Children":[{"ID":"20250919110548-hctg4wg","Type":"NodeParagraph","Properties":{"id":"20250919110548-hctg4wg","updated":"20250919110608"},"Children":[{"Type":"NodeText","Data":"相同 GPU 渲染通道配置，如相同的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Pass"},{"Type":"NodeText","Data":"​ 配置、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Blend"},{"Type":"NodeText","Data":"​、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ZTest"},{"Type":"NodeText","Data":"​ 等"}]}]}]},{"ID":"20250919110542-dr804f7","Type":"NodeParagraph","Properties":{"id":"20250919110542-dr804f7","updated":"20250919110542"},"Children":[{"Type":"NodeText","Data":"等等"}]}]},{"ID":"20250919110451-hpla5c9","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250919110451-hpla5c9","updated":"20250919110451"},"Children":[{"ID":"20250919110451-mwrlus6","Type":"NodeParagraph","Properties":{"id":"20250919110451-mwrlus6","updated":"20250919110451"},"Children":[{"Type":"NodeText","Data":"每个静态批次最多可以包含 64,000 个顶点（具体数量可以查看对应版本官方说明文档）"}]},{"ID":"20250919110457-xqzvenj","Type":"NodeParagraph","Properties":{"id":"20250919110457-xqzvenj","updated":"20250919110457"},"Children":[{"Type":"NodeText","Data":"如果超过这个数目，Unity 会创建另一个批次"}]}]},{"ID":"20250919110451-kcqhebl","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250919110451-kcqhebl","updated":"20250919110451"},"Children":[{"ID":"20250919110451-w2gmrue","Type":"NodeParagraph","Properties":{"id":"20250919110451-w2gmrue","updated":"20250919110505"},"Children":[{"Type":"NodeText","Data":"进行静态批处理的对象，运行时不能改变 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Transform"},{"Type":"NodeText","Data":"​（位置、旋转、缩放），否则会失去批处理资格"}]}]},{"ID":"20250919110451-s7rgm45","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20250919110451-s7rgm45","updated":"20250919110451"},"Children":[{"ID":"20250919110451-l8rk2uk","Type":"NodeParagraph","Properties":{"id":"20250919110451-l8rk2uk","updated":"20250919110519"},"Children":[{"Type":"NodeText","Data":"运行时不能修改网格"}]},{"ID":"20250919110521-kmz6kr9","Type":"NodeParagraph","Properties":{"id":"20250919110521-kmz6kr9","updated":"20250919110521"},"Children":[{"Type":"NodeText","Data":"比如通过脚本代码调用相关 API 修改网格数据等"}]}]},{"ID":"20250919110451-030tsux","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ni4=","Num":6},"Properties":{"id":"20250919110451-030tsux","updated":"20250919110451"},"Children":[{"ID":"20250919110451-9i3v5dq","Type":"NodeParagraph","Properties":{"id":"20250919110451-9i3v5dq","updated":"20250919110451"},"Children":[{"Type":"NodeText","Data":"动态创建的静态对象不会进行静态批处理"}]},{"ID":"20250919110615-d75303q","Type":"NodeParagraph","Properties":{"id":"20250919110615-d75303q","updated":"20250919110640"},"Children":[{"Type":"NodeText","Data":"运行时如果动态创建静态对象，这些对象如果不做处理，并不会被静态批处理\n因此我们需要尽量把想要进行静态批处理的对象放在原始场景中\n当然我们可以利用 API："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"StaticBatchingUtility.Combine()"},{"Type":"NodeText","Data":"​ 来强制进行批处理，但是会带来新的开销"}]},{"ID":"20250919142856-60mz59k","Type":"NodeBlockquote","Properties":{"id":"20250919142856-60mz59k","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20250919142857"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20250919142857-l0og7zd","Type":"NodeParagraph","Properties":{"id":"20250919142857-l0og7zd","updated":"20250919143713"},"Children":[{"Type":"NodeText","Data":"注：如果是动态加载的场景，则新场景里的静态对象能够被正常静态批处理，\n因此，我们可以将一个场景内大而多的静态对象分割为多个场景内若干个静态对象，然后动态加载场景（以附加形式加载）"}]},{"ID":"20250919143235-5osjv5c","Type":"NodeList","ListData":{},"Properties":{"id":"20250919143235-5osjv5c","updated":"20250919143430"},"Children":[{"ID":"20250919143430-xt3rhbu","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250919143430-xt3rhbu","updated":"20250919143430"},"Children":[{"ID":"20250919143430-ew0wpzl","Type":"NodeParagraph","Properties":{"id":"20250919143430-ew0wpzl","updated":"20250919143430"},"Children":[{"Type":"NodeText","Data":"未加载内容时："}]},{"ID":"20250919143431-n4dxb03","Type":"NodeParagraph","Properties":{"id":"20250919143431-n4dxb03","updated":"20250919143431"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250919143243-mzqwlp2.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20250919143434-v78a2gx","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250919143434-v78a2gx","updated":"20250919143434"},"Children":[{"ID":"20250919143434-nk2vwrn","Type":"NodeParagraph","Properties":{"id":"20250919143434-nk2vwrn","updated":"20250919143434"},"Children":[{"Type":"NodeText","Data":"加载场景："}]},{"ID":"20250919143908-c5wd4kr","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250919143908-c5wd4kr","updated":"20250919143939"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"private void OnGUI()\n{\n    if (GUILayout.Button(\"Load Scene\"))\n    {\n        SceneManager.LoadSceneAsync(\"StaticBatchTest\", LoadSceneMode.Additive);\n    }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250919143436-8nqs0p5","Type":"NodeParagraph","Properties":{"id":"20250919143436-8nqs0p5","updated":"20250919143436"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250919143305-0wlqiux.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250919143314-r2yv9ip.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20250919143439-15nwvun","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250919143439-15nwvun","updated":"20250919143439"},"Children":[{"ID":"20250919143439-qvfmiz1","Type":"NodeParagraph","Properties":{"id":"20250919143439-qvfmiz1","updated":"20250919143439"},"Children":[{"Type":"NodeText","Data":"加载预制体："}]},{"ID":"20250919143944-1eve4x3","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250919143944-1eve4x3","updated":"20250919144006"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"public GameObject testPrefab;\nprivate GameObject _testObj;\n\nprivate void OnGUI()\n{\n    if (GUILayout.Button(\"Load Prefab\"))\n    {\n        if (_testObj != null)\n        {\n            Destroy(_testObj);\n            _testObj = null;\n        }\n        _testObj = Object.Instantiate(testPrefab);\n    }\n    if (GUILayout.Button(\"Static Batching Combine\"))\n    {\n        StaticBatchingUtility.Combine(_testObj);\n    }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250919143440-qmggn34","Type":"NodeParagraph","Properties":{"id":"20250919143440-qmggn34","updated":"20250919143440"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250919143341-pgyn4wf.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250919143411-sv6a47u.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250919143447-to6qprz","Type":"NodeList","ListData":{},"Properties":{"id":"20250919143447-to6qprz","updated":"20250919143447"},"Children":[{"ID":"20250919143447-q7gaywn","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250919143447-q7gaywn","updated":"20250919143447"},"Children":[{"ID":"20250919143447-sfh1rj9","Type":"NodeParagraph","Properties":{"id":"20250919143447-sfh1rj9","updated":"20250919143506"},"Children":[{"Type":"NodeText","Data":"使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"StaticBatchingUtility.Combine()"},{"Type":"NodeText","Data":"​ 压缩后："}]},{"ID":"20250919143451-8ogax5q","Type":"NodeParagraph","Properties":{"id":"20250919143451-8ogax5q","updated":"20250919143452"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250919143452-ng3y5yd.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]}]}]}]}]}]},{"ID":"20250919110451-s9ctqfw","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ny4=","Num":7},"Properties":{"id":"20250919110451-s9ctqfw","updated":"20250919145457"},"Children":[{"ID":"20250919110451-xog2rpl","Type":"NodeParagraph","Properties":{"id":"20250919110451-xog2rpl","updated":"20250919110451"},"Children":[{"Type":"NodeText","Data":"网格设置为可读写"}]},{"ID":"20250919110649-o6riupz","Type":"NodeParagraph","Properties":{"id":"20250919110649-o6riupz","updated":"20250919145457"},"Children":[{"Type":"NodeText","Data":"如果使用的是导入的资源，需要选中模型资源在 Inspector 窗口中将网格设置为可读写（勾选模型资源的 "},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20230807200532-59q8tv6","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"Read/Write Enabled"},{"Type":"NodeText","Data":" ）"}]},{"ID":"20250919145307-wz0e02m","Type":"NodeParagraph","Properties":{"id":"20250919145307-wz0e02m","updated":"20250919145345"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250919145345-aha15mj.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]}]},{"ID":"20250919143412-s6jgmr0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250919143412-s6jgmr0","updated":"20250919145618"},"Children":[{"Type":"NodeText","Data":"静态批处理带来的内存开销"}]},{"ID":"20250919144146-nx09g6c","Type":"NodeParagraph","Properties":{"id":"20250919144146-nx09g6c","updated":"20250919144146"},"Children":[{"Type":"NodeText","Data":"我们刚才提到静态批处理的原理，是把每个对象的网格合并到一个大网格中\n那就意味着我们需要将原本对象的顶点数据复制到一个更大网格的内存缓冲区\n换句话说，原始每个网格的顶点数据还在，静态批处理会再复制一份到新的合并网格里"}]},{"ID":"20250919144154-nxekcfl","Type":"NodeParagraph","Properties":{"id":"20250919144154-nxekcfl","updated":"20250919144156"},"Children":[{"Type":"NodeText","Data":"所以：静态批处理的内存开销 ≈ 原始顶点数据大小 + 合并网格的顶点数据大小"}]},{"ID":"20250919144159-khsw6dw","Type":"NodeParagraph","Properties":{"id":"20250919144159-khsw6dw","updated":"20250919144706"},"Children":[{"Type":"NodeText","Data":"举例：\n我们要渲染 1000 个相同的箱子对象，本来一个箱子的内存占用假设是 10 KB，原本他们就占用 1000 × 10 KB "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"="}]},{"Type":"NodeText","Data":" 10000 KB 内存\n现在由于我们要对他们进行静态批处理了，要把这些数据复制到一个新的内存缓冲区中，\n也就是静态批处理的大网格就是 1000 个箱子合并来的，大网格的内存占用为 10000 KB（假设顶点结构和数量完全相同，总和一致）\n而原本 1000 个箱子占用的内存 和 合并的大网格的内存 是独立的，因此他们加起来一共 20000 KB\n其中 10000 KB 是原本 1000 个箱子的，另外 10000 KB 是合并的大网格的"}]},{"ID":"20250919144426-ggdrnws","Type":"NodeParagraph","Properties":{"id":"20250919144426-ggdrnws","updated":"20250919144714"},"Children":[{"Type":"NodeText","Data":"说人话：静态批处理的内存是翻倍增长的，因为合并网格是额外生成的，合并的物体越多，顶点数越多，额外内存越大"}]},{"ID":"20250919144427-br1rqsg","Type":"NodeParagraph","Properties":{"id":"20250919144427-br1rqsg","updated":"20250919145618"},"Children":[{"Type":"NodeText","Data":"解决方案：如果你确定一些静态批处理对象不在其他地方使用，可以尝试获取对象，通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Resources.UnloadAsset()"},{"Type":"NodeText","Data":"​ 或 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AssetBundle.Unload(true)"},{"Type":"NodeText","Data":"​ 等 API 手动释放网格数据"}]},{"ID":"20250919144747-pycwtdv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250919144747-pycwtdv","updated":"20250919144925"},"Children":[{"Type":"NodeText","Data":"适合使用静态批处理的情况"}]},{"ID":"20250919144755-48vhloo","Type":"NodeParagraph","Properties":{"id":"20250919144755-48vhloo","updated":"20250919144919"},"Children":[{"Type":"NodeText","Data":"一堆不会动、状态一致的小网格物体，且 CPU DrawCall 是瓶颈时"}]},{"ID":"20250919144834-7av99pe","Type":"NodeParagraph","Properties":{"id":"20250919144834-7av99pe","updated":"20250919144834"},"Children":[{"Type":"NodeText","Data":"比如："}]},{"ID":"20250919144803-ozfjm4j","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250919144803-ozfjm4j","updated":"20250919144808"},"Children":[{"ID":"20250919144803-alp6h4u","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250919144803-alp6h4u","updated":"20250919144803"},"Children":[{"ID":"20250919144803-w7cq25m","Type":"NodeParagraph","Properties":{"id":"20250919144803-w7cq25m","updated":"20250919144803"},"Children":[{"Type":"NodeText","Data":"大量重复或相似的静态小物体"}]},{"ID":"20250919144804-nhpwlc9","Type":"NodeParagraph","Properties":{"id":"20250919144804-nhpwlc9","updated":"20250919144804"},"Children":[{"Type":"NodeText","Data":"场景中的路灯、栏杆、石头、建筑碎片等"}]}]},{"ID":"20250919144803-5cf5io3","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250919144803-5cf5io3","updated":"20250919144808"},"Children":[{"ID":"20250919144803-8v2xhku","Type":"NodeParagraph","Properties":{"id":"20250919144803-8v2xhku","updated":"20250919144808"},"Children":[{"Type":"NodeText","Data":"完全静止的背景 / 场景物体"}]},{"ID":"20250919144805-83g007k","Type":"NodeParagraph","Properties":{"id":"20250919144805-83g007k","updated":"20250919144805"},"Children":[{"Type":"NodeText","Data":"山体、背景建筑、城市街道、地面细节等"}]}]}]},{"ID":"20250919144801-i3wqd3m","Type":"NodeParagraph","Properties":{"id":"20250919144801-i3wqd3m","updated":"20250919144801"},"Children":[{"Type":"NodeText","Data":"等等"}]},{"ID":"20250919144800-1h8437s","Type":"NodeParagraph","Properties":{"id":"20250919144800-1h8437s","updated":"20250919144800"},"Children":[{"Type":"NodeText","Data":"不太适合使用静态批处理的情况"}]},{"ID":"20250919144837-wg9g82h","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250919144837-wg9g82h","updated":"20250919144925"},"Children":[{"ID":"20250919144844-bq74rf8","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250919144844-bq74rf8","updated":"20250919144925"},"Children":[{"ID":"20250919144844-kac02lh","Type":"NodeParagraph","Properties":{"id":"20250919144844-kac02lh","updated":"20250919144844"},"Children":[{"Type":"NodeText","Data":"物体会移动/旋转/缩放"}]},{"ID":"20250919144846-93bc2w8","Type":"NodeParagraph","Properties":{"id":"20250919144846-93bc2w8","updated":"20250919144925"},"Children":[{"Type":"NodeText","Data":"一旦 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Transform"},{"Type":"NodeText","Data":"​ 改变，就会退出静态批处理，反而浪费了额外生成大网格的内存"}]}]},{"ID":"20250919144844-88e36o0","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20250919144844-88e36o0","updated":"20250919144844"},"Children":[{"ID":"20250919144844-wv84ovn","Type":"NodeParagraph","Properties":{"id":"20250919144844-wv84ovn","updated":"20250919144844"},"Children":[{"Type":"NodeText","Data":"超大网格或分布很远的物体"}]},{"ID":"20250919144847-8kp7odm","Type":"NodeParagraph","Properties":{"id":"20250919144847-8kp7odm","updated":"20250919144847"},"Children":[{"Type":"NodeText","Data":"合并后剔除粒度变差，可能因为一个角落可见，导致整个大网格都渲染"}]}]},{"ID":"20250919144844-0amsth5","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20250919144844-0amsth5","updated":"20250919144844"},"Children":[{"ID":"20250919144844-8zcafb8","Type":"NodeParagraph","Properties":{"id":"20250919144844-8zcafb8","updated":"20250919144844"},"Children":[{"Type":"NodeText","Data":"GPU 是瓶颈，而 CPU 不紧张"}]},{"ID":"20250919144849-aq3u7gz","Type":"NodeParagraph","Properties":{"id":"20250919144849-aq3u7gz","updated":"20250919144849"},"Children":[{"Type":"NodeText","Data":"静态批处理只减少 CPU Draw Call，对 GPU 顶点数没减少。\n如果 GPU 已经满载，批处理意义不大，甚至会因为剔除粒度降低让 GPU 更忙"}]}]},{"ID":"20250919144844-u0ij43x","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250919144844-u0ij43x","updated":"20250919144844"},"Children":[{"ID":"20250919144844-ev8g3cq","Type":"NodeParagraph","Properties":{"id":"20250919144844-ev8g3cq","updated":"20250919144844"},"Children":[{"Type":"NodeText","Data":"内存紧张的项目"}]},{"ID":"20250919144852-v48wt5c","Type":"NodeParagraph","Properties":{"id":"20250919144852-v48wt5c","updated":"20250919144852"},"Children":[{"Type":"NodeText","Data":"静态批处理会增加内存开销，如果不合理使用，可能造成内存瓶颈"}]}]}]},{"ID":"20250919144841-1iffagk","Type":"NodeParagraph","Properties":{"id":"20250919144841-1iffagk","updated":"20250919144841"},"Children":[{"Type":"NodeText","Data":"等等"}]}]}