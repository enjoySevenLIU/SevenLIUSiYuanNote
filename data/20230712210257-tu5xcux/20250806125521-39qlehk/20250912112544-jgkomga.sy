","Data":"assets/image-20250915110658-i7jlfn3.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]}]}]},{"ID":"20250912113604-47kkkth","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20250912113604-47kkkth","name":"Profiler.GetRuntimeMemorySizeLong()","updated":"20250915110811"},"Children":[{"Type":"NodeText","Data":"针对某个对象分析内存"}]},{"ID":"20250912113612-exy6mz3","Type":"NodeParagraph","Properties":{"id":"20250912113612-exy6mz3","updated":"20250912113838"},"Children":[{"Type":"NodeText","Data":"获取某个对象占用的内存（估算值），包括纹理、网格等对象的实际内存占用"}]},{"ID":"20250912113614-gjftb7l","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250912113614-gjftb7l","updated":"20250915110755"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"GameObject obj = new();\nDebug.Log($\"对象占用的内存大小: {Profiler.GetRuntimeMemorySizeLong(obj)}\");\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250915110756-sgwj690","Type":"NodeParagraph","Properties":{"id":"20250915110756-sgwj690","updated":"20250915110811"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250915110811-ugyb7ql.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250912113649-xd4optn","Type":"NodeHeading","HeadingLevel":3,"Properties":{"alias":"Profiler.EndSample()","id":"20250912113649-xd4optn","name":"Profiler.BeginSample()","updated":"20250915111450"},"Children":[{"Type":"NodeText","Data":"特定分析部分逻辑"}]},{"ID":"20250912113655-12np0v2","Type":"NodeParagraph","Properties":{"id":"20250912113655-12np0v2","updated":"20250912113801"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Profiler.BeginSample()"},{"Type":"NodeText","Data":"​ 开始一个自定义采样区段，常用于标记性能热点段，配合 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"EndSample()"},{"Type":"NodeText","Data":"​ 使用\n会在 Unity Profiler 的 CPU 模块中显示为一条标记，建议仅在开发环境使用\n可通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"#if UNITY_EDITOR"},{"Type":"NodeText","Data":"​ 包裹避免构建时存在"}]},{"ID":"20250912113723-1hvaa3i","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250912113723-1hvaa3i","updated":"20250915111305"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"void Update()\n{\n\t#if UNITY_EDITOR\n    Profiler.BeginSample(\"ProfilerTestCode\");\n    // 做一些逻辑或渲染操作\n    for (int i = 0; i \u003c 99999; i++)\n    {\n        float x = Mathf.Sqrt(i);\n    }\n    // 结束采样区段\n    Profiler.EndSample();\n\t#endif\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250915111311-an0rq7o","Type":"NodeParagraph","Properties":{"id":"20250915111311-an0rq7o","updated":"20250915111450"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250915111447-8p2wtcj.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20250912113749-s34z32p","Type":"NodeHeading","HeadingLevel":3,"Properties":{"alias":"Profiler.logFile","id":"20250912113749-s34z32p","name":"Profiler.enableBinaryLog","updated":"20250912114346"},"Children":[{"Type":"NodeText","Data":"获取记录详细数据"}]},{"ID":"20250912113833-96l4ehb","Type":"NodeParagraph","Properties":{"id":"20250912113833-96l4ehb","updated":"20250912113913"},"Children":[{"Type":"NodeText","Data":"可将 Profiler 数据写入文件，用于离线分析（比如上传给 QA 或分析工具）\n是用于 在运行时手动采集 Unity Profiler 的原始性能数据（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".raw"},{"Type":"NodeText","Data":"​ 文件），这些数据可以导入 Unity Profiler 界面中进行离线分析。\n我们一般可以在游戏中嵌入一个开启功能，采集一定时间的性能数据内容"}]},{"ID":"20250912113913-wlk15r6","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250912113913-wlk15r6","updated":"20250912114151"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"private IEnumerator LogTest()\n{\n    Profiler.logFile = Application.persistentDataPath + \"/myProfileData.raw\";\n    Profiler.enableBinaryLog = true; // 开始记录\n    yield return new WaitForSeconds(10f); \n    Profiler.enableBinaryLog = false; // 停止记录\n    //主动通过代码去上传采样数据到服务器\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250912114346-jdvv0oa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20250912114346-jdvv0oa","updated":"20250912114650"},"Children":[{"Type":"NodeText","Data":"更多 Profiler API"}]},{"ID":"20250912114348-bbfbugu","Type":"NodeParagraph","Properties":{"id":"20250912114348-bbfbugu","updated":"20250912114650"},"Children":[{"Type":"NodeText","Data":"更多 Profiler API，可见："},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://docs.unity.cn/cn/2022.3/ScriptReference/Profiling.Profiler.html","TextMarkTextContent":"Profiling.Profiler - Unity 脚本 API"}]},{"ID":"20250912114400-oiew2c6","Type":"NodeParagraph","Properties":{"id":"20250912114400-oiew2c6","updated":"20250912114400"}}]}