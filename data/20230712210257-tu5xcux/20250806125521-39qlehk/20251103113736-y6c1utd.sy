gLevel":3,"Properties":{"id":"20251103145251-jqyxnvy","updated":"20251104120252"},"Children":[{"Type":"NodeText","Data":"缓存"}]},{"ID":"20251103145313-4noec1l","Type":"NodeParagraph","Properties":{"id":"20251103145313-4noec1l","updated":"20251103145323"},"Children":[{"Type":"NodeText","Data":"它是 GPU 内部的小容量高速存储，主要用于存放从显存取出的热点数据，方便我们重复利用"}]},{"ID":"20251103145313-63tez0a","Type":"NodeParagraph","Properties":{"id":"20251103145313-63tez0a","updated":"20251103145342"},"Children":[{"Type":"NodeText","Data":"所谓热点数据（Hot Data），一般在 CPU 和 GPU 的优化领域中指的是："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"在短时间内被高频访问的数据"},{"Type":"NodeText","Data":"\n因为它被用的多，所以放在更快的存储空间中（比如寄存器、缓存）能极大的提升性能"}]},{"ID":"20251103145349-p5tz1rs","Type":"NodeParagraph","Properties":{"id":"20251103145349-p5tz1rs","updated":"20251103145359"},"Children":[{"Type":"NodeText","Data":"比如在 GPU 中的常见热点数据为："}]},{"ID":"20251103145359-giiieb6","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103145359-giiieb6","updated":"20251103145359"},"Children":[{"ID":"20251103145359-2q4yc5u","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103145359-2q4yc5u","updated":"20251103145359"},"Children":[{"ID":"20251103145359-33ib8dv","Type":"NodeParagraph","Properties":{"id":"20251103145359-33ib8dv","updated":"20251103145359"},"Children":[{"Type":"NodeText","Data":"顶点缓存"}]},{"ID":"20251103145359-j8lwzp7","Type":"NodeParagraph","Properties":{"id":"20251103145359-j8lwzp7","updated":"20251103145359"},"Children":[{"Type":"NodeText","Data":"渲染一个网格时，某些顶点会被多个三角形复用\nGPU 会把最近变换过的顶点存在 缓存 里，避免重复计算"}]}]},{"ID":"20251103145359-zy3pc6v","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103145359-zy3pc6v","updated":"20251103145359"},"Children":[{"ID":"20251103145359-fx959mt","Type":"NodeParagraph","Properties":{"id":"20251103145359-fx959mt","updated":"20251103145359"},"Children":[{"Type":"NodeText","Data":"纹理缓存"}]},{"ID":"20251103145401-3yrjot6","Type":"NodeParagraph","Properties":{"id":"20251103145401-3yrjot6","updated":"20251103145401"},"Children":[{"Type":"NodeText","Data":"当片元连续访问相邻的 UV 时，缓存会把周边像素块一起取进来"}]}]},{"ID":"20251103145359-8jhotyh","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251103145359-8jhotyh","updated":"20251103145359"},"Children":[{"ID":"20251103145359-vs51hms","Type":"NodeParagraph","Properties":{"id":"20251103145359-vs51hms","updated":"20251103145359"},"Children":[{"Type":"NodeText","Data":"常量缓存"}]},{"ID":"20251103145404-qffy8qo","Type":"NodeParagraph","Properties":{"id":"20251103145404-qffy8qo","updated":"20251103145404"},"Children":[{"Type":"NodeText","Data":"灯光参数、矩阵等，几乎每个片元都要用"}]}]}]},{"ID":"20251103145313-2r7wjkm","Type":"NodeParagraph","Properties":{"id":"20251103145313-2r7wjkm","updated":"20251103145411"},"Children":[{"Type":"NodeText","Data":"特点："}]},{"ID":"20251103145411-v9ka1ku","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103145411-v9ka1ku","updated":"20251103145416"},"Children":[{"ID":"20251103145411-phhlkas","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103145411-phhlkas","updated":"20251103145416"},"Children":[{"ID":"20251103145411-nl6ei2q","Type":"NodeParagraph","Properties":{"id":"20251103145411-nl6ei2q","updated":"20251103145416"},"Children":[{"Type":"NodeText","Data":"容量小，以 KB ~ MB 计，速度快"}]}]},{"ID":"20251103145411-fjcuasu","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103145411-fjcuasu","updated":"20251103145411"},"Children":[{"ID":"20251103145411-qfu70qx","Type":"NodeParagraph","Properties":{"id":"20251103145411-qfu70qx","updated":"20251103145411"},"Children":[{"Type":"NodeText","Data":"命中（缓存中找得到对应数据）时快，不命中（找不到）时必须回显存"}]}]}]},{"ID":"20251103145313-6wztanv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20251103145313-6wztanv","updated":"20251104120252"},"Children":[{"Type":"NodeText","Data":"缓存的工作原理"}]},{"ID":"20251103145430-cgm66wq","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103145430-cgm66wq","updated":"20251104120252"},"Children":[{"ID":"20251103145437-dn06g1u","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103145437-dn06g1u","updated":"20251104120252"},"Children":[{"ID":"20251103145437-v8ljtk9","Type":"NodeParagraph","Properties":{"id":"20251103145437-v8ljtk9","updated":"20251104120252"},"Children":[{"Type":"NodeText","Data":"缓存"}]},{"ID":"20251103145437-75667mg","Type":"NodeParagraph","Properties":{"id":"20251103145437-75667mg","updated":"20251103145448"},"Children":[{"Type":"NodeText","Data":"缓存不会一字节一字节存，而是一次性把一大块连续的数据搬进来，\n原因：利用 空间局部性，取了一个地址，附近的数据很可能也会用"}]}]},{"ID":"20251103145437-ktys1ws","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103145437-ktys1ws","updated":"20251103145437"},"Children":[{"ID":"20251103145437-r1hiqea","Type":"NodeParagraph","Properties":{"id":"20251103145437-r1hiqea","updated":"20251103145437"},"Children":[{"Type":"NodeText","Data":"索引映射"}]},{"ID":"20251103145449-2sz3p9j","Type":"NodeParagraph","Properties":{"id":"20251103145449-2sz3p9j","updated":"20251103145505"},"Children":[{"Type":"NodeText","Data":"缓存的容量有限，需要一个规则来决定某个内存地址的数据放在哪个缓存槽里"}]},{"ID":"20251103145522-sz1zmnx","Type":"NodeParagraph","Properties":{"id":"20251103145522-sz1zmnx","updated":"20251103145522"},"Children":[{"Type":"NodeText","Data":"常见规则："}]},{"ID":"20251103145505-h6otgox","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103145505-h6otgox","updated":"20251103145505"},"Children":[{"ID":"20251103145505-vmc27ka","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103145505-vmc27ka","updated":"20251103145505"},"Children":[{"ID":"20251103145505-ooziik6","Type":"NodeParagraph","Properties":{"id":"20251103145505-ooziik6","updated":"20251103145505"},"Children":[{"Type":"NodeText","Data":"直接映射（Direct Mapped）：一个内存块只能放在某个固定的缓存槽"}]}]},{"ID":"20251103145505-t7go4ds","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103145505-t7go4ds","updated":"20251103145505"},"Children":[{"ID":"20251103145505-67nbxsk","Type":"NodeParagraph","Properties":{"id":"20251103145505-67nbxsk","updated":"20251103145505"},"Children":[{"Type":"NodeText","Data":"组相联（Set Associative）：一个内存块可以放到一组缓存槽里，组内用替换策略选位置"}]}]},{"ID":"20251103145505-90fn5l4","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251103145505-90fn5l4","updated":"20251103145505"},"Children":[{"ID":"20251103145505-arm74s4","Type":"NodeParagraph","Properties":{"id":"20251103145505-arm74s4","updated":"20251103145505"},"Children":[{"Type":"NodeText","Data":"全相联（Fully Associative）：一个内存块可以放到任何缓存槽（灵活但查找慢）"}]}]},{"ID":"20251103145505-8fxz96a","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20251103145505-8fxz96a","updated":"20251103145505"},"Children":[{"ID":"20251103145505-hdf4arb","Type":"NodeParagraph","Properties":{"id":"20251103145505-hdf4arb","updated":"20251103145516"},"Children":[{"Type":"NodeText","Data":"高组相联（High Associativity）：当一个内存地址映射到某一组时，它有很多个槽位可以选择存放，几乎接近全相联"}]}]}]},{"ID":"20251103145457-x5titym","Type":"NodeParagraph","Properties":{"id":"20251103145457-x5titym","updated":"20251103145457"},"Children":[{"Type":"NodeText","Data":"GPU 中一般使用 高组相联缓存"}]}]},{"ID":"20251103145437-y3ptqna","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251103145437-y3ptqna","updated":"20251103145437"},"Children":[{"ID":"20251103145437-xbdt4y0","Type":"NodeParagraph","Properties":{"id":"20251103145437-xbdt4y0","updated":"20251103145437"},"Children":[{"Type":"NodeText","Data":"替换策略"}]},{"ID":"20251103145537-v06f8zv","Type":"NodeParagraph","Properties":{"id":"20251103145537-v06f8zv","updated":"20251103145542"},"Children":[{"Type":"NodeText","Data":"当缓存满了，替换策略常见规则"}]},{"ID":"20251103145542-zo6dzyq","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103145542-zo6dzyq","updated":"20251103145542"},"Children":[{"ID":"20251103145542-jod6kg6","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103145542-jod6kg6","updated":"20251103145542"},"Children":[{"ID":"20251103145542-kfr11nu","Type":"NodeParagraph","Properties":{"id":"20251103145542-kfr11nu","updated":"20251103145542"},"Children":[{"Type":"NodeText","Data":"LRU（Least Recently Used，最近最少使用）"}]}]},{"ID":"20251103145542-fr3gp1w","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103145542-fr3gp1w","updated":"20251103145542"},"Children":[{"ID":"20251103145542-mquouzh","Type":"NodeParagraph","Properties":{"id":"20251103145542-mquouzh","updated":"20251103145542"},"Children":[{"Type":"NodeText","Data":"FIFO（先进先出）"}]}]},{"ID":"20251103145542-noeijux","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251103145542-noeijux","updated":"20251103145542"},"Children":[{"ID":"20251103145542-wduydb6","Type":"NodeParagraph","Properties":{"id":"20251103145542-wduydb6","updated":"20251103145542"},"Children":[{"Type":"NodeText","Data":"Random（随机，GPU 上常见，因为简单+并行）"}]}]}]}]}]},{"ID":"20251103145547-cg2z6ec","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251103145547-cg2z6ec","updated":"20251103145716"},"Children":[{"Type":"NodeText","Data":"显存和缓存的关系"}]},{"ID":"20251103145602-jr5d6n2","Type":"NodeBlockquote","Properties":{"id":"20251103145602-jr5d6n2","style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);","updated":"20251103145615"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251103145615-4n9s7hu","Type":"NodeParagraph","Properties":{"id":"20251103145615-4n9s7hu","updated":"20251103145615"},"Children":[{"Type":"NodeText","Data":"注意：GPU 和 CPU 中都存在这个概念，原理是一致的"}]}]},{"ID":"20251103145607-swaeqi5","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103145607-swaeqi5","updated":"20251103145705"},"Children":[{"ID":"20251103145607-5it3lua","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103145607-5it3lua","updated":"20251103145607"},"Children":[{"ID":"20251103145607-mao0ua2","Type":"NodeParagraph","Properties":{"id":"20251103145607-mao0ua2","updated":"20251103145607"},"Children":[{"Type":"NodeText","Data":"取数据时"}]},{"ID":"20251103145627-njju2ea","Type":"NodeParagraph","Properties":{"id":"20251103145627-njju2ea","updated":"20251103145633"},"Children":[{"Type":"NodeText","Data":"当 GPU 或 CPU 访问某个地址"}]},{"ID":"20251103145633-jp64esz","Type":"NodeList","ListData":{},"Properties":{"id":"20251103145633-jp64esz","updated":"20251103145633"},"Children":[{"ID":"20251103145633-1d93za3","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103145633-1d93za3","updated":"20251103145633"},"Children":[{"ID":"20251103145633-7oxdl6w","Type":"NodeParagraph","Properties":{"id":"20251103145633-7oxdl6w","updated":"20251103145633"},"Children":[{"Type":"NodeText","Data":"缓存中命中（在缓存中找到了）：直接从缓存中读取，速度快"}]}]},{"ID":"20251103145634-b6zzr2b","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103145634-b6zzr2b","updated":"20251103145634"},"Children":[{"ID":"20251103145634-co56hgj","Type":"NodeParagraph","Properties":{"id":"20251103145634-co56hgj","updated":"20251103145634"},"Children":[{"Type":"NodeText","Data":"缓存未命中（在缓存中没找到）：去显存中去，同时把这块数据搬进缓存"}]}]}]}]},{"ID":"20251103145607-ctym61c","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103145607-ctym61c","updated":"20251103145607"},"Children":[{"ID":"20251103145607-5csexvs","Type":"NodeParagraph","Properties":{"id":"20251103145607-5csexvs","updated":"20251103145644"},"Children":[{"Type":"NodeText","Data":"往缓存里放数据时"}]},{"ID":"20251103145646-3uuzdgj","Type":"NodeParagraph","Properties":{"id":"20251103145646-3uuzdgj","updated":"20251103145646"},"Children":[{"Type":"NodeText","Data":"缓存不是一字节一字节放，而是一次性搬一整块（通常 32B / 64B / 128B）\n这样就能利用空间局部性，如果你要用的数据附近的数据也很可能会用，就顺便搬进来"}]}]},{"ID":"20251103145607-xqdvw4j","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251103145607-xqdvw4j","updated":"20251103145705"},"Children":[{"ID":"20251103145607-0klsuah","Type":"NodeParagraph","Properties":{"id":"20251103145607-0klsuah","updated":"20251103145607"},"Children":[{"Type":"NodeText","Data":"替换缓存数据时"}]},{"ID":"20251103145648-10gxz05","Type":"NodeList","ListData":{},"Properties":{"id":"20251103145648-10gxz05","updated":"20251103145705"},"Children":[{"ID":"20251103145651-p7b4zo4","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103145651-p7b4zo4","updated":"20251103145651"},"Children":[{"ID":"20251103145651-yy9jqz7","Type":"NodeParagraph","Properties":{"id":"20251103145651-yy9jqz7","updated":"20251103145651"},"Children":[{"Type":"NodeText","Data":"如果缓存还有空：直接放进去"}]}]},{"ID":"20251103145652-6cp7wqz","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103145652-6cp7wqz","updated":"20251103145705"},"Children":[{"ID":"20251103145652-rmq6ifk","Type":"NodeParagraph","Properties":{"id":"20251103145652-rmq6ifk","updated":"20251103145705"},"Children":[{"Type":"NodeText","Data":"如果缓存满了：根据数据替换规则直接覆盖之前的数据（GPU 一般采用 Random 随机替换、CPU 一般采用 LRU 最近最少使用的替换）"}]}]}]}]}]},{"ID":"20251103145709-3c359zf","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251103145709-3c359zf","updated":"20251103145729"},"Children":[{"Type":"NodeText","Data":"为什么缓存和显存会影响性能"}]},{"ID":"20251103145719-oliov99","Type":"NodeList","ListData":{},"Properties":{"id":"20251103145719-oliov99","updated":"20251103145729"},"Children":[{"ID":"20251103145729-5mipa2p","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103145729-5mipa2p","updated":"20251103145729"},"Children":[{"ID":"20251103145729-mbm2v6d","Type":"NodeParagraph","Properties":{"id":"20251103145729-mbm2v6d","updated":"20251103145731"},"Children":[{"Type":"NodeText","Data":"显存"}]},{"ID":"20251103145740-rj4zmmx","Type":"NodeParagraph","Properties":{"id":"20251103145740-rj4zmmx","updated":"20251103145742"},"Children":[{"Type":"NodeText","Data":"性能瓶颈主要来自于："}]},{"ID":"20251103145742-jutl60t","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103145742-jutl60t","updated":"20251103145742"},"Children":[{"ID":"20251103145742-pe4wqn1","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103145742-pe4wqn1","updated":"20251103145742"},"Children":[{"ID":"20251103145742-wl8hk4o","Type":"NodeParagraph","Properties":{"id":"20251103145742-wl8hk4o","updated":"20251103145811"},"Children":[{"Type":"NodeText","Data":"内存带宽不足（"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20251103120337-012i2a1","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"上文详细讲过"},{"Type":"NodeText","Data":"）"}]}]},{"ID":"20251103145742-nd904gs","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103145742-nd904gs","updated":"20251103145742"},"Children":[{"ID":"20251103145742-z9ut9hb","Type":"NodeParagraph","Properties":{"id":"20251103145742-z9ut9hb","updated":"20251103145742"},"Children":[{"Type":"NodeText","Data":"容量不足"}]}]}]},{"ID":"20251103145740-yvw5con","Type":"NodeParagraph","Properties":{"id":"20251103145740-yvw5con","updated":"20251103145749"},"Children":[{"Type":"NodeText","Data":"说人话：显存决定能装多少，能传多快，当超出上限，就存在性能问题"}]}]},{"ID":"20251103145732-5wx6bvk","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103145732-5wx6bvk","updated":"20251103145732"},"Children":[{"ID":"20251103145732-lypb7mi","Type":"NodeParagraph","Properties":{"id":"20251103145732-lypb7mi","updated":"20251103145734"},"Children":[{"Type":"NodeText","Data":"缓存"}]},{"ID":"20251103145825-27qy87i","Type":"NodeParagraph","Properties":{"id":"20251103145825-27qy87i","updated":"20251103145828"},"Children":[{"Type":"NodeText","Data":"性能瓶颈主要来自于："}]},{"ID":"20251103145828-0nhfqn2","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103145828-0nhfqn2","updated":"20251103145828"},"Children":[{"ID":"20251103145828-7ckj1m5","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103145828-7ckj1m5","updated":"20251103145828"},"Children":[{"ID":"20251103145828-8eoiefu","Type":"NodeParagraph","Properties":{"id":"20251103145828-8eoiefu","updated":"20251103145828"},"Children":[{"Type":"NodeText","Data":"未命中"}]},{"ID":"20251103145829-ushn7ha","Type":"NodeParagraph","Properties":{"id":"20251103145829-ushn7ha","updated":"20251103145841"},"Children":[{"Type":"NodeText","Data":"比如：在 Shader 中进行随机采样纹理、UV 跨度过大，就会导致缓存命中率低\n当未命中就睡频繁的去显存中取数据，导致获取数据缓慢，延迟变高"}]}]},{"ID":"20251103145828-v3h3eom","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103145828-v3h3eom","updated":"20251103145828"},"Children":[{"ID":"20251103145828-yua6yqs","Type":"NodeParagraph","Properties":{"id":"20251103145828-yua6yqs","updated":"20251103145828"},"Children":[{"Type":"NodeText","Data":"OverDraw、重复访问"}]},{"ID":"20251103145844-bgknai1","Type":"NodeParagraph","Properties":{"id":"20251103145844-bgknai1","updated":"20251103145844"},"Children":[{"Type":"NodeText","Data":"一个像素被多次覆盖，导致反复的读取纹理等信息，不停替换缓存中内容，缓存中内容还没有重复使用就被替换了\n让缓存命中率下降，缓存的加速作用大幅削弱"}]}]}]},{"ID":"20251103145825-ukfoo1g","Type":"NodeParagraph","Properties":{"id":"20251103145825-ukfoo1g","updated":"20251103145850"},"Children":[{"Type":"NodeText","Data":"说人话：缓存决定能不能就近取，取的快不快，当取不到，就存在性能问题"}]}]}]},{"ID":"20251103145856-145urd3","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251103145856-145urd3","updated":"20251103150950"},"Children":[{"Type":"NodeText","Data":"缓存和显存的优化思路"}]},{"ID":"20251103145915-vtlv2ne","Type":"NodeParagraph","Properties":{"id":"20251103145915-vtlv2ne","updated":"20251103150035"},"Children":[{"Type":"NodeText","Data":"显存主要的优化思路就是 容量 和 带宽 的优化，其中由于在上文"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20251103143018-lxgwvlo","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"内存带宽"},{"Type":"NodeText","Data":"讲解过带宽的优化思路，这里不赘述，这里主要讲解 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"容量"},{"Type":"NodeText","Data":" 优化思路"}]},{"ID":"20251103150032-5ja6n5h","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103150032-5ja6n5h","updated":"20251103150539"},"Children":[{"ID":"20251103150048-7m5xwlb","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103150048-7m5xwlb","updated":"20251103150048"},"Children":[{"ID":"20251103150048-o5f3ry9","Type":"NodeParagraph","Properties":{"id":"20251103150048-o5f3ry9","updated":"20251103150054"},"Children":[{"Type":"NodeText","Data":"资源压缩"}]},{"ID":"20251103150054-itif2ys","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103150054-itif2ys","updated":"20251103150054"},"Children":[{"ID":"20251103150054-7xpm6in","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103150054-7xpm6in","updated":"20251103150054"},"Children":[{"ID":"20251103150054-uvjjt9y","Type":"NodeParagraph","Properties":{"id":"20251103150054-uvjjt9y","updated":"20251103150054"},"Children":[{"Type":"NodeText","Data":"纹理压缩"}]},{"ID":"20251103150055-t36ciiq","Type":"NodeParagraph","Properties":{"id":"20251103150055-t36ciiq","updated":"20251103150059"},"Children":[{"Type":"NodeText","Data":"Unity 选择更节约空间的压缩格式，比如 ASTC、ETC2 等"}]}]},{"ID":"20251103150054-h539d0m","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103150054-h539d0m","updated":"20251103150054"},"Children":[{"ID":"20251103150054-j92xu52","Type":"NodeParagraph","Properties":{"id":"20251103150054-j92xu52","updated":"20251103150110"},"Children":[{"Type":"NodeText","Data":"法线压缩等"}]},{"ID":"20251103150111-wr4ar1j","Type":"NodeParagraph","Properties":{"id":"20251103150111-wr4ar1j","updated":"20251103150113"},"Children":[{"Type":"NodeText","Data":"双通道压缩，只存法线的 X 和 Y 分量，Z 分量在运行时计算\n可以在 Unity 中选择 ETC2、EAC、RG 等压缩格式"}]}]}]},{"ID":"20251103150052-7sru4oc","Type":"NodeParagraph","Properties":{"id":"20251103150052-7sru4oc","updated":"20251103150052"},"Children":[{"Type":"NodeText","Data":"等等"}]}]},{"ID":"20251103150048-hudyq7n","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103150048-hudyq7n","updated":"20251103150048"},"Children":[{"ID":"20251103150048-hex32tb","Type":"NodeParagraph","Properties":{"id":"20251103150048-hex32tb","updated":"20251103150124"},"Children":[{"Type":"NodeText","Data":"降低资源规格"}]},{"ID":"20251103150124-igdwgyh","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103150124-igdwgyh","updated":"20251103150124"},"Children":[{"ID":"20251103150124-ub9g1pv","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103150124-ub9g1pv","updated":"20251103150124"},"Children":[{"ID":"20251103150124-7kegx1q","Type":"NodeParagraph","Properties":{"id":"20251103150124-7kegx1q","updated":"20251103150124"},"Children":[{"Type":"NodeText","Data":"降低贴图分辨率"}]}]},{"ID":"20251103150124-ym3t4dn","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103150124-ym3t4dn","updated":"20251103150124"},"Children":[{"ID":"20251103150124-q5s93p5","Type":"NodeParagraph","Properties":{"id":"20251103150124-q5s93p5","updated":"20251103150132"},"Children":[{"Type":"NodeText","Data":"减少 G-Buffer（延迟渲染中缓冲区）和 Render Target（各种缓冲区、颜色、深度、法线等等，包括 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​）数量"}]},{"ID":"20251103150135-hv4tjr9","Type":"NodeParagraph","Properties":{"id":"20251103150135-hv4tjr9","updated":"20251103150139"},"Children":[{"Type":"NodeText","Data":"可以通过合并属性，比如合并金属度、粗糙度等属性\n可以降低 RT 的分辨率，屏幕后处理效果使用半分辨率\n移动平台 使用前向渲染路径，避免延迟渲染 等等"}]}]}]},{"ID":"20251103150122-klm2nbl","Type":"NodeParagraph","Properties":{"id":"20251103150122-klm2nbl","updated":"20251103150122"},"Children":[{"Type":"NodeText","Data":"等等"}]}]},{"ID":"20251103150048-58ttd7i","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251103150048-58ttd7i","updated":"20251103150454"},"Children":[{"ID":"20251103150048-yd1mk18","Type":"NodeParagraph","Properties":{"id":"20251103150048-yd1mk18","updated":"20251103150151"},"Children":[{"Type":"NodeText","Data":"Mipmap + Streaming"}]},{"ID":"20251103150153-jvsjuk3","Type":"NodeParagraph","Properties":{"id":"20251103150153-jvsjuk3","updated":"20251103150454"},"Children":[{"Type":"NodeText","Data":"使用 "},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20230727203130-4rvs7r1","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"Mipmap"},{"Type":"NodeText","Data":"，远处只保留低分辨率层级，在 "},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20230726022149-s75ymy5","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"Texture Importer"},{"Type":"NodeText","Data":" 面板勾选 "},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20230727202308-tdqbyqi","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"Streaming Mipmaps"},{"Type":"NodeText","Data":"，按需加载纹理（Texture Streaming）\nUnity 会根据相机和屏幕大小，自动决定加载哪些 Mipmap 层，可以减少显存占用和显存带宽消耗"}]}]},{"ID":"202