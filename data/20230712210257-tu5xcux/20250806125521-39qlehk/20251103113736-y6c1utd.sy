"id":"20251103144113-d7tykb3","updated":"20251103144113"},"Children":[{"Type":"NodeText","Data":"顶点：就像建房子的“钢筋骨架”。"}]}]},{"ID":"20251103144113-zoyi75v","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103144113-zoyi75v","updated":"20251103144113"},"Children":[{"ID":"20251103144113-7idah4f","Type":"NodeParagraph","Properties":{"id":"20251103144113-7idah4f","updated":"20251103144113"},"Children":[{"Type":"NodeText","Data":"片元：就是把框架之间的“砖块”一块块填上"}]}]}]},{"ID":"20251103144111-9glzbp7","Type":"NodeParagraph","Properties":{"id":"20251103144111-9glzbp7","updated":"20251103144111"},"Children":[{"Type":"NodeText","Data":"GPU渲染时：先有骨架（顶点），再填满砖块（片元），最后变成完整画面"}]},{"ID":"20251103144001-pb24n8k","Type":"NodeParagraph","Properties":{"id":"20251103144001-pb24n8k","updated":"20251103144005"},"Children":[{"Type":"NodeText","Data":"顶点和片元如果单独理解"}]},{"ID":"20251103144008-nwfb0hq","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251103144008-nwfb0hq","updated":"20251103144030"},"Children":[{"Type":"NodeText","Data":"顶点"}]},{"ID":"20251103144014-pnvvdg4","Type":"NodeParagraph","Properties":{"id":"20251103144014-pnvvdg4","updated":"20251103144023"},"Children":[{"Type":"NodeText","Data":"一般指模型的几何数据，是组成三角形网格的点，一个 3D 模型实际上就是由很多三角形拼接而成的，而三角形的角就是顶点"}]},{"ID":"20251103144014-d5y3dkv","Type":"NodeParagraph","Properties":{"id":"20251103144014-d5y3dkv","updated":"20251103144020"},"Children":[{"Type":"NodeText","Data":"作用：是网格的框架点，决定了模型的形状"}]},{"ID":"20251103144014-8isw93o","Type":"NodeParagraph","Properties":{"id":"20251103144014-8isw93o","updated":"20251103144019"},"Children":[{"Type":"NodeText","Data":"着色器阶段：一般会在着色器中的 顶点着色器 中进行处理和计算"}]},{"ID":"20251103144014-xjf1vz0","Type":"NodeParagraph","Properties":{"id":"20251103144014-xjf1vz0","updated":"20251103144017"},"Children":[{"Type":"NodeText","Data":"顶点着色器 主要任务"}]},{"ID":"20251103144017-00eqdgl","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103144017-00eqdgl","updated":"20251103144017"},"Children":[{"ID":"20251103144017-nzm5odf","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103144017-nzm5odf","updated":"20251103144017"},"Children":[{"ID":"20251103144017-xxojyte","Type":"NodeParagraph","Properties":{"id":"20251103144017-xxojyte","updated":"20251103144017"},"Children":[{"Type":"NodeText","Data":"将模型空间的顶点转换到裁剪空间、屏幕空间"}]}]},{"ID":"20251103144017-byjrx8h","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103144017-byjrx8h","updated":"20251103144017"},"Children":[{"ID":"20251103144017-le34qk0","Type":"NodeParagraph","Properties":{"id":"20251103144017-le34qk0","updated":"20251103144017"},"Children":[{"Type":"NodeText","Data":"把需要的数据（UV、法线、颜色等）传递给片元阶段"}]}]}]},{"ID":"20251103144025-117ynww","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251103144025-117ynww","updated":"20251103144129"},"Children":[{"Type":"NodeText","Data":"片元"}]},{"ID":"20251103144038-wmnvxl5","Type":"NodeParagraph","Properties":{"id":"20251103144038-wmnvxl5","updated":"20251103144038"},"Children":[{"Type":"NodeText","Data":"一般指光栅化阶段产生的、候选的像素点\n当三角形被投影到屏幕后，会覆盖一片像素区域\n每个像素位置对应一个片元，GPU 会为它准备一份数据（位置、UV、颜色等）"}]},{"ID":"20251103144038-rqto274","Type":"NodeParagraph","Properties":{"id":"20251103144038-rqto274","updated":"20251103144043"},"Children":[{"Type":"NodeText","Data":"作用：决定屏幕上每个像素的最终颜色"}]},{"ID":"20251103144038-r3c6m9y","Type":"NodeParagraph","Properties":{"id":"20251103144038-r3c6m9y","updated":"20251103144043"},"Children":[{"Type":"NodeText","Data":"着色器阶段：一般会在着色器中的 片元着色器 中进行处理和计算"}]},{"ID":"20251103144038-uw8a888","Type":"NodeParagraph","Properties":{"id":"20251103144038-uw8a888","updated":"20251103144041"},"Children":[{"Type":"NodeText","Data":"主要任务"}]},{"ID":"20251103144041-c6uagv4","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103144041-c6uagv4","updated":"20251103144041"},"Children":[{"ID":"20251103144041-glxpyc0","Type":"NodeLis