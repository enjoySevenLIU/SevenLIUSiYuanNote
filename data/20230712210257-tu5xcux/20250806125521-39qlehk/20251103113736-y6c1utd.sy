20251103150750-t2poxeu","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103150750-t2poxeu","updated":"20251103150750"},"Children":[{"ID":"20251103150750-11ft3yw","Type":"NodeParagraph","Properties":{"id":"20251103150750-11ft3yw","updated":"20251103150750"},"Children":[{"Type":"NodeText","Data":"避免退化三角形：面积为零的三角形，也就是三个顶点中有两个或三个是重合的情况"}]}]}]}]}]}]},{"ID":"20251103150738-zjm3rek","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103150738-zjm3rek","updated":"20251103150738"},"Children":[{"ID":"20251103150738-pqnlvem","Type":"NodeParagraph","Properties":{"id":"20251103150738-pqnlvem","updated":"20251103150738"},"Children":[{"Type":"NodeText","Data":"减少缓存未命中"}]},{"ID":"20251103150802-syayf48","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103150802-syayf48","updated":"20251103150806"},"Children":[{"ID":"20251103150806-j4gum4x","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103150806-j4gum4x","updated":"20251103150806"},"Children":[{"ID":"20251103150806-g8fx42b","Type":"NodeParagraph","Properties":{"id":"20251103150806-g8fx42b","updated":"20251103150916"},"Children":[{"Type":"NodeText","Data":"降低 OverDraw"}]}]},{"ID":"20251103150806-08si2pe","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103150806-08si2pe","updated":"20251103150806"},"Children":[{"ID":"20251103150806-x1y54z7","Type":"NodeParagraph","Properties":{"id":"20251103150806-x1y54z7","updated":"20251103150915"},"Children":[{"Type":"NodeText","Data":"避免 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"依赖采样"},{"Type":"NodeText","Data":"（所谓 依赖采样 指的是在片元着色器里，纹理采样的坐标不是直接来自插值，而是运行时计算出来的）"}]},{"ID":"20251103150820-chnawz5","Type":"NodeParagraph","Properties":{"id":"20251103150820-chnawz5","updated":"20251103150904"},"Children":[{"Type":"NodeText","Data":"GPU 的纹理单元本来可以提前准备需要取的区域，但依赖采样让它必须等前一步结果"}]},{"ID":"20251103150904-thpqtkj","Type":"NodeList","ListData":{},"Properties":{"id":"20251103150904-thpqtkj","updated":"20251103150904"},"Children":[{"ID":"20251103150904-heelrd4","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103150904-heelrd4","updated":"20251103150904"},"Children":[{"ID":"20251103150904-y0xyyvk","Type":"NodeParagraph","Properties":{"id":"20251103150904-y0xyyvk","updated":"20251103150904"},"Children":[{"Type":"NodeText","Data":"普通采样 UV 连续，相邻像素会访问相邻内容，缓存命中率高"}]}]},{"ID":"20251103150905-rtkl4x2","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103150905-rtkl4x2","updated":"20251103150905"},"Children":[{"ID":"20251103150905-bgqudp0","Type":"NodeParagraph","Properties":{"id":"20251103150905-bgqudp0","updated":"20251103150908"},"Children":[{"Type":"NodeText","Data":"依赖采样 UV 可能随机跳，缓存命中率低，频繁回显存"}]}]}]},{"ID":"20251103150909-827hsc3","Type":"NodeParagraph","Properties":{"id":"20251103150909-827hsc3","updated":"20251103150910"},"Children":[{"Type":"NodeText","Data":"我们应该尽量减少采样坐标依赖前一次计算的情况，可以采用预计算预烘焙到纹理中直接获取相关信息，要尽量简化 UV 的计算"}]}]}]}]},{"ID":"20251103150738-6s3ycik","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251103150738-6s3ycik","updated":"20251103150950"},"Children":[{"ID":"20251103150738-kmkp8dq","Type":"NodeParagraph","Properties":{"id":"20251103150738-kmkp8dq","updated":"20251103150929"},"Children":[{"Type":"NodeText","Data":"减少数据占用"}]},{"ID":"20251103150930-7sb0231","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103150930-7sb0231","updated":"20251103150950"},"Children":[{"ID":"20251103150933-l2ia78e","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103150933-l2ia78e","updated":"20251103150933"},"Children":[{"ID":"20251103150933-0jaushf","Type":"NodeParagraph","Properties":{"id":"20251103150933-0jaushf","updated":"20251103150933"},"Children":[{"Type":"NodeText","Data":"数据轻量化"}]},{"ID":"20251103150934-5q4nx12","Type":"NodeParagraph","Properties":{"id":"20251103150934-5q4nx12","updated":"20251103150945"},"Children":[{"Type":"NodeText","Data":"顶点属性尽量用低精度的，比如用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"half"},{"Type":"NodeText","Data":"​ 替代 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"float"},{"Type":"NodeText","Data":"​\n顶点着色器的输出结构体中 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"v2f"},{"Type":"NodeText","Data":"​，只传必要数据"}]}]},{"ID":"20251103150933-5hvz67v","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103150933-5hvz67v","updated":"20251103150950"},"Children":[{"ID":"20251103150933-6yvxrhe","Type":"NodeParagraph","Properties":{"id":"20251103150933-6yvxrhe","updated":"20251103150933"},"Children":[{"Type":"NodeText","Data":"共享内存"}]},{"ID":"20251103150948-uu4kayz","Type":"NodeParagraph","Properties":{"id":"20251103150948-uu4kayz","updated":"20251103150950"},"Children":[{"Type":"NodeText","Data":"在 Shader 中，用共享内存替代反复访问"}]}]}]}]}]},{"ID":"20251103150731-sumnwgb","Type":"NodeParagraph","Properties":{"id":"20251103150731-sumnwgb","updated":"20251103150731"},"Children":[{"Type":"NodeText","Data":"等等"}]},{"ID":"20251103150659-kqqnm4u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251103150659-kqqnm4u","updated":"20251103151517"},"Children":[{"Type":"NodeText","Data":"并行度与调度"}]},{"ID":"20251103151511-8x5bf4b","Type":"NodeList","ListData":{},"Properties":{"id":"20251103151511-8x5bf4b","updated":"20251103151517"},"Children":[{"ID":"20251103151517-ojrm8so","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103151517-ojrm8so","updated":"20251103151517"},"Children":[{"ID":"20251103151517-b2wppic","Type":"NodeParagraph","Properties":{"id":"20251103151517-b2wppic","updated":"20251103151517"},"Children":[{"Type":"NodeText","Data":"并行度：表示 有没有足够的线程让 GPU 忙起来"}]}]},{"ID":"20251103151518-fd504bh","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103151518-fd504bh","updated":"20251103151518"},"Children":[{"ID":"20251103151518-m1a9dtk","Type":"NodeParagraph","Properties":{"id":"20251103151518-m1a9dtk","updated":"20251103151518"},"Children":[{"Type":"NodeText","Data":"调度：表示 GPU 能否在等待延迟时把空闲单元塞满"}]}]}]},{"ID":"20251103151225-2cr1uo1","Type":"NodeBlockquote","Properties":{"id":"20251103151225-2cr1uo1","updated":"20251103151327"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20251103151226-levfnye","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20251103151226-levfnye","updated":"20251103151327"},"Children":[{"Type":"NodeText","Data":"GPU 的 执行模型"}]},{"ID":"20251103151242-m6d6au0","Type":"NodeParagraph","Properties":{"id":"20251103151242-m6d6au0","updated":"20251103151242"},"Children":[{"Type":"NodeText","Data":"GPU 的线程不是单独执行的，而是 一批一批 按 线程组（Warp / Wavefront） 执行\nNVIDIA：一个 Warp = 32 个线程\nAMD：一个 Wavefront = 64 个线程"}]},{"ID":"20251103151242-ojmea7d","Type":"NodeParagraph","Properties":{"id":"20251103151242-ojmea7d","updated":"20251103151327"},"Children":[{"Type":"NodeText","Data":"而一批次内的线程中，同一条指令同时在所有线程上跑，只是每个线程的数据不同\n理想情况：所有线程执行同一条路径，利用率 100%"}]}]},{"ID":"20251103151344-oofwayj","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251103151344-oofwayj","updated":"20251103151418"},"Children":[{"Type":"NodeText","Data":"并行度"}]},{"ID":"20251103151353-0yzw7e6","Type":"NodeParagraph","Properties":{"id":"20251103151353-0yzw7e6","updated":"20251103151415"},"Children":[{"Type":"NodeText","Data":"GPU 天然是 大规模并行处理器，成千上万个小核心（算数逻辑单元）在同时执行，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"并行度"},{"Type":"NodeText","Data":" 指的是能同时被 GPU 执行的任务数量和有效利用率"}]},{"ID":"20251103151408-j9fjxci","Type":"NodeParagraph","Properties":{"id":"20251103151408-j9fjxci","updated":"20251103151408"},"Children":[{"Type":"NodeText","Data":"常见的并行度层次（GPU 在不同维度的并行能力分类）有："}]},{"ID":"20251103151359-3lrpwch","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103151359-3lrpwch","updated":"20251103151359"},"Children":[{"ID":"20251103151359-x0wndto","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103151359-x0wndto","updated":"20251103151359"},"Children":[{"ID":"20251103151359-eximt35","Type":"NodeParagraph","Properties":{"id":"20251103151359-eximt35","updated":"20251103151359"},"Children":[{"Type":"NodeText","Data":"数据并行"}]},{"ID":"20251103151359-5cd1kfw","Type":"NodeParagraph","Properties":{"id":"20251103151359-5cd1kfw","updated":"20251103151359"},"Children":[{"Type":"NodeText","Data":"大量像素 / 顶点 / 线程同时计算"}]}]},{"ID":"20251103151359-cn5pnox","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103151359-cn5pnox","updated":"20251103151359"},"Children":[{"ID":"20251103151359-tlcjju9","Type":"NodeParagraph","Properties":{"id":"20251103151359-tlcjju9","updated":"20251103151359"},"Children":[{"Type":"NodeText","Data":"任务并行"}]},{"ID":"20251103151400-0kbz59x","Type":"NodeParagraph","Properties":{"id":"20251103151400-0kbz59x","updated":"20251103151400"},"Children":[{"Type":"NodeText","Data":"不同 Pass 或 Shader 阶段并行执行"}]}]},{"ID":"20251103151359-srhobkz","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251103151359-srhobkz","updated":"20251103151359"},"Children":[{"ID":"20251103151359-6iv0d9c","Type":"NodeParagraph","Properties":{"id":"20251103151359-6iv0d9c","updated":"20251103151359"},"Children":[{"Type":"NodeText","Data":"指令并行"}]},{"ID":"20251103151404-dvgrdiz","Type":"NodeParagraph","Properties":{"id":"20251103151404-dvgrdiz","updated":"20251103151404"},"Children":[{"Type":"NodeText","Data":"单个线程里，独立指令是否能被调度器交错执行，从而减少空等、提高 GPU 硬件单元利用率"}]}]}]},{"ID":"20251103151418-gi09kgs","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251103151418-gi09kgs","updated":"20251103151525"},"Children":[{"Type":"NodeText","Data":"调度"}]},{"ID":"20251103151437-kjx9ex6","Type":"NodeParagraph","Properties":{"id":"20251103151437-kjx9ex6","updated":"20251103151502"},"Children":[{"Type":"NodeText","Data":"GPU 内部调度器负责在 不同的线程组（Warp / Wavefront） 之间切换，\n把 ALU（算数逻辑单元）、内存访问、纹理采样、光栅化等任务交错执行，\n调度的目标是 尽量保持硬件单元忙碌"}]},{"ID":"20251103151525-iu1an5t","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251103151525-iu1an5t","updated":"20251103152250"},"Children":[{"Type":"NodeText","Data":"为什么并行度与调度会影响性能"}]},{"ID":"20251103151531-pzd9oyu","Type":"NodeParagraph","Properties":{"id":"20251103151531-pzd9oyu","updated":"20251103151615"},"Children":[{"Type":"NodeText","Data":"并行度影响性能的主要原因有："}]},{"ID":"20251103151622-uaqvu6y","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103151622-uaqvu6y","updated":"20251103152009"},"Children":[{"ID":"20251103151628-ihpzbgd","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103151628-ihpzbgd","updated":"20251103152009"},"Children":[{"ID":"20251103151628-tfqp20d","Type":"NodeParagraph","Properties":{"id":"20251103151628-tfqp20d","updated":"20251103151628"},"Children":[{"Type":"NodeText","Data":"并行度不足"}]},{"ID":"20251103151629-4p330hm","Type":"NodeParagraph","Properties":{"id":"20251103151629-4p330hm","updated":"20251103151634"},"Children":[{"Type":"NodeText","Data":"GPU 核心会出现空转（闲置状态），算力浪费，比如："}]},{"ID":"20251103151638-tbow1rm","Type":"NodeList","ListData":{},"Properties":{"id":"20251103151638-tbow1rm","updated":"20251103152009"},"Children":[{"ID":"20251103151955-21vz879","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103151955-21vz879","updated":"20251103151955"},"Children":[{"ID":"20251103151955-s053tke","Type":"NodeParagraph","Properties":{"id":"20251103151955-s053tke","updated":"20251103151955"},"Children":[{"Type":"NodeText","Data":"小批量 DrawCall（每次只处理少量像素/顶点），并行度就会不足"}]}]},{"ID":"20251103151955-0wv78f4","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103151955-0wv78f4","updated":"20251103152009"},"Children":[{"ID":"20251103151955-n5a03wa","Type":"NodeParagraph","Properties":{"id":"20251103151955-n5a03wa","updated":"20251103151955"},"Children":[{"Type":"NodeText","Data":"Shader 中大量分支，线程分化，造成部分线程空跑"}]},{"ID":"20251103151958-au893p4","Type":"NodeParagraph","Properties":{"id":"20251103151958-au893p4","updated":"20251103151958"},"Children":[{"Type":"NodeText","Data":"当 Shader 里有 条件分支 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"if/else"},{"Type":"NodeText","Data":"​、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"switch"},{"Type":"NodeText","Data":"​、loop 时，线程组（Warp）内的线程可能走不同路径"}]},{"ID":"20251103151741-s5i46id","Type":"NodeParagraph","Properties":{"id":"20251103151741-s5i46id","updated":"20251103152009"},"Children":[{"Type":"NodeText","Data":"比如："}]},{"ID":"20251103151702-njkriyl","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251103151702-njkriyl","updated":"20251103152009"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"if (color.r \u003e 0.5) {\n    doSomething();      // 分支 A\n} else {\n    doSomethingElse();  // 分支 B\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251103151700-t74itu7","Type":"NodeParagraph","Properties":{"id":"20251103151700-t74itu7","updated":"20251103152009"},"Children":[{"Type":"NodeText","Data":"假设 Warp 内 32 个线程，有一半满足条件走 A，另一半走 B，GPU 不能同时执行两条不同的指令\n调度器会把分支拆开，先执行 A 的线程，再执行 B 的线程\n当执行 A 时，走 B 的线程空转；当执行 B 时，走 A 的线程空转，这就是所谓的线程分化"}]},{"ID":"20251103151826-h9yy5h5","Type":"NodeList","ListData":{},"Properties":{"id":"20251103151826-h9yy5h5","updated":"20251103152009"},"Children":[{"ID":"20251103151826-0q95szq","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103151826-0q95szq","updated":"20251103151826"},"Children":[{"ID":"20251103151826-oerw9qn","Type":"NodeParagraph","Properties":{"id":"20251103151826-oerw9qn","updated":"20251103151848"},"Children":[{"Type":"NodeText","Data":"分支完全对齐时：32 线程并行， 1 次执行完成"}]}]},{"ID":"20251103151827-1wxe2ei","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103151827-1wxe2ei","updated":"20251103151827"},"Children":[{"ID":"20251103151827-80tj0tq","Type":"NodeParagraph","Properties":{"id":"20251103151827-80tj0tq","updated":"20251103151845"},"Children":[{"Type":"NodeText","Data":"分支分化时：等于串行化，执行时间翻倍（甚至更差），就造成了 ALU（算数逻辑单元） 利用率下降"}]}]}]}]}]}]},{"ID":"20251103151628-dhame4t","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103151628-dhame4t","updated":"20251103151931"},"Children":[{"ID":"20251103151628-cz8twey","Type":"NodeParagraph","Properties":{"id":"20251103151628-cz8twey","updated":"20251103151628"},"Children":[{"Type":"NodeText","Data":"并行度过高"}]},{"ID":"20251103151856-hb1ca1r","Type":"NodeParagraph","Properties":{"id":"20251103151856-hb1ca1r","updated":"20251103151914"},"Children":[{"Type":"NodeText","Data":"内存带宽、寄存器压力增加，反而造成瓶颈，比如：假设我们在片元着色器中对4张4k纹理进行采样，4K ≈ 830 万像素，如果是 60 FPS的游戏"}]},{"ID":"20251103151916-ahe0xg1","Type":"NodeParagraph","Properties":{"id":"20251103151916-ahe0xg1","updated":"20251103151931"},"Children":[{"Type":"NodeText","Data":"那每秒采样 830万 * 60 * 4 = 20 亿次纹理访问，这样 并行度虽然非常高（数百万像素同时跑）\n但是会造成 GPU 的 内存带宽被吃满，ALU（算数逻辑单元）很空闲，还能算更多，但 带宽不足，取不到数据，造成 GPU 利用率下降"}]}]}]},{"ID":"20251103152035-spkphp7","Type":"NodeParagraph","Properties":{"id":"20251103152035-spkphp7","updated":"20251103152054"},"Children":[{"Type":"NodeText","Data":"调度影响性能的主要原因：如果调度不合理（或没有足够可切换的任务），GPU 会出现 ALU（算数逻辑单元）闲置的情况，比如："}]},{"ID":"20251103152056-1puau7h","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103152056-1puau7h","updated":"20251103152242"},"Children":[{"ID":"20251103152116-9spzycf","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103152116-9spzycf","updated":"20251103152242"},"Children":[{"ID":"20251103152116-np3v3m7","Type":"NodeParagraph","Properties":{"id":"20251103152116-np3v3m7","updated":"20251103152119"},"Children":[{"Type":"NodeText","Data":"等待内存，ALU（算数逻辑单元）没事儿干"}]},{"ID":"20251103152153-tqeo2gi","Type":"NodeParagraph","Properties":{"id":"20251103152153-tqeo2gi","updated":"20251103152200"},"Children":[{"Type":"NodeText","Data":"比如，我们在片元着色器中进行纹理采样时"}]},{"ID":"20251103152121-br55i09","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251103152121-br55i09","updated":"20251103152134"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"float4 frag(v2f i) : SV_Target\n{\n    // 从显存里采样一张大纹理\n    float4 texColor = tex2D(_MainTex, i.uv);\n    // 得到采样结果才能计算\n    float brightness = dot(texColor.rgb, float3(0.3, 0.59, 0.11));\n    return float4(brightness.xxx, 1.0);\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251103152120-zp591i0","Type":"NodeParagraph","Properties":{"id":"20251103152120-zp591i0","updated":"20251103152242"},"Children":[{"Type":"NodeText","Data":"当我们从纹理中采样时，需要去缓存或显存中获取数据，那么这里就会存在延迟等待，\n在采样结果没有回来之前，后面的相关计算，都无法执行，相当于就是在等待内存，\n此时的 ALU（算数逻辑单元）在此期间就无事可做"}]}]},{"ID":"20251103152116-93hfzcx","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103152116-93hfzcx","updated":"20251103152227"},"Children":[{"ID":"20251103152116-qjb337u","Type":"NodeParagraph","Properties":{"id":"20251103152116-qjb337u","updated":"20251103152215"},"Children":[{"Type":"NodeText","Data":"算数、依赖链过长"}]},{"ID":"20251103152223-n8yvwd5","Type":"NodeParagraph","Properties":{"id":"20251103152223-n8yvwd5","updated":"20251103152223"},"Children":[{"Type":"NodeText","Data":"比如 我们执行以下指令"}]},{"ID":"20251103152217-mg80i5a","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20251103152217-mg80i5a","updated":"20251103152219"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aGxzbA=="},{"Type":"NodeCodeBlockCode","Data":"float a = heavyFunc1(x);\nfloat b = heavyFunc2(a);\nfloat c = heavyFunc3(b);\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20251103152216-2ng9y2g","Type":"NodeParagraph","Properties":{"id":"20251103152216-2ng9y2g","updated":"20251103152227"},"Children":[{"Type":"NodeText","Data":"必须等前一条执行完才能执行下一条，调度器无法插入别的计算"}]}]}]},{"ID":"20251103152058-ofbtoij","Type":"NodeParagraph","Properties":{"id":"20251103152058-ofbtoij","updated":"20251103152058"},"Children":[{"Type":"NodeText","Data":"等等"}]},{"ID":"20251103152244-iyc477i","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20251103152244-iyc477i","updated":"20251103152713"},"Children":[{"Type":"NodeText","Data":"并行度与调度的优化思路"}]},{"ID":"20251103152256-m5smzml","Type":"NodeParagraph","Properties":{"id":"20251103152256-m5smzml","updated":"20251103152306"},"Children":[{"Type":"NodeText","Data":"总体思路：让GPU永远有足够的独立的事情可做，避免任何单元长时间空闲"}]},{"ID":"20251103152310-g8cq6fv","Type":"NodeParagraph","Properties":{"id":"20251103152310-g8cq6fv","updated":"20251103152320"},"Children":[{"Type":"NodeText","Data":"并行度优化主要目标：保证 GPU 有足够多的线程在跑，避免核心闲置"}]},{"ID":"20251103152322-8m5ih72","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103152322-8m5ih72","updated":"20251103152543"},"Children":[{"ID":"20251103152328-zscvagc","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103152328-zscvagc","updated":"20251103152328"},"Children":[{"ID":"20251103152328-tends7z","Type":"NodeParagraph","Properties":{"id":"20251103152328-tends7z","updated":"20251103152328"},"Children":[{"Type":"NodeText","Data":"提高批处理力度"}]},{"ID":"20251103152329-vj0gxw9","Type":"NodeParagraph","Properties":{"id":"20251103152329-vj0gxw9","updated":"20251103152419"},"Children":[{"Type":"NodeText","Data":"用之前学习的"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250918203139-8ivqcls","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"批处理技术"},{"Type":"NodeText","Data":"，减少 DrawCall，让每次处理更多的顶点和像素\n"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250919145831-3ema0jv","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"GPU Instancing"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20250919154952-4bba43p","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"SRP Batcher"},{"Type":"NodeText","Data":" 还可以让 GPU 同时处理更多对象"}]}]},{"ID":"20251103152328-59vcz10","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103152328-59vcz10","updated":"20251103152328"},"Children":[{"ID":"20251103152328-dak6uax","Type":"NodeParagraph","Properties":{"id":"20251103152328-dak6uax","updated":"20251103152328"},"Children":[{"Type":"NodeText","Data":"避免 线程组（Warp）内线程分化"}]},{"ID":"20251103152423-09i3lno","Type":"NodeParagraph","Properties":{"id":"20251103152423-09i3lno","updated":"20251103152519"},"Children":[{"Type":"NodeText","Data":"减少 Shader 内部的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"if/else"},{"Type":"NodeText","Data":"​ 的使用\n用数学函数（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lerp()"},{"Type":"NodeText","Data":"​、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"step()"},{"Type":"NodeText","Data":"​）替代分支"}]}]},{"ID":"20251103152328-hbtplj9","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251103152328-hbtplj9","updated":"20251103152328"},"Children":[{"ID":"20251103152328-yponww2","Type":"NodeParagraph","Properties":{"id":"20251103152328-yponww2","updated":"20251103152523"},"Children":[{"Type":"NodeText","Data":"控制寄存器压力"}]},{"ID":"20251103152523-tcl4gjx","Type":"NodeParagraph","Properties":{"id":"20251103152523-tcl4gjx","updated":"20251103152537"},"Children":[{"Type":"NodeText","Data":"避免单个 Shader 太臃肿，中间变量过多，用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"half"},{"Type":"NodeText","Data":"​ 代替 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"float"},{"Type":"NodeText","Data":"​（移动端尤为重要）\n拆分 Shader Pass，降低寄存器占用，让更多 线程组（Warp） 能并行驻留"}]}]},{"ID":"20251103152328-hi2870j","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20251103152328-hi2870j","updated":"20251103152543"},"Children":[{"ID":"20251103152328-oxkl64r","Type":"NodeParagraph","Properties":{"id":"20251103152328-oxkl64r","updated":"20251103152328"},"Children":[{"Type":"NodeText","Data":"保证任务规模足够大"}]},{"ID":"20251103152541-20ilbrn","Type":"NodeParagraph","Properties":{"id":"20251103152541-20ilbrn","updated":"20251103152543"},"Children":[{"Type":"NodeText","Data":"避免超小网格、超小计算任务（否则并行度不足）\n如果使用 Compute Shader（计算着色器）要合理设计工作组大小，让 GPU 核心填满"}]}]}]},{"ID":"20251103152316-soo0iy5","Type":"NodeParagraph","Properties":{"id":"20251103152316-soo0iy5","updated":"20251103152608"},"Children":[{"Type":"NodeText","Data":"调度优化主要目标：让 GPU 能在等待（内存 / 采样 / 依赖）时切换别的任务，避免管线停滞"}]},{"ID":"20251103152605-5xstbhr","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103152605-5xstbhr","updated":"20251103152658"},"Children":[{"ID":"20251103152619-u3gsekf","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103152619-u3gsekf","updated":"20251103152638"},"Children":[{"ID":"20251103152619-zyj18lb","Type":"NodeParagraph","Properties":{"id":"20251103152619-zyj18lb","updated":"20251103152619"},"Children":[{"Type":"NodeText","Data":"内存访问优化"}]},{"ID":"20251103152629-k9j1ato","Type":"NodeList","ListData":{},"Properties":{"id":"20251103152629-k9j1ato","updated":"20251103152638"},"Children":[{"ID":"20251103152631-n4ug43w","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103152631-n4ug43w","updated":"20251103152636"},"Children":[{"ID":"20251103152631-texxl4q","Type":"NodeParagraph","Properties":{"id":"20251103152631-texxl4q","updated":"20251103152636"},"Children":[{"Type":"NodeText","Data":"减少带宽需求：纹理压缩（ASTC / BCn / ETC2）、MipMap、合理精度格式"}]}]},{"ID":"20251103152631-szk6xpm","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103152631-szk6xpm","updated":"20251103152638"},"Children":[{"ID":"20251103152631-e0o8mg1","Type":"NodeParagraph","Properties":{"id":"20251103152631-e0o8mg1","updated":"20251103152638"},"Children":[{"Type":"NodeText","Data":"提高缓存命中率：让相邻像素访问相邻内存（UV 连续、把多种需要的数据合并到一张纹理里，而不是分散存放）"}]}]},{"ID":"20251103152632-rqb7uga","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103152632-rqb7uga","updated":"20251103152632"},"Children":[{"ID":"20251103152632-2nx51i7","Type":"NodeParagraph","Properties":{"id":"20251103152632-2nx51i7","updated":"20251103152632"},"Children":[{"Type":"NodeText","Data":"减少依赖采样：UV 复杂运算/链式采样容易停顿，尽量预计算。"}]}]}]}]},{"ID":"20251103152619-2o93yhf","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103152619-2o93yhf","updated":"20251103152619"},"Children":[{"ID":"20251103152619-qv8rfaj","Type":"NodeParagraph","Properties":{"id":"20251103152619-qv8rfaj","updated":"20251103152619"},"Children":[{"Type":"NodeText","Data":"指令调度优化"}]},{"ID":"20251103152620-h77olsm","Type":"NodeParagraph","Properties":{"id":"20251103152620-h77olsm","updated":"20251103152620"},"Children":[{"Type":"NodeText","Data":"打散指令依赖链，让调度器有空间插入别的运算"}]}]},{"ID":"20251103152619-2an0f7b","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251103152619-2an0f7b","updated":"20251103152658"},"Children":[{"ID":"20251103152619-eh93l34","Type":"NodeParagraph","Properties":{"id":"20251103152619-eh93l34","updated":"20251103152619"},"Children":[{"Type":"NodeText","Data":"负载均衡"}]},{"ID":"20251103152622-u6ct4o8","Type":"NodeParagraph","Properties":{"id":"20251103152622-u6ct4o8","updated":"20251103152658"},"Children":[{"Type":"NodeText","Data":"避免片元过重、顶点过轻，减少 Overdraw，\n动态分辨率等优化分辨率方案来控制片元数量"}]}]}]},{"ID":"20251103152616-t6g2cit","Type":"NodeParagraph","Properties":{"id":"20251103152616-t6g2cit","updated":"20251103152616"},"Children":[{"Type":"NodeText","Data":"等等"}]},{"ID":"20251103152712-bzuj4y3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20251103152712-bzuj4y3","updated":"20251103153324"},"Children":[{"Type":"NodeText","Data":"影响 GPU 性能的其它因素"}]},{"ID":"20251103152722-jmyh796","Type":"NodeParagraph","Properties":{"id":"20251103152722-jmyh796","updated":"20251103152724"},"Children":[{"Type":"NodeText","Data":"目前我们已经了解了：填充率、OverDraw、内存带宽、顶点/片元、缓存与显存、并行度与调度\n这些因素都可能会对GPU造成性能影响"}]},{"ID":"20251103152722-9kak2qx","Type":"NodeParagraph","Properties":{"id":"20251103152722-9kak2qx","updated":"20251103152733"},"Children":[{"Type":"NodeText","Data":"除此之外，我们还应该注意以下一些因素，这些因素可能已经被我们在以上因素中提及过，在这里再次进行强调"}]},{"ID":"20251103152734-3q4ksc3","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103152734-3q4ksc3","updated":"20251103153324"},"Children":[{"ID":"20251103152740-bxtrf0b","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103152740-bxtrf0b","updated":"20251103152740"},"Children":[{"ID":"20251103152740-7vi9zml","Type":"NodeParagraph","Properties":{"id":"20251103152740-7vi9zml","updated":"20251103152740"},"Children":[{"Type":"NodeText","Data":"DrawCall"}]},{"ID":"20251103152741-ax7oo4g","Type":"NodeParagraph","Properties":{"id":"20251103152741-ax7oo4g","updated":"20251103152806"},"Children":[{"Type":"NodeText","Data":"每个 DrawCall 都有 CPU 到 GPU 的指令调度开销，频繁切换材质、着色器、渲染目标会造成流水线停滞\n因此减少 DrawCall 不仅仅可以优化 CPU 性能，同样也可以优化 GPU 性能"}]}]},{"ID":"20251103152807-1t0tbdk","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103152807-1t0tbdk","updated":"20251103152807"},"Children":[{"ID":"20251103152807-j3yn8q1","Type":"NodeParagraph","Properties":{"id":"20251103152807-j3yn8q1","updated":"20251103152812"},"Children":[{"Type":"NodeText","Data":"纹理采样"}]},{"ID":"20251103152812-tpvoy78","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103152812-tpvoy78","updated":"20251103152822"},"Children":[{"ID":"20251103152822-ia7dvnk","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103152822-ia7dvnk","updated":"20251103152822"},"Children":[{"ID":"20251103152822-6o4o6p6","Type":"NodeParagraph","Properties":{"id":"20251103152822-6o4o6p6","updated":"20251103152826"},"Children":[{"Type":"NodeText","Data":"优化采样次数可以提高 GPU 性能"}]},{"ID":"20251103152823-a8p53bf","Type":"NodeParagraph","Properties":{"id":"20251103152823-a8p53bf","updated":"20251103152831"},"Children":[{"Type":"NodeText","Data":"纹理查询是片元着色器的主要瓶颈之一，Mipmap、LOD 能减少带宽和缓存压力"}]}]},{"ID":"20251103152822-soiworb","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103152822-soiworb","updated":"20251103152822"},"Children":[{"ID":"20251103152822-2e6okge","Type":"NodeParagraph","Properties":{"id":"20251103152822-2e6okge","updated":"20251103152822"},"Children":[{"Type":"NodeText","Data":"有规律的进行采样，可以提高缓存命中率"}]},{"ID":"20251103152833-hibxlv9","Type":"NodeParagraph","Properties":{"id":"20251103152833-hibxlv9","updated":"20251103152833"},"Children":[{"Type":"NodeText","Data":"如果片元访问的纹理坐标分布离散，纹理缓存命中率下降，会大量访问显存，我们应该有规律的连续采样"}]}]},{"ID":"20251103152822-hbfdzib","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251103152822-hbfdzib","updated":"20251103152822"},"Children":[{"ID":"20251103152822-x30gddn","Type":"NodeParagraph","Properties":{"id":"20251103152822-x30gddn","updated":"20251103152822"},"Children":[{"Type":"NodeText","Data":"采样模式的复杂度越高，越消耗性能"}]},{"ID":"20251103152835-la4pdi1","Type":"NodeParagraph","Properties":{"id":"20251103152835-la4pdi1","updated":"20251103153007"},"Children":[{"Type":"NodeText","Data":"在 Inspector \u003e Texture Import Settings 里有一个 "},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20230727204845-rjuym28","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"Filter Mode"},{"Type":"NodeText","Data":"："}]},{"ID":"20251103152847-qh4ayyy","Type":"NodeList","ListData":{},"Properties":{"id":"20251103152847-qh4ayyy","updated":"20251103152848"},"Children":[{"ID":"20251103152848-am7q5jn","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103152848-am7q5jn","updated":"20251103152848"},"Children":[{"ID":"20251103152848-ohdicab","Type":"NodeParagraph","Properties":{"id":"20251103152848-ohdicab","updated":"20251103152856"},"Children":[{"Type":"NodeText","Data":"Point（最近点）"}]}]},{"ID":"20251103152848-6e10nms","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103152848-6e10nms","updated":"20251103152848"},"Children":[{"ID":"20251103152848-wrmj2oz","Type":"NodeParagraph","Properties":{"id":"20251103152848-wrmj2oz","updated":"20251103152900"},"Children":[{"Type":"NodeText","Data":"Bilinear（双线性）"}]}]},{"ID":"20251103152850-p3gwmuv","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251103152850-p3gwmuv","updated":"20251103152850"},"Children":[{"ID":"20251103152850-g0imfoe","Type":"NodeParagraph","Properties":{"id":"20251103152850-g0imfoe","updated":"20251103152903"},"Children":[{"Type":"NodeText","Data":"Trilinear（三线性）"}]}]}]},{"ID":"20251103152845-o7lzbb6","Type":"NodeParagraph","Properties":{"id":"20251103152845-o7lzbb6","updated":"20251103152911"},"Children":[{"Type":"NodeText","Data":"性能消耗：三线性 \u003e 双线性 \u003e 最近点"}]}]},{"ID":"20251103152822-gso10ku","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20251103152822-gso10ku","updated":"20251103152822"},"Children":[{"ID":"20251103152822-zm0fedu","Type":"NodeParagraph","Properties":{"id":"20251103152822-zm0fedu","updated":"20251103152822"},"Children":[{"Type":"NodeText","Data":"尽量减少多纹理绑定"}]},{"ID":"20251103152906-dzr3sqo","Type":"NodeParagraph","Properties":{"id":"20251103152906-dzr3sqo","updated":"20251103152906"},"Children":[{"Type":"NodeText","Data":"过多材质切换也会增加开销"}]}]}]}]},{"ID":"20251103153037-j1tng0q","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251103153037-j1tng0q","updated":"20251103153037"},"Children":[{"ID":"20251103153037-jp05688","Type":"NodeParagraph","Properties":{"id":"20251103153037-jp05688","updated":"20251103153038"},"Children":[{"Type":"NodeText","Data":"着色器"}]},{"ID":"20251103153044-o4ewvjj","Type":"NodeParagraph","Properties":{"id":"20251103153044-o4ewvjj","updated":"20251103153045"},"Children":[{"Type":"NodeText","Data":"着色器复杂度越高，分支越多，越耗性能\n我们应该避免或减少分支或循环的使用\n减少高开销的内部函数调用"}]}]},{"ID":"20251103153046-sekm4a9","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20251103153046-sekm4a9","updated":"20251103153324"},"Children":[{"ID":"20251103153046-6too2va","Type":"NodeParagraph","Properties":{"id":"20251103153046-6too2va","updated":"20251103153051"},"Children":[{"Type":"NodeText","Data":"精度和数据格式"}]},{"ID":"20251103153124-tdmoe4i","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103153124-tdmoe4i","updated":"20251103153324"},"Children":[{"ID":"20251103153245-etju7op","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103153245-etju7op","updated":"20251103153245"},"Children":[{"ID":"20251103153245-7nvjuog","Type":"NodeParagraph","Properties":{"id":"20251103153245-7nvjuog","updated":"20251103153249"},"Children":[{"Type":"NodeText","Data":"Shader 中尽量用低精度减少性能消耗"}]},{"ID":"20251103153251-zmflyt9","Type":"NodeParagraph","Properties":{"id":"20251103153251-zmflyt9","updated":"20251103153251"},"Children":[{"Type":"NodeText","Data":"移动端使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"half"},{"Type":"NodeText","Data":"​ 精度可大幅减少寄存器与能耗"}]}]},{"ID":"20251103153245-ny1c6ne","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103153245-ny1c6ne","updated":"20251103153324"},"Children":[{"ID":"20251103153245-dctil58","Type":"NodeParagraph","Properties":{"id":"20251103153245-dctil58","updated":"20251103153324"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code block-ref","TextMarkBlockRefID":"20241221221104-wuiiuuj","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"RenderTexture"},{"Type":"NodeText","Data":"​ 格式在满足需求的情况下，尽量选择精度低的格式"}]},{"ID":"20251103153252-wimky85","Type":"NodeParagraph","Properties":{"id":"20251103153252-wimky85","updated":"20251103153252"},"Children":[{"Type":"NodeText","Data":"RGBA32F 带宽和存储开销远高于 RGBA8"}]}]},{"ID":"20251103153245-rnrm6h0","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251103153245-rnrm6h0","updated":"20251103153245"},"Children":[{"ID":"20251103153245-14f641p","Type":"NodeParagraph","Properties":{"id":"20251103153245-14f641p","updated":"20251103153245"},"Children":[{"Type":"NodeText","Data":"尽量在对应平台上使用合适的压缩格式"}]}]},{"ID":"20251103153245-6bufylq","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20251103153245-6bufylq","updated":"20251103153302"},"Children":[{"ID":"20251103153245-vu9zj7p","Type":"NodeParagraph","Properties":{"id":"20251103153245-vu9zj7p","updated":"20251103153302"},"Children":[{"Type":"NodeText","Data":"在顶点着色器中输出的结构体 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"v2f"},{"Type":"NodeText","Data":"​，应该尽量避免在其中包含无意义数据，因为会进行插值计算，消耗性能"}]}]}]}]},{"ID":"20251103153052-769gdug","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20251103153052-769gdug","updated":"20251103153052"},"Children":[{"ID":"20251103153052-3aa1db0","Type":"NodeParagraph","Properties":{"id":"20251103153052-3aa1db0","updated":"20251103153058"},"Children":[{"Type":"NodeText","Data":"后处理和特效"}]},{"ID":"20251103153059-gf5giha","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20251103153059-gf5giha","updated":"20251103153107"},"Children":[{"ID":"20251103153107-4m0htrk","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20251103153107-4m0htrk","updated":"20251103153107"},"Children":[{"ID":"20251103153107-pol4s4c","Type":"NodeParagraph","Properties":{"id":"20251103153107-pol4s4c","updated":"20251103153121"},"Children":[{"Type":"NodeText","Data":"尽量减少全屏屏幕后处理效果，它们对带宽和片元算力消耗很大"}]}]},{"ID":"20251103153107-veat6y7","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20251103153107-veat6y7","updated":"20251103153107"},"Children":[{"ID":"20251103153107-metui9h","Type":"NodeParagraph","Properties":{"id":"20251103153107-metui9h","updated":"20251103153113"},"Children":[{"Type":"NodeText","Data":"半透明效果会大幅提升 OverDraw，需要谨慎使用"}]}]},{"ID":"20251103153107-87xxifq","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20251103153107-87xxifq","updated":"20251103153107"},"Children":[{"ID":"20251103153107-2rpdeu2","Type":"NodeParagraph","Properties":{"id":"20251103153107-2rpdeu2","updated":"20251103153117"},"Children":[{"Type":"NodeText","Data":"逐像素光照、多阴影贴图采样会显著增加片元着色开销，需要谨慎使用"}]}]}]}]}]},{"ID":"20251103152802-1zlidpg","Type":"NodeParagraph","Properties":{"id":"20251103152802-1zlidpg","updated":"20251103152802"}}]}