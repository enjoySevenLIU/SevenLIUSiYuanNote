{"ID":"20230713031957-op5yt5y","Spec":"1","Type":"NodeDocument","Properties":{"id":"20230713031957-op5yt5y","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20230713031957-op5yt5y\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20230713031957-yxo68d9\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20230822204649-qlkh2k2\u0026quot;,\u0026quot;scrollTop\u0026quot;:685,\u0026quot;focusId\u0026quot;:\u0026quot;20230713151447-2he9b0o\u0026quot;,\u0026quot;focusStart\u0026quot;:11,\u0026quot;focusEnd\u0026quot;:11\u0026#125;","title":"U2L10——Resources资源动态加载","type":"doc","updated":"20250903203930"},"Children":[{"ID":"20230713031957-yxo68d9","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20230713031957-yxo68d9","name":"Resources","updated":"20250903203930"},"Children":[{"Type":"NodeText","Data":"Resources 资源动态加载"}]},{"ID":"20230713150842-mj3d6ll","Type":"NodeParagraph","Properties":{"id":"20230713150842-mj3d6ll","updated":"20250903203742"},"Children":[{"Type":"NodeText","Data":"Resources 文件夹作用：资源文件夹"}]},{"ID":"20250903203918-pozpoha","Type":"NodeParagraph","Properties":{"id":"20250903203918-pozpoha","updated":"20250903203930"},"Children":[{"Type":"NodeText","Data":"需要通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Resources"},{"Type":"NodeText","Data":"​ 相关 API 动态加载的资源需要放在 Resources 文件夹中\n该文件夹下所有文件都会被打包出去，打包时 Unity 会对其压缩加密\n该文件夹打包后只读 只能通过 Resources 相关API加载\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color);"},"TextMarkType":"strong text","TextMarkTextContent":"因此只有需要动态加载的资源需要放在其中，一些不会用到的资源不需要放在里面"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color);\"}"}]},{"ID":"20230713152719-6msp1rd","Type":"NodeParagraph","Properties":{"id":"20230713152719-6msp1rd","updated":"20250903203750"},"Children":[{"Type":"NodeText","Data":"在一个工程当中 "},{"Type":"NodeTextM