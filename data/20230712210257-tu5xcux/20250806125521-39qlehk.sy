,"Marker":"Kg=="},"Properties":{"id":"20251103112932-we1tea4","updated":"20251103112932"},"Children":[{"ID":"20251103112932-u1xe1za","Type":"NodeParagraph","Properties":{"id":"20251103112932-u1xe1za","updated":"20251104154705"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20251104154705-0d3ona4","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"增强渲染性能"}]}]}]}]}]}]},{"ID":"20250806125809-dtmcl6k","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20250806125809-dtmcl6k","updated":"20251124160756"},"Children":[{"ID":"20250806125809-apv0wkw","Type":"NodeParagraph","Properties":{"id":"20250806125809-apv0wkw","updated":"20250806125812"},"Children":[{"Type":"NodeText","Data":"内存优化"}]},{"ID":"20251114103641-iajuzqe","Type":"NodeList","ListData":{},"Properties":{"id":"20251114103641-iajuzqe","updated":"20251124160756"},"Children":[{"ID":"20251114103641-7jcqdxw","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251114103641-7jcqdxw","updated":"20251124102548"},"Children":[{"ID":"20251114103641-fpf4tj6","Type":"NodeParagraph","Properties":{"id":"20251114103641-fpf4tj6","updated":"20251124102548"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20251124102548-ldnpd6z","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"资源优化"}]}]},{"ID":"20251114103645-ryi81x7","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20251114103645-ryi81x7","updated":"20251124160756"},"Children":[{"ID":"20251114103645-skpm6x8","Type":"NodeParagraph","Properties":{"id":"20251114103645-skpm6x8","updated":"20251124160756"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20251124160756-o96wt3t","TextMarkBlockRefSubtype":"s","TextMarkTextContent":"内存管理"}]}]}]}]}]},{"ID":"20250903120551-8u16pok","Type":"NodeParagraph","Properties":{"id":"20250903120551-8u16pok","updated":"202509031205