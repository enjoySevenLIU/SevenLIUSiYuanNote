							"Properties": {
								"id": "20250507132919-6ikde1m",
								"updated": "20250507132933"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "排序开始后：每次将未排序区第一个元素取出和，排序区中元素比较从后往前，满足条件（较大或者较小），则排序区中元素往后移动一个位置"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20250507132903-ysmaapz",
			"Type": "NodeBlockquote",
			"Properties": {
				"id": "20250507132903-ysmaapz",
				"style": "background-color: var(--b3-card-warning-background); color: var(--b3-card-warning-color); --b3-parent-background: var(--b3-card-warning-background);",
