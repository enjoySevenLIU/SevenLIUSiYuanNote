					},
					"Children": [
						{
							"ID": "20250507140628-0i2gkf1",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250507140628-0i2gkf1",
								"updated": "20250507140628"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "循环执行步骤 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "2."
								},
								{
									"Type": "NodeText",
									"Data": "​ ，直到 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "i"
								},
								{
									"Type": "NodeText",
									"Data": "​ 和 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "j"
								},
								{
									"Type": "NodeText",
									"Data": "​ 相遇时停止，最后将基准数交换至两个子数组的分界线。"
								}
							]
						}
					]
				}
			]
		},
		{
