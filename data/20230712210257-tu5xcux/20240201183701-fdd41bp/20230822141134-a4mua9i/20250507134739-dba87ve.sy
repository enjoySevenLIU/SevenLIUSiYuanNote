					},
					"Children": [
						{
							"ID": "20250507140628-5h53osz",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250507140628-5h53osz",
								"updated": "20250507140628"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "设置一个循环，在每轮中使用 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "i"
								},
								{
									"Type": "NodeText",
									"Data": "​（"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "j"
								},
								{
									"Type": "NodeText",
									"Data": "​）分别寻找第一个比基准数大（小）的元素，然后交换这两个元素。"
								}
							]
						}
					]
				},
				{
					"ID": "20250507140628-tjkmhnq",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Delimiter": 46,
