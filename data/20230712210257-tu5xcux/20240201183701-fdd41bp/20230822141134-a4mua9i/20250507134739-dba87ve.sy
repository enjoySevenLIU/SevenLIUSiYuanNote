			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250507135548-8d6yqlt",
				"updated": "20250507140614"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "快速排序（quick sort）是一种基于分治策略的排序算法，运行高效，应用广泛。\n"
				}
			]
		},
		{
			"ID": "20250507135601-m2oq7bm",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20250507135601-m2oq7bm",
				"updated": "20250507144728"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "快速排序基本原理"
				}
			]
		},
		{
			"ID": "20250507135627-75wyvoc",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250507135627-75wyvoc",
				"updated": "20250507140615"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "简略来说：选取基准，产生左右标识，左右比基准，满足则换位，排完一次，基准定位，左右递归，直到有序"
				}
			]
		},
		{
			"ID": "20250507140620-5h13ctk",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250507140620-5h13ctk",
				"updated": "20250507140620"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "详细解释：快速排序的核心操作是“哨兵划分”，其目标是：选择数组中的某个元素作为“基准数”，将所有小于基准数的元素移到其左侧，而大于基准数的元素移到其右侧。"
				}
			]
		},
		{
			"ID": "20250507140628-6tqjove",
			"Type": "NodeList",
			"ListData": {
				"Typ": 1
			},
			"Properties": {
				"id": "20250507140628-6tqjove",
				"updated": "20250507140628"
			},
			"Children": [
				{
					"ID": "20250507140628-ysk3dn1",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Delimiter": 46,
						"Marker": "MS4=",
						"Num": 1
					},
					"Properties": {
						"id": "20250507140628-ysk3dn1",
						"updated": "20250507140628"
					},
					"Children": [
						{
							"ID": "20250507140628-sogqpap",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250507140628-sogqpap",
								"updated": "20250507140628"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "选取数组最左端元素作为基准数，初始化两个指针 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "i"
								},
								{
									"Type": "NodeText",
									"Data": "​ 和 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "j"
								},
								{
									"Type": "NodeText",
									"Data": "​ 分别指向数组的两端。"
								}
							]
						}
					]
				},
				{
					"ID": "20250507140628-09eu835",
					"Type": "NodeListItem",
					"ListData": {
						"Typ": 1,
						"Delimiter": 46,
