			"Children": [
				{
					"ID": "20250507143318-jy20rn2",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250507143318-jy20rn2",
						"updated": "20250507143419"
					},
					"Children": [
						{
							"ID": "20250507143318-15k8xh6",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250507143318-15k8xh6",
								"updated": "20250507143419"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "时间复杂度为"
								},
								{
									"Type": "NodeText",
									"Data": " "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong inline-math",
									"TextMarkInlineMathContent": "O(n\\log⁡n)"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "、非自适应排序"
								},
								{
									"Type": "NodeText",
									"Data": "：在平均情况下，哨兵划分的递归层数为 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "\\log⁡n"
								},
								{
									"Type": "NodeText",
									"Data": " ，每层中的总循环数为 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "n"
								},
								{
									"Type": "NodeText",
									"Data": " ，总体使用 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "O(n\\log⁡n)"
								},
								{
									"Type": "NodeText",
									"Data": " 时间。\n在最差情况下，每轮哨兵划分操作都将长度为 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "n"
								},
								{
									"Type": "NodeText",
									"Data": " 的数组划分为长度为 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "0"
								},
								{
									"Type": "NodeText",
									"Data": " 和 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "n−1"
								},
								{
									"Type": "NodeText",
									"Data": " 的两个子数组，此时递归层数达到 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "n"
								},
								{
									"Type": "NodeText",
									"Data": " ，每层中的循环数为 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "n"
								},
								{
									"Type": "NodeText",
									"Data": " ，总体使用 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "O(n^2)"
								},
								{
									"Type": "NodeText",
									"Data": " 时间。"
								}
							]
						}
					]
				},
				{
					"ID": "20250507143318-ltb7a4q",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250507143318-ltb7a4q",
						"updated": "20250507143437"
					},
					"Children": [
						{
							"ID": "20250507143318-f74flqy",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250507143318-f74flqy",
								"updated": "20250507143437"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "空间复杂度为"
								},
								{
									"Type": "NodeText",
									"Data": " "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong inline-math",
									"TextMarkInlineMathContent": "O(n)"
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "、原地排序"
								},
								{
									"Type": "NodeText",
									"Data": "：在输入数组完全倒序的情况下，达到最差递归深度 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "n"
								},
								{
									"Type": "NodeText",
									"Data": " ，使用 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "O(n)"
								},
								{
									"Type": "NodeText",
									"Data": " 栈帧空间。排序操作是在原数组上进行的，未借助额外数组。"
								}
							]
						}
					]
				},
				{
					"ID": "20250507143318-1nt1o4o",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250507143318-1nt1o4o",
						"updated": "20250507143318"
					},
					"Children": [
						{
							"ID": "20250507143318-rdrk3n1",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250507143318-rdrk3n1",
								"updated": "20250507143318"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "非稳定排序"
								},
								{
									"Type": "NodeText",
									"Data": "：在哨兵划分的最后一步，基准数可能会被交换至相等元素的右侧。"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20250507143517-poo9qvj",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20250507143517-poo9qvj",
				"updated": "20250507143543"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "快速排序为什么快"
				}
			]
		},
		{
			"ID": "20250507143543-u2b1mbm",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250507143543-u2b1mbm",
				"updated": "20250507143547"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "从名称上就能看出，快速排序在效率方面应该具有一定的优势。尽管快速排序的平均时间复杂度与“归并排序”和“堆排序”相同，但通常快速排序的效率更高，主要有以下原因。"
				}
			]
		},
		{
			"ID": "20250507143543-0tzgetr",
			"Type": "NodeList",
			"ListData": {},
			"Properties": {
				"id": "20250507143543-0tzgetr",
				"updated": "20250507143543"
			},
			"Children": [
				{
					"ID": "20250507143543-nc8ouc2",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250507143543-nc8ouc2",
						"updated": "20250507143543"
					},
					"Children": [
						{
							"ID": "20250507143543-b9xwjpd",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250507143543-b9xwjpd",
								"updated": "20250507143601"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "出现最差情况的概率很低"
								},
								{
									"Type": "NodeText",
									"Data": "：虽然快速排序的最差时间复杂度为 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "O(n^2)"
								},
								{
									"Type": "NodeText",
									"Data": " ，没有归并排序稳定，但在绝大多数情况下，快速排序能在 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "O(n\\log⁡n)"
								},
								{
									"Type": "NodeText",
									"Data": " 的时间复杂度下运行。"
								}
							]
						}
					]
				},
				{
					"ID": "20250507143543-qmz4939",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250507143543-qmz4939",
						"updated": "20250507143543"
					},
					"Children": [
						{
							"ID": "20250507143543-966hwht",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250507143543-966hwht",
								"updated": "20250507143543"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "缓存使用效率高"
								},
								{
									"Type": "NodeText",
									"Data": "：在执行哨兵划分操作时，系统可将整个子数组加载到缓存，因此访问元素的效率较高。而像“堆排序”这类算法需要跳跃式访问元素，从而缺乏这一特性。"
								}
							]
						}
					]
				},
				{
					"ID": "20250507143543-njr2gpc",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "20250507143543-njr2gpc",
						"updated": "20250507143543"
					},
					"Children": [
						{
							"ID": "20250507143543-l7mov1v",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250507143543-l7mov1v",
								"updated": "20250507143543"
							},
							"Children": [
								{
									"Type": "NodeTextMark",
									"TextMarkType": "strong",
									"TextMarkTextContent": "复杂度的常数系数小"
								},
								{
									"Type": "NodeText",
									"Data": "：在上述三种算法中，快速排序的比较、赋值、交换等操作的总数量最少。这与“插入排序”比“冒泡排序”更快的原因类似。"
								}
							]
						}
					]
				}
			]
		},
		{
			"ID": "20250507143620-hmfditb",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20250507143620-hmfditb",
				"updated": "20250507144412"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "基准值优化"
				}
			]
		},
		{
			"ID": "20250507144019-4ivsvtg",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250507144019-4ivsvtg",
				"updated": "20250507144124"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "快速排序在某些输入下的时间效率可能降低"
				},
				{
					"Type": "NodeText",
					"Data": "。\n举一个极端例子，假设输入数组是完全倒序的，由于我们选择最左端元素作为基准数，那么在哨兵划分完成后，基准数被交换至数组最右端，导致左子数组长度为 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "n−1"
				},
				{
					"Type": "NodeText",
					"Data": "、右子数组长度为 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "0"
				},
				{
					"Type": "NodeText",
					"Data": " 。如此递归下去，每轮哨兵划分后都有一个子数组的长度为 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "0"
				},
				{
					"Type": "NodeText",
					"Data": " ，分治策略失效，快速排序退化为“冒泡排序”的近似形式。"
				}
			]
		},
		{
			"ID": "20250507144019-lw9g7ze",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250507144019-lw9g7ze",
				"updated": "20250507144117"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "为了尽量避免这种情况发生，"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "我们可以优化哨兵划分中的基准数的选取策略"
				},
				{
					"Type": "NodeText",
					"Data": "。\n例如，我们可以随机选取一个元素作为基准数。然而，如果运气不佳，每次都选到不理想的基准数，效率仍然不尽如人意。"
				}
			]
		},
		{
			"ID": "20250507144019-4vct1sd",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250507144019-4vct1sd",
				"updated": "20250507144019"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "需要注意的是，编程语言通常生成的是“伪随机数”。如果我们针对伪随机数序列构建一个特定的测试样例，那么快速排序的效率仍然可能劣化。"
				}
			]
		},
		{
			"ID": "20250507144019-u54g3q6",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250507144019-u54g3q6",
				"updated": "20250507144114"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "为了进一步改进，我们可以在数组中选取三个候选元素（通常为数组的首、尾、中点元素），"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "并将这三个候选元素的中位数作为基准数"
				},
				{
					"Type": "NodeText",
					"Data": "。\n这样一来，基准数“既不太小也不太大”的概率将大幅提升。当然，我们还可以选取更多候选元素，以进一步提高算法的稳健性。\n采用这种方法后，时间复杂度劣化至 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "O(n^2)"
				},
				{
					"Type": "NodeText",
					"Data": " 的概率大大降低。"
				}
			]
		},
		{
			"ID": "20250507144142-5ovbd4m",
			"Type": "NodeCodeBlock",
			"IsFencedCodeBlock": true,
			"Properties": {
				"id": "20250507144142-5ovbd4m",
				"updated": "20250507144148"
			},
			"Children": [
				{
					"Type": "NodeCodeBlockFenceOpenMarker",
					"Data": "```"
				},
				{
					"Type": "NodeCodeBlockFenceInfoMarker"
				},
				{
					"Type": "NodeCodeBlockCode"
				},
				{
					"Type": "NodeCodeBlockFenceCloseMarker",
					"Data": "```"
				}
			]
		},
		{
			"ID": "20250507144410-qkcsa1x",
			"Type": "NodeHeading",
			"HeadingLevel": 2,
			"Properties": {
				"id": "20250507144410-qkcsa1x",
				"updated": "20250507144705"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "尾递归优化"
				}
			]
		},
		{
			"ID": "20250507144422-mobtut0",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250507144422-mobtut0",
				"updated": "20250507144446"
			},
			"Children": [
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "在某些输入下，快速排序可能占用空间较多"
				},
				{
					"Type": "NodeText",
					"Data": "。\n以完全有序的输入数组为例，设递归中的子数组长度为 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "m"
				},
				{
					"Type": "NodeText",
					"Data": " ，每轮哨兵划分操作都将产生长度为 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "0"
				},
				{
					"Type": "NodeText",
					"Data": " 的左子数组和长度为 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "m−1"
				},
				{
					"Type": "NodeText",
					"Data": " 的右子数组，\n这意味着每一层递归调用减少的问题规模非常小（只减少一个元素），递归树的高度会达到 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "n−1"
				},
				{
					"Type": "NodeText",
					"Data": " ，此时需要占用 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "O(n)"
				},
				{
					"Type": "NodeText",
					"Data": " 大小的栈帧空间。"
				}
			]
		},
		{
			"ID": "20250507144422-733hi0i",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20250507144422-733hi0i",
				"updated": "20250507144512"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "为了防止栈帧空间的累积，我们可以在每轮哨兵排序完成后，比较两个子数组的长度，"
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "strong",
					"TextMarkTextContent": "仅对较短的子数组进行递归"
				},
				{
					"Type": "NodeText",
					"Data": "。\n由于较短子数组的长度不会超过 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "n/2"
				},
				{
					"Type": "NodeText",
					"Data": " ，因此这种方法能确保递归深度不超过 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "\\log⁡n"
				},
				{
					"Type": "NodeText",
					"Data": "，从而将最差空间复杂度优化至 "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "inline-math",
					"TextMarkInlineMathContent": "O(\\log⁡n)"
				},
				{
					"Type": "NodeText",
					"Data": "。代码如下所示："
				}
			]
		},
