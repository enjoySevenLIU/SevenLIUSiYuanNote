									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "n"
								},
								{
									"Type": "NodeText",
									"Data": " ，最后一轮的未排序区间长度为 2 ，\n即各轮外循环分别包含 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "n、n−1、…、3、2"
								},
								{
									"Type": "NodeText",
									"Data": " 轮内循环，求和为 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "inline-math",
									"TextMarkInlineMathContent": "\\frac{(n−1)(n+2)}{2}"
								},
								{
									"Type": "NodeText",
									"Data": " 。"
								}
							]
						}
					]
				},
