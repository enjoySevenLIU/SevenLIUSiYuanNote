0250424154103-po1zpod","Type":"NodeParagraph","Properties":{"id":"20250424154103-po1zpod","updated":"20250424154130"},"Children":[{"Type":"NodeText","Data":"异或加密是一种简单的对称加密算法。原理就是基于异或运算，相同为0，不同为1。\n异或加密时会有一个固定的密钥，想要加密的数据与该密钥进行异或运算得到加密后的数据\n加密后的数据再和密钥进行异或运算得到原数据（解密后的数据）"}]},{"ID":"20250424154133-107gr9d","Type":"NodeParagraph","Properties":{"id":"20250424154133-107gr9d","updated":"20250424154354"},"Children":[{"Type":"NodeText","Data":"举例：\n假设原数据为："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"1010"},{"Type":"NodeText","Data":"​\n密钥为："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"1100"},{"Type":"NodeText","Data":"​\n加密后的数据为："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"1010 ^ 1100 = 0110"},{"Type":"NodeText","Data":"​\n解密数据："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"0110 ^ 1100 = 1010"},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20250424153802-zn9rume","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20250424153802-zn9rume","updated":"20250424153802"},"Children":[{"ID":"20250424153802-xx9bhr5","Type":"NodeParagraph","Properties":{"id":"20250424153802-xx9bhr5","updated":"20250424153802"},"Children":[{"Type":"NodeText","Data":"下面的函数是判断一个整数是不是 2 的 n 次方。请问 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"if"},{"Type":"NodeText","Data":"​ 语句中应该如何书写"}]},{"ID":"20250424153802-um7pp1n","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20250424153802-um7pp1n","updated":"20250424153802"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YyM="},{"Type":"NodeCodeBlockCode","Data":"static bool isPowerOfTwo(uint num)\n{\n    if (/*...*/)\n        return true;\n    return false;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20250424154713-wina7wq","Type":"NodeParagraph","Properties":{"id":"20250424154713-wina7wq","updated":"20250424154802"},"Children":[{"Type":"NodeText","Data":"答："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"(num \u0026amp; num - 1) == 0 \u0026amp;\u0026amp; num \u0026gt;= 0"},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20250424153802-d77qxog","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20250424153802-d77qxog","updated":"20250424155244"},"Children":[{"ID":"20250424153802-750bder","Type":"NodeParagraph","Properties":{"id":"20250424153802-750bder","updated":"20250424153802"},"Children":[{"Type":"NodeText","Data":"有 1000 瓶水其中一瓶是有毒的，喝下后 24 小时后才死，现在用小白鼠来测试哪一瓶有毒。\n最少需要用多少只小白鼠才能测出哪一瓶是有毒的水（需要在 24 小时后出结果，不能用几天时间来测试）"}]},{"ID":"20250424155244-zmwhblk","Type":"NodeParagraph","Properties":{"id":"20250424155244-zmwhblk","updated":"20250424155244"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 403px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20250424155244-oyx3yah.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 403px;\"}"},{"Type":"NodeText","Data":"​"}]}]}]},{"ID":"20250424153802-z282z4b","Type":"NodeParagraph","Properties":{"id":"20250424153802-z282z4b","updated":"20250424153802"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Unity"}]},{"ID":"20250424153802-fnyecm7","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20250424153802-fnyecm7","updated":"20250424160021"},"Children":[{"ID":"20250424153802-pj3goey","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20250424153802-pj3goey","updated":"20250424153802"},"Children":[{"ID":"20250424153802-48rs6pk","Type":"NodeParagraph","Properties":{"id":"20250424153802-48rs6pk","updated":"