											"Type": "NodeParagraph",
											"Properties": {
												"id": "20250425104511-m0kqw4b",
												"updated": "20250425104511"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "动态批处理在运行时随时可能变化（对象可以频繁进行移动、旋转、缩放等操作），静态批处理结果运行时不变（静态对象不能有变化）"
												}
											]
										}
									]
								},
								{
									"ID": "20250425104514-envsgnp",
									"Type": "NodeListItem",
