						{
							"ID": "20250425103006-e7t75lw",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250425103006-e7t75lw",
								"updated": "20250425103006"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "为什么线性的表现效果更好，Unity 默认还是使用的伽马呢？"
								}
							]
						},
						{
							"ID": "20250425110038-0dezd47",
							"Type": "NodeList",
							"ListData": {
								"Typ": 1
							},
							"Properties": {
								"id": "20250425110038-0dezd47",
								"updated": "20250425110123"
							},
							"Children": [
								{
									"ID": "20250425110042-rg42x29",
									"Type": "NodeListItem",
									"ListData": {
										"Typ": 1,
										"Delimiter": 46,
										"Marker": "MS4=",
										"Num": 1
									},
									"Properties": {
										"id": "20250425110042-rg42x29",
										"updated": "20250425110123"
									},
									"Children": [
										{
											"ID": "20250425110042-f02m250",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20250425110042-f02m250",
												"updated": "20250425110123"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "早期的计算机图形学和显示技术主要使用伽马颜色空间，\n传统的显示设备（如CRT显示器：阴极射线管显示器）也默认使用伽马曲线来显示颜色。\n为了确保向前兼容性，很多图形应用程序和引擎默认都使用的伽马颜色空间。"
												}
											]
										}
									]
								},
								{
									"ID": "20250425110049-webujof",
									"Type": "NodeListItem",
									"ListData": {
										"Typ": 1,
										"Delimiter": 46,
										"Marker": "Mi4=",
										"Num": 2
									},
									"Properties": {
										"id": "20250425110049-webujof",
										"updated": "20250425110049"
									},
									"Children": [
										{
											"ID": "20250425110049-3f7ynrr",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20250425110049-3f7ynrr",
												"updated": "20250425110052"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "即使目前较新的显示器采用的也是 sRGB 颜色空间，是一种与伽马非常相近的非线性颜色空间"
												}
											]
										}
									]
								},
								{
									"ID": "20250425110054-d6y3yiy",
									"Type": "NodeListItem",
									"ListData": {
										"Typ": 1,
										"Delimiter": 46,
										"Marker": "My4=",
										"Num": 3
									},
									"Properties": {
										"id": "20250425110054-d6y3yiy",
										"updated": "20250425110107"
									},
									"Children": [
										{
											"ID": "20250425110054-6190zrh",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20250425110054-6190zrh",
												"updated": "20250425110107"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "伽马颜色空间下的性能消耗更低，颜色和光照计算都是直接进行的，无需进行线性化和去线性化的转换步骤。\n在线性颜色空间中，需要将输入的 sRGB 颜色值转换为线性颜色值进行计算，完成后再将结果转换回 sRGB 以供显示"
												}
											]
										}
									]
								}
							]
						}
					]
				}
			]
		}
	]
}