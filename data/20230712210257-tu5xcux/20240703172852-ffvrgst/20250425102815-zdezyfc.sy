						{
							"ID": "20250425103006-kpj1b6c",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250425103006-kpj1b6c",
								"updated": "20250425103006"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "在 Unity 中使用 C"
								},
								{
									"Type": "NodeBackslash",
									"Data": "span",
									"Children": [
										{
											"Type": "NodeText",
											"Data": "#"
										}
									]
								},
								{
									"Type": "NodeText",
									"Data": " 的 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "foreach"
								},
								{
									"Type": "NodeText",
									"Data": "​ 是否会带来额外内存和性能开销？"
								}
							]
						},
						{
							"ID": "20250425103404-8n6g6yn",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250425103404-8n6g6yn",
								"updated": "20250425103450"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "在老版本 Unity 中，由于 mono 编译器的一个 bug，\n在使用 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "foreach"
								},
								{
									"Type": "NodeText",
									"Data": "​ 时编译器会通过 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "IEnumerable\u0026lt;T\u0026gt;"
								},
								{
									"Type": "NodeText",
									"Data": "​ 或 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "IEnumerable"
								},
								{
									"Type": "NodeText",
									"Data": "​ 接口访问集合的枚举器，\n导致值类型被装箱，产生额外内存分配和垃圾回收。这个问题在 Unity 5.6 版本后已经就已经进行了修复。"
								}
							]
						},
						{
							"ID": "20250425103454-pkwx0gt",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "20250425103454-pkwx0gt",
								"updated": "20250425103503"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "只要避免在 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "Update"
								},
								{
									"Type": "NodeText",
									"Data": "​ 循环中使用 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "foreach"
								},
								{
									"Type": "NodeText",
									"Data": "​ 即可，在其他地方使用 "
								},
								{
									"Type": "NodeTextMark",
									"TextMarkType": "code",
									"TextMarkTextContent": "foreach"
								},
								{
									"Type": "NodeText",
									"Data": "​ 没有太大的顾虑了"
								}
							]
						}
					]
				},
