											"Children": [
												{
													"Type": "NodeText",
													"Data": "动态批处理和静态批处理都可以在 Player Setting 中 Other Settings 中设置是否开启"
												}
											]
										},
										{
											"ID": "20250425104432-ug3ex4b",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20250425104432-ug3ex4b",
												"updated": "20250425104432"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "静态批处理默认开启，动态批处理默认关闭"
												}
											]
										}
									]
								},
								{
									"ID": "20250425104423-4mn26dx",
									"Type": "NodeListItem",
									"ListData": {
										"Typ": 1,
										"Delimiter": 46,
										"Marker": "Mi4=",
										"Num": 2
									},
									"Properties": {
										"id": "20250425104423-4mn26dx",
										"updated": "20250425104423"
									},
									"Children": [
										{
											"ID": "20250425104423-vktmnz3",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20250425104423-vktmnz3",
												"updated": "20250425104808"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "动态批处理是 Unity 自动会帮助我们将小型动态对象进行批处理，而静态批处理只会处理设置为静态 Static 的对象（注意：相同材质的对象）"
												}
											]
										},
										{
											"ID": "20250425104743-yvpa7dx",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20250425104743-yvpa7dx",
												"updated": "20250425104816"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "动态批处理无法处理超过 900 个顶点属性和 225 个顶点的网格，\n比如着色器使用顶点位置、顶点法线和单个 UV，则 Unity 最多可以动态批处理 225 个顶点。\n但是，如果着色器使用顶点位置、顶点法线、UV0、UV1 和顶点正切，则 Unity 只能动态批处理 180 个顶点"
												}
											]
										}
									]
								},
								{
									"ID": "20250425104502-vvdb8fg",
									"Type": "NodeListItem",
									"ListData": {
										"Typ": 1,
										"Delimiter": 46,
										"Marker": "My4=",
										"Num": 3
									},
									"Properties": {
										"id": "20250425104502-vvdb8fg",
										"updated": "20250425104502"
									},
									"Children": [
										{
											"ID": "20250425104502-fn1vz05",
											"Type": "NodeParagraph",
											"Properties": {
												"id": "20250425104502-fn1vz05",
												"updated": "20250425104507"
											},
											"Children": [
												{
													"Type": "NodeText",
													"Data": "动态批处理主要消耗 CPU 性能，静态批处理主要消耗内存"
												}
											]
										}
									]
								},
								{
									"ID": "20250425104511-cpwvzx6",
									"Type": "NodeListItem",
									"ListData": {
										"Typ": 1,
										"Delimiter": 46,
										"Marker": "NC4=",
